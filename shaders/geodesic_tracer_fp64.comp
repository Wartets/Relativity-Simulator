const double PI_D = 3.14159265358979323846;
const uint PERSISTENT_BATCH_SIZE = 8u;

uint hash_u32(uint x) {
	x ^= x >> 16;
	x *= 0x7feb352dU;
	x ^= x >> 15;
	x *= 0x846ca68bU;
	x ^= x >> 16;
	return x;
}

float hash_to_float(uint x) {
	return float(hash_u32(x) & 0x00FFFFFFU) * (1.0 / 16777216.0);
}

dvec2 precise_sincos(double theta) {
	double h = theta * 0.25;
	double h2 = h * h;
	double sin_h = h * (1.0 - h2 * (1.0 / 6.0 - h2 * (1.0 / 120.0 - h2 * (1.0 / 5040.0 - h2 / 362880.0))));
	double cos_h = 1.0 - h2 * (0.5 - h2 * (1.0 / 24.0 - h2 * (1.0 / 720.0 - h2 / 40320.0)));
	double sin_2h = 2.0 * sin_h * cos_h;
	double cos_2h = 1.0 - 2.0 * sin_h * sin_h;
	double sin_4h = 2.0 * sin_2h * cos_2h;
	double cos_4h = 1.0 - 2.0 * sin_2h * sin_2h;
	return dvec2(sin_4h, cos_4h);
}

dvec3 spherical_to_cartesian(double r, double theta, double phi) {
	dvec2 sincos_theta = precise_sincos(theta);
	float phi_f = float(phi);
	double r_sin_theta = r * sincos_theta.x;
	return dvec3(r_sin_theta * double(cos(phi_f)), r_sin_theta * double(sin(phi_f)), r * sincos_theta.y);
}

double cbrt_d(double x) {
	float xf = float(x);
	float sign_x = (xf < 0.0) ? -1.0 : 1.0;
	float result = sign_x * pow(abs(xf), 1.0 / 3.0);
	return double(result);
}

double kerr_newman_delta(double r, double mass, double a, double rq2) {
	return r * r - 2.0 * mass * r + a * a + rq2;
}

double kerr_isco_radius_prograde_retrograde(double mass, double a) {
	double a_star = clamp(a / mass, -0.9999999, 0.9999999);
	double abs_a = abs(a_star);
	double orbit_sign = (a_star >= 0.0) ? -1.0 : 1.0;
	double cbrt_term = cbrt_d(max(1.0 - abs_a * abs_a, 0.0));
	double z1 = 1.0 + cbrt_term * (cbrt_d(1.0 + abs_a) + cbrt_d(1.0 - abs_a));
	double z2 = sqrt(3.0 * abs_a * abs_a + z1 * z1);
	double r_isco_over_m = 3.0 + z2 + orbit_sign * sqrt(max((3.0 - z1) * (3.0 + z1 + 2.0 * z2), 0.0));
	return r_isco_over_m * mass;
}

void kerr_newman_zamo_frame(
	double r, double theta, double mass, double a, double rq2,
	out double g00, out double g03, out double g11, out double g22, out double g33,
	out double e0_t, out double e0_phi, out double e1_r, out double e2_th, out double e3_phi
) {
	float theta_f = float(theta);
	double sin_t = double(sin(theta_f));
	double cos_t = double(cos(theta_f));
	double sin2_t = sin_t * sin_t;
	double cos2_t = cos_t * cos_t;
	double a2 = a * a;
	double r2 = r * r;
	double rho2 = r2 + a2 * cos2_t;
	double delta = kerr_newman_delta(r, mass, a, rq2);
	double two_mr_minus_q2 = 2.0 * mass * r - rq2;
	double sigma = (r2 + a2) * (r2 + a2) - a2 * delta * sin2_t;

	g00 = -(1.0 - two_mr_minus_q2 / rho2);
	g03 = -(two_mr_minus_q2 * a * sin2_t) / rho2;
	g11 = rho2 / delta;
	g22 = rho2;
	g33 = (sigma * sin2_t) / rho2;

	double omega = -g03 / max(g33, 1e-30);
	double lapse_sq = -(g00 + omega * g03);
	double alpha = sqrt(max(lapse_sq, 1e-30));
	e0_t = 1.0 / alpha;
	e0_phi = omega / alpha;
	e1_r = 1.0 / sqrt(max(g11, 1e-30));
	e2_th = 1.0 / sqrt(max(g22, 1e-30));
	e3_phi = 1.0 / sqrt(max(g33, 1e-30));
}

dvec4 kerr_newman_geodesic_derivative(dvec4 u, double r, double theta, double mass, double a, double rq2) {
	float theta_f = float(theta);
	double sin_t = double(sin(theta_f));
	double cos_t = double(cos(theta_f));
	double sin2_t = sin_t * sin_t;
	double cos2_t = cos_t * cos_t;
	double a2 = a * a;
	double r2 = r * r;
	double rho2 = r2 + a2 * cos2_t;
	double inv_rho2 = 1.0 / rho2;
	double inv_rho4 = inv_rho2 * inv_rho2;
	double delta = kerr_newman_delta(r, mass, a, rq2);
	double inv_delta = 1.0 / delta;
	double inv_delta2 = inv_delta * inv_delta;
	double inv_rho2_delta = inv_rho2 * inv_delta;
	double two_mr_minus_q2 = 2.0 * mass * r - rq2;

	double d1_ratio = (2.0 * mass * rho2 - two_mr_minus_q2 * 2.0 * r) * inv_rho4;
	double d1_g00 = d1_ratio;
	double d1_g03 = -a * sin2_t * d1_ratio;
	double d1_delta = 2.0 * (r - mass);
	double d1_g11 = (2.0 * r * delta - rho2 * d1_delta) * inv_delta2;
	double d1_g22 = 2.0 * r;
	double sigma = (r2 + a2) * (r2 + a2) - a2 * delta * sin2_t;
	double d1_sigma = 4.0 * r * (r2 + a2) - a2 * d1_delta * sin2_t;
	double d1_g33 = sin2_t * (d1_sigma * rho2 - sigma * 2.0 * r) * inv_rho4;

	double sin_cos = sin_t * cos_t;
	double d2_rho2 = -2.0 * a2 * sin_cos;
	double d2_ratio = -two_mr_minus_q2 * d2_rho2 * inv_rho4;
	double d2_g00 = d2_ratio;
	double d2_g03 = -a * (2.0 * sin_cos * two_mr_minus_q2 * rho2 - two_mr_minus_q2 * sin2_t * d2_rho2) * inv_rho4;
	double d2_g11 = d2_rho2 * inv_delta;
	double d2_g22 = d2_rho2;
	double d2_sigma = -2.0 * a2 * delta * sin_cos;
	double d2_term = 2.0 * sin_cos * sigma * rho2 + sin2_t * d2_sigma * rho2 - sigma * sin2_t * d2_rho2;
	double d2_g33 = d2_term * inv_rho4;

	double inv_g00 = -sigma * inv_rho2_delta;
	double inv_g03 = -(two_mr_minus_q2 * a) * inv_rho2_delta;
	double inv_g11 = delta * inv_rho2;
	double inv_g22 = inv_rho2;
	double safe_sin2_t = max(sin2_t, 1e-12);
	double inv_g33 = (delta - a2 * sin2_t) * (inv_rho2_delta / safe_sin2_t);

	double p0 = u.x, p1 = u.y, p2 = u.z, p3 = u.w;

	double term0 = d1_g00 * p1 * p0 + d2_g00 * p2 * p0 + d1_g03 * p1 * p3 + d2_g03 * p2 * p3;
	double term1 = -0.5 * (d1_g00 * p0 * p0 + d1_g11 * p1 * p1 + d1_g22 * p2 * p2 + d1_g33 * p3 * p3 + 2.0 * d1_g03 * p0 * p3) + d1_g11 * p1 * p1 + d2_g11 * p2 * p1;
	double term2 = -0.5 * (d2_g00 * p0 * p0 + d2_g11 * p1 * p1 + d2_g22 * p2 * p2 + d2_g33 * p3 * p3 + 2.0 * d2_g03 * p0 * p3) + d1_g22 * p1 * p2 + d2_g22 * p2 * p2;
	double term3 = d1_g03 * p1 * p0 + d2_g03 * p2 * p0 + d1_g33 * p1 * p3 + d2_g33 * p2 * p3;

	dvec4 acc;
	acc.x = -(inv_g00 * term0 + inv_g03 * term3);
	acc.y = -inv_g11 * term1;
	acc.z = -inv_g22 * term2;
	acc.w = -(inv_g03 * term0 + inv_g33 * term3);
	return acc;
}

dvec3 compute_pinhole_ray(double u, double v, double fov) {
	double tan_half = double(tan(float(fov * 0.5)));
	double n1 = 1.0;
	double n2 = v * tan_half;
	double n3 = u * tan_half;
	double len = sqrt(n1 * n1 + n2 * n2 + n3 * n3);
	double inv_len = (len > 0.0) ? (1.0 / len) : 1.0;
	return dvec3(n1 * inv_len, n2 * inv_len, n3 * inv_len);
}

dvec3 compute_fisheye_stereographic_ray(double u, double v, double fov) {
	double max_fov = clamp(fov * 1.6, 0.1, 260.0 * 0.017453292519943295);
	double r = sqrt(u * u + v * v);
	if (r < 1e-15) return dvec3(1.0, 0.0, 0.0);
	double half_max_fov = max_fov * 0.5;
	float tan_half_max_fov = tan(float(half_max_fov * 0.5));
	double theta = double(2.0 * atan(float(r) * tan_half_max_fov));
	float theta_f = float(theta);
	double sin_t = double(sin(theta_f));
	double cos_t = double(cos(theta_f));
	double n1 = cos_t;
	double n2 = v * (sin_t / r);
	double n3 = u * (sin_t / r);
	double len = sqrt(n1 * n1 + n2 * n2 + n3 * n3);
	double inv_len = (len > 0.0) ? (1.0 / len) : 1.0;
	return dvec3(n1 * inv_len, n2 * inv_len, n3 * inv_len);
}

dvec3 compute_fisheye_equidistant_ray(double u, double v, double fov) {
	double r = sqrt(u * u + v * v);
	if (r < 1e-15) return dvec3(1.0, 0.0, 0.0);
	double theta = min(r * fov * 0.5, PI_D);
	float theta_f = float(theta);
	double sin_t = double(sin(theta_f));
	double cos_t = double(cos(theta_f));
	double n1 = cos_t;
	double n2 = v * (sin_t / r);
	double n3 = u * (sin_t / r);
	double len = sqrt(n1 * n1 + n2 * n2 + n3 * n3);
	double inv_len = (len > 0.0) ? (1.0 / len) : 1.0;
	return dvec3(n1 * inv_len, n2 * inv_len, n3 * inv_len);
}

dvec3 compute_fisheye_orthographic_ray(double u, double v, double fov) {
	double r = sqrt(u * u + v * v);
	double sin_half_fov = double(sin(float(clamp(fov * 0.5, 0.01, PI_D * 0.499))));
	double sin_t = clamp(r * sin_half_fov, 0.0, 1.0);
	double cos_t = sqrt(max(1.0 - sin_t * sin_t, 0.0));
	if (r < 1e-15) return dvec3(1.0, 0.0, 0.0);
	double n1 = cos_t;
	double n2 = v * (sin_t / r);
	double n3 = u * (sin_t / r);
	double len = sqrt(n1 * n1 + n2 * n2 + n3 * n3);
	double inv_len = (len > 0.0) ? (1.0 / len) : 1.0;
	return dvec3(n1 * inv_len, n2 * inv_len, n3 * inv_len);
}

dvec3 compute_panini_cylindrical_ray(double u, double v, double fov) {
	double d = 1.0;
	double tan_h = double(tan(float(fov * 0.5)));
	double px = u * tan_h;
	double py = v * tan_h;
	double s = (d + 1.0) / (d + sqrt(max(1.0 + (1.0 - d * d) * px * px / ((d + 1.0) * (d + 1.0)), 1e-15)));
	double sin_phi = (px * s) / (d + 1.0);
	double cos_phi = sqrt(max(1.0 - sin_phi * sin_phi, 0.0));
	double n1 = cos_phi;
	double n2 = py;
	double n3 = sin_phi;
	double len = sqrt(n1 * n1 + n2 * n2 + n3 * n3);
	double inv_len = (len > 0.0) ? (1.0 / len) : 1.0;
	return dvec3(n1 * inv_len, n2 * inv_len, n3 * inv_len);
}

dvec3 compute_hammer_aitoff_ray(double u, double v, double fov) {
	double zoom = (60.0 * 0.017453292519943295) / max(fov, 0.01);
	double sqrt2 = 1.4142135623730951;
	double x = clamp(u * zoom * sqrt2, -sqrt2, sqrt2);
	double y = clamp(v * zoom * sqrt2 * 0.5, -sqrt2 * 0.5, sqrt2 * 0.5);
	double z = sqrt(max(1.0 - (x * x * 0.25) - (y * y), 1e-15));
	double phi = double(2.0 * atan(float(z * x), float(2.0 * (2.0 * z * z - 1.0))));
	double theta = (PI_D * 0.5) - double(asin(float(clamp(z * y * sqrt2, -1.0, 1.0))));
	float theta_f = float(theta);
	float phi_f = float(phi);
	double sin_t = double(sin(theta_f));
	double cos_t = double(cos(theta_f));
	double sin_p = double(sin(phi_f));
	double cos_p = double(cos(phi_f));
	return dvec3(sin_t * cos_p, cos_t, sin_t * sin_p);
}

dvec3 compute_equirectangular_360_ray(double u, double v, double fov) {
	double fov_scale = fov / (60.0 * 0.017453292519943295);
	double phi = u * PI_D * fov_scale;
	double theta = clamp((PI_D * 0.5) - v * (PI_D * 0.5) * fov_scale, 0.0001, PI_D - 0.0001);
	float theta_f = float(theta);
	float phi_f = float(phi);
	double sin_t = double(sin(theta_f));
	double cos_t = double(cos(theta_f));
	double sin_p = double(sin(phi_f));
	double cos_p = double(cos(phi_f));
	double n1 = sin_t * cos_p;
	double n2 = cos_t;
	double n3 = sin_t * sin_p;
	double len = sqrt(n1 * n1 + n2 * n2 + n3 * n3);
	double inv_len = (len > 0.0) ? (1.0 / len) : 1.0;
	return dvec3(n1 * inv_len, n2 * inv_len, n3 * inv_len);
}

dvec3 compute_ray_direction(uint mode, double u, double v, double fov) {
	if (mode == 2u) return compute_fisheye_stereographic_ray(u, v, fov);
	if (mode == 3u) return compute_equirectangular_360_ray(u, v, fov);
	if (mode == 4u) return compute_fisheye_equidistant_ray(u, v, fov);
	if (mode == 5u) return compute_fisheye_orthographic_ray(u, v, fov);
	if (mode == 6u) return compute_panini_cylindrical_ray(u, v, fov);
	if (mode == 7u) return compute_hammer_aitoff_ray(u, v, fov);
	return compute_pinhole_ray(u, v, fov);
}

vec3 sample_celestial_starfield(vec3 dir, float star_density, float star_brightness, float nebula_intensity, float brightness_variation, float size_variation, float color_variation, float temperature_bias, uint seed) {
	float theta = acos(clamp(dir.z, -1.0, 1.0));
	float phi = atan(dir.y, dir.x);
	float u = (phi + 3.14159265) * (1.0 / (2.0 * 3.14159265));
	float v = theta * (1.0 / 3.14159265);

	float gal_lat = 0.5 - v;
	float gal_band = exp(-(gal_lat * gal_lat) / 0.015);
	float gal_core = exp(-(gal_lat * gal_lat) / 0.008) * exp(-pow(u - 0.5, 2.0) / 0.05);
	float nebula_scale = max(nebula_intensity, 0.0);

	vec3 col = vec3(
		(0.015 * gal_band + 0.12 * gal_core) * nebula_scale,
		(0.020 * gal_band + 0.09 * gal_core) * nebula_scale,
		(0.045 * gal_band + 0.06 * gal_core) * nebula_scale
	);

	float u_grid = u * 720.0;
	float v_grid = v * 360.0;
	int iu = int(floor(u_grid));
	int iv = int(floor(v_grid));
	uint cell_seed = uint(iu * 73856093 ^ iv * 19349663) ^ (seed * 2654435761u);
	float star_prob = hash_to_float(cell_seed);
	float star_threshold = clamp(1.0 - 0.12 * max(star_density, 0.0), 0.0, 0.999);

	if (star_prob > star_threshold) {
		float off_u = hash_to_float(cell_seed + 101u);
		float off_v = hash_to_float(cell_seed + 202u);
		float du = (u_grid - float(iu)) - off_u;
		float dv = (v_grid - float(iv)) - off_v;

		float size_rand = hash_to_float(cell_seed + 707u);
		float radius_sq_limit = clamp(0.12 + max(size_variation, 0.0) * (0.05 + 0.55 * size_rand), 0.05, 1.1);
		float d2 = du * du + dv * dv;
		if (d2 < radius_sq_limit) {
			float brightness_exponent = 1.0 + clamp(brightness_variation, 0.0, 1.0) * 8.0;
			float base = pow(hash_to_float(cell_seed + 303u), brightness_exponent) * 4.5;
			float falloff = exp(-d2 * (3.2 / radius_sq_limit));

			float color_temp = clamp(hash_to_float(cell_seed + 404u) - clamp(temperature_bias, -1.0, 1.0) * 0.3, 0.0, 1.0);
			vec3 star_tint = vec3(1.0);
			if (color_temp < 0.3) star_tint = vec3(0.8, 0.85, 1.3);
			else if (color_temp > 0.7) star_tint = vec3(1.3, 0.85, 0.6);
			float color_mix = clamp(color_variation, 0.0, 2.0);
			star_tint = vec3(1.0) + (star_tint - vec3(1.0)) * color_mix;

			float lum = base * falloff * max(star_brightness, 0.0);
			col += star_tint * lum;
		}
	}
	return col;
}

vec3 sample_deep_field_galaxies(vec3 dir, uint seed, double density, double brightness, double size_scale) {
	if (density <= 0.0) return vec3(0.0);
	float theta = acos(clamp(dir.z, -1.0, 1.0));
	float phi = atan(dir.y, dir.x);
	float u = (phi + 3.14159265) * (1.0 / (2.0 * 3.14159265));
	float v = theta * (1.0 / 3.14159265);

	const float grid_u = 48.0;
	const float grid_v = 24.0;
	float u_grid = u * grid_u;
	float v_grid = v * grid_v;
	int iu = int(floor(u_grid));
	int iv = int(floor(v_grid));
	uint cell_seed = uint(iu * 668265263 ^ iv * 2246822519u) ^ (seed * 40503u);

	float presence = hash_to_float(cell_seed);
	float threshold = clamp(1.0 - 0.4 * clamp(float(density), 0.0, 4.0), 0.0, 0.999);
	if (presence <= threshold) return vec3(0.0);

	float off_u = hash_to_float(cell_seed + 11u);
	float off_v = hash_to_float(cell_seed + 22u);
	float du = (u_grid - float(iu)) - off_u;
	float dv = (v_grid - float(iv)) - off_v;
	float footprint = max(float(size_scale), 0.05) * max(float(size_scale), 0.05) * 1.4;
	float dist_sq = du * du + dv * dv;
	if (dist_sq > footprint) return vec3(0.0);

	float r = sqrt(dist_sq);
	float angle = atan(dv, du);
	float spiral = 0.5 + 0.5 * sin(angle * 3.0 + log(r + 0.08) * 6.0);
	float core = exp(-dist_sq * (5.0 / max(footprint, 1e-6)));
	float arms = spiral * exp(-dist_sq * (1.4 / max(footprint, 1e-6))) * 0.5;

	float base_brightness = pow(hash_to_float(cell_seed + 33u), 3.5) * 1.6;
	float lum = base_brightness * (core + arms) * float(max(brightness, 0.0));

	bool warm_tint = hash_to_float(cell_seed + 44u) > 0.5;
	float tr = warm_tint ? 0.95 : 0.55;
	float tg = warm_tint ? 0.80 : 0.70;
	float tb = warm_tint ? 0.55 : 1.05;

	return vec3(tr * lum, tg * lum, tb * lum);
}

double body_fbm(dvec3 p, uint octaves, double roughness);

vec3 sample_dust_clouds(dvec3 dir_d, uint seed, double density, double intensity, double scale) {
	if (density <= 0.0) return vec3(0.0);
	double freq = clamp(double(scale), 0.1, 10.0) * 2.2;
	double seed_offset = double(seed % 4096u) * 0.37;
	double n = body_fbm(dir_d * freq + dvec3(seed_offset, -seed_offset, seed_offset * 0.5), 4u, 0.55);
	double threshold = clamp(1.0 - 0.22 * clamp(double(density), 0.0, 4.0), -0.2, 0.98);
	if (n <= threshold) return vec3(0.0);

	float strength = float(clamp((n - threshold) / max(1.0 - threshold, 0.05), 0.0, 1.0));
	float shaped = strength * strength;

	double tint_noise = body_fbm(dir_d * freq * 0.5 + dvec3(91.0, -37.0, 13.0), 3u, 0.5);
	float tint_t = float(clamp((tint_noise + 1.0) * 0.5, 0.0, 1.0));
	float rr = 0.55 * (1.0 - tint_t) + 0.28 * tint_t;
	float gg = 0.22 * (1.0 - tint_t) + 0.16 * tint_t;
	float bb = 0.12 * (1.0 - tint_t) + 0.52 * tint_t;

	float lum = shaped * float(max(intensity, 0.0)) * 0.6;
	return vec3(rr * lum, gg * lum, bb * lum);
}

vec3 sample_star_clusters(vec3 dir, uint seed, double density, double brightness, double size_scale) {
	if (density <= 0.0) return vec3(0.0);
	float theta = acos(clamp(dir.z, -1.0, 1.0));
	float phi = atan(dir.y, dir.x);
	float u = (phi + 3.14159265) * (1.0 / (2.0 * 3.14159265));
	float v = theta * (1.0 / 3.14159265);

	const float grid_u = 90.0;
	const float grid_v = 45.0;
	float u_grid = u * grid_u;
	float v_grid = v * grid_v;
	int iu = int(floor(u_grid));
	int iv = int(floor(v_grid));
	uint cell_seed = uint(iu * 1274126177 ^ iv * 374761393u) ^ (seed * 2246822519u);

	float presence = hash_to_float(cell_seed);
	float threshold = clamp(1.0 - 0.06 * clamp(float(density), 0.0, 4.0), 0.0, 0.999);
	if (presence <= threshold) return vec3(0.0);

	vec3 total = vec3(0.0);
	float member_footprint = max(float(size_scale), 0.05) * 0.03;
	for (uint member = 0u; member < 7u; ++member) {
		uint member_seed = cell_seed + member * 97u;
		float off_u = hash_to_float(member_seed + 1u);
		float off_v = hash_to_float(member_seed + 2u);
		float du = (u_grid - float(iu)) - off_u;
		float dv = (v_grid - float(iv)) - off_v;
		float dist_sq = du * du + dv * dv;
		if (dist_sq > member_footprint) continue;

		float member_brightness = pow(hash_to_float(member_seed + 3u), 3.0) * 2.2;
		float falloff = exp(-dist_sq * (6.0 / max(member_footprint, 1e-6)));
		float lum = member_brightness * falloff * float(max(brightness, 0.0));
		total += vec3(lum, lum * 0.95, lum * 0.85);
	}
	return total;
}

vec3 sample_celestial_grid_sphere(vec3 dir, float grid_opacity) {
	float theta = acos(clamp(dir.z, -1.0, 1.0));
	float phi = atan(dir.y, dir.x);
	float lat_deg = 90.0 - theta * (180.0 / 3.14159265);
	float lon_deg = phi * (180.0 / 3.14159265);
	float lat_line = abs(mod(lat_deg + 7.5, 15.0) - 7.5);
	float lon_line = abs(mod(lon_deg + 7.5, 15.0) - 7.5);
	const float line_width = 0.35;
	bool on_major_lat = abs(mod(lat_deg + 45.0, 90.0) - 45.0) < line_width;
	bool on_major_lon = abs(mod(lon_deg + 45.0, 90.0) - 45.0) < line_width;
	bool on_minor_line = (lat_line < line_width) || (lon_line < line_width);
	float opacity = max(grid_opacity, 0.0);
	if (on_major_lat || on_major_lon) return vec3(0.14, 0.20, 0.28) * opacity;
	if (on_minor_line) return vec3(0.05, 0.07, 0.10) * opacity;
	return vec3(0.008, 0.009, 0.012) * opacity;
}

vec3 apply_hue_saturation(vec3 rgb, double hue_shift_rad, double saturation) {
	if (hue_shift_rad == 0.0 && saturation == 1.0) return rgb;
	float r = rgb.r, g = rgb.g, b = rgb.b;
	float max_c = max(r, max(g, b));
	float min_c = min(r, min(g, b));
	float delta = max_c - min_c;
	float h = 0.0;
	if (delta > 1e-8) {
		if (max_c == r) h = mod((g - b) / delta, 6.0);
		else if (max_c == g) h = (b - r) / delta + 2.0;
		else h = (r - g) / delta + 4.0;
		h *= 60.0;
		if (h < 0.0) h += 360.0;
	}
	float s_val = (max_c > 1e-8) ? (delta / max_c) : 0.0;
	float v_val = max_c;

	h += float(hue_shift_rad * (180.0 / PI_D));
	h = mod(h, 360.0);
	if (h < 0.0) h += 360.0;
	float s_new = clamp(s_val * float(saturation), 0.0, 1.0);

	float c_val = v_val * s_new;
	float x_val = c_val * (1.0 - abs(mod(h / 60.0, 2.0) - 1.0));
	float m_val = v_val - c_val;

	float r2 = 0.0, g2 = 0.0, b2 = 0.0;
	if (h < 60.0) { r2 = c_val; g2 = x_val; b2 = 0.0; }
	else if (h < 120.0) { r2 = x_val; g2 = c_val; b2 = 0.0; }
	else if (h < 180.0) { r2 = 0.0; g2 = c_val; b2 = x_val; }
	else if (h < 240.0) { r2 = 0.0; g2 = x_val; b2 = c_val; }
	else if (h < 300.0) { r2 = x_val; g2 = 0.0; b2 = c_val; }
	else { r2 = c_val; g2 = 0.0; b2 = x_val; }

	return vec3(r2 + m_val, g2 + m_val, b2 + m_val);
}

vec3 sample_panorama(vec3 dir) {
	float len = length(dir);
	if (len < 1e-12) return vec3(0.0);
	float theta = acos(clamp(dir.z / len, -1.0, 1.0));
	float phi = atan(dir.y, dir.x);
	float u = (phi + 3.14159265) * (1.0 / (2.0 * 3.14159265));
	float v = theta * (1.0 / 3.14159265);
	return textureLod(panorama_sampler, vec2(u, clamp(v, 0.0, 1.0)), 0.0).rgb;
}

vec3 compute_sky_radiance(dvec3 dir_d, double sky_rotation_rad) {
	float sky_rotation_f = float(sky_rotation_rad);
	double cos_r = double(cos(sky_rotation_f));
	double sin_r = double(sin(sky_rotation_f));
	dvec3 rotated = dvec3(
		dir_d.x * cos_r - dir_d.y * sin_r,
		dir_d.x * sin_r + dir_d.y * cos_r,
		dir_d.z
	);
	vec3 dir = vec3(rotated);

	if (pc.sky_background_source != 0u && pc.sky_panorama_width > 0u && pc.sky_panorama_height > 0u) {
		vec3 panorama_rgb = sample_panorama(dir);
		panorama_rgb = apply_hue_saturation(panorama_rgb, pc.sky_hue_shift_rad, pc.sky_saturation);
		return max(panorama_rgb + vec3(float(pc.sky_background_r), float(pc.sky_background_g), float(pc.sky_background_b)), vec3(0.0));
	}

	uint sky_mode = pc.render_flags & 0x0Fu;
	vec3 sky_rgb = vec3(0.0);

	float bvar = float(pc.sky_star_brightness_variation);
	float svar = float(pc.sky_star_size_variation);
	float cvar = float(pc.sky_star_color_variation);
	float tbias = float(pc.sky_star_temperature_bias);
	uint seed = pc.sky_procedural_seed;

	if (sky_mode == 1u || (pc.render_flags & (1u << 4)) != 0u) {
		sky_rgb = sample_celestial_grid_sphere(dir, float(pc.sky_grid_opacity));
	} else if (sky_mode == 2u) {
		vec3 stars = sample_celestial_starfield(dir, float(pc.sky_star_density), float(pc.sky_star_brightness), float(pc.sky_nebula_intensity), bvar, svar, cvar, tbias, seed);
		vec3 grid = sample_celestial_grid_sphere(dir, float(pc.sky_grid_opacity));
		sky_rgb = stars + grid * 0.7;
	} else if (sky_mode == 0u) {
		sky_rgb = sample_celestial_starfield(dir, float(pc.sky_star_density), float(pc.sky_star_brightness), float(pc.sky_nebula_intensity), bvar, svar, cvar, tbias, seed);
	} else if (sky_mode == 4u) {
		sky_rgb = sample_celestial_starfield(dir, float(pc.sky_star_density), float(pc.sky_star_brightness), 0.0, bvar, svar, cvar, tbias, seed);
	} else if (sky_mode == 5u) {
		vec3 stars = sample_celestial_starfield(dir, float(pc.sky_star_density), float(pc.sky_star_brightness), 0.0, bvar, svar, cvar, tbias, seed);
		vec3 grid = sample_celestial_grid_sphere(dir, float(pc.sky_grid_opacity));
		sky_rgb = stars + grid;
	}

	if (pc.sky_galaxy_density > 0.0) {
		sky_rgb += sample_deep_field_galaxies(dir, seed, pc.sky_galaxy_density, pc.sky_galaxy_brightness, pc.sky_galaxy_size_scale);
	}
	if (pc.sky_dust_density > 0.0) {
		sky_rgb += sample_dust_clouds(rotated, seed, pc.sky_dust_density, pc.sky_dust_intensity, pc.sky_dust_scale);
	}
	if (pc.sky_cluster_density > 0.0) {
		sky_rgb += sample_star_clusters(dir, seed, pc.sky_cluster_density, pc.sky_cluster_brightness, pc.sky_cluster_size_scale);
	}

	sky_rgb = apply_hue_saturation(sky_rgb, pc.sky_hue_shift_rad, pc.sky_saturation);
	sky_rgb.r = max(0.0, sky_rgb.r + float(pc.sky_background_r));
	sky_rgb.g = max(0.0, sky_rgb.g + float(pc.sky_background_g));
	sky_rgb.b = max(0.0, sky_rgb.b + float(pc.sky_background_b));
	return sky_rgb;
}

float cie_gaussian_component(float x, float alpha, float mu, float sigma1, float sigma2) {
	float sigma = (x < mu) ? sigma1 : sigma2;
	float t = (x - mu) / sigma;
	return alpha * exp(-0.5 * t * t);
}

float cie_x_bar(float lambda_nm) {
	return cie_gaussian_component(lambda_nm, 1.056, 599.8, 37.9, 31.0)
		+ cie_gaussian_component(lambda_nm, 0.362, 442.0, 16.0, 26.7)
		- cie_gaussian_component(lambda_nm, 0.065, 501.1, 20.4, 26.2);
}

float cie_y_bar(float lambda_nm) {
	return cie_gaussian_component(lambda_nm, 0.821, 568.8, 46.9, 40.5)
		+ cie_gaussian_component(lambda_nm, 0.286, 530.9, 16.3, 31.1);
}

float cie_z_bar(float lambda_nm) {
	return cie_gaussian_component(lambda_nm, 1.217, 437.0, 11.8, 36.0)
		+ cie_gaussian_component(lambda_nm, 0.681, 459.0, 26.0, 13.8);
}

float planck_spectral_radiance(float lambda_m, float temp_k) {
	const float c2 = 0.0143877688;
	float x = c2 / (lambda_m * temp_k);
	if (x > 80.0) return 0.0;
	float lambda_um = lambda_m * 1e6;
	float lambda5 = lambda_um * lambda_um * lambda_um * lambda_um * lambda_um;
	return 1.0 / (lambda5 * (exp(x) - 1.0));
}

dvec3 temperature_to_linear_rgb(double t_kelvin, double intensity, double saturation) {
	float t = float(clamp(t_kelvin, 800.0, 60000.0));
	vec3 int_xyz = vec3(0.0);
	const int samples = 16;
	const float lambda_start = 380.0;
	const float d_lambda = (780.0 - 380.0) / float(samples);
	for (int i = 0; i <= samples; ++i) {
		float lambda_nm = lambda_start + float(i) * d_lambda;
		float radiance = planck_spectral_radiance(lambda_nm * 1e-9, t);
		float weight = (i == 0 || i == samples) ? 0.5 : 1.0;
		int_xyz.x += weight * radiance * cie_x_bar(lambda_nm);
		int_xyz.y += weight * radiance * cie_y_bar(lambda_nm);
		int_xyz.z += weight * radiance * cie_z_bar(lambda_nm);
	}

	float r =  3.2404542 * int_xyz.x - 1.5371385 * int_xyz.y - 0.4985314 * int_xyz.z;
	float g = -0.9692660 * int_xyz.x + 1.8760108 * int_xyz.y + 0.0415560 * int_xyz.z;
	float b =  0.0556434 * int_xyz.x - 0.2040259 * int_xyz.y + 1.0572252 * int_xyz.z;
	r = max(r, 0.0);
	g = max(g, 0.0);
	b = max(b, 0.0);

	float max_c = max(max(r, g), max(b, 1e-6));
	r /= max_c;
	g /= max_c;
	b /= max_c;

	float luma = 0.2126 * r + 0.7152 * g + 0.0722 * b;
	float sat = float(clamp(saturation, 0.0, 3.0));
	r = max(0.0, luma + (r - luma) * sat);
	g = max(0.0, luma + (g - luma) * sat);
	b = max(0.0, luma + (b - luma) * sat);

	float scale = float(max(intensity, 0.0));
	return dvec3(double(r * scale), double(g * scale), double(b * scale));
}

vec3 apply_tonemapping(vec3 linear_color, uint mode, double exposure_ev) {
	float exp_scale = exp2(float(exposure_ev));
	vec3 col = max(linear_color * exp_scale, vec3(0.0));

	if (mode == 1u) {
		const float a = 2.51, b = 0.03, c = 2.43, d = 0.59, e = 0.14;
		col = clamp((col * (a * col + b)) / (col * (c * col + d) + e), 0.0, 1.0);
	} else if (mode == 2u) {
		float lum = dot(col, vec3(0.2126, 0.7152, 0.0722));
		if (lum > 0.0) {
			const float inv_log_base = 0.108572457;
			float mapped_lum = log(1.0 + lum * 100.0) * inv_log_base;
			col = clamp(col * clamp(mapped_lum / lum, 0.0, 1.0), 0.0, 1.0);
		} else {
			col = vec3(0.0);
		}
	} else if (mode == 3u) {
		col = (col * (1.0 + col * 0.04)) / (1.0 + col);
	} else {
		col = clamp(col, 0.0, 1.0);
	}

	vec3 lo = 12.92 * col;
	vec3 hi = 1.055 * pow(col, vec3(1.0 / 2.4)) - 0.055;
	return mix(hi, lo, lessThanEqual(col, vec3(0.0031308)));
}

double body_hash3(ivec3 p) {
	uint h = uint(p.x) * 374761393u + uint(p.y) * 668265263u + uint(p.z) * 2147483647u;
	return double(hash_to_float(h)) * 2.0 - 1.0;
}

float body_value_noise(vec3 p) {
	ivec3 i0 = ivec3(floor(p));
	vec3 f = p - vec3(i0);
	vec3 u = f * f * (3.0 - 2.0 * f);

	float c000 = float(body_hash3(i0 + ivec3(0, 0, 0)));
	float c100 = float(body_hash3(i0 + ivec3(1, 0, 0)));
	float c010 = float(body_hash3(i0 + ivec3(0, 1, 0)));
	float c110 = float(body_hash3(i0 + ivec3(1, 1, 0)));
	float c001 = float(body_hash3(i0 + ivec3(0, 0, 1)));
	float c101 = float(body_hash3(i0 + ivec3(1, 0, 1)));
	float c011 = float(body_hash3(i0 + ivec3(0, 1, 1)));
	float c111 = float(body_hash3(i0 + ivec3(1, 1, 1)));

	float c00 = mix(c000, c100, u.x);
	float c10 = mix(c010, c110, u.x);
	float c01 = mix(c001, c101, u.x);
	float c11 = mix(c011, c111, u.x);

	float c0 = mix(c00, c10, u.y);
	float c1 = mix(c01, c11, u.y);

	return mix(c0, c1, u.z);
}

double body_fbm(dvec3 p_d, uint octaves, double roughness) {
	vec3 p = vec3(p_d);
	float r_f = float(roughness);
	float total = 0.0;
	float amplitude = 1.0;
	float frequency = 1.0;
	float max_val = 0.0;
	for (uint i = 0u; i < octaves; ++i) {
		total += body_value_noise(p * frequency) * amplitude;
		max_val += amplitude;
		amplitude *= r_f;
		frequency *= 2.0;
	}
	return double(total / max(max_val, 1e-5));
}

bool intersect_bodies(dvec3 ray_pos, dvec3 ray_dir, double max_dist, out vec3 out_color, out uint out_status, out double out_hit_dist) {
	bool hit_any = false;
	double best_t = max_dist;
	vec3 best_color = vec3(0.0);

	for (uint bi = 0u; bi < pc.body_count; ++bi) {
		GpuBody body = bodies[bi];
		dvec3 bpos = dvec3(body.position_xy.x, body.position_xy.y, body.position_zw.x);
		double radius = max(body.radius, 1e-6);
		double oblateness = clamp(body.oblateness_ratio, 0.1, 5.0);

		double scale_a = radius;
		double scale_b = radius;
		double scale_c = radius;
		if (body.geometry_model == 0u) {
			scale_c = radius * oblateness;
		} else if (body.geometry_model == 2u) {
			scale_c = radius / max(oblateness, 0.1);
		} else if (body.geometry_model == 3u) {
			scale_b = radius * 0.85;
			scale_c = radius * oblateness;
		}

		dvec3 o = ray_pos - bpos;
		double bound_radius = max(scale_a, max(scale_b, scale_c));
		double max_reach = bound_radius + max_dist;
		double dist_sq = dot(o, o);
		if (dist_sq > max_reach * max_reach) continue;
		double bound_b = dot(o, ray_dir);
		double bound_disc = bound_b * bound_b - (dist_sq - bound_radius * bound_radius);
		if (bound_disc < 0.0) continue;
		double bound_root = sqrt(bound_disc);
		if (-bound_b + bound_root < 1e-5 || -bound_b - bound_root > best_t) continue;
		double inv_a2 = 1.0 / (scale_a * scale_a);
		double inv_b2 = 1.0 / (scale_b * scale_b);
		double inv_c2 = 1.0 / (scale_c * scale_c);

		double A = ray_dir.x * ray_dir.x * inv_a2 + ray_dir.y * ray_dir.y * inv_b2 + ray_dir.z * ray_dir.z * inv_c2;
		double B = 2.0 * (o.x * ray_dir.x * inv_a2 + o.y * ray_dir.y * inv_b2 + o.z * ray_dir.z * inv_c2);
		double C = o.x * o.x * inv_a2 + o.y * o.y * inv_b2 + o.z * o.z * inv_c2 - 1.0;

		double discr = B * B - 4.0 * A * C;
		if (discr < 0.0) continue;
		double sqrt_discr = sqrt(discr);
		double t1 = (-B - sqrt_discr) / (2.0 * A);
		double t2 = (-B + sqrt_discr) / (2.0 * A);
		double t = -1.0;
		if (t1 > 1e-5) t = t1;
		else if (t2 > 1e-5) t = t2;
		if (t <= 1e-5 || t >= best_t) continue;

		dvec3 hit_pos = ray_pos + ray_dir * t;
		dvec3 l = hit_pos - bpos;
		dvec3 nrm = dvec3(l.x * inv_a2, l.y * inv_b2, l.z * inv_c2);
		double n_len = length(nrm);
		if (n_len > 1e-12) nrm = nrm / n_len;

		double dist_to_cam = length(o);
		double angular_pixel_size = pc.field_of_view_rad / max(double(pc.screen_width), 1.0);
		double max_axis = max(scale_a, max(scale_b, scale_c));
		double apparent_radius = double(asin(float(clamp(max_axis / max(dist_to_cam, 1e-9), 0.0, 1.0))));
		double coverage = apparent_radius / max(angular_pixel_size, 1e-12);

		bool is_point_lod = (pc.body_render_low_power_mode == 0u) && (coverage < double(max(pc.body_render_point_pixel_threshold, 1u)));
		bool is_simple_lod = (pc.body_render_low_power_mode != 0u) || is_point_lod || (coverage < double(pc.body_render_lod_pixel_threshold));

		vec3 surf = vec3(body.color_primary_xy.x, body.color_primary_xy.y, body.color_primary_zw.x);

		if (!is_simple_lod) {
			double noise_scale = max(body.noise_scale, 0.1);
			double roughness = clamp(body.noise_roughness, 0.05, 1.0);
			double n_val = body_fbm(nrm * noise_scale, clamp(pc.body_noise_octaves, 1u, 6u), roughness);
			vec3 secondary = vec3(body.color_secondary_xy.x, body.color_secondary_xy.y, body.color_secondary_zw.x);
			double mix_t = clamp((n_val + 1.0) * 0.5, 0.0, 1.0);
			surf = mix(surf, secondary, float(mix_t));
		}

		double view_dot_n = max(0.0, dot(-ray_dir, nrm));
		double lighting = view_dot_n;
		if (!is_point_lod && (pc.render_flags & (1u << 16)) != 0u) {
			double to_origin_len = length(hit_pos);
			if (to_origin_len > 1e-9) {
				dvec3 light_dir = -hit_pos / to_origin_len;
				lighting = max(0.0, dot(nrm, light_dir));
			}
		}

		float light_factor = is_point_lod ? 1.0 : float(0.25 + 0.75 * lighting);
		if (body.emission_intensity > 0.0) {
			light_factor += float(body.emission_intensity);
		}
		surf *= light_factor;

		if ((pc.render_flags & (1u << 13)) != 0u) {
			dvec3 vel = dvec3(body.velocity_xy.x, body.velocity_xy.y, body.velocity_zw.x);
			double v_sq = dot(vel, vel);
			if (v_sq > 1e-12) {
				double beta = min(sqrt(v_sq), 0.9999);
				double beta_dot_n = dot(vel, ray_dir) / beta;
				double gamma = 1.0 / sqrt(1.0 - beta * beta);
				double doppler = 1.0 / (gamma * (1.0 - beta * beta_dot_n));
				float d_factor = float(clamp(doppler * doppler * doppler, 0.1, 10.0));
				surf *= d_factor;
			}
		}

		if ((pc.render_flags & (1u << 14)) != 0u && body.mass > 0.0) {
			double z_factor = sqrt(max(1.0 - 2.0 * body.mass / radius, 0.05));
			surf *= vec3(float(z_factor), float(z_factor * 0.9), float(z_factor * 0.7));
		}

		if ((pc.render_flags & (1u << 15)) != 0u && !is_simple_lod && body.atmosphere_mode != 2u) {
			float rim = pow(1.0 - float(view_dot_n), 3.0);
			float atmo_thick = float(body.atmosphere_thickness * pc.body_atmosphere_global_intensity);
			vec3 acol = vec3(body.atmosphere_color_xy.x, body.atmosphere_color_xy.y, body.atmosphere_color_zw.x);
			float aa = float(body.atmosphere_color_zw.y);
			surf = surf * (1.0 - rim * aa) + acol * rim * atmo_thick * 2.5;
		}

		best_t = t;
		best_color = clamp(surf, 0.0, 10.0);
		hit_any = true;
	}

	out_color = best_color;
	out_status = hit_any ? 16u : 0u;
	out_hit_dist = best_t;
	return hit_any;
}

bool attempt_analytic_space_skip(inout double ray_r, inout double ray_th, inout double ray_phi, inout double ray_pr, inout double ray_pth, inout double ray_pphi, double space_skip_radius, double escape_radius, double mass) {
	if (ray_r <= space_skip_radius) {
		return false;
	}

	dvec2 sincos_th = precise_sincos(ray_th);
	double sin_t = sincos_th.x;
	double cos_t = sincos_th.y;
	float phi_f = float(ray_phi);
	double sin_p = double(sin(phi_f));
	double cos_p = double(cos(phi_f));

	double px = ray_r * sin_t * cos_p;
	double py = ray_r * sin_t * sin_p;
	double pz = ray_r * cos_t;

	double local_radial = ray_pr / sqrt(max(1.0 - 2.0 * mass / ray_r, 1e-6));
	double dx = -(local_radial * sin_t * cos_p + ray_r * ray_pth * cos_t * cos_p - ray_r * sin_t * ray_pphi * sin_p);
	double dy = -(local_radial * sin_t * sin_p + ray_r * ray_pth * cos_t * sin_p + ray_r * sin_t * ray_pphi * cos_p);
	double dz = -(local_radial * cos_t - ray_r * ray_pth * sin_t);

	double dir_norm_sq = dx * dx + dy * dy + dz * dz;
	if (dir_norm_sq <= 1e-30) {
		return false;
	}

	double cross_x = py * dz - pz * dy;
	double cross_y = pz * dx - px * dz;
	double cross_z = px * dy - py * dx;
	double cross_norm = sqrt(cross_x * cross_x + cross_y * cross_y + cross_z * cross_z);
	double dir_norm_for_impact = sqrt(dir_norm_sq);
	double impact_parameter_relative = (dir_norm_for_impact > 1e-30) ? (cross_norm / dir_norm_for_impact) : 0.0;
	if (impact_parameter_relative > mass * 0.05 && mass > 0.0) {
		double impact_parameter = impact_parameter_relative;
		double deflection = min(4.0 * mass / max(impact_parameter, mass * 1e-6), 0.6);
		double nx = cross_x / cross_norm;
		double ny = cross_y / cross_norm;
		double nz = cross_z / cross_norm;
		double wx = ny * dz - nz * dy;
		double wy = nz * dx - nx * dz;
		double wz = nx * dy - ny * dx;
		float defl_f = float(deflection);
		double cos_a = double(cos(defl_f));
		double sin_a = double(sin(defl_f));
		double rdx = dx * cos_a + wx * sin_a;
		double rdy = dy * cos_a + wy * sin_a;
		double rdz = dz * cos_a + wz * sin_a;
		dx = rdx;
		dy = rdy;
		dz = rdz;
	}

	double p_dot_d = px * dx + py * dy + pz * dz;
	double p_dot_p = px * px + py * py + pz * pz;

	double t_skip = -1.0;
	{
		double c_coeff = p_dot_p - space_skip_radius * space_skip_radius;
		double b_coeff = 2.0 * p_dot_d;
		double discr = b_coeff * b_coeff - 4.0 * dir_norm_sq * c_coeff;
		if (discr >= 0.0) {
			double sqrt_discr = sqrt(discr);
			double t1 = (-b_coeff - sqrt_discr) / (2.0 * dir_norm_sq);
			double t2 = (-b_coeff + sqrt_discr) / (2.0 * dir_norm_sq);
			if (t1 > 1e-9) t_skip = t1;
			if (t2 > 1e-9 && (t_skip < 0.0 || t2 < t_skip)) t_skip = t2;
		}
	}

	double t_escape = -1.0;
	{
		double c_coeff = p_dot_p - escape_radius * escape_radius;
		double b_coeff = 2.0 * p_dot_d;
		double discr = b_coeff * b_coeff - 4.0 * dir_norm_sq * c_coeff;
		if (discr >= 0.0) {
			double sqrt_discr = sqrt(discr);
			double t1 = (-b_coeff - sqrt_discr) / (2.0 * dir_norm_sq);
			double t2 = (-b_coeff + sqrt_discr) / (2.0 * dir_norm_sq);
			if (t1 > 1e-9) t_escape = t1;
			if (t2 > 1e-9 && (t_escape < 0.0 || t2 < t_escape)) t_escape = t2;
		}
	}

	double t_leap;
	if (t_skip > 0.0 && t_escape > 0.0) {
		t_leap = min(t_skip, t_escape);
	} else if (t_skip > 0.0) {
		t_leap = t_skip;
	} else if (t_escape > 0.0) {
		t_leap = t_escape;
	} else {
		return false;
	}

	if (t_leap <= 1e-6) {
		return false;
	}

	double new_px = px + t_leap * dx;
	double new_py = py + t_leap * dy;
	double new_pz = pz + t_leap * dz;

	double new_r = sqrt(new_px * new_px + new_py * new_py + new_pz * new_pz);
	if (new_r <= 1e-9) {
		return false;
	}

	float new_cos_theta_f = float(clamp(new_pz / new_r, -1.0, 1.0));
	double new_theta = double(acos(new_cos_theta_f));
	double new_phi = double(atan(float(new_py), float(new_px)));

	dvec2 sincos_new_th = precise_sincos(new_theta);
	double new_sin_t = sincos_new_th.x;
	double safe_sin_t = (abs(new_sin_t) > 1e-9) ? new_sin_t : ((new_sin_t >= 0.0) ? 1e-9 : -1e-9);

	double new_local_f = max(1.0 - 2.0 * mass / new_r, 1e-6);
	double inv_dir_len = 1.0 / sqrt(dir_norm_sq);
	double travel_x = dx * inv_dir_len;
	double travel_y = dy * inv_dir_len;
	double travel_z = dz * inv_dir_len;
	double travel_radial = (new_px * travel_x + new_py * travel_y + new_pz * travel_z) / new_r;
	double inv_sqrt_new_f = 1.0 / sqrt(new_local_f);
	double new_pr = -travel_radial;
	double new_pth = -((travel_radial * (new_pz / new_r) - travel_z) / (new_r * safe_sin_t)) * inv_sqrt_new_f;
	double r2_sin2 = new_r * new_r * new_sin_t * new_sin_t;
	double new_pphi = (abs(r2_sin2) > 1e-12) ? (-((new_px * travel_y - new_py * travel_x) / r2_sin2) * inv_sqrt_new_f) : 0.0;

	ray_r = new_r;
	ray_th = new_theta;
	ray_phi = new_phi;
	ray_pr = new_pr;
	ray_pth = new_pth;
	ray_pphi = new_pphi;
	return true;
}

void main() {
	uint total_pixel_count = pc.screen_width * pc.screen_height;

	for (;;) {
	uint persistent_batch_start = atomicAdd(persistent_next_pixel_index, PERSISTENT_BATCH_SIZE);
	if (persistent_batch_start >= total_pixel_count) {
		return;
	}
	uint persistent_batch_end = min(persistent_batch_start + PERSISTENT_BATCH_SIZE, total_pixel_count);
	for (uint pixel_index = persistent_batch_start; pixel_index < persistent_batch_end; ++pixel_index) {
	uint px = pixel_index % pc.screen_width;
	uint py = pixel_index / pc.screen_width;

	double aspect = double(pc.screen_width) / double(pc.screen_height);
	double v_norm = 1.0 - (double(py) + 0.5) / double(pc.screen_height) * 2.0;
	bool is_allsky = (pc.projection_mode == 3u || pc.projection_mode == 7u);
	double u_raw = (double(px) + 0.5) / double(pc.screen_width) * 2.0 - 1.0;
	double u_coord = is_allsky ? u_raw : (u_raw * aspect);

	dvec3 n_local = compute_ray_direction(pc.projection_mode, u_coord, v_norm, pc.field_of_view_rad);

	dvec3 fwd = pc.tetrad_e1.yzw;
	dvec3 rgt = pc.tetrad_e2.yzw;
	dvec3 up  = pc.tetrad_e3.yzw;

	dvec3 ray_dir = n_local.x * fwd + n_local.z * rgt + n_local.y * up;

	{
		double obs_r0 = pc.observer_position.y;
		double obs_th0 = pc.observer_position.z;
		double obs_ph0 = pc.observer_position.w;
		dvec3 obs_pos0 = spherical_to_cartesian(obs_r0, obs_th0, obs_ph0);

		if ((pc.render_flags & (1u << 12)) != 0u && pc.body_count > 0u && (pc.metric_type == 0u || (pc.render_flags & (1u << 17)) != 0u)) {
			vec3 body_color;
			uint body_status;
			double body_dist;
			if (intersect_bodies(obs_pos0, ray_dir, 1e30, body_color, body_status, body_dist)) {
				vec3 mapped_body = apply_tonemapping(body_color, pc.tonemapping_mode, pc.camera_exposure);
				pixels[pixel_index].rgba = vec4(mapped_body, 1.0);
				pixels[pixel_index].redshift = 1.0;
				pixels[pixel_index].affine_parameter = 0.0;
				pixels[pixel_index].status_flags = body_status;
				pixels[pixel_index].iterations_used = 0u;
				continue;
			}
		}

		if ((pc.render_flags & (1u << 17)) != 0u) {
			vec3 sky_only = compute_sky_radiance(ray_dir, pc.sky_rotation_rad);
			vec3 mapped_sky = apply_tonemapping(sky_only, pc.tonemapping_mode, pc.camera_exposure);
			pixels[pixel_index].rgba = vec4(mapped_sky, 1.0);
			pixels[pixel_index].redshift = 1.0;
			pixels[pixel_index].affine_parameter = 0.0;
			pixels[pixel_index].status_flags = 2u;
			pixels[pixel_index].iterations_used = 0u;
			continue;
		}
	}

	double m = max(pc.metric_mass, 1e-4);
	double raw_spin = clamp(pc.metric_spin, -0.999 * m, 0.999 * m);
	double a_spin = (pc.metric_type == 4u) ? 0.0 : raw_spin;
	double kn_charge_sq = (pc.metric_type == 4u || pc.metric_type == 5u) ? (pc.metric_charge * pc.metric_charge) : 0.0;
	double rs = 2.0 * m;
	double rh = (abs(a_spin) > 1e-12 || kn_charge_sq > 1e-12) ? (m + sqrt(max(m * m - a_spin * a_spin - kn_charge_sq, 0.0))) : rs;

	uint status = 0u;
	uint iters = 0u;
	dvec3 accum = dvec3(0.0);
	double redshift_rec = 1.0;

	if (pc.metric_type == 0u) {
		iters = 1u;
		vec3 sky = compute_sky_radiance(ray_dir, pc.sky_rotation_rad);
		accum = dvec3(sky);
	} else {
		bool has_accretion_disk = (pc.metric_type == 1u || pc.metric_type == 2u || pc.metric_type == 3u || pc.metric_type == 4u || pc.metric_type == 5u);
		bool use_kerr_newman_metric = (pc.metric_type == 2u || pc.metric_type == 4u || pc.metric_type == 5u) && (abs(a_spin) > 1e-9 * m || kn_charge_sq > 1e-18 * m * m);
		double isco = use_kerr_newman_metric ? kerr_isco_radius_prograde_retrograde(m, a_spin) : ((abs(a_spin) > 1e-12) ? max(rh * 1.05, 6.0 * m - 4.0 * a_spin) : (6.0 * m));
		double disk_outer = 24.0 * m;

		double r_obs = max(pc.observer_position.y, rh * 1.02);
		double theta_obs = clamp(pc.observer_position.z, 0.001, PI_D - 0.001);
		double phi_obs = pc.observer_position.w;

		double angular_pixel_size = pc.field_of_view_rad / max(double(pc.screen_width), 1.0);
		double bh_angular_diameter = (2.0 * rh) / r_obs;
		double turbulence_aa_factor = clamp(bh_angular_diameter / max(angular_pixel_size * 24.0, 1e-9), 0.0, 1.0);

		float phi_obs_f = float(phi_obs);
		dvec2 sincos_theta_obs = precise_sincos(theta_obs);
		double sin_to = sincos_theta_obs.x;
		double cos_to = sincos_theta_obs.y;
		double sin_po = double(sin(phi_obs_f));
		double cos_po = double(cos(phi_obs_f));

		dvec3 er = dvec3(sin_to * cos_po, sin_to * sin_po, cos_to);
		dvec3 eth = dvec3(cos_to * cos_po, cos_to * sin_po, -sin_to);
		dvec3 eph = dvec3(-sin_po, cos_po, 0.0);

		double n_r = dot(ray_dir, er);
		double n_th = dot(ray_dir, eth);
		double n_ph = dot(ray_dir, eph);

		double ray_r = r_obs;
		double ray_th = theta_obs;
		double ray_phi = phi_obs;
		double ray_pr;
		double ray_pth;
		double ray_pphi;
		double ray_p0 = 1.0;
		double E_cons = 1.0;
		double Lz_cons = 0.0;

		if (use_kerr_newman_metric) {
			double g00, g03, g11, g22, g33;
			double e0_t, e0_phi, e1_r, e2_th, e3_phi;
			kerr_newman_zamo_frame(r_obs, theta_obs, m, a_spin, kn_charge_sq, g00, g03, g11, g22, g33, e0_t, e0_phi, e1_r, e2_th, e3_phi);
			ray_p0 = e0_t;
			ray_pr = -n_r * e1_r;
			ray_pth = -n_th * e2_th;
			ray_pphi = e0_phi - n_ph * e3_phi;
			E_cons = -(g00 * ray_p0 + g03 * ray_pphi);
			Lz_cons = g03 * ray_p0 + g33 * ray_pphi;
		} else {
			double factor_obs = max(1.0 - rs / r_obs, 1e-6);
			double sqrt_factor_obs = sqrt(factor_obs);
			ray_pr = -n_r;
			ray_pth = -n_th / (r_obs * sqrt_factor_obs);
			ray_pphi = -n_ph / (r_obs * sin_to * sqrt_factor_obs);
			Lz_cons = ray_pphi * (r_obs * r_obs * sin_to * sin_to);
		}

		double throughput = 1.0;

		bool bodies_traced = (pc.render_flags & (1u << 12)) != 0u && pc.body_count > 0u && (pc.render_flags & (1u << 17)) == 0u;
		dvec3 curr_body_cart_pos = bodies_traced ? spherical_to_cartesian(ray_r, ray_th, ray_phi) : dvec3(0.0);

		uint effective_max_steps = pc.max_integration_steps;
		if ((pc.render_flags & (1u << 9)) != 0u && pc.lod_distance_threshold > 0.0 && r_obs > pc.lod_distance_threshold) {
			effective_max_steps = min(pc.max_integration_steps, pc.lod_reduced_steps);
		}

		for (uint step = 0u; step < effective_max_steps && throughput > 0.01; ++step) {
			iters = step + 1u;

			double delta_kn = kerr_newman_delta(ray_r, m, a_spin, kn_charge_sq);
			if (ray_r <= rh * 1.0001 || delta_kn <= 0.0) {
				status = 1u;
				throughput = 0.0;
				break;
			}
			if (ray_r >= pc.escape_radius) {
				status = 2u;
				break;
			}

			if (!use_kerr_newman_metric && (pc.render_flags & (1u << 10)) != 0u) {
				double effective_skip_r = has_accretion_disk ? max(pc.space_skip_radius_scale * m, disk_outer * 1.05) : max(pc.space_skip_radius_scale * m, rh * 2.0);
				if (ray_r > effective_skip_r) {
					dvec3 skip_origin = spherical_to_cartesian(ray_r, ray_th, ray_phi);
					if (attempt_analytic_space_skip(ray_r, ray_th, ray_phi, ray_pr, ray_pth, ray_pphi, effective_skip_r, pc.escape_radius, m)) {
						if (bodies_traced) {
							dvec3 skip_vector = spherical_to_cartesian(ray_r, ray_th, ray_phi) - skip_origin;
							double skip_length = length(skip_vector);
							vec3 skip_color;
							uint skip_status;
							double skip_dist;
							if (skip_length > 1e-12 && intersect_bodies(skip_origin, skip_vector / skip_length, skip_length, skip_color, skip_status, skip_dist)) {
								accum += throughput * dvec3(skip_color);
								status |= 16u;
								throughput = 0.0;
								break;
							}
							curr_body_cart_pos = spherical_to_cartesian(ray_r, ray_th, ray_phi);
						}
						continue;
					}
				}
			}

			double r_scale = max(ray_r - rh, 0.02 * m);
			dvec2 sincos_ray_th = precise_sincos(ray_th);
			double sin_t = sincos_ray_th.x;
			double cos_t = sincos_ray_th.y;
			double pole_guard = clamp(abs(sin_t) * 12.0 * pc.pole_guard_precision_scale, 0.02, 1.0);
			double far_field_factor = 1.0 + (pc.far_field_step_scale - 1.0) * clamp((ray_r - 20.0 * rh) / (80.0 * rh), 0.0, 1.0);
			double dt = -clamp(0.05 * sqrt(ray_r * r_scale) * far_field_factor, 0.004, 3.5 * pc.far_field_step_scale) * pole_guard;

			double prev_r = ray_r;
			double prev_th = ray_th;
			double prev_phi = ray_phi;
			double prev_pphi = ray_pphi;

			if (use_kerr_newman_metric) {
				dvec4 u_state = dvec4(ray_p0, ray_pr, ray_pth, ray_pphi);
				dvec4 du_state = kerr_newman_geodesic_derivative(u_state, ray_r, ray_th, m, a_spin, kn_charge_sq);

				ray_r += dt * ray_pr;
				ray_th += dt * ray_pth;
				ray_phi += dt * ray_pphi;
				ray_p0 += dt * du_state.x;
				ray_pr += dt * du_state.y;
				ray_pth += dt * du_state.z;
				ray_pphi += dt * du_state.w;
			} else {
				double inv_r = 1.0 / ray_r;
				double inv_r2 = inv_r * inv_r;
				double f = max(1.0 - rs * inv_r, 1e-6);
				double inv_f = 1.0 / f;
				double p_t = E_cons * inv_f;
				double sin2_t = max(sin_t * sin_t, 1e-10);
				double safe_sin_t = (abs(sin_t) > 1e-7) ? sin_t : ((sin_t >= 0.0) ? 1e-7 : -1e-7);

				double half_rs_inv_r2 = 0.5 * rs * inv_r2;
				double g100 = half_rs_inv_r2 * f;
				double g111 = -half_rs_inv_r2 * inv_f;
				double rf = ray_r * f;
				double g122 = -rf;
				double g133 = -rf * sin2_t;

				double d_pr = -(g100 * p_t * p_t + g111 * ray_pr * ray_pr + g122 * ray_pth * ray_pth + g133 * ray_pphi * ray_pphi);
				double d_pth = -(2.0 * inv_r * ray_pr * ray_pth - sin_t * cos_t * ray_pphi * ray_pphi);
				double d_pphi = -2.0 * (inv_r * ray_pr * ray_pphi + (cos_t / safe_sin_t) * ray_pth * ray_pphi);

				ray_r += dt * ray_pr;
				ray_th += dt * ray_pth;
				ray_phi += dt * ray_pphi;
				ray_pr += dt * d_pr;
				ray_pth += dt * d_pth;
				ray_pphi += dt * d_pphi;
			}

			if (ray_th < 0.0) {
				ray_th = -ray_th;
				ray_phi += PI_D;
				ray_pth = -ray_pth;
			} else if (ray_th > PI_D) {
				ray_th = 2.0 * PI_D - ray_th;
				ray_phi += PI_D;
				ray_pth = -ray_pth;
			}

			bool body_segment_hit = false;
			vec3 body_segment_color = vec3(0.0);
			if (bodies_traced) {
				dvec3 next_body_cart_pos = spherical_to_cartesian(ray_r, ray_th, ray_phi);
				dvec3 segment_vector = next_body_cart_pos - curr_body_cart_pos;
				double segment_length = length(segment_vector);
				if (segment_length > 1e-12) {
					uint segment_status;
					double segment_dist;
					body_segment_hit = intersect_bodies(curr_body_cart_pos, segment_vector / segment_length, segment_length, body_segment_color, segment_status, segment_dist);
				}
				curr_body_cart_pos = next_body_cart_pos;
			}

			double mid_plane = PI_D * 0.5;
			if (has_accretion_disk && (prev_th - mid_plane) * (ray_th - mid_plane) <= 0.0) {
				double d_th_span = abs(ray_th - prev_th);
				double s_cross = (d_th_span > 1e-12) ? clamp(abs(prev_th - mid_plane) / d_th_span, 0.0, 1.0) : 0.5;
				double r_cross = prev_r + s_cross * (ray_r - prev_r);
				double phi_cross = prev_phi + s_cross * (ray_phi - prev_phi);
				double pphi_cross = prev_pphi + s_cross * (ray_pphi - prev_pphi);

				if (r_cross >= isco && r_cross <= disk_outer) {
					status |= 4u;

					double lz_at_cross = use_kerr_newman_metric ? (pphi_cross * r_cross * r_cross) : Lz_cons;
					double v_orb = sqrt(m / r_cross);
					double omega_orb = v_orb / r_cross;
					double gamma_orb = 1.0 / sqrt(max(1.0 - 3.0 * m / r_cross, 1e-4));
					double l_over_e = lz_at_cross / max(abs(E_cons), 1e-12);
					double denom_g = gamma_orb * (1.0 - omega_orb * l_over_e);
					double g_doppler = (abs(denom_g) > 1e-12) ? (sqrt(max(1.0 - rs / r_cross, 1e-4)) / denom_g) : 1.0;
					redshift_rec = g_doppler;

					double q_ratio = isco / r_cross;
					double q_quarter = sqrt(sqrt(q_ratio));
					double q_three_quarter = q_quarter * q_quarter * q_quarter;
					double sqrt_q_ratio = sqrt(q_ratio);
					double w_ratio = max(1.0 - sqrt_q_ratio, 0.0);
					double w_quarter = sqrt(sqrt(w_ratio));
					double t_norm = q_three_quarter * w_quarter;
					double t_eff_k = pc.disk_temperature_scale_k * t_norm + pc.disk_temperature_floor_k;
					double t_obs = t_eff_k * g_doppler;

					double g4 = double(pow(float(g_doppler), float(pc.disk_doppler_beaming_exponent)));
					double radial_envelope = clamp((disk_outer - r_cross) / (1.5 * m), 0.0, 1.0) * clamp((r_cross - isco) / (0.8 * m), 0.0, 1.0);
					double log_ratio = double(log(float(r_cross / isco)));
					double turbulence_phase = 8.0 * phi_cross - 4.0 * log_ratio;
					double turbulence = 1.0 - (0.12 * turbulence_aa_factor) + (0.12 * turbulence_aa_factor) * double(sin(float(turbulence_phase)));
					double flux_intensity = max(g4 * t_norm * radial_envelope * turbulence, 0.0) * 1.5;

					dvec3 disk_rgb = temperature_to_linear_rgb(t_obs, flux_intensity, pc.disk_color_saturation);
					double alpha_opacity = clamp(radial_envelope * 0.95, 0.0, 0.98);

					accum += throughput * disk_rgb;
					throughput *= (1.0 - alpha_opacity);
				}
			}
			if (body_segment_hit && throughput > 0.01) {
				accum += throughput * dvec3(body_segment_color);
				status |= 16u;
				throughput = 0.0;
				break;
			}
		}

		if ((status & 2u) != 0u || throughput > 0.01) {
			float ray_phi_f2 = float(ray_phi);
			dvec2 sincos_exit_th = precise_sincos(ray_th);
			double sin_t = sincos_exit_th.x;
			double cos_t = sincos_exit_th.y;
			double sin_p = double(sin(ray_phi_f2));
			double cos_p = double(cos(ray_phi_f2));

			double exit_radial = ray_pr / sqrt(max(1.0 - rs / ray_r, 1e-6));
			double pxr = -(exit_radial * sin_t * cos_p + ray_r * ray_pth * cos_t * cos_p - ray_r * sin_t * ray_pphi * sin_p);
			double pyr = -(exit_radial * sin_t * sin_p + ray_r * ray_pth * cos_t * sin_p + ray_r * sin_t * ray_pphi * cos_p);
			double pzr = -(exit_radial * cos_t - ray_r * ray_pth * sin_t);

			double p_len = sqrt(pxr * pxr + pyr * pyr + pzr * pzr);
			double inv_plen = (p_len > 1e-12) ? (1.0 / p_len) : 1.0;
			dvec3 dir_out = dvec3(pxr * inv_plen, pyr * inv_plen, pzr * inv_plen);

			bool exit_body_hit = false;
			if (bodies_traced) {
				vec3 exit_color;
				uint exit_status;
				double exit_dist;
				dvec3 exit_origin = spherical_to_cartesian(ray_r, ray_th, ray_phi);
				exit_body_hit = intersect_bodies(exit_origin, dir_out, 1e30, exit_color, exit_status, exit_dist);
				if (exit_body_hit) {
					accum += throughput * dvec3(exit_color);
					status |= 16u;
				}
			}
			if (!exit_body_hit) {
				vec3 sky = compute_sky_radiance(dir_out, pc.sky_rotation_rad);
				accum += throughput * dvec3(sky);
			}
		}
	}

	vec3 mapped = apply_tonemapping(vec3(accum), pc.tonemapping_mode, pc.camera_exposure);

	pixels[pixel_index].rgba = vec4(mapped, 1.0);
	pixels[pixel_index].redshift = float(redshift_rec);
	pixels[pixel_index].affine_parameter = float(iters) * 0.05;
	pixels[pixel_index].status_flags = status;
	pixels[pixel_index].iterations_used = iters;
	}
	}
}
