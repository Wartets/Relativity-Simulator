const double PI_D = 3.14159265358979323846;
const float PI_F = 3.14159265358979323846f;

uint hash_u32(uint x) {
	x ^= x >> 16;
	x *= 0x7feb352dU;
	x ^= x >> 15;
	x *= 0x846ca68bU;
	x ^= x >> 16;
	return x;
}

float hash_to_float(uint x) {
	return float(hash_u32(x) & 0x00FFFFFFU) * (1.0 / 16777216.0);
}

dvec2 precise_sincos(double theta) {
	double h = theta * 0.25;
	double h2 = h * h;
	double sin_h = h * (1.0 - h2 * (1.0 / 6.0 - h2 * (1.0 / 120.0 - h2 * (1.0 / 5040.0 - h2 / 362880.0))));
	double cos_h = 1.0 - h2 * (0.5 - h2 * (1.0 / 24.0 - h2 * (1.0 / 720.0 - h2 / 40320.0)));
	double sin_2h = 2.0 * sin_h * cos_h;
	double cos_2h = 1.0 - 2.0 * sin_h * sin_h;
	double sin_4h = 2.0 * sin_2h * cos_2h;
	double cos_4h = 1.0 - 2.0 * sin_2h * sin_2h;
	return dvec2(sin_4h, cos_4h);
}

dvec3 spherical_to_cartesian(double r, double theta, double phi) {
	dvec2 sincos_theta = precise_sincos(theta);
	float phi_f = float(phi);
	double r_sin_theta = r * sincos_theta.x;
	return dvec3(r_sin_theta * double(cos(phi_f)), r_sin_theta * double(sin(phi_f)), r * sincos_theta.y);
}

double cbrt_d(double x) {
	if (x == 0.0) return 0.0;
	float xf = float(x);
	float sign_x = (xf < 0.0) ? -1.0 : 1.0;
	double y = double(sign_x * pow(abs(xf), 1.0 / 3.0));
	for (int iteration = 0; iteration < 2; ++iteration) {
		y -= (y * y * y - x) / (3.0 * y * y);
	}
	return y;
}

double kerr_newman_delta(double r, double mass, double a, double rq2) {
	return r * r - 2.0 * mass * r + a * a + rq2;
}

double kerr_isco_radius_prograde_retrograde(double mass, double a) {
	double a_star = clamp(a / mass, -0.9999999, 0.9999999);
	double abs_a = abs(a_star);
	double orbit_sign = (a_star >= 0.0) ? -1.0 : 1.0;
	double cbrt_term = cbrt_d(max(1.0 - abs_a * abs_a, 0.0));
	double z1 = 1.0 + cbrt_term * (cbrt_d(1.0 + abs_a) + cbrt_d(1.0 - abs_a));
	double z2 = sqrt(3.0 * abs_a * abs_a + z1 * z1);
	double r_isco_over_m = 3.0 + z2 + orbit_sign * sqrt(max((3.0 - z1) * (3.0 + z1 + 2.0 * z2), 0.0));
	return r_isco_over_m * mass;
}

void kerr_newman_zamo_frame(
	double r, double theta, double mass, double a, double rq2,
	out double g00, out double g03, out double g11, out double g22, out double g33,
	out double e0_t, out double e0_phi, out double e1_r, out double e2_th, out double e3_phi
) {
	float theta_f = float(theta);
	double sin_t = double(sin(theta_f));
	double cos_t = double(cos(theta_f));
	double sin2_t = sin_t * sin_t;
	double cos2_t = cos_t * cos_t;
	double a2 = a * a;
	double r2 = r * r;
	double rho2 = r2 + a2 * cos2_t;
	double delta = kerr_newman_delta(r, mass, a, rq2);
	double two_mr_minus_q2 = 2.0 * mass * r - rq2;
	double sigma = (r2 + a2) * (r2 + a2) - a2 * delta * sin2_t;

	g00 = -(1.0 - two_mr_minus_q2 / rho2);
	g03 = -(two_mr_minus_q2 * a * sin2_t) / rho2;
	g11 = rho2 / delta;
	g22 = rho2;
	g33 = (sigma * sin2_t) / rho2;

	double omega = -g03 / max(g33, 1e-30);
	double lapse_sq = -(g00 + omega * g03);
	double alpha = sqrt(max(lapse_sq, 1e-30));
	e0_t = 1.0 / alpha;
	e0_phi = omega / alpha;
	e1_r = 1.0 / sqrt(max(g11, 1e-30));
	e2_th = 1.0 / sqrt(max(g22, 1e-30));
	e3_phi = 1.0 / sqrt(max(g33, 1e-30));
}

dvec4 kerr_newman_geodesic_derivative(dvec4 u, double r, double theta, double mass, double a, double rq2) {
	float theta_f = float(theta);
	double sin_t = double(sin(theta_f));
	double cos_t = double(cos(theta_f));
	double sin2_t = sin_t * sin_t;
	double cos2_t = cos_t * cos_t;
	double a2 = a * a;
	double r2 = r * r;
	double rho2 = r2 + a2 * cos2_t;
	double inv_rho2 = 1.0 / rho2;
	double inv_rho4 = inv_rho2 * inv_rho2;
	double delta = kerr_newman_delta(r, mass, a, rq2);
	double inv_delta = 1.0 / delta;
	double inv_delta2 = inv_delta * inv_delta;
	double inv_rho2_delta = inv_rho2 * inv_delta;
	double two_mr_minus_q2 = 2.0 * mass * r - rq2;

	double d1_ratio = (2.0 * mass * rho2 - two_mr_minus_q2 * 2.0 * r) * inv_rho4;
	double d1_g00 = d1_ratio;
	double d1_g03 = -a * sin2_t * d1_ratio;
	double d1_delta = 2.0 * (r - mass);
	double d1_g11 = (2.0 * r * delta - rho2 * d1_delta) * inv_delta2;
	double d1_g22 = 2.0 * r;
	double sigma = (r2 + a2) * (r2 + a2) - a2 * delta * sin2_t;
	double d1_sigma = 4.0 * r * (r2 + a2) - a2 * d1_delta * sin2_t;
	double d1_g33 = sin2_t * (d1_sigma * rho2 - sigma * 2.0 * r) * inv_rho4;

	double sin_cos = sin_t * cos_t;
	double d2_rho2 = -2.0 * a2 * sin_cos;
	double d2_ratio = -two_mr_minus_q2 * d2_rho2 * inv_rho4;
	double d2_g00 = d2_ratio;
	double d2_g03 = -a * (2.0 * sin_cos * two_mr_minus_q2 * rho2 - two_mr_minus_q2 * sin2_t * d2_rho2) * inv_rho4;
	double d2_g11 = d2_rho2 * inv_delta;
	double d2_g22 = d2_rho2;
	double d2_sigma = -2.0 * a2 * delta * sin_cos;
	double d2_term = 2.0 * sin_cos * sigma * rho2 + sin2_t * d2_sigma * rho2 - sigma * sin2_t * d2_rho2;
	double d2_g33 = d2_term * inv_rho4;

	double inv_g00 = -sigma * inv_rho2_delta;
	double inv_g03 = -(two_mr_minus_q2 * a) * inv_rho2_delta;
	double inv_g11 = delta * inv_rho2;
	double inv_g22 = inv_rho2;
	double safe_sin2_t = max(sin2_t, 1e-12);
	double inv_g33 = (delta - a2 * sin2_t) * (inv_rho2_delta / safe_sin2_t);

	double p0 = u.x, p1 = u.y, p2 = u.z, p3 = u.w;

	double term0 = d1_g00 * p1 * p0 + d2_g00 * p2 * p0 + d1_g03 * p1 * p3 + d2_g03 * p2 * p3;
	double term1 = -0.5 * (d1_g00 * p0 * p0 + d1_g11 * p1 * p1 + d1_g22 * p2 * p2 + d1_g33 * p3 * p3 + 2.0 * d1_g03 * p0 * p3) + d1_g11 * p1 * p1 + d2_g11 * p2 * p1;
	double term2 = -0.5 * (d2_g00 * p0 * p0 + d2_g11 * p1 * p1 + d2_g22 * p2 * p2 + d2_g33 * p3 * p3 + 2.0 * d2_g03 * p0 * p3) + d1_g22 * p1 * p2 + d2_g22 * p2 * p2;
	double term3 = d1_g03 * p1 * p0 + d2_g03 * p2 * p0 + d1_g33 * p1 * p3 + d2_g33 * p2 * p3;

	dvec4 acc;
	acc.x = -(inv_g00 * term0 + inv_g03 * term3);
	acc.y = -inv_g11 * term1;
	acc.z = -inv_g22 * term2;
	acc.w = -(inv_g03 * term0 + inv_g33 * term3);
	return acc;
}

dvec3 compute_pinhole_ray(double u, double v, double fov) {
	double tan_half = double(tan(float(fov * 0.5)));
	double n1 = 1.0;
	double n2 = v * tan_half;
	double n3 = u * tan_half;
	double len = sqrt(n1 * n1 + n2 * n2 + n3 * n3);
	double inv_len = (len > 0.0) ? (1.0 / len) : 1.0;
	return dvec3(n1 * inv_len, n2 * inv_len, n3 * inv_len);
}

dvec3 compute_fisheye_stereographic_ray(double u, double v, double fov) {
	double max_fov = clamp(fov * 1.6, 0.1, 260.0 * 0.017453292519943295);
	double r = sqrt(u * u + v * v);
	if (r < 1e-15) return dvec3(1.0, 0.0, 0.0);
	double half_max_fov = max_fov * 0.5;
	float tan_half_max_fov = tan(float(half_max_fov * 0.5));
	double theta = double(2.0 * atan(float(r) * tan_half_max_fov));
	float theta_f = float(theta);
	double sin_t = double(sin(theta_f));
	double cos_t = double(cos(theta_f));
	double n1 = cos_t;
	double n2 = v * (sin_t / r);
	double n3 = u * (sin_t / r);
	double len = sqrt(n1 * n1 + n2 * n2 + n3 * n3);
	double inv_len = (len > 0.0) ? (1.0 / len) : 1.0;
	return dvec3(n1 * inv_len, n2 * inv_len, n3 * inv_len);
}

dvec3 compute_fisheye_equidistant_ray(double u, double v, double fov) {
	double r = sqrt(u * u + v * v);
	if (r < 1e-15) return dvec3(1.0, 0.0, 0.0);
	double theta = min(r * fov * 0.5, PI_D);
	float theta_f = float(theta);
	double sin_t = double(sin(theta_f));
	double cos_t = double(cos(theta_f));
	double n1 = cos_t;
	double n2 = v * (sin_t / r);
	double n3 = u * (sin_t / r);
	double len = sqrt(n1 * n1 + n2 * n2 + n3 * n3);
	double inv_len = (len > 0.0) ? (1.0 / len) : 1.0;
	return dvec3(n1 * inv_len, n2 * inv_len, n3 * inv_len);
}

dvec3 compute_fisheye_orthographic_ray(double u, double v, double fov) {
	double r = sqrt(u * u + v * v);
	double sin_half_fov = double(sin(float(clamp(fov * 0.5, 0.01, PI_D * 0.499))));
	double sin_t = clamp(r * sin_half_fov, 0.0, 1.0);
	double cos_t = sqrt(max(1.0 - sin_t * sin_t, 0.0));
	if (r < 1e-15) return dvec3(1.0, 0.0, 0.0);
	double n1 = cos_t;
	double n2 = v * (sin_t / r);
	double n3 = u * (sin_t / r);
	double len = sqrt(n1 * n1 + n2 * n2 + n3 * n3);
	double inv_len = (len > 0.0) ? (1.0 / len) : 1.0;
	return dvec3(n1 * inv_len, n2 * inv_len, n3 * inv_len);
}

dvec3 compute_panini_cylindrical_ray(double u, double v, double fov) {
	double d = 1.0;
	double tan_h = double(tan(float(fov * 0.5)));
	double px = u * tan_h;
	double py = v * tan_h;
	double s = (d + 1.0) / (d + sqrt(max(1.0 + (1.0 - d * d) * px * px / ((d + 1.0) * (d + 1.0)), 1e-15)));
	double sin_phi = (px * s) / (d + 1.0);
	double cos_phi = sqrt(max(1.0 - sin_phi * sin_phi, 0.0));
	double n1 = cos_phi;
	double n2 = py;
	double n3 = sin_phi;
	double len = sqrt(n1 * n1 + n2 * n2 + n3 * n3);
	double inv_len = (len > 0.0) ? (1.0 / len) : 1.0;
	return dvec3(n1 * inv_len, n2 * inv_len, n3 * inv_len);
}

dvec3 compute_hammer_aitoff_ray(double u, double v, double fov) {
	double zoom = (60.0 * 0.017453292519943295) / max(fov, 0.01);
	double sqrt2 = 1.4142135623730951;
	double x = clamp(u * zoom * sqrt2, -sqrt2, sqrt2);
	double y = clamp(v * zoom * sqrt2 * 0.5, -sqrt2 * 0.5, sqrt2 * 0.5);
	double z = sqrt(max(1.0 - (x * x * 0.25) - (y * y), 1e-15));
	double phi = double(2.0 * atan(float(z * x), float(2.0 * (2.0 * z * z - 1.0))));
	double theta = (PI_D * 0.5) - double(asin(float(clamp(z * y * sqrt2, -1.0, 1.0))));
	float theta_f = float(theta);
	float phi_f = float(phi);
	double sin_t = double(sin(theta_f));
	double cos_t = double(cos(theta_f));
	double sin_p = double(sin(phi_f));
	double cos_p = double(cos(phi_f));
	return dvec3(sin_t * cos_p, cos_t, sin_t * sin_p);
}

dvec3 compute_equirectangular_360_ray(double u, double v, double fov) {
	double fov_scale = fov / (60.0 * 0.017453292519943295);
	double phi = u * PI_D * fov_scale;
	double theta = clamp((PI_D * 0.5) - v * (PI_D * 0.5) * fov_scale, 0.0001, PI_D - 0.0001);
	float theta_f = float(theta);
	float phi_f = float(phi);
	double sin_t = double(sin(theta_f));
	double cos_t = double(cos(theta_f));
	double sin_p = double(sin(phi_f));
	double cos_p = double(cos(phi_f));
	double n1 = sin_t * cos_p;
	double n2 = cos_t;
	double n3 = sin_t * sin_p;
	double len = sqrt(n1 * n1 + n2 * n2 + n3 * n3);
	double inv_len = (len > 0.0) ? (1.0 / len) : 1.0;
	return dvec3(n1 * inv_len, n2 * inv_len, n3 * inv_len);
}

dvec3 compute_ray_direction(uint mode, double u, double v, double fov) {
	if (mode == 2u) return compute_fisheye_stereographic_ray(u, v, fov);
	if (mode == 3u) return compute_equirectangular_360_ray(u, v, fov);
	if (mode == 4u) return compute_fisheye_equidistant_ray(u, v, fov);
	if (mode == 5u) return compute_fisheye_orthographic_ray(u, v, fov);
	if (mode == 6u) return compute_panini_cylindrical_ray(u, v, fov);
	if (mode == 7u) return compute_hammer_aitoff_ray(u, v, fov);
	return compute_pinhole_ray(u, v, fov);
}

double body_hash3(ivec3 p) {
	uint h = uint(p.x) * 374761393u + uint(p.y) * 668265263u + uint(p.z) * 2147483647u;
	return double(hash_to_float(h)) * 2.0 - 1.0;
}

float body_value_noise(vec3 p) {
	ivec3 i0 = ivec3(floor(p));
	vec3 f = p - vec3(i0);
	vec3 u = f * f * (3.0 - 2.0 * f);

	float c000 = float(body_hash3(i0 + ivec3(0, 0, 0)));
	float c100 = float(body_hash3(i0 + ivec3(1, 0, 0)));
	float c010 = float(body_hash3(i0 + ivec3(0, 1, 0)));
	float c110 = float(body_hash3(i0 + ivec3(1, 1, 0)));
	float c001 = float(body_hash3(i0 + ivec3(0, 0, 1)));
	float c101 = float(body_hash3(i0 + ivec3(1, 0, 1)));
	float c011 = float(body_hash3(i0 + ivec3(0, 1, 1)));
	float c111 = float(body_hash3(i0 + ivec3(1, 1, 1)));

	float c00 = mix(c000, c100, u.x);
	float c10 = mix(c010, c110, u.x);
	float c01 = mix(c001, c101, u.x);
	float c11 = mix(c011, c111, u.x);

	float c0 = mix(c00, c10, u.y);
	float c1 = mix(c01, c11, u.y);

	return mix(c0, c1, u.z);
}

double body_fbm(dvec3 p_d, uint octaves, double roughness) {
	vec3 p = vec3(p_d);
	float r_f = float(roughness);
	float total = 0.0;
	float amplitude = 1.0;
	float frequency = 1.0;
	float max_val = 0.0;
	for (uint i = 0u; i < octaves; ++i) {
		total += body_value_noise(p * frequency) * amplitude;
		max_val += amplitude;
		amplitude *= r_f;
		frequency *= 2.0;
	}
	return double(total / max(max_val, 1e-5));
}

float surface_fbm(vec3 p, uint octaves, float roughness) {
	return float(body_fbm(dvec3(p), octaves, double(roughness)));
}

float sample_distribution_gpu(uint dist_type, float min_val, float max_val, float shape_param, uint hash_val) {
	float u = hash_to_float(hash_val);
	if (min_val >= max_val) return min_val;
	if (dist_type == 1u) {
		float alpha = max(shape_param, 0.05);
		if (abs(alpha - 1.0) < 1e-4) return min_val * pow(max_val / min_val, u);
		float oma = 1.0 - alpha;
		float term = (1.0 - u) * pow(min_val, oma) + u * pow(max_val, oma);
		return clamp(pow(max(term, 1e-15), 1.0 / oma), min_val, max_val);
	}
	if (dist_type == 2u) {
		float lambda = max(shape_param, 0.1);
		float norm = 1.0 - exp(-lambda * (max_val - min_val));
		return min_val - log(max(1.0 - u * norm, 1e-12)) / lambda;
	}
	if (dist_type == 3u) {
		float u2 = max(hash_to_float(hash_val ^ 0x94d049bbu), 1e-12);
		float z = sqrt(-2.0 * log(max(u, 1e-12))) * cos(2.0 * PI_F * u2);
		float log_min = log(max(min_val, 1e-8));
		float log_max = log(max(max_val, 1e-7));
		float mid = 0.5 * (log_min + log_max);
		float spread = clamp(shape_param * 0.35, 0.05, 2.5) * (log_max - log_min);
		return clamp(exp(mid + spread * z), min_val, max_val);
	}
	if (dist_type == 4u) {
		if (u < 0.85) {
			return min_val + (u / 0.85) * (0.12 * (max_val - min_val));
		} else {
			return min_val + 0.60 * (max_val - min_val) + ((u - 0.85) / 0.15) * 0.40 * (max_val - min_val);
		}
	}
	return min_val + u * (max_val - min_val);
}

float bessel_j1_gpu(float x) {
	float ax = abs(x);
	if (ax < 3.75) {
		float y = (x / 3.75) * (x / 3.75);
		return x * (0.5 + y * (-0.56249985 + y * (0.21093573 + y * (-0.03954289 + y * 0.00443319))));
	}
	float y = 3.75 / ax;
	float f0 = 0.79788456 + y * (-0.00000077 + y * (-0.00552740 + y * 0.00009512));
	float theta0 = ax - 2.35619449 + y * (0.04411179 + y * (-0.00008449 - y * 0.00076126));
	float res = (f0 / sqrt(ax)) * cos(theta0);
	return (x < 0.0) ? -res : res;
}

float evaluate_star_psf_gpu(float theta_sq, float eff_sigma, float eff_sigma_sq, float pixel_footprint, float local_x, float local_y, uint model) {
	float theta = sqrt(max(theta_sq, 0.0));
	if (model == 6u) {
		float tightness = clamp(float(pc.sky.star_dirac_concentration), 0.1, 0.999);
		float core_w = max(pixel_footprint * (1.0 - tightness) * 0.4, 1e-7);
		return exp(-theta_sq / (2.0 * core_w * core_w));
	}
	if (model == 7u) {
		float core = exp(-theta_sq / (2.0 * eff_sigma_sq));
		float bloom_w = max(eff_sigma * clamp(float(pc.sky.star_bloom_radius), 1.0, 30.0), pixel_footprint * 3.5);
		return core + float(pc.sky.star_bloom_intensity) * 1.8 * exp(-theta / bloom_w);
	}
	if (model == 1u) {
		float scale_p = max(float(pc.sky.star_profile_param), 0.05);
		float gamma_sq = eff_sigma_sq * scale_p;
		return (gamma_sq / (gamma_sq + theta_sq)) + 0.25 * (gamma_sq / (gamma_sq + theta_sq * 0.25));
	}
	if (model == 2u) {
		float beta = clamp(float(pc.sky.star_profile_param), 1.05, 8.0);
		float scale = max(eff_sigma_sq * float(pc.sky.star_profile_param2), 1e-10);
		return pow(1.0 + theta_sq / scale, -beta);
	}
	if (model == 3u) {
		float v = PI_F * theta / max(eff_sigma * 0.5, 1e-7);
		if (v < 1e-4) return 1.0;
		float j1 = bessel_j1_gpu(v);
		float airy = (2.0 * j1 / v) * (2.0 * j1 / v);
		return min(airy * max(float(pc.sky.star_profile_param2), 0.5), 3.0);
	}
	if (model == 4u) {
		float disc_r = max(eff_sigma, pixel_footprint * 0.5);
		float softness = clamp(float(pc.sky.star_profile_softness), 0.005, 1.0);
		float edge_w = max(pixel_footprint * 0.4, disc_r * softness);
		return 1.0 - clamp((theta - (disc_r - edge_w)) / max(2.0 * edge_w, 1e-7), 0.0, 1.0);
	}
	if (model == 5u) {
		float core = exp(-theta_sq / (2.0 * eff_sigma_sq));
		float angle = atan(local_y, local_x) + float(pc.sky.star_spike_angle_deg) * (PI_F / 180.0);
		float n_spikes = (pc.sky.star_spike_count == 6u) ? 3.0 : ((pc.sky.star_spike_count == 8u) ? 4.0 : 2.0);
		float cos_sp = abs(cos(n_spikes * angle));
		float beam = pow(cos_sp, 32.0);
		float len = max(eff_sigma * clamp(float(pc.sky.star_spike_length), 0.5, 60.0), pixel_footprint * 8.0);
		float falloff = exp(-theta / len);
		return core + float(pc.sky.star_spike_intensity) * 2.5 * beam * falloff;
	}
	return exp(-theta_sq / (2.0 * eff_sigma_sq)) + 0.08 * exp(-theta / (3.5 * max(eff_sigma, 1e-7)));
}

vec3 sample_procedural_stars_gpu(vec3 dir, float fov_rad, float zoom_factor) {
	if (pc.sky.stars_enabled == 0u || pc.sky.star_density <= 0.0) return vec3(0.0);
	float base_density = clamp(float(pc.sky.star_density), 0.01, 100.0);
	float base_grid_res = clamp(14.0 * sqrt(base_density), 6.0, 96.0);
	float pixel_footprint = max(fov_rad / 1080.0, 1e-6);

	vec3 plane_norm = vec3(pc.sky.nebula_plane_normal[0], pc.sky.nebula_plane_normal[1], pc.sky.nebula_plane_normal[2]);
	float pn_len = length(plane_norm);
	plane_norm = (pn_len > 1e-6) ? (plane_norm / pn_len) : vec3(0.0, 0.4472136, 0.8944272);

	vec3 accum = vec3(0.0);
	uint base_seed = pc.sky.seed;
	float grid_res = base_grid_res;

	vec3 p = dir * grid_res;
	ivec3 c = ivec3(floor(p));
	float presence_thresh = clamp(1.0 - base_density * 0.16, 0.01, 0.99);

	for (int dz = -1; dz <= 1; ++dz) {
		for (int dy = -1; dy <= 1; ++dy) {
			for (int dx = -1; dx <= 1; ++dx) {
				ivec3 cell = c + ivec3(dx, dy, dz);
				uint cell_hash = uint(cell.x * 73856093 ^ cell.y * 19349663 ^ cell.z * 83492791) ^ base_seed;
				if (hash_to_float(cell_hash) <= presence_thresh) continue;

					vec3 offset = vec3(hash_to_float(cell_hash + 11u), hash_to_float(cell_hash + 23u), hash_to_float(cell_hash + 37u));
					vec3 star_dir = normalize(vec3(cell) + offset);

					if (pc.sky.star_placement_model == 1u) {
						float h_plane = dot(star_dir, plane_norm);
						float p_disk = exp(-abs(h_plane) * float(pc.sky.star_galactic_concentration));
						if (hash_to_float(cell_hash + 101u) > (p_disk * 0.95 + 0.05)) continue;
					} else if (pc.sky.star_placement_model == 2u) {
						float cl = float(body_fbm(dvec3(star_dir * 3.8), 3u, 0.65));
						float cl_p = pow(clamp((cl + 0.6) * 0.85, 0.0, 1.0), 3.0);
						if (hash_to_float(cell_hash + 102u) > cl_p) continue;
					} else if (pc.sky.star_placement_model == 3u) {
						float h_plane = dot(star_dir, plane_norm);
						bool is_disk = hash_to_float(cell_hash + 103u) > 0.30;
						if (is_disk) {
							float p_disk = exp(-abs(h_plane) * float(pc.sky.star_galactic_concentration));
							if (hash_to_float(cell_hash + 107u) > p_disk) continue;
						}
					} else if (pc.sky.star_placement_model == 4u) {
						float h_plane = dot(star_dir, plane_norm);
						float phi_plane = atan(star_dir.y, star_dir.x);
						float arm_val = sin(2.0 * phi_plane - 4.5 * log(max(abs(h_plane) + 0.2, 0.05)));
						float p_arm = clamp(exp(-abs(h_plane) * 3.0) * (0.15 + 0.85 * (arm_val * 0.5 + 0.5)), 0.02, 1.0);
						if (hash_to_float(cell_hash + 109u) > p_arm) continue;
					}

					float mu = dot(dir, star_dir);
					if (mu <= 0.994) continue;
					float theta_sq = 2.0 * max(0.0, 1.0 - mu);

					float radius = sample_distribution_gpu(pc.sky.star_size_distribution, float(pc.sky.star_size_min), float(pc.sky.star_size_max), float(pc.sky.star_size_param), cell_hash + 31u) * float(pc.sky.star_size_scale);

					float eff_sigma = sqrt(radius * radius * (pc.sky.star_profile_model == 4u ? 1.0 : 1.96) + pixel_footprint * pixel_footprint * 0.35);
					float eff_sigma_sq = eff_sigma * eff_sigma;

					float max_sup = eff_sigma * 6.0;
					if (pc.sky.star_profile_model == 5u) max_sup = max(max_sup, eff_sigma * float(pc.sky.star_spike_length));
					else if (pc.sky.star_profile_model == 7u) max_sup = max(max_sup, eff_sigma * float(pc.sky.star_bloom_radius));
					else if (pc.sky.star_profile_model == 3u) max_sup = max(max_sup, eff_sigma * 12.0);

					float max_sup_sq = max_sup * max_sup;
					if (theta_sq > max_sup_sq) continue;
					float window_u = clamp(theta_sq / max_sup_sq, 0.0, 1.0);
					float hermite = (1.0 - window_u) * (1.0 - window_u);

					float lum = sample_distribution_gpu(pc.sky.star_luminosity_distribution, 0.2, 25.0, float(pc.sky.star_luminosity_param), cell_hash + 53u) * float(pc.sky.star_brightness);

					if (pc.sky.dynamic_motion != 0u && pc.sky.star_scintillation > 0.0) {
						float tw_phase = hash_to_float(cell_hash + 67u) * 6.2831853;
						lum *= (1.0 + float(pc.sky.star_scintillation) * sin(float(pc.sky.time_seconds) * 3.8 + tw_phase));
					}

					vec3 u1 = (abs(star_dir.z) < 0.9) ? normalize(vec3(-star_dir.y, star_dir.x, 0.0)) : normalize(vec3(0.0, -star_dir.z, star_dir.y));
					vec3 u2 = cross(star_dir, u1);
					vec3 delta = dir - star_dir;
					float loc_x = dot(delta, u1);
					float loc_y = dot(delta, u2);

					float psf = evaluate_star_psf_gpu(theta_sq, eff_sigma, eff_sigma_sq, pixel_footprint, loc_x, loc_y, pc.sky.star_profile_model);
					float apparent_ratio = clamp((radius * radius) / max(eff_sigma_sq, 1e-10), 0.02, 4.0);
					float total_flux = lum * apparent_ratio * psf * hermite;

					float temp_norm = clamp(hash_to_float(cell_hash + 79u) + float(pc.sky.star_temperature_bias) * 0.4, 0.0, 1.0);
					vec3 tint = vec3(1.0);
					if (temp_norm < 0.2) tint = vec3(1.55, 0.65, 0.35);
					else if (temp_norm < 0.45) tint = vec3(1.35, 1.05, 0.70);
					else if (temp_norm < 0.70) tint = vec3(1.05, 1.05, 1.05);
					else if (temp_norm < 0.88) tint = vec3(0.80, 0.95, 1.35);
					else tint = vec3(0.65, 0.80, 1.60);
					tint = mix(vec3(1.0), tint, float(pc.sky.star_color_variation));

					accum += tint * total_flux;
				}
			}
		}
	return accum;
}

vec3 sample_deep_field_galaxies_gpu(vec3 dir) {
	if (pc.sky.galaxies_enabled == 0u || pc.sky.galaxy_density <= 0.0) return vec3(0.0);
	float grid_res = clamp(6.0 * sqrt(float(pc.sky.galaxy_density)), 3.0, 24.0);
	vec3 p = dir * grid_res;
	ivec3 c = ivec3(floor(p));
	uint base_seed = pc.sky.seed ^ 0x6a09e667u;
	float presence_thresh = clamp(1.0 - float(pc.sky.galaxy_density) * 0.20, 0.02, 0.99);

	vec3 accum = vec3(0.0);
	for (int dz = -1; dz <= 1; ++dz) {
		for (int dy = -1; dy <= 1; ++dy) {
			for (int dx = -1; dx <= 1; ++dx) {
				ivec3 cell = c + ivec3(dx, dy, dz);
				uint cell_hash = uint(cell.x * 73856093 ^ cell.y * 19349663 ^ cell.z * 83492791) ^ base_seed;
				if (hash_to_float(cell_hash) > presence_thresh) continue;

				vec3 offset = vec3(hash_to_float(cell_hash + 11u), hash_to_float(cell_hash + 23u), hash_to_float(cell_hash + 37u));
				vec3 gal_dir = normalize(vec3(cell) + offset);

				float mu = dot(dir, gal_dir);
				if (mu <= 0.998) continue;
				float sep_sq = 2.0 * max(0.0, 1.0 - mu);

				float size_rad = sample_distribution_gpu(pc.sky.galaxy_size_distribution, float(pc.sky.galaxy_size_min), float(pc.sky.galaxy_size_max), float(pc.sky.galaxy_size_param), cell_hash + 13u) * float(pc.sky.galaxy_size_scale);
				float size_sq = size_rad * size_rad;
				if (sep_sq > 9.0 * size_sq) continue;

				vec3 t1 = (abs(gal_dir.z) < 0.9) ? normalize(vec3(-gal_dir.y, gal_dir.x, 0.0)) : normalize(vec3(0.0, -gal_dir.z, gal_dir.y));
				vec3 t2 = cross(gal_dir, t1);

				float pos_angle = hash_to_float(cell_hash + 17u) * 6.2831853;
				vec3 u1 = t1 * cos(pos_angle) + t2 * sin(pos_angle);
				vec3 u2 = -t1 * sin(pos_angle) + t2 * cos(pos_angle);

				float inc_raw = hash_to_float(cell_hash + 23u);
				float cos_inc = clamp(1.0 - inc_raw * float(pc.sky.galaxy_inclination_variance), 0.12, 1.0);
				float sin_inc = sqrt(max(1.0 - cos_inc * cos_inc, 0.0));

				vec3 delta = dir - gal_dir;
				float x_obs = dot(delta, u1) / max(size_rad, 1e-6);
				float y_obs = dot(delta, u2) / max(size_rad, 1e-6);

				float x_disk = x_obs;
				float y_disk = y_obs / cos_inc;
				float r_disk = sqrt(x_disk * x_disk + y_disk * y_disk);
				float phi_disk = atan(y_disk, x_disk);

				uint morph = pc.sky.galaxy_morphology_model;
				if (morph == 0u) {
					float w1 = max(float(pc.sky.galaxy_weight_grand_design), 0.0);
					float w2 = max(float(pc.sky.galaxy_weight_flocculent), 0.0);
					float w3 = max(float(pc.sky.galaxy_weight_barred), 0.0);
					float w4 = max(float(pc.sky.galaxy_weight_elliptical), 0.0);
					float w5 = max(float(pc.sky.galaxy_weight_lenticular), 0.0);
					float w6 = max(float(pc.sky.galaxy_weight_ring), 0.0);
					float sum = w1 + w2 + w3 + w4 + w5 + w6;
					if (sum <= 1.0e-6) sum = 1.0;
					float pick = hash_to_float(cell_hash + 999u) * sum;
					if (pick < w1) morph = 1u;
					else if (pick < w1 + w2) morph = 2u;
					else if (pick < w1 + w2 + w3) morph = 3u;
					else if (pick < w1 + w2 + w3 + w4) morph = 4u;
					else if (pick < w1 + w2 + w3 + w4 + w5) morph = 5u;
					else morph = 6u;
				}

				float core = 0.0;
				float disk = 0.0;
				vec3 tint_core = vec3(1.25, 1.05, 0.70);
				vec3 tint_disk = vec3(0.65, 0.85, 1.35);

				if (morph == 4u) {
					float sersic_b = 2.0 * float(pc.sky.galaxy_bulge_sersic_index) - 0.333333;
					float sersic_arg = sersic_b * pow(r_disk, 1.0 / float(pc.sky.galaxy_bulge_sersic_index));
					core = exp(-clamp(sersic_arg, 0.0, 30.0));
					disk = 0.0;
					tint_core = vec3(1.35, 1.00, 0.65);
				} else if (morph == 5u) {
					core = exp(-r_disk * 3.5);
					disk = exp(-r_disk * 1.8);
					float ring_dist = abs(r_disk - 0.65);
					float dust_ring = (1.0 - exp(-ring_dist * ring_dist / 0.008)) * float(pc.sky.galaxy_dust_lane_opacity);
					disk *= (1.0 - dust_ring);
					tint_core = vec3(1.20, 1.05, 0.80);
					tint_disk = vec3(0.95, 0.95, 0.90);
				} else if (morph == 3u) {
					core = exp(-r_disk * r_disk * 6.0);
					float bar_len = 0.55 * clamp(float(pc.sky.galaxy_bar_strength), 0.1, 2.0);
					float bar_w = 0.15;
					float bar_profile = exp(-(x_disk * x_disk) / (2.0 * bar_len * bar_len) - (y_disk * y_disk) / (2.0 * bar_w * bar_w));
					float arms = 0.5 + 0.5 * cos(2.0 * (phi_disk - r_disk * 3.5 * float(pc.sky.galaxy_pitch_angle)));
					disk = (bar_profile * 0.7 + exp(-r_disk * 2.2) * arms * 0.5);
				} else if (morph == 2u) {
					core = exp(-r_disk * 4.0);
					float clump_n = surface_fbm(vec3(x_disk * 6.0, y_disk * 6.0, float(cell_hash & 0xFFu)), 3u, 0.6);
					float floc_arms = 0.5 + 0.5 * cos(6.0 * phi_disk - r_disk * 7.0 * float(pc.sky.galaxy_pitch_angle) + clump_n * 2.5);
					disk = exp(-r_disk * 2.5) * floc_arms * (1.0 + float(pc.sky.galaxy_clumpiness) * clump_n);
				} else if (morph == 6u) {
					core = exp(-r_disk * r_disk * 8.0) * 1.2;
					float ring_rad = 0.70;
					float ring_thick = 0.12;
					float ring_diff = abs(r_disk - ring_rad);
					disk = exp(-(ring_diff * ring_diff) / (2.0 * ring_thick * ring_thick)) * 1.4;
					tint_disk = vec3(0.45, 0.80, 1.65);
				} else {
					core = exp(-r_disk * r_disk * 4.0);
					float arms = 0.5 + 0.5 * cos(float(pc.sky.galaxy_spiral_arms) * phi_disk - r_disk * 4.8 * float(pc.sky.galaxy_pitch_angle));
					disk = exp(-r_disk * 2.2) * arms;
				}

				if (morph != 4u && pc.sky.galaxy_dust_lane_opacity > 0.0) {
					float near_side = y_obs * sin_inc;
					if (near_side > 0.0) {
						float dust_lane = exp(-abs(near_side - 0.18) * 9.0) * float(pc.sky.galaxy_dust_lane_opacity);
						core *= (1.0 - dust_lane * 0.85);
						disk *= (1.0 - dust_lane * 0.65);
					}
				}

				float c_ratio = clamp(float(pc.sky.galaxy_core_ratio), 0.0, 1.0);
				float final_int = (core * c_ratio + disk * (1.0 - c_ratio)) * float(pc.sky.galaxy_brightness) * 1.6;

				float warm_hash = hash_to_float(cell_hash + 29u);
				float tint_mod = 0.8 + 0.4 * warm_hash;

				accum += final_int * (c_ratio * tint_core + (1.0 - c_ratio) * tint_disk) * vec3(tint_mod, 1.0, 2.0 - tint_mod);
			}
		}
	}
	return accum;
}

vec3 sample_dust_clouds_gpu(vec3 dir) {
	if (pc.sky.dust_enabled == 0u || pc.sky.dust_intensity <= 0.0) return vec3(0.0);
	float eff_qual = max(float(pc.sky.quality_factor * pc.sky.dust_quality_factor), 0.05);
	float scale = clamp(float(pc.sky.dust_scale), 0.2, 8.0);
	int octaves = clamp(int(float(pc.sky.dust_fractal_octaves) * eff_qual + 0.5), 1, 6);
	float seed_f = float(pc.sky.seed % 4096u) * 0.77;

	float d_val = surface_fbm(dir * scale + vec3(seed_f, -53.0, seed_f * 0.5), uint(octaves), 0.55);
	float threshold = clamp(1.0 - 0.2 * float(pc.sky.dust_density), 0.0, 0.95);

	if (d_val > threshold) {
		float normalized = (d_val - threshold) / (1.0 - threshold);
		float lum = pow(normalized, float(pc.sky.dust_contrast)) * float(pc.sky.dust_intensity) * 0.35;
		vec3 tint = vec3(pc.sky.dust_tint[0], pc.sky.dust_tint[1], pc.sky.dust_tint[2]);
		return tint * lum;
	}
	return vec3(0.0);
}

vec3 sample_star_clusters_gpu(vec3 dir, float fov_rad) {
	if (pc.sky.clusters_enabled == 0u || pc.sky.cluster_density <= 0.0) return vec3(0.0);
	float eff_qual = max(float(pc.sky.quality_factor * pc.sky.cluster_quality_factor), 0.05);
	float base_density = max(float(pc.sky.cluster_density), 0.01);
	float grid_res = clamp(6.0 * sqrt(base_density), 3.0, 24.0);

	vec3 p = dir * grid_res;
	ivec3 c = ivec3(floor(p));
	uint base_seed = pc.sky.seed ^ 0xbb67ae85u;
	float presence_thresh = clamp(1.0 - base_density * 0.15, 0.01, 0.99);

	vec3 plane_norm = vec3(pc.sky.nebula_plane_normal[0], pc.sky.nebula_plane_normal[1], pc.sky.nebula_plane_normal[2]);
	float pn_len = length(plane_norm);
	plane_norm = (pn_len > 1e-6) ? (plane_norm / pn_len) : vec3(0.0, 0.4472136, 0.8944272);

	vec3 asym_dir = vec3(pc.sky.nebula_asymmetry_dir[0], pc.sky.nebula_asymmetry_dir[1], pc.sky.nebula_asymmetry_dir[2]);
	float an_len = length(asym_dir);
	asym_dir = (an_len > 1e-6) ? (asym_dir / an_len) : vec3(0.7071068, 0.0, 0.7071068);

	float pixel_footprint = fov_rad / 1080.0;
	vec3 core_tint = vec3(pc.sky.cluster_core_tint[0], pc.sky.cluster_core_tint[1], pc.sky.cluster_core_tint[2]);
	vec3 accum = vec3(0.0);

	for (int dz = -1; dz <= 1; ++dz) {
		for (int dy = -1; dy <= 1; ++dy) {
			for (int dx = -1; dx <= 1; ++dx) {
				ivec3 cell = c + ivec3(dx, dy, dz);
				uint cell_hash = uint(cell.x * 73856093 ^ cell.y * 19349663 ^ cell.z * 83492791) ^ base_seed;
				if (hash_to_float(cell_hash) > presence_thresh) continue;

				vec3 offset = vec3(hash_to_float(cell_hash + 5u), hash_to_float(cell_hash + 9u), hash_to_float(cell_hash + 13u));
				vec3 cl_center = normalize(vec3(cell) + offset);

				if (pc.sky.cluster_placement_model == 0u) {
					float cos_gc = dot(cl_center, asym_dir);
					float prob_gc = 1.0 / (1.0 + (1.0 - cos_gc) / max(float(pc.sky.cluster_halo_radius * pc.sky.cluster_halo_radius), 0.04));
					if (hash_to_float(cell_hash + 99u) > prob_gc) continue;
				} else if (pc.sky.cluster_placement_model == 1u) {
					float h_cl = dot(cl_center, plane_norm);
					float prob_pl = exp(-(h_cl * h_cl) / max(float(pc.sky.cluster_plane_scale_height * pc.sky.cluster_plane_scale_height), 0.005));
					if (hash_to_float(cell_hash + 99u) > prob_pl) continue;
				}

				float mu = dot(dir, cl_center);
				if (mu <= 0.998) continue;
				float sep_sq = 2.0 * max(0.0, 1.0 - mu);

				float cl_rad = sample_distribution_gpu(pc.sky.cluster_size_distribution, float(pc.sky.cluster_size_min), float(pc.sky.cluster_size_max), 1.5, cell_hash + 17u) * float(pc.sky.cluster_size_scale);
				float rad_sq = cl_rad * cl_rad;
				if (sep_sq > 9.0 * rad_sq) continue;

				if (pc.sky.cluster_halo_intensity > 0.0) {
					float core_denom = rad_sq * 0.40 * max(float(pc.sky.cluster_spread_factor), 0.1);
					float plummer = 1.0 / pow(1.0 + sep_sq / max(core_denom, 1e-7), float(pc.sky.cluster_concentration));
					float flux = plummer * float(pc.sky.cluster_brightness) * clamp(float(pc.sky.cluster_halo_intensity), 0.0, 2.0) * 0.75;
					accum += core_tint * flux;
				}

				if (pc.sky.cluster_stars_enabled != 0u && pc.sky.cluster_member_count > 0u) {
					vec3 u1 = (abs(cl_center.z) < 0.9) ? normalize(vec3(-cl_center.y, cl_center.x, 0.0)) : normalize(vec3(0.0, -cl_center.z, cl_center.y));
					vec3 u2 = cross(cl_center, u1);

					uint members = clamp(uint(float(pc.sky.cluster_member_count) * eff_qual), 4u, 96u);
					float r_core = cl_rad * 0.50 * max(float(pc.sky.cluster_spread_factor), 0.1);
					uint prof_model = (pc.sky.cluster_inherit_star_profile != 0u) ? pc.sky.star_profile_model : pc.sky.cluster_star_profile_model;

					for (uint mi = 0u; mi < members; ++mi) {
						uint m_hash = cell_hash ^ (mi * 0x3c6ef372u);
						float u_rad = clamp(hash_to_float(m_hash), 0.001, 0.96);
						float r_m = r_core * sqrt(pow(u_rad, 0.666667) / max(1.0 - pow(u_rad, 0.666667), 1e-4));
						float phi_m = 6.2831853 * hash_to_float(m_hash + 13u);
						float dx_m = r_m * cos(phi_m);
						float dy_m = r_m * sin(phi_m);

						vec3 m_dir = normalize(cl_center + u1 * dx_m + u2 * dy_m);
						float mu_m = dot(dir, m_dir);
						if (mu_m <= 0.9994) continue;
						float theta_sq_m = 2.0 * max(0.0, 1.0 - mu_m);
						float m_rad = max(float(pc.sky.cluster_member_size), 1e-6);
						float eff_sigma_m = sqrt(m_rad * m_rad + pixel_footprint * pixel_footprint * 0.25);
						float eff_sigma_sq_m = eff_sigma_m * eff_sigma_m;
						if (theta_sq_m > 16.0 * eff_sigma_sq_m) continue;

						float psf_m = evaluate_star_psf_gpu(theta_sq_m, eff_sigma_m, eff_sigma_sq_m, pixel_footprint, dx_m, dy_m, prof_model);
						float m_lum = (0.5 + 1.5 * hash_to_float(m_hash + 29u)) * float(pc.sky.cluster_member_brightness);
						float temp_m = clamp(hash_to_float(m_hash + 43u) + float(pc.sky.star_temperature_bias) * 0.4, 0.0, 1.0);
						vec3 tint_m = mix(vec3(1.0), (temp_m < 0.5 ? vec3(1.4, 0.8, 0.5) : vec3(0.7, 0.9, 1.4)), float(pc.sky.star_color_variation));
						accum += core_tint * (m_lum * psf_m) * tint_m;
					}
				}
			}
		}
	}
	return accum;
}

vec3 sample_volumetric_nebulae_gpu(vec3 dir, float zoom_factor) {
	if (pc.sky.nebula_enabled == 0u || pc.sky.nebula_intensity <= 0.0) return vec3(0.0);
	vec3 plane_norm = vec3(pc.sky.nebula_plane_normal[0], pc.sky.nebula_plane_normal[1], pc.sky.nebula_plane_normal[2]);
	float pn_len = length(plane_norm);
	plane_norm = (pn_len > 1e-6) ? (plane_norm / pn_len) : vec3(0.0, 0.4472136, 0.8944272);

	float h = dot(dir, plane_norm);
	float thickness = max(float(pc.sky.nebula_plane_thickness), 0.02);
	float falloff_exp = clamp(float(pc.sky.nebula_plane_falloff), 1.0, 6.0);
	float disc_envelope = exp(-pow(abs(h) / thickness, falloff_exp));

	vec3 asym_dir = vec3(pc.sky.nebula_asymmetry_dir[0], pc.sky.nebula_asymmetry_dir[1], pc.sky.nebula_asymmetry_dir[2]);
	float an_len = length(asym_dir);
	asym_dir = (an_len > 1e-6) ? (asym_dir / an_len) : vec3(0.7071068, 0.0, 0.7071068);

	float cos_psi = dot(dir, asym_dir);
	float asymmetry = pow(clamp((1.0 + cos_psi) * 0.5, 0.0, 1.0), clamp(float(pc.sky.nebula_asymmetry) * 2.5 + 0.1, 0.1, 8.0));
	float core_glow = float(pc.sky.nebula_core_glow) * exp(-2.5 * max(0.0, 1.0 - cos_psi));

	float eff_qual = max(float(pc.sky.quality_factor * pc.sky.nebula_quality_factor), 0.05);
	int octaves = clamp(int(float(pc.sky.nebula_octaves) * sqrt(eff_qual)), 1, 8);
	if (pc.sky.adaptive_fov_quality != 0u && zoom_factor > 1.2) {
		octaves = min(8, octaves + int(floor(log2(zoom_factor))));
	}

	float freq = float(pc.sky.nebula_frequency);
	float rough = clamp(float(pc.sky.nebula_roughness), 0.1, 0.95);
	float seed_f = float(pc.sky.seed % 1024u) * 1.37;
	vec3 d = dir;

	if (pc.sky.nebula_curl_strength > 0.01) {
		float cs = float(pc.sky.nebula_curl_strength) * 0.25;
		d += vec3(body_value_noise(vec3(d.yz * 2.0, seed_f)), body_value_noise(vec3(d.zx * 2.0, seed_f + 7.1)), body_value_noise(vec3(d.xy * 2.0, seed_f + 13.3))) * cs;
		d = normalize(d);
	}

	uint layers = clamp(uint(float(pc.sky.nebula_layer_count) * eff_qual + 0.4), 1u, 5u);
	vec3 total_emission = vec3(0.0);
	float sep = clamp(float(pc.sky.nebula_color_separation), 0.5, 3.0);
	float gas_contrast = clamp(float(pc.sky.nebula_gas_contrast), 0.5, 3.0);
	float ion_glow = clamp(float(pc.sky.nebula_ionization_glow), 0.0, 3.0);

	vec3 col1 = vec3(pc.sky.nebula_emission_color[0], pc.sky.nebula_emission_color[1], pc.sky.nebula_emission_color[2]);
	vec3 col2 = vec3(pc.sky.nebula_secondary_color[0], pc.sky.nebula_secondary_color[1], pc.sky.nebula_secondary_color[2]);
	vec3 col3 = vec3(pc.sky.nebula_tertiary_color[0], pc.sky.nebula_tertiary_color[1], pc.sky.nebula_tertiary_color[2]);

	for (uint l = 0u; l < layers; ++l) {
		float l_off = float(l) * 17.3 * float(pc.sky.nebula_layer_spread);
		float l_scale = 1.0 + float(l) * 0.75 * float(pc.sky.nebula_layer_spread);

		float n1 = surface_fbm(d * freq * l_scale + vec3(seed_f + l_off, -seed_f * 0.7, 13.5 + l_off), uint(octaves), rough);
		float e1 = pow(max(0.0, (n1 + 0.18) * 1.05), 1.8 * gas_contrast);

		float n2 = surface_fbm(d * freq * 1.85 * l_scale + vec3(-27.1 + l_off * sep, seed_f * 0.5, -11.2), uint(octaves), rough);
		float e2 = pow(max(0.0, (n2 + 0.12) * 1.10), 2.2 * gas_contrast) * ion_glow;

		float n3 = surface_fbm(d * freq * 2.7 * l_scale + vec3(43.0, l_off * sep * 1.3, -seed_f), uint(octaves), rough);
		float e3 = pow(max(0.0, (n3 + 0.05) * 0.95), 2.4 * gas_contrast);

		float weight = 1.0 / (1.0 + 0.45 * float(l));
		total_emission += (col1 * e1 + col2 * e2 * 0.35 + col3 * e3) * weight;
	}

	float n_dust = float(body_fbm(dvec3(d * freq * 2.6 + vec3(71.3, -39.4, seed_f)), uint(octaves), 0.6));
	float tau = max(0.0, n_dust - 0.26) * float(pc.sky.nebula_absorption_density * 2.6);
	float extinction = exp(-tau);

	float envelope = (disc_envelope * asymmetry + core_glow) * extinction * float(pc.sky.nebula_intensity * pc.sky.nebula_quality_factor);
	return total_emission * envelope;
}

double body_fbm(dvec3 p, uint octaves, double roughness);

vec3 sample_quasars_gpu(vec3 dir) {
	if (pc.sky.quasar_enabled == 0u || pc.sky.quasar_density <= 0.0) return vec3(0.0);
	float grid_res = clamp(6.0 * sqrt(clamp(float(pc.sky.quasar_density), 0.01, 10.0)), 4.0, 36.0);

	vec3 p = dir * grid_res;
	ivec3 c = ivec3(floor(p));
	uint base_seed = pc.sky.seed ^ 0x9b05688cu;
	float presence_thresh = clamp(1.0 - float(pc.sky.quasar_density) * 0.06, 0.05, 0.99);

	vec3 accum = vec3(0.0);
	for (int dz = -1; dz <= 1; ++dz) {
		for (int dy = -1; dy <= 1; ++dy) {
			for (int dx = -1; dx <= 1; ++dx) {
				ivec3 cell = c + ivec3(dx, dy, dz);
				uint cell_hash = uint(cell.x * 73856093 ^ cell.y * 19349663 ^ cell.z * 83492791) ^ base_seed;
				if (hash_to_float(cell_hash) <= presence_thresh) continue;

				vec3 offset = vec3(hash_to_float(cell_hash + 11u), hash_to_float(cell_hash + 23u), hash_to_float(cell_hash + 37u));
				vec3 q_dir = normalize(vec3(cell) + offset);

				float mu = dot(dir, q_dir);
				if (mu <= 0.985) continue;
				float sep_sq = 2.0 * max(0.0, 1.0 - mu);

				float j_theta = hash_to_float(cell_hash + 41u) * PI_F;
				float j_phi = hash_to_float(cell_hash + 47u) * (2.0 * PI_F);
				vec3 jet_axis = vec3(sin(j_theta) * cos(j_phi), sin(j_theta) * sin(j_phi), cos(j_theta));

				float cos_view = abs(dot(dir, jet_axis));
				float gamma = max(float(pc.sky.quasar_jet_lorentz_factor), 1.05);
				float beta = sqrt(1.0 - 1.0 / (gamma * gamma));
				float doppler = clamp(1.0 / (gamma * (1.0 - beta * cos_view)), 0.1, 10.0);
				float boost = doppler * doppler * doppler;

				float core_rad = max(float(pc.sky.quasar_core_size), 0.0001);
				float core_flux = exp(-sep_sq / (2.0 * core_rad * core_rad)) * float(pc.sky.quasar_brightness) * 1.5;

				vec3 delta = dir - q_dir;
				float d_dot_jet = dot(delta, jet_axis);
				float perp_sq = max(sep_sq - d_dot_jet * d_dot_jet, 0.0);
				float jet_len = max(float(pc.sky.quasar_jet_length), 0.005);
				float open_rad = max(float(pc.sky.quasar_jet_opening_angle_deg), 1.0) * (PI_F / 180.0);
				float jet_w = core_rad + abs(d_dot_jet) * tan(open_rad);
				float jet_prof = exp(-perp_sq / (2.0 * jet_w * jet_w)) * exp(-abs(d_dot_jet) / jet_len);
				float knot = 0.8 + 0.2 * cos(abs(d_dot_jet) * 160.0);
				float jet_flux = jet_prof * knot * float(pc.sky.quasar_jet_intensity * pc.sky.quasar_brightness) * boost * 0.4;

				float max_supp = max(jet_len * 2.0, core_rad * 8.0);
				float window = clamp(1.0 - sep_sq / (max_supp * max_supp), 0.0, 1.0);
				float total = (core_flux + jet_flux) * window * window;
				accum += vec3(total * 0.90, total * 1.10, total * 1.60);
			}
		}
	}
	return accum;
}

vec3 sample_pulsars_gpu(vec3 dir) {
	if (pc.sky.pulsar_enabled == 0u || pc.sky.pulsar_brightness <= 0.0) return vec3(0.0);
	float grid_res = clamp(6.0 * sqrt(clamp(float(pc.sky.pulsar_density), 0.01, 10.0)), 4.0, 36.0);

	vec3 p = dir * grid_res;
	ivec3 c = ivec3(floor(p));
	uint base_seed = pc.sky.seed ^ 0x4f1bbcdu;
	float presence_thresh = clamp(1.0 - float(pc.sky.pulsar_density) * 0.06, 0.05, 0.99);

	vec3 accum = vec3(0.0);
	for (int dz = -1; dz <= 1; ++dz) {
		for (int dy = -1; dy <= 1; ++dy) {
			for (int dx = -1; dx <= 1; ++dx) {
				ivec3 cell = c + ivec3(dx, dy, dz);
				uint cell_hash = uint(cell.x * 73856093 ^ cell.y * 19349663 ^ cell.z * 83492791) ^ base_seed;
				if (hash_to_float(cell_hash) <= presence_thresh) continue;

				vec3 offset = vec3(hash_to_float(cell_hash + 11u), hash_to_float(cell_hash + 23u), hash_to_float(cell_hash + 37u));
				vec3 p_dir = normalize(vec3(cell) + offset);

				float mu = dot(dir, p_dir);
				if (mu <= 0.996) continue;
				float sep_sq = 2.0 * max(0.0, 1.0 - mu);

				float spin_t = hash_to_float(cell_hash + 49u) * PI_F;
				float spin_p = hash_to_float(cell_hash + 53u) * (2.0 * PI_F);
				vec3 spin_axis = vec3(sin(spin_t) * cos(spin_p), sin(spin_t) * sin(spin_p), cos(spin_t));

				float tilt_rad = float(pc.sky.pulsar_magnetic_tilt_deg) * (PI_F / 180.0);
				float freq_jitter = exp((hash_to_float(cell_hash + 83u) - 0.5) * float(pc.sky.pulsar_frequency_spread) * 2.0);
				float local_rate = float(pc.sky.pulsar_pulse_rate) * freq_jitter;
				float sweep_phase = mod(float(pc.sky.time_seconds) * local_rate + hash_to_float(cell_hash + 61u), 1.0) * (2.0 * PI_F);

				vec3 u1 = (abs(spin_axis.z) < 0.9) ? normalize(vec3(-spin_axis.y, spin_axis.x, 0.0)) : normalize(vec3(0.0, -spin_axis.z, spin_axis.y));
				vec3 u2 = cross(spin_axis, u1);

				vec3 beam_vec = cos(tilt_rad) * spin_axis + sin(tilt_rad) * (cos(sweep_phase) * u1 + sin(sweep_phase) * u2);
				float mu_beam = abs(dot(dir, beam_vec));
				float beam_rad = max(float(pc.sky.pulsar_beam_width_deg), 0.5) * (PI_F / 180.0);
				float beam_sep_sq = 2.0 * max(0.0, 1.0 - mu_beam);
				float beam_duty = exp(-beam_sep_sq / (2.0 * beam_rad * beam_rad));

				float core_rad = 0.0004;
				float core = exp(-sep_sq / (2.0 * core_rad * core_rad)) * float(pc.sky.pulsar_brightness) * 1.8;

				float pwn_scale = max(float(pc.sky.pulsar_wind_nebula_scale), 0.0005);
				vec3 delta = dir - p_dir;
				float d_dot_s = dot(delta, spin_axis);
				float pwn_perp_sq = max(sep_sq - d_dot_s * d_dot_s, 0.0);
				float pwn_torus = exp(-pwn_perp_sq / (2.0 * pwn_scale * pwn_scale)) * exp(-abs(d_dot_s) / (pwn_scale * 0.4));
				float pwn_flux = pwn_torus * float(pc.sky.pulsar_wind_nebula_intensity * pc.sky.pulsar_brightness) * 0.5;

				float total = (core * beam_duty + pwn_flux);
				accum += vec3(total * 0.70, total * 1.30, total * 1.15);
			}
		}
	}
	return accum;
}

vec3 sample_supernova_remnants_gpu(vec3 dir) {
	if (pc.sky.snr_enabled == 0u || pc.sky.snr_brightness <= 0.0) return vec3(0.0);
	float grid_res = clamp(6.0 * sqrt(clamp(float(pc.sky.snr_density), 0.01, 10.0)), 4.0, 36.0);

	vec3 p = dir * grid_res;
	ivec3 c = ivec3(floor(p));
	uint base_seed = pc.sky.seed ^ 0x7a31b9efu;
	float presence_thresh = clamp(1.0 - float(pc.sky.snr_density) * 0.06, 0.05, 0.99);

	vec3 accum = vec3(0.0);
	for (int dz = -1; dz <= 1; ++dz) {
		for (int dy = -1; dy <= 1; ++dy) {
			for (int dx = -1; dx <= 1; ++dx) {
				ivec3 cell = c + ivec3(dx, dy, dz);
				uint cell_hash = uint(cell.x * 73856093 ^ cell.y * 19349663 ^ cell.z * 83492791) ^ base_seed;
				if (hash_to_float(cell_hash) <= presence_thresh) continue;

				vec3 offset = vec3(hash_to_float(cell_hash + 11u), hash_to_float(cell_hash + 23u), hash_to_float(cell_hash + 37u));
				vec3 snr_dir = normalize(vec3(cell) + offset);

				float mu = dot(dir, snr_dir);
				if (mu <= 0.992) continue;
				float sep_sq = 2.0 * max(0.0, 1.0 - mu);

				float morph_rnd = hash_to_float(cell_hash + 67u);
				vec3 elong_axis = vec3(hash_to_float(cell_hash + 71u) - 0.5, hash_to_float(cell_hash + 73u) - 0.5, hash_to_float(cell_hash + 79u) - 0.5);
				float el_len = max(length(elong_axis), 1e-6);
				elong_axis /= el_len;
				float elong_proj = dot(dir - snr_dir, elong_axis);
				float elong_scale = 1.0 + (morph_rnd - 0.5) * float(pc.sky.snr_morphology_variety) * 1.1;

				float base_rad = max(float(pc.sky.snr_size) * (0.8 + 0.4 * float(pc.sky.snr_expansion_age)) * elong_scale, 0.003);
				float dist = sqrt(max(sep_sq + elong_proj * elong_proj * (elong_scale * elong_scale - 1.0), 0.0));
				if (dist > base_rad * 2.2) continue;

				float turb = surface_fbm(dir * float(pc.sky.snr_filament_scale) * 30.0, 3u, 0.6);
				float pert_rad = base_rad * (1.0 + float(pc.sky.snr_asymmetry) * 0.35 * turb);
				float shell_thick = max(float(pc.sky.snr_shell_thickness) * base_rad, 0.0005);
				float diff = abs(dist - pert_rad);
				float shell_exp = exp(-(diff * diff) / (2.0 * shell_thick * shell_thick));
				float shell_flux = shell_exp * float(pc.sky.snr_brightness) * 1.5;

				float interior_boost = (morph_rnd > 0.5) ? 1.6 : 0.4;
				float interior_flux = (dist < pert_rad)
					? (exp(-dist / pert_rad) * float(pc.sky.snr_interior_glow * pc.sky.snr_brightness) * interior_boost)
					: 0.0;

				float max_rad = base_rad * 1.6;
				float window = clamp(1.0 - sep_sq / (max_rad * max_rad), 0.0, 1.0);
				float hermite = window * window;

				float col_seed = hash_to_float(cell_hash + 83u);
				vec3 var_shell = (col_seed < 0.33) ? vec3(0.45, 1.45, 1.05) : ((col_seed < 0.66) ? vec3(1.65, 0.40, 0.55) : vec3(1.45, 1.15, 0.35));
				vec3 var_int = (col_seed < 0.33) ? vec3(0.25, 0.85, 1.45) : ((col_seed < 0.66) ? vec3(1.35, 0.70, 0.30) : vec3(0.95, 0.40, 1.35));

				float c_var = clamp(float(pc.sky.snr_color_variation), 0.0, 2.0);
				vec3 shell_col = mix(vec3(pc.sky.snr_shell_color[0], pc.sky.snr_shell_color[1], pc.sky.snr_shell_color[2]), var_shell, 0.5 * c_var);
				vec3 int_col = mix(vec3(pc.sky.snr_interior_color[0], pc.sky.snr_interior_color[1], pc.sky.snr_interior_color[2]), var_int, 0.5 * c_var);

				accum += (shell_flux * shell_col + interior_flux * int_col) * hermite;
			}
		}
	}
	return accum;
}

vec3 sample_dust_clouds(dvec3 dir_d, uint seed, double density, double intensity, double scale) {
	if (density <= 0.0) return vec3(0.0);
	double freq = clamp(double(scale), 0.1, 10.0) * 2.2;
	double seed_offset = double(seed % 4096u) * 0.37;
	double n = body_fbm(dir_d * freq + dvec3(seed_offset, -seed_offset, seed_offset * 0.5), 4u, 0.55);
	double threshold = clamp(1.0 - 0.22 * clamp(double(density), 0.0, 4.0), -0.2, 0.98);
	if (n <= threshold) return vec3(0.0);

	float strength = float(clamp((n - threshold) / max(1.0 - threshold, 0.05), 0.0, 1.0));
	float shaped = strength * strength;

	double tint_noise = body_fbm(dir_d * freq * 0.5 + dvec3(91.0, -37.0, 13.0), 3u, 0.5);
	float tint_t = float(clamp((tint_noise + 1.0) * 0.5, 0.0, 1.0));
	float rr = 0.55 * (1.0 - tint_t) + 0.28 * tint_t;
	float gg = 0.22 * (1.0 - tint_t) + 0.16 * tint_t;
	float bb = 0.12 * (1.0 - tint_t) + 0.52 * tint_t;

	float lum = shaped * float(max(intensity, 0.0)) * 0.6;
	return vec3(rr * lum, gg * lum, bb * lum);
}

vec3 sample_star_clusters(vec3 dir, uint seed, double density, double brightness, double size_scale) {
	if (density <= 0.0) return vec3(0.0);
	float theta = acos(clamp(dir.z, -1.0, 1.0));
	float phi = atan(dir.y, dir.x);
	float u = (phi + PI_F) * (1.0 / (2.0 * PI_F));
	float v = theta * (1.0 / PI_F);

	const float grid_u = 90.0;
	const float grid_v = 45.0;
	float u_grid = u * grid_u;
	float v_grid = v * grid_v;
	int iu = int(floor(u_grid));
	int iv = int(floor(v_grid));
	uint cell_seed = uint(iu * 1274126177 ^ iv * 374761393u) ^ (seed * 2246822519u);

	float presence = hash_to_float(cell_seed);
	float threshold = clamp(1.0 - 0.06 * clamp(float(density), 0.0, 4.0), 0.0, 0.999);
	if (presence <= threshold) return vec3(0.0);

	vec3 total = vec3(0.0);
	float member_footprint = max(float(size_scale), 0.05) * 0.03;
	for (uint member = 0u; member < 7u; ++member) {
		uint member_seed = cell_seed + member * 97u;
		float off_u = hash_to_float(member_seed + 1u);
		float off_v = hash_to_float(member_seed + 2u);
		float du = (u_grid - float(iu)) - off_u;
		float dv = (v_grid - float(iv)) - off_v;
		float dist_sq = du * du + dv * dv;
		if (dist_sq > member_footprint) continue;

		float member_brightness = pow(hash_to_float(member_seed + 3u), 3.0) * 2.2;
		float falloff = exp(-dist_sq * (6.0 / max(member_footprint, 1e-6)));
		float lum = member_brightness * falloff * float(max(brightness, 0.0));
		total += vec3(lum, lum * 0.95, lum * 0.85);
	}
	return total;
}

vec3 sample_celestial_grid_gpu(vec3 dir, float fov_rad) {
	if (pc.sky.grid_enabled == 0u || (pc.sky.grid_opacity <= 0.0 && pc.sky.grid_cell_opacity <= 0.0)) return vec3(0.0);
	float d2r = PI_F / 180.0;
	float dec = asin(clamp(dir.z, -1.0, 1.0));
	float ra = atan(dir.y, dir.x);

	float spacing = max(float(pc.sky.grid_spacing_deg), 0.1) * d2r;
	float pixel_footprint = max(fov_rad / 1080.0, 1e-7);
	float cos_dec = max(cos(dec), 1e-4);

	vec3 accum_col = vec3(0.0);
	float accum_alpha = 0.0;

	if (pc.sky.grid_cell_fill_mode != 0u && pc.sky.grid_cell_opacity > 0.0) {
		float dec_shifted = dec + PI_F * 0.5;
		float ra_shifted = (ra < 0.0) ? (ra + 2.0 * PI_F) : ra;
		int cell_dec = int(floor(dec_shifted / spacing));
		int cell_ra = int(floor(ra_shifted / spacing));
		int num_cols = clamp(int(pc.sky.grid_cell_color_count), 1, 16);
		int picked_index = 0;

		if (pc.sky.grid_cell_fill_mode == 1u) {
			picked_index = ((cell_dec + cell_ra) % 2 + 2) % 2;
		} else if (pc.sky.grid_cell_fill_mode == 2u) {
			picked_index = ((cell_dec + 2 * cell_ra) % num_cols + num_cols) % num_cols;
		} else if (pc.sky.grid_cell_fill_mode == 3u) {
			int px = (cell_ra % 2 + 2) % 2;
			int py = (cell_dec % 2 + 2) % 2;
			picked_index = (px + 2 * py) % num_cols;
		} else if (pc.sky.grid_cell_fill_mode == 4u) {
			uint ch = uint((cell_dec + 10000) * 73856093 ^ (cell_ra + 10000) * 19349663) ^ (pc.sky.seed ^ 0x5a17u);
			float hval = hash_to_float(ch);
			picked_index = int(hval * float(num_cols)) % num_cols;
		}

		vec3 cell_color = pc.sky.grid_cell_colors[picked_index].rgb;
		float fill_a = clamp(float(pc.sky.grid_cell_opacity), 0.0, 1.0);
		accum_col = cell_color;
		accum_alpha = fill_a;
	}

	if (pc.sky.grid_opacity <= 0.0) {
		return accum_col * accum_alpha;
	}

	float feather = max(pixel_footprint * 0.6, 1e-8);
	float hw_maj = max(float(pc.sky.grid_major_width), pixel_footprint) * 0.5;
	float hw_min = max(float(pc.sky.grid_minor_width), pixel_footprint * 0.7) * 0.5;
	float hw_eq = max(float(pc.sky.grid_equator_width), pixel_footprint) * 0.5;
	float hw_pol = max(float(pc.sky.grid_polar_width), pixel_footprint) * 0.5;
	float hw_mer = max(float(pc.sky.grid_meridian_width), pixel_footprint) * 0.5;
	float hw_tick = max(float(pc.sky.grid_tick_width), pixel_footprint) * 0.5;

	float pole_taper = clamp((spacing * cos_dec - hw_maj * 0.5) / max(hw_maj * 2.5, 1e-6), 0.0, 1.0);

	float dist_dec = abs(mod(dec + spacing * 0.5, spacing) - spacing * 0.5);
	float cov_maj_dec = 1.0 - clamp((dist_dec - (hw_maj - feather)) / (2.0 * feather), 0.0, 1.0);
	float dist_ra = abs(mod(ra + spacing * 0.5, spacing) - spacing * 0.5) * cos_dec;
	float cov_maj_ra = (1.0 - clamp((dist_ra - (hw_maj - feather)) / (2.0 * feather), 0.0, 1.0)) * pole_taper;
	float cov_major = max(cov_maj_dec, cov_maj_ra);

	float cov_sub = 0.0;
	if (pc.sky.grid_subdivisions > 0u) {
		float sub_spacing = spacing / float(pc.sky.grid_subdivisions + 1u);
		float dist_sdec = abs(mod(dec + sub_spacing * 0.5, sub_spacing) - sub_spacing * 0.5);
		float cov_sdec = 1.0 - clamp((dist_sdec - (hw_min - feather)) / (2.0 * feather), 0.0, 1.0);
		float dist_sra = abs(mod(ra + sub_spacing * 0.5, sub_spacing) - sub_spacing * 0.5) * cos_dec;
		float sub_taper = clamp((sub_spacing * cos_dec - hw_min * 0.5) / max(hw_min * 2.5, 1e-6), 0.0, 1.0);
		float cov_sra = (1.0 - clamp((dist_sra - (hw_min - feather)) / (2.0 * feather), 0.0, 1.0)) * sub_taper;
		cov_sub = max(cov_sdec, cov_sra) * 0.75;
	}

	float cov_eq = (pc.sky.grid_show_equator != 0u)
		? (1.0 - clamp((abs(dec) - (hw_eq - feather)) / (2.0 * feather), 0.0, 1.0)) * clamp(float(pc.sky.grid_equator_opacity), 0.0, 1.0)
		: 0.0;

	float cov_pm = (pc.sky.grid_show_meridians != 0u)
		? (1.0 - clamp((abs(mod(ra + PI_F * 0.5, PI_F) - PI_F * 0.5) * cos_dec - (hw_mer - feather)) / (2.0 * feather), 0.0, 1.0)) * pole_taper * clamp(float(pc.sky.grid_meridian_opacity), 0.0, 1.0)
		: 0.0;

	float cov_cap = (pc.sky.grid_show_polar_caps != 0u)
		? (1.0 - clamp((abs(abs(dec) - (PI_F * 0.5 - spacing)) - (hw_pol - feather)) / (2.0 * feather), 0.0, 1.0)) * clamp(float(pc.sky.grid_polar_opacity), 0.0, 1.0)
		: 0.0;

	float cov_ticks = 0.0;
	if (pc.sky.grid_show_ticks != 0u) {
		float tick_spacing = max(float(pc.sky.grid_tick_interval_deg), 0.1) * d2r;
		float tick_extent = max(float(pc.sky.grid_tick_length), pixel_footprint * 2.0);
		if (abs(dec) < tick_extent) {
			float dist_tick_ra = abs(mod(ra + tick_spacing * 0.5, tick_spacing) - tick_spacing * 0.5) * cos_dec;
			float cov_t = (1.0 - clamp((dist_tick_ra - (hw_tick - feather)) / (2.0 * feather), 0.0, 1.0))
				* (1.0 - clamp((abs(dec) - (tick_extent - feather)) / (2.0 * feather), 0.0, 1.0));
			cov_ticks = max(cov_ticks, cov_t);
		}
		if (abs(mod(ra + PI_F * 0.5, PI_F * 0.5) - PI_F * 0.25) * cos_dec < tick_extent) {
			float dist_tick_dec = abs(mod(dec + tick_spacing * 0.5, tick_spacing) - tick_spacing * 0.5);
			float cov_t = (1.0 - clamp((dist_tick_dec - (hw_tick - feather)) / (2.0 * feather), 0.0, 1.0))
				* (1.0 - clamp((abs(mod(ra + PI_F * 0.5, PI_F * 0.5) - PI_F * 0.25) * cos_dec - (tick_extent - feather)) / (2.0 * feather), 0.0, 1.0));
			cov_ticks = max(cov_ticks, cov_t * pole_taper);
		}
	}

	float glow_radius = max(hw_maj * 6.0, pixel_footprint * 4.0);
	float glow_dec = exp(-dist_dec * dist_dec / (2.0 * glow_radius * glow_radius));
	float glow_ra = exp(-dist_ra * dist_ra / (2.0 * glow_radius * glow_radius)) * pole_taper;
	float glow = max(glow_dec, glow_ra) * clamp(float(pc.sky.grid_glow), 0.0, 10.0);

	#define APPLY_GRID_LAYER(cov, col_arr, boost) \
		if (cov > 0.0) { \
			float a = clamp(cov * float(pc.sky.grid_opacity), 0.0, 1.0); \
			vec3 c = vec3(col_arr[0], col_arr[1], col_arr[2]) * boost; \
			accum_col = mix(accum_col, c, a); \
			accum_alpha = accum_alpha + a * (1.0 - accum_alpha); \
		}

	APPLY_GRID_LAYER(cov_sub, pc.sky.grid_minor_color, 0.85);
	APPLY_GRID_LAYER(cov_major, pc.sky.grid_major_color, 1.0 + glow);
	APPLY_GRID_LAYER(cov_cap, pc.sky.grid_polar_color, 1.1);
	APPLY_GRID_LAYER(cov_pm, pc.sky.grid_meridian_color, 1.15);
	APPLY_GRID_LAYER(cov_eq, pc.sky.grid_equator_color, 1.2);
	APPLY_GRID_LAYER(cov_ticks, pc.sky.grid_tick_color, 1.3);

	#undef APPLY_GRID_LAYER

	return accum_col * clamp(accum_alpha, 0.0, 1.0);
}

vec3 apply_hue_saturation(vec3 rgb, double hue_shift_rad, double saturation) {
	if (hue_shift_rad == 0.0 && saturation == 1.0) return rgb;
	float r = rgb.r, g = rgb.g, b = rgb.b;
	float max_c = max(r, max(g, b));
	float min_c = min(r, min(g, b));
	float delta = max_c - min_c;
	float h = 0.0;
	if (delta > 1e-8) {
		if (max_c == r) h = mod((g - b) / delta, 6.0);
		else if (max_c == g) h = (b - r) / delta + 2.0;
		else h = (r - g) / delta + 4.0;
		h *= 60.0;
		if (h < 0.0) h += 360.0;
	}
	float s_val = (max_c > 1e-8) ? (delta / max_c) : 0.0;
	float v_val = max_c;

	h += float(hue_shift_rad * (180.0 / PI_D));
	h = mod(h, 360.0);
	if (h < 0.0) h += 360.0;
	float s_new = clamp(s_val * float(saturation), 0.0, 1.0);

	float c_val = v_val * s_new;
	float x_val = c_val * (1.0 - abs(mod(h / 60.0, 2.0) - 1.0));
	float m_val = v_val - c_val;

	float r2 = 0.0, g2 = 0.0, b2 = 0.0;
	if (h < 60.0) { r2 = c_val; g2 = x_val; b2 = 0.0; }
	else if (h < 120.0) { r2 = x_val; g2 = c_val; b2 = 0.0; }
	else if (h < 180.0) { r2 = 0.0; g2 = c_val; b2 = x_val; }
	else if (h < 240.0) { r2 = 0.0; g2 = x_val; b2 = c_val; }
	else if (h < 300.0) { r2 = x_val; g2 = 0.0; b2 = c_val; }
	else { r2 = c_val; g2 = 0.0; b2 = x_val; }

	return vec3(r2 + m_val, g2 + m_val, b2 + m_val);
}

vec3 sample_panorama(vec3 dir) {
	float len = length(dir);
	if (len < 1e-12) return vec3(0.0);
	float theta = acos(clamp(dir.z / len, -1.0, 1.0));
	float phi = atan(dir.y, dir.x);
	float u = (phi + PI_F) * (1.0 / (2.0 * PI_F));
	float v = theta * (1.0 / PI_F);
	return textureLod(panorama_sampler, vec2(u, clamp(v, 0.0, 1.0)), 0.0).rgb;
}

vec3 sky_rotate_vector(vec3 v, float yaw_deg, float pitch_deg, float roll_deg) {
	float d2r = PI_F / 180.0;
	float cy = cos(yaw_deg * d2r);
	float sy = sin(yaw_deg * d2r);
	float cp = cos(pitch_deg * d2r);
	float sp = sin(pitch_deg * d2r);
	float cr = cos(roll_deg * d2r);
	float sr = sin(roll_deg * d2r);

	float x1 = v.x * cy - v.y * sy;
	float y1 = v.x * sy + v.y * cy;
	float z1 = v.z;

	float x2 = x1 * cp + z1 * sp;
	float y2 = y1;
	float z2 = -x1 * sp + z1 * cp;

	return vec3(x2, y2 * cr - z2 * sr, y2 * sr + z2 * cr);
}

vec3 compute_sky_radiance(dvec3 dir_d, double sky_rotation_rad) {
	if (pc.sky.enabled == 0u) return vec3(0.0);
	vec3 unit_dir = normalize(vec3(dir_d));

	float yaw = float(pc.sky.orientation_yaw_deg);
	if (pc.sky.dynamic_rotation != 0u) {
		yaw = mod(yaw + float(pc.sky.rotation_rate_deg_s) * float(pc.sky.time_seconds), 360.0);
	}
	vec3 dir = sky_rotate_vector(unit_dir, yaw, float(pc.sky.orientation_pitch_deg), float(pc.sky.orientation_roll_deg));

	if (pc.sky_background_source != 0u && pc.sky_panorama_width > 0u && pc.sky_panorama_height > 0u) {
		vec3 panorama_rgb = sample_panorama(dir);
		panorama_rgb = apply_hue_saturation(panorama_rgb, pc.sky.hue_shift_deg * (PI_D / 180.0), pc.sky.saturation);
		vec3 bg = vec3(pc.sky.background_color[0], pc.sky.background_color[1], pc.sky.background_color[2]);
		return max((panorama_rgb + bg) * float(pc.sky.master_intensity), vec3(0.0));
	}

	float fov_deg = float(pc.field_of_view_rad * (180.0 / PI_D));
	float zoom_factor = clamp(float(pc.sky.adaptive_fov_reference) / max(fov_deg, 0.05), 1.0, 128.0);
	float fov_rad = float(pc.field_of_view_rad);

	vec3 accum = vec3(pc.sky.background_color[0], pc.sky.background_color[1], pc.sky.background_color[2]);
	accum += sample_volumetric_nebulae_gpu(dir, zoom_factor);
	accum += sample_dust_clouds_gpu(dir);
	accum += sample_deep_field_galaxies_gpu(dir);
	accum += sample_star_clusters_gpu(dir, fov_rad);
	if (pc.sky.quasar_enabled != 0u) accum += sample_quasars_gpu(dir);
	if (pc.sky.pulsar_enabled != 0u) accum += sample_pulsars_gpu(dir);
	if (pc.sky.snr_enabled != 0u) accum += sample_supernova_remnants_gpu(dir);
	accum += sample_procedural_stars_gpu(dir, fov_rad, zoom_factor);

	accum *= float(max(pc.sky.master_intensity, 0.0));
	accum = max(accum, vec3(0.0));
	accum = apply_hue_saturation(accum, pc.sky.hue_shift_deg * (PI_D / 180.0), pc.sky.saturation);

	if (pc.sky.grid_enabled != 0u) {
		vec3 grid_dir = sky_rotate_vector(unit_dir, float(pc.sky.grid_orientation_yaw_deg), float(pc.sky.grid_orientation_pitch_deg), float(pc.sky.grid_orientation_roll_deg));
		accum += sample_celestial_grid_gpu(grid_dir, fov_rad);
	}

	return accum;
}

float cie_gaussian_component(float x, float alpha, float mu, float sigma1, float sigma2) {
	float sigma = (x < mu) ? sigma1 : sigma2;
	float t = (x - mu) / sigma;
	return alpha * exp(-0.5 * t * t);
}

float cie_x_bar(float lambda_nm) {
	return cie_gaussian_component(lambda_nm, 1.056, 599.8, 37.9, 31.0)
		+ cie_gaussian_component(lambda_nm, 0.362, 442.0, 16.0, 26.7)
		- cie_gaussian_component(lambda_nm, 0.065, 501.1, 20.4, 26.2);
}

float cie_y_bar(float lambda_nm) {
	return cie_gaussian_component(lambda_nm, 0.821, 568.8, 46.9, 40.5)
		+ cie_gaussian_component(lambda_nm, 0.286, 530.9, 16.3, 31.1);
}

float cie_z_bar(float lambda_nm) {
	return cie_gaussian_component(lambda_nm, 1.217, 437.0, 11.8, 36.0)
		+ cie_gaussian_component(lambda_nm, 0.681, 459.0, 26.0, 13.8);
}

float planck_spectral_radiance(float lambda_m, float temp_k) {
	const float c2 = 0.0143877688;
	float x = c2 / (lambda_m * temp_k);
	if (x > 80.0) return 0.0;
	float lambda_um = lambda_m * 1e6;
	float lambda5 = lambda_um * lambda_um * lambda_um * lambda_um * lambda_um;
	return 1.0 / (lambda5 * (exp(x) - 1.0));
}

dvec3 temperature_to_linear_rgb(double t_kelvin, double intensity, double saturation) {
	float t = float(clamp(t_kelvin, 800.0, 60000.0));
	vec3 int_xyz = vec3(0.0);
	const int samples = 16;
	const float lambda_start = 380.0;
	const float d_lambda = (780.0 - 380.0) / float(samples);
	for (int i = 0; i <= samples; ++i) {
		float lambda_nm = lambda_start + float(i) * d_lambda;
		float radiance = planck_spectral_radiance(lambda_nm * 1e-9, t);
		float weight = (i == 0 || i == samples) ? 0.5 : 1.0;
		int_xyz.x += weight * radiance * cie_x_bar(lambda_nm);
		int_xyz.y += weight * radiance * cie_y_bar(lambda_nm);
		int_xyz.z += weight * radiance * cie_z_bar(lambda_nm);
	}

	float r =  3.2404542 * int_xyz.x - 1.5371385 * int_xyz.y - 0.4985314 * int_xyz.z;
	float g = -0.9692660 * int_xyz.x + 1.8760108 * int_xyz.y + 0.0415560 * int_xyz.z;
	float b =  0.0556434 * int_xyz.x - 0.2040259 * int_xyz.y + 1.0572252 * int_xyz.z;
	r = max(r, 0.0);
	g = max(g, 0.0);
	b = max(b, 0.0);

	float max_c = max(max(r, g), max(b, 1e-6));
	r /= max_c;
	g /= max_c;
	b /= max_c;

	float luma = 0.2126 * r + 0.7152 * g + 0.0722 * b;
	float sat = float(clamp(saturation, 0.0, 3.0));
	r = max(0.0, luma + (r - luma) * sat);
	g = max(0.0, luma + (g - luma) * sat);
	b = max(0.0, luma + (b - luma) * sat);

	float scale = float(max(intensity, 0.0));
	return dvec3(double(r * scale), double(g * scale), double(b * scale));
}

float disk_lattice_value(ivec3 p, uint seed) {
	uint h = uint(p.x) * 374761393u + uint(p.y) * 668265263u + uint(p.z) * 2147483647u + seed * 1274126177u;
	return float(hash_u32(h) & 0x00FFFFFFu) * (1.0 / 16777216.0) * 2.0 - 1.0;
}

float disk_value_noise(vec3 p, uint seed) {
	vec3 base = floor(p);
	ivec3 i0 = ivec3(base);
	vec3 f = p - base;
	vec3 u = f * f * (3.0 - 2.0 * f);

	float c000 = disk_lattice_value(i0, seed);
	float c100 = disk_lattice_value(i0 + ivec3(1, 0, 0), seed);
	float c010 = disk_lattice_value(i0 + ivec3(0, 1, 0), seed);
	float c110 = disk_lattice_value(i0 + ivec3(1, 1, 0), seed);
	float c001 = disk_lattice_value(i0 + ivec3(0, 0, 1), seed);
	float c101 = disk_lattice_value(i0 + ivec3(1, 0, 1), seed);
	float c011 = disk_lattice_value(i0 + ivec3(0, 1, 1), seed);
	float c111 = disk_lattice_value(i0 + ivec3(1, 1, 1), seed);

	float c00 = mix(c000, c100, u.x);
	float c10 = mix(c010, c110, u.x);
	float c01 = mix(c001, c101, u.x);
	float c11 = mix(c011, c111, u.x);
	return mix(mix(c00, c10, u.y), mix(c01, c11, u.y), u.z);
}

float disk_fractal_noise(vec3 p, int octaves, uint seed) {
	float total = 0.0;
	float amplitude = 1.0;
	float frequency = 1.0;
	float normalization = 0.0;
	for (int octave = 0; octave < octaves; ++octave) {
		total += disk_value_noise(p * frequency, seed + uint(octave) * 7919u) * amplitude;
		normalization += amplitude;
		amplitude *= 0.5;
		frequency *= 2.0;
	}
	return total / max(normalization, 1e-5);
}

shared vec3 cie_weight_table[33];

vec3 disk_blackbody_rgb_strided(float temperature_k, float reference_luminance, int stride) {
	float t = clamp(temperature_k, 300.0, 400000.0);
	vec3 xyz = vec3(0.0);
	for (int i = 0; i <= 32; i += stride) {
		float lambda_um = (380.0 + float(i) * (400.0 / 32.0)) * 1e-3;
		float exponent = 14387.76877 / (lambda_um * t);
		if (exponent > 80.0) continue;
		float lambda_sq = lambda_um * lambda_um;
		float radiance = 1.0 / (lambda_sq * lambda_sq * lambda_um * (exp(exponent) - 1.0));
		xyz += float(stride) * radiance * cie_weight_table[i];
	}
	xyz /= max(reference_luminance, 1e-30);
	vec3 rgb = vec3(
		3.2404542 * xyz.x - 1.5371385 * xyz.y - 0.4985314 * xyz.z,
		-0.9692660 * xyz.x + 1.8760108 * xyz.y + 0.0415560 * xyz.z,
		0.0556434 * xyz.x - 0.2040259 * xyz.y + 1.0572252 * xyz.z
	);
	return max(rgb, vec3(0.0));
}

vec3 disk_blackbody_rgb(float temperature_k, float reference_luminance) {
	return disk_blackbody_rgb_strided(temperature_k, reference_luminance, 1);
}

void disk_orbital_frame(double mass, double spin, double radius, out double omega, out double dilation) {
	double spin_magnitude = abs(spin);
	double sqrt_mass = sqrt(max(mass, 1e-12));
	double sqrt_radius = sqrt(max(radius, 1e-12));
	double radius_pow_1_5 = radius * sqrt_radius;
	double angular = sqrt_mass / (radius_pow_1_5 + spin_magnitude * sqrt_mass);
	double bracket = max(radius_pow_1_5 - 3.0 * mass * sqrt_radius + 2.0 * spin_magnitude * sqrt_mass, 1e-9);
	omega = (spin < 0.0) ? -angular : angular;
	dilation = (radius_pow_1_5 + spin_magnitude * sqrt_mass) / (sqrt(radius_pow_1_5) * sqrt(bracket));
}

double disk_redshift(double mass, double spin, double radius, double angular_momentum_ratio) {
	double omega;
	double dilation;
	disk_orbital_frame(mass, spin, radius, omega, dilation);
	double denominator = dilation * (1.0 - omega * angular_momentum_ratio);
	return (abs(denominator) > 1e-9) ? clamp(1.0 / denominator, 0.05, 4.0) : 1.0;
}

float disk_smooth_unit(float x) {
	float t = clamp(x, 0.0, 1.0);
	return t * t * (3.0 - 2.0 * t);
}

double disk_reduce_angle(double angle) {
	const double two_pi = 6.283185307179586;
	return angle - two_pi * floor(angle / two_pi);
}

vec3 disk_grade_emission(DiskProfile disk, vec3 linear_color, float gain) {
	vec3 color = linear_color * gain;
	float luma = dot(color, vec3(0.2126, 0.7152, 0.0722));
	color = max(vec3(0.0), vec3(luma) + (color - vec3(luma)) * disk.color_saturation);
	color *= vec3(1.0) + (vec3(disk.tint_r, disk.tint_g, disk.tint_b) - vec3(1.0)) * disk.tint_strength;
	return color;
}

void disk_shade_with_base(DiskProfile disk, double mass_in, double spin, double inner_in, double outer_in, double radius_in, double azimuth, double redshift_in, double time, double detail_scale, double base_override, out vec3 radiance, out double opacity) {
	double mass = max(mass_in, 1e-9);
	double radius = max(radius_in, 1e-9);
	double inner = max(inner_in, 1e-9);
	double outer = max(outer_in, inner * 1.0001);

	float u = float(clamp(inner / radius, 1e-4, 1.0));
	float boundary = max(1.0 - disk.zero_torque_strength * sqrt(u), 0.0);
	float base = (base_override >= 0.0) ? float(base_override) : (pow(u, disk.temperature_exponent) * pow(boundary, 0.25) * disk.temperature_normalization);

	float softness = max(disk.edge_softness, 0.05);
	float mass_f = float(mass);
	float envelope = disk_smooth_unit(float(radius - inner) / (0.8 * softness * mass_f)) * disk_smooth_unit(float(outer - radius) / (1.5 * softness * mass_f));

	double rotation = double(disk.rotation_speed_scale) * time;
	double omega_local;
	double omega_pattern;
	double unused_dilation;
	disk_orbital_frame(mass, spin, radius, omega_local, unused_dilation);
	disk_orbital_frame(mass, spin, sqrt(inner * outer), omega_pattern, unused_dilation);
	double shear_phase = disk_reduce_angle(azimuth - omega_local * rotation);
	double pattern_phase = disk_reduce_angle(azimuth - omega_pattern * rotation);

	float log_ratio = log(float(max(radius / inner, 1.0)));
	float log_span = max(log(float(max(outer / inner, 1.0001))), 1e-4);
	float radial_coordinate = log_ratio / log_span;

	float ring_wave = 0.5 + 0.5 * cos(6.28318531 * disk.ring_frequency * radial_coordinate);
	float ring_sharpness = max(disk.ring_sharpness, 1.0);
	float ring = max(1.0 + disk.ring_amplitude * (pow(ring_wave, ring_sharpness) * sqrt(PI_F * ring_sharpness) - 1.0), 0.0);

	float arms = floor(disk.spiral_arm_count + 0.5);
	float spiral = (arms > 0.5) ? max(1.0 + disk.spiral_amplitude * cos(arms * (float(pattern_phase) - disk.spiral_pitch * log_ratio)), 0.0) : 1.0;

	float shear_cos = cos(float(shear_phase));
	float shear_sin = sin(float(shear_phase));
	int octaves = clamp(int(disk.turbulence_octaves + 0.5), 1, 6);
	uint seed = uint(max(disk.noise_seed, 0.0));
	float detail = float(clamp(detail_scale, 0.0, 1.0));

	float turbulence_noise = disk_fractal_noise(vec3(log_ratio * disk.turbulence_scale * disk.radial_stretch, shear_cos * disk.turbulence_scale, shear_sin * disk.turbulence_scale), octaves, seed);
	float turbulence = exp(1.5 * disk.turbulence_amplitude * detail * turbulence_noise);
	float grain_noise = disk_value_noise(vec3(log_ratio * disk.grain_scale * disk.radial_stretch, shear_cos * disk.grain_scale, shear_sin * disk.grain_scale), seed + 104729u);
	float grain = max(1.0 + disk.grain_amplitude * detail * grain_noise, 0.0);

	float flux_modulation = clamp(ring * spiral * turbulence * grain, 0.0, 8.0);
	float temperature_span = max(disk.peak_temperature_k - disk.floor_temperature_k, 0.0);
	float local_temperature = (disk.floor_temperature_k + temperature_span * base) * pow(max(flux_modulation, 1e-4), 0.25);
	float redshift = float(max(redshift_in, 1e-3));

	vec3 color = disk_grade_emission(disk, disk_blackbody_rgb(local_temperature * redshift, disk.reference_luminance), disk.brightness * pow(redshift, disk.extra_beaming_exponent) * envelope);

	radiance = color;
	opacity = double(clamp(envelope * 0.95 * disk.opacity_scale * clamp(sqrt(min(flux_modulation, 1.0)), 0.15, 1.0), 0.0, 0.98));
}

void disk_shade(DiskProfile disk, double mass_in, double spin, double inner_in, double outer_in, double radius_in, double azimuth, double redshift_in, double time, double detail_scale, out vec3 radiance, out double opacity) {
	disk_shade_with_base(disk, mass_in, spin, inner_in, outer_in, radius_in, azimuth, redshift_in, time, detail_scale, -1.0, radiance, opacity);
}

const double LN2_D = 0.6931471805599453;

double exp_d(double x) {
	double bounded = clamp(x, -700.0, 700.0);
	double k = floor(bounded / LN2_D + 0.5);
	double r = bounded - k * LN2_D;
	double term = 1.0;
	double sum = 1.0;
	for (int n = 1; n <= 14; ++n) {
		term *= r / double(n);
		sum += term;
	}
	return ldexp(sum, int(k));
}

double log_d(double x) {
	if (x <= 0.0) return -1.0e30;
	double y = double(log(float(x)));
	for (int iteration = 0; iteration < 2; ++iteration) {
		double e = exp_d(y);
		y += 2.0 * (x - e) / (x + e);
	}
	return y;
}

double nt_page_thorne_f(double x, double x0, double a_star) {
	if (x < x0) return 0.0;
	double psi = double(acos(float(clamp(a_star, -1.0, 1.0)))) / 3.0;
	double roots[3];
	roots[0] = 2.0 * double(cos(float(psi - 1.0471975511965976)));
	roots[1] = 2.0 * double(cos(float(psi + 1.0471975511965976)));
	roots[2] = -2.0 * double(cos(float(psi)));
	for (int i = 0; i < 3; ++i) {
		for (int iteration = 0; iteration < 3; ++iteration) {
			double slope = 3.0 * roots[i] * roots[i] - 3.0;
			if (abs(slope) > 1e-9) {
				roots[i] -= (roots[i] * roots[i] * roots[i] - 3.0 * roots[i] + 2.0 * a_star) / slope;
			}
		}
	}
	double value = x - x0;
	if (abs(a_star) > 1e-15) {
		value -= 1.5 * a_star * log_d(x / x0);
	}
	for (int i = 0; i < 3; ++i) {
		double xi = roots[i];
		if (i == 1 && abs(xi) <= 1e-12) continue;
		double xj = roots[(i + 1) % 3];
		double xk = roots[(i + 2) % 3];
		double denominator = xi * (xi - xj) * (xi - xk);
		if (abs(denominator) < 1e-30) continue;
		double coefficient = 3.0 * (xi - a_star) * (xi - a_star) / denominator;
		double argument = max((x - xi) / (x0 - xi), 1e-30);
		value -= coefficient * log_d(argument);
	}
	return max(value, 0.0);
}

double nt_base_temperature(double radius, double mass, double spin) {
	double a_star = clamp(spin / mass, -0.999999999, 0.999999999);
	double r_isco = kerr_isco_radius_prograde_retrograde(mass, a_star * mass);
	double x0 = sqrt(r_isco / mass);
	double x = sqrt(radius / mass);
	double f_value = nt_page_thorne_f(x, x0, a_star);
	double denominator = x * (x * x * x + a_star);
	if (denominator <= 1e-24) return 0.0;
	double flux = max(3.0 * mass / (8.0 * PI_D * radius * radius * radius) * (f_value / denominator), 0.0);
	double ratio = flux / max(double(pc.hydro_disk.flux_peak), 1e-300);
	return double(pow(float(ratio), 0.25)) * double(pc.hydro_disk.rate_factor);
}

double fm_potential(double radius, double cos_theta, double mass, double spin, double specific_l, double horizon) {
	if (radius <= horizon * 1.0001) return 1.0e30;
	double cos2 = cos_theta * cos_theta;
	double sin2 = max(1.0 - cos2, 1e-30);
	double r2 = radius * radius;
	double a2 = spin * spin;
	double rho2 = r2 + a2 * cos2;
	double delta = r2 - 2.0 * mass * radius + a2;
	double sigma = (r2 + a2) * (r2 + a2) - a2 * delta * sin2;
	double denominator = sigma * sin2 - 4.0 * mass * radius * spin * specific_l * sin2 - specific_l * specific_l * (delta - a2 * sin2);
	if (denominator <= 0.0 || delta <= 0.0) return 1.0e30;
	double u_t_squared = rho2 * delta * sin2 / denominator;
	return 0.5 * double(log(float(max(u_t_squared, 1e-30))));
}

void fm_orbital_frame(double radius, double cos_theta, double potential, double mass, double spin, double specific_l, out double omega, out double dilation) {
	double cos2 = cos_theta * cos_theta;
	double sin2 = max(1.0 - cos2, 1e-30);
	double r2 = radius * radius;
	double a2 = spin * spin;
	double rho2 = r2 + a2 * cos2;
	double delta = r2 - 2.0 * mass * radius + a2;
	double sigma = (r2 + a2) * (r2 + a2) - a2 * delta * sin2;
	double u_t_lower = -double(exp(float(potential)));
	double u_phi_lower = -specific_l * u_t_lower;
	double inverse_tt = -sigma / (rho2 * delta);
	double inverse_tphi = -(2.0 * mass * radius * spin) / (rho2 * delta);
	double inverse_phiphi = (delta - a2 * sin2) / (rho2 * delta * sin2);
	double u_t = inverse_tt * u_t_lower + inverse_tphi * u_phi_lower;
	double u_phi = inverse_tphi * u_t_lower + inverse_phiphi * u_phi_lower;
	dilation = u_t;
	omega = (u_t > 1e-12) ? (u_phi / u_t) : 0.0;
}

void torus_integrate_segment(dvec3 from_pos, dvec3 to_pos, double l_ratio, double mass, double spin, out vec3 radiance, out double opacity, out double redshift_average) {
	radiance = vec3(0.0);
	opacity = 0.0;
	redshift_average = 1.0;
	if ((pc.hydro_disk.flags & 1u) == 0u) return;

	dvec3 delta = to_pos - from_pos;
	double length_sq = dot(delta, delta);
	if (length_sq < 1e-24) return;
	double outer_bound = double(pc.hydro_disk.outer_bound);
	double inner_bound = double(pc.hydro_disk.inner_bound);
	double b = dot(from_pos, delta) / length_sq;
	double c = (dot(from_pos, from_pos) - outer_bound * outer_bound) / length_sq;
	double discriminant = b * b - c;
	if (discriminant <= 0.0) return;
	double root = sqrt(discriminant);
	double t_begin = clamp(-b - root, 0.0, 1.0);
	double t_end = clamp(-b + root, 0.0, 1.0);
	if (t_end <= t_begin) return;

	double clipped_length = sqrt(length_sq) * (t_end - t_begin);
	double density = max(double(pc.hydro_disk.sampling_density), 0.1);
	int sample_count = clamp(int(ceil(clipped_length * density / mass)), 1, 64);
	double step_length = clipped_length / double(sample_count);
	double horizon = mass + sqrt(max(mass * mass - spin * spin, 0.0));
	double specific_l = double(pc.hydro_disk.specific_angular_momentum);
	double potential_inner = double(pc.hydro_disk.potential_inner);
	float kappa = pc.hydro_disk.optical_depth_scale * max(pc.primary_disk.opacity_scale, 0.0);
	float exponent = 1.0 / max(pc.hydro_disk.adiabatic_index - 1.0, 1e-3);
	float enthalpy_span = max(pc.hydro_disk.max_enthalpy - 1.0, 1e-12);
	float depth_per_sample = float(step_length / mass);
	float peak_temperature = pc.primary_disk.peak_temperature_k;
	float floor_temperature = pc.primary_disk.floor_temperature_k;

	float transmittance = 1.0;
	float weight_sum = 0.0;
	float redshift_sum = 0.0;
	vec3 accumulated = vec3(0.0);
	for (int i = 0; i < sample_count; ++i) {
		double t = t_begin + (t_end - t_begin) * ((double(i) + 0.5) / double(sample_count));
		dvec3 sample_pos = from_pos + t * delta;
		double sample_radius = length(sample_pos);
		if (sample_radius < inner_bound || sample_radius > outer_bound) continue;
		double cos_theta = clamp(sample_pos.z / sample_radius, -1.0, 1.0);
		double potential = fm_potential(sample_radius, cos_theta, mass, spin, specific_l, horizon);
		if (potential >= potential_inner) continue;
		float enthalpy = exp(float(potential_inner - potential));
		if (enthalpy <= 1.0) continue;
		float ratio = clamp((enthalpy - 1.0) / enthalpy_span, 0.0, 1.0);
		float optical_depth = kappa * pow(ratio, exponent) * depth_per_sample;
		if (optical_depth < 1e-12) continue;

		double omega;
		double dilation;
		fm_orbital_frame(sample_radius, cos_theta, potential, mass, spin, specific_l, omega, dilation);
		if (dilation <= 1e-12) continue;
		double denominator = dilation * (1.0 - omega * l_ratio);
		float redshift = (abs(denominator) > 1e-9) ? float(clamp(1.0 / denominator, 0.05, 4.0)) : 1.0;

		float step_transmittance = exp(-optical_depth);
		float weight = transmittance * (1.0 - step_transmittance);
		if (weight > 1e-6) {
			float temperature = floor_temperature + (peak_temperature - floor_temperature) * ratio;
			vec3 linear_color = disk_blackbody_rgb_strided(temperature * redshift, pc.primary_disk.reference_luminance, 2);
			accumulated += weight * disk_grade_emission(pc.primary_disk, linear_color, pc.primary_disk.brightness * pow(redshift, pc.primary_disk.extra_beaming_exponent));
		}
		weight_sum += weight;
		redshift_sum += weight * redshift;
		transmittance *= step_transmittance;
		if (transmittance < 0.002) break;
	}

	radiance = accumulated;
	opacity = double(1.0 - transmittance);
	redshift_average = (weight_sum > 1e-30) ? double(redshift_sum / weight_sum) : 1.0;
}

double jet_pow(double base, double exponent) {
	return exp_d(exponent * log_d(max(base, 1.0e-30)));
}

double jet_smooth_unit(double x) {
	double t = clamp(x, 0.0, 1.0);
	return t * t * (3.0 - 2.0 * t);
}

double jet_field_index() {
	if (pc.jet.geometry > 2.5) return 2.0;
	if (pc.jet.geometry > 1.5) return max(double(pc.jet.field_line_index), 0.25);
	return 1.0;
}

void jet_shape(double theta, out double value, out double derivative) {
	dvec2 sc = precise_sincos(theta);
	double s = sc.x;
	double c = sc.y;
	if (pc.jet.geometry > 2.5) {
		value = 0.5 * s * s;
		derivative = s * c;
	} else if (pc.jet.geometry > 0.5) {
		double sign = (c > 0.0) ? 1.0 : ((c < 0.0) ? -1.0 : 0.0);
		value = 1.0 - abs(c);
		derivative = s * sign;
	} else {
		value = 1.0 - c;
		derivative = s;
	}
}

double jet_footpoint_angle(double ratio) {
	if (pc.jet.geometry > 2.5) return double(asin(float(sqrt(clamp(2.0 * ratio, 0.0, 1.0)))));
	if (pc.jet.geometry > 0.5) return double(acos(float(clamp(1.0 - ratio, 0.0, 1.0))));
	return double(acos(float(clamp(1.0 - ratio, -1.0, 1.0))));
}

void jet_field_and_frame(double r, double theta, out dvec3 field, out double footpoint, out double omega_field, out double lapse, out double dragging, out double phi_radius) {
	double m = double(pc.jet.mass);
	double a = double(pc.jet.spin);
	double r_h = double(pc.jet.horizon_radius);
	double nu = jet_field_index();
	double norm = jet_pow(r_h, 2.0 - nu);
	dvec2 sc = precise_sincos(theta);
	double sin_t = max(sc.x, 1.0e-6);
	double cos_t = sc.y;
	double a2 = a * a;
	double r2 = r * r;
	double rho2 = r2 + a2 * cos_t * cos_t;
	double rho = sqrt(rho2);
	double delta = max(r2 - 2.0 * m * r + a2, 1.0e-12);
	double sigma = (r2 + a2) * (r2 + a2) - a2 * delta * sin_t * sin_t;
	phi_radius = sqrt(max(sigma * sin_t * sin_t / rho2, 1.0e-30));
	lapse = max(sqrt(rho2 * delta / sigma), 1.0e-9);
	dragging = 2.0 * m * a * r / sigma;

	double value;
	double derivative;
	jet_shape(theta, value, derivative);
	double r_pow = jet_pow(r, nu);
	double d_theta = norm * r_pow * derivative;
	double d_r = nu * norm * r_pow * value / r;
	double ratio = jet_pow(r / r_h, nu) * value;
	footpoint = jet_footpoint_angle(ratio);
	double foot_sin = double(sin(float(footpoint)));
	double foot_cos = double(cos(float(footpoint)));
	double omega_h = double(pc.jet.horizon_angular_velocity);
	if (pc.jet.angular_velocity_law > 0.5) {
		omega_field = double(pc.jet.fixed_angular_velocity) / m;
	} else {
		omega_field = omega_h * double(pc.jet.angular_velocity_fraction) * (1.0 - double(pc.jet.angular_velocity_variation) * foot_sin * foot_sin);
	}
	double foot_value;
	double foot_derivative;
	jet_shape(footpoint, foot_value, foot_derivative);
	double hemisphere = (pc.jet.geometry < 0.5) ? 1.0 : ((cos_t >= 0.0) ? 1.0 : -1.0);
	double horizon_sq = r_h * r_h + a2;
	double znajek = (omega_field - omega_h) * horizon_sq * foot_sin / (horizon_sq - a2 * foot_sin * foot_sin);
	double toroidal = double(pc.jet.toroidal_field_scale) * znajek * norm * jet_pow(r_h, nu) * abs(foot_derivative) * hemisphere;
	double scale = 1.0 / (rho * phi_radius);
	field = dvec3(d_theta * scale, -d_r * sqrt(delta) * scale, toroidal / phi_radius);
}

double jet_emission_weight(double r, double footpoint) {
	double folded = min(footpoint, PI_D - footpoint);
	double inner = double(pc.jet.inner_radius);
	double outer = double(pc.jet.outer_radius);
	double soft = max(double(pc.jet.footpoint_softness), 1.0e-3);
	double radial_in = jet_smooth_unit((r - inner) / max(0.25 * inner, 1.0e-9));
	double radial_out = jet_smooth_unit((outer - r) / max(0.25 * outer, 1.0e-9));
	double angular = 1.0 - jet_smooth_unit((folded - (double(pc.jet.footpoint_edge) - soft)) / (2.0 * soft));
	return radial_in * radial_out * angular;
}

double jet_lorentz_factor(double r) {
	double span = max(double(pc.jet.acceleration_radius), 1.0e-9);
	double x = jet_pow(max(r - double(pc.jet.inner_radius), 0.0) / span, max(double(pc.jet.acceleration_index), 1.0e-3));
	double inner = double(pc.jet.lorentz_inner);
	return inner + (double(pc.jet.lorentz_max) - inner) * x / (1.0 + x);
}

bool jet_plasma_state(double r, double theta, dvec3 photon, out double weight, out double electron_density, out double field_tesla, out double cos_pitch, out double doppler) {
	weight = 0.0;
	electron_density = 0.0;
	field_tesla = 0.0;
	cos_pitch = 0.0;
	doppler = 1.0;
	if (r < double(pc.jet.inner_radius) || r > double(pc.jet.outer_radius)) return false;
	double theta_c = clamp(theta, 1.0e-4, PI_D - 1.0e-4);
	dvec3 field;
	double footpoint;
	double omega_field;
	double lapse;
	double dragging;
	double phi_radius;
	jet_field_and_frame(r, theta_c, field, footpoint, omega_field, lapse, dragging, phi_radius);
	weight = jet_emission_weight(r, footpoint);
	if (weight <= 1.0e-6) return false;

	double gamma_target = jet_lorentz_factor(r);
	double speed = sqrt(max(1.0 - 1.0 / (gamma_target * gamma_target), 0.0));
	double b_pol = length(field.xy);
	dvec3 pol_dir = (b_pol > 1.0e-12) ? dvec3(field.xy / b_pol, 0.0) : dvec3(1.0, 0.0, 0.0);
	if (pol_dir.x < 0.0) pol_dir = -pol_dir;

	bool relativistic_flow = pc.jet.doppler_enabled > 0.5;
	double rotation = (omega_field - dragging) * phi_radius / lapse;
	double rotation_cap = 0.9 * speed;
	double beta_phi = double(pc.jet.rotation_coupling) * clamp(rotation, -rotation_cap, rotation_cap);
	double beta_pol = sqrt(max(speed * speed - beta_phi * beta_phi, 0.0));
	dvec3 beta = dvec3(beta_pol * pol_dir.x, beta_pol * pol_dir.y, beta_phi);
	if (!relativistic_flow) beta = dvec3(0.0);
	double beta_sq = dot(beta, beta);
	double beta_mag = sqrt(beta_sq);
	double gamma_flow = 1.0 / sqrt(max(1.0 - beta_sq, 1.0e-9));
	dvec3 field_comoving = field / gamma_flow + (gamma_flow / (gamma_flow + 1.0)) * beta * dot(beta, field);
	dvec3 photon_comoving = photon;
	if (beta_mag > 1.0e-9) {
		dvec3 beta_hat = beta / beta_mag;
		double parallel = dot(photon, beta_hat);
		dvec3 perpendicular = photon - parallel * beta_hat;
		double denominator = 1.0 - beta_mag * parallel;
		photon_comoving = ((parallel - beta_mag) / denominator) * beta_hat + (1.0 / (gamma_flow * denominator)) * perpendicular;
	}

	doppler = relativistic_flow ? 1.0 / (gamma_flow * (1.0 - dot(beta, photon))) : 1.0;
	if (pc.jet.redshift_enabled > 0.5) doppler *= lapse;
	doppler = clamp(doppler, 1.0e-3, 1.0e3);

	double field_mag = length(field_comoving);
	if (field_mag <= 1.0e-12) return false;
	cos_pitch = clamp(dot(photon_comoving, field_comoving) / (max(length(photon_comoving), 1.0e-12) * field_mag), -1.0, 1.0);
	field_tesla = field_mag * double(pc.jet.horizon_field_tesla);
	double sigma = max(double(pc.jet.magnetization) * jet_pow(r / double(pc.jet.horizon_radius), double(pc.jet.magnetization_index)), 1.0e-6);
	electron_density = double(pc.jet.electron_density_constant) * field_tesla * field_tesla / sigma;
	return true;
}

vec3 jet_polarization_color(float x) {
	return vec3(clamp(2.0 * x, 0.0, 1.0), clamp(1.0 - abs(2.0 * x - 1.0), 0.0, 1.0), clamp(1.0 - 2.0 * x, 0.0, 1.0));
}

bool jet_integrate_segment(dvec3 from_pos, dvec3 to_pos, out vec3 radiance, out double transmittance) {
	radiance = vec3(0.0);
	transmittance = 1.0;
	dvec3 delta = to_pos - from_pos;
	double segment_length = length(delta);
	if (segment_length < 1.0e-12) return false;
	double inner = double(pc.jet.inner_radius);
	double outer = double(pc.jet.outer_radius);
	if (max(length(from_pos), length(to_pos)) < inner) return false;
	double t_closest = clamp(-dot(from_pos, delta) / (segment_length * segment_length), 0.0, 1.0);
	if (length(from_pos + t_closest * delta) > outer) return false;

	double mass = max(double(pc.jet.mass), 1.0e-9);
	int sample_count = clamp(int(ceil(segment_length / mass * double(pc.jet.sampling_density))), 1, max(int(pc.jet.max_samples + 0.5), 1));
	double step_length = segment_length / double(sample_count);
	double step_meters = step_length * double(pc.jet.meters_per_unit);
	dvec3 photon = -delta / segment_length;
	double nu_obs = double(pc.jet.observing_frequency_hz);
	double p = double(pc.jet.power_law_index);
	double normalization = exp_d(-double(pc.jet.log_reference_intensity)) * double(pc.jet.brightness);
	double coherence = double(pc.jet.polarization_coherence);
	vec3 tint = vec3(pc.jet.tint_r, pc.jet.tint_g, pc.jet.tint_b);
	uint display = uint(pc.jet.display_mode + 0.5);
	bool any_emission = false;

	for (int i = 0; i < sample_count; ++i) {
		double t = (double(i) + 0.5) / double(sample_count);
		dvec3 pos = from_pos + t * delta;
		double r = length(pos);
		if (r < inner || r > outer) continue;
		double theta = double(acos(float(clamp(pos.z / r, -1.0, 1.0))));
		double rho = length(pos.xy);
		dvec3 e_r = pos / r;
		dvec3 e_phi = (rho > 1.0e-12) ? dvec3(-pos.y / rho, pos.x / rho, 0.0) : dvec3(0.0, 1.0, 0.0);
		dvec3 e_theta = cross(e_phi, e_r);
		dvec3 photon_local = dvec3(dot(photon, e_r), dot(photon, e_theta), dot(photon, e_phi));

		double weight;
		double electron_density;
		double field_tesla;
		double cos_pitch;
		double doppler;
		if (!jet_plasma_state(r, theta, photon_local, weight, electron_density, field_tesla, cos_pitch, doppler)) continue;

		double nu_emit = nu_obs / doppler;
		double sin_pitch = max(sqrt(max(1.0 - cos_pitch * cos_pitch, 0.0)), 1.0e-4);
		double nonthermal_density = max(electron_density * weight * double(pc.jet.non_thermal_fraction), 1.0e-30);
		double log_field = log_d(max(field_tesla * sin_pitch, 1.0e-30));
		double log_nu = log_d(nu_emit);
		double log_density = log_d(nonthermal_density);
		double emissivity = exp_d(double(pc.jet.log_emissivity_constant) + log_density + 0.5 * (p + 1.0) * log_field - 0.5 * (p - 1.0) * log_nu);
		double absorptivity = exp_d(double(pc.jet.log_absorptivity_constant) + log_density + 0.5 * (p + 4.0) * log_field - 0.5 * (p + 4.0) * log_nu);
		emissivity *= doppler * doppler;
		absorptivity *= double(pc.jet.absorption_scale) / doppler;

		double tau = absorptivity * step_meters;
		double step_transmittance = exp_d(-min(tau, 600.0));
		double effective_path = (tau < 1.0e-4) ? step_meters * (1.0 - 0.5 * tau) : (1.0 - step_transmittance) / max(absorptivity, 1.0e-30);
		double step_intensity = emissivity * effective_path * normalization;

		double faraday_depth = double(pc.jet.faraday_constant) * double(pc.jet.faraday_scale) * electron_density * weight * field_tesla * abs(cos_pitch) / (nu_emit * nu_emit) / doppler * step_meters;
		double depolarization = (faraday_depth > 1.0e-4) ? double(abs(sin(float(faraday_depth)) / float(faraday_depth))) : 1.0;
		double polarization_fraction = clamp(double(pc.jet.polarization_fraction) * depolarization * coherence, 0.0, 1.0);

		vec3 color;
		if (display == 1u) {
			color = tint * float(step_intensity * polarization_fraction);
		} else if (display == 2u) {
			color = jet_polarization_color(float(polarization_fraction)) * float(step_intensity);
		} else {
			color = tint * float(step_intensity);
		}
		radiance += float(transmittance) * color;
		transmittance *= step_transmittance;
		any_emission = true;
	}
	return any_emission;
}

vec3 apply_tonemapping(vec3 linear_color, uint mode, double exposure_ev) {
	float exp_scale = exp2(float(exposure_ev));
	vec3 col = max(linear_color * exp_scale, vec3(0.0));

	if (mode == 1u) {
		const float a = 2.51, b = 0.03, c = 2.43, d = 0.59, e = 0.14;
		col = clamp((col * (a * col + b)) / (col * (c * col + d) + e), 0.0, 1.0);
	} else if (mode == 2u) {
		float lum = dot(col, vec3(0.2126, 0.7152, 0.0722));
		if (lum > 0.0) {
			const float inv_log_base = 0.108572457;
			float mapped_lum = log(1.0 + lum * 100.0) * inv_log_base;
			col = clamp(col * clamp(mapped_lum / lum, 0.0, 1.0), 0.0, 1.0);
		} else {
			col = vec3(0.0);
		}
	} else if (mode == 3u) {
		col = (col * (1.0 + col * 0.04)) / (1.0 + col);
	} else {
		col = clamp(col, 0.0, 1.0);
	}

	vec3 lo = 12.92 * col;
	vec3 hi = 1.055 * pow(col, vec3(1.0 / 2.4)) - 0.055;
	return mix(hi, lo, lessThanEqual(col, vec3(0.0031308)));
}

float surface_pattern_value(uint pattern, vec3 p, float theta, float phi, float scale, uint octaves, uint seed) {
	vec3 q = p * scale + vec3(float(seed % 977u) * 0.731, -float(seed % 613u) * 0.417, float(seed % 389u) * 0.293);
	if (pattern == 1u) {
		float r = 1.0 - abs(surface_fbm(q, octaves, 0.5));
		return r * r;
	}
	if (pattern == 2u) return abs(surface_fbm(q, octaves, 0.5));
	if (pattern == 3u) return 0.5 + 0.5 * sin(theta * scale * 2.0 + surface_fbm(q, octaves, 0.5) * 2.0);
	if (pattern == 4u) return 0.5 + 0.5 * sin(phi * scale + surface_fbm(q, octaves, 0.5) * 2.0);
	if (pattern == 5u) {
		float n = 0.5 + 0.5 * surface_fbm(q * 4.0, 2u, 0.5);
		return smoothstep(0.55, 1.0, n);
	}
	if (pattern == 6u) {
		float c = 0.5 + 0.5 * surface_fbm(q, octaves, 0.5);
		return clamp(smoothstep(0.55, 0.62, c) - 0.6 * smoothstep(0.62, 0.85, c), 0.0, 1.0);
	}
	if (pattern == 7u) {
		float n = surface_fbm(q, octaves, 0.5);
		return pow(clamp(1.0 - abs(n) * 2.2, 0.0, 1.0), 6.0);
	}
	if (pattern == 8u) return 0.5 + 0.5 * sin((phi + theta) * scale * 0.5 + surface_fbm(q, octaves, 0.5) * 6.0);
	if (pattern == 9u) {
		float warp = surface_fbm(q * 0.5, 2u, 0.5);
		return 0.5 + 0.5 * surface_fbm(q + vec3(warp * 1.5), octaves, 0.55);
	}
	return 0.5 + 0.5 * surface_fbm(q, octaves, 0.5);
}

float surface_mask_value(uint mask, float cos_t, float sun, float width) {
	if (mask == 1u) return smoothstep(1.0 - width, 1.0, abs(cos_t));
	if (mask == 2u) return 1.0 - smoothstep(0.0, width, abs(cos_t));
	if (mask == 3u) return smoothstep(-0.5 * width, 0.5 * width, cos_t);
	if (mask == 4u) return 1.0 - smoothstep(-0.5 * width, 0.5 * width, cos_t);
	if (mask == 5u) return smoothstep(-0.5 * width, 0.5 * width, sun);
	if (mask == 6u) return 1.0 - smoothstep(-0.5 * width, 0.5 * width, sun);
	return 1.0;
}

vec3 surface_apply_blend(uint blend, vec3 base, vec3 layer_color, float a) {
	if (blend == 1u) return base + layer_color * a;
	if (blend == 2u) return mix(base, base * layer_color, a);
	if (blend == 3u) return mix(base, vec3(1.0) - (vec3(1.0) - base) * (vec3(1.0) - layer_color), a);
	if (blend == 4u) {
		vec3 lo = 2.0 * base * layer_color;
		vec3 hi = vec3(1.0) - 2.0 * (vec3(1.0) - base) * (vec3(1.0) - layer_color);
		return mix(base, mix(hi, lo, lessThan(base, vec3(0.5))), a);
	}
	return mix(base, layer_color, a);
}

vec3 shade_photographic_surface(uint bi, float phi, float cos_t, float sun, float vdn, float footprint_pixels, vec3 fallback, out vec3 emissive) {
	emissive = vec3(0.0);
	uint mode = bodies[bi].surface_texture_mode;
	uint catalog_id = (mode >= 13u) ? (mode - 13u) : 0u;
	vec2 uv = vec2(fract((phi + PI_F) * (1.0 / (2.0 * PI_F))), clamp(acos(clamp(cos_t, -1.0, 1.0)) * (1.0 / PI_F), 0.0, 1.0));
	float safe_footprint = (footprint_pixels == footprint_pixels) ? clamp(footprint_pixels, 1e-3, 1.0e6) : 1.0;
	float grazing_lod = -0.5 * log2(clamp(vdn, 0.05, 1.0));

	if (catalog_id == 0u) {
		uint variant = bodies[bi].earth_map_variant;
		vec3 day_rgb = fallback;
		vec3 night_rgb = vec3(0.0);

		if (variant != 1u && pc.earth_day_width > 0u) {
			float day_lod = clamp(log2(max(float(pc.earth_day_width) / safe_footprint, 1.0)) + grazing_lod, 0.0, 16.0);
			day_rgb = textureLod(celestial_samplers[0], uv, day_lod).rgb;
		}
		if (variant != 0u && pc.earth_night_width > 0u) {
			float night_lod = clamp(log2(max(float(pc.earth_night_width) / safe_footprint, 1.0)) + grazing_lod, 0.0, 16.0);
			night_rgb = textureLod(celestial_samplers[14], uv, night_lod).rgb;
		}

		if (variant == 0u) return day_rgb;
		if (variant == 1u) { emissive = night_rgb; return vec3(0.0); }

		float illumination = sun;
		float softness = clamp(bodies[bi].earth_terminator_softness, 0.0, 1.0);
		float half_width = 0.04 + 0.46 * softness;
		float blend_t = clamp((illumination + half_width) / (2.0 * half_width), 0.0, 1.0);
		float day_weight = blend_t * blend_t * blend_t * (blend_t * (blend_t * 6.0 - 15.0) + 10.0);
		emissive = night_rgb * (1.0 - day_weight);
		return day_rgb * day_weight;
	}

	uint sampler_idx = min(catalog_id, 13u);
	float lod = clamp(log2(max(2048.0 / safe_footprint, 1.0)) + grazing_lod, 0.0, 16.0);
	vec3 sampled = textureLod(celestial_samplers[sampler_idx], uv, lod).rgb;
	if (catalog_id == 1u) {
		emissive = sampled * 2.0;
	}
	return sampled;
}

vec3 shade_body_surface(uint bi, dvec3 nrm, double sun_facing, double view_dot_n, out vec3 emissive, out float city_speckle, float earth_footprint_pixels) {
	emissive = vec3(0.0);
	city_speckle = 0.0;
	vec3 c1 = vec3(bodies[bi].color_primary_xy.x, bodies[bi].color_primary_xy.y, bodies[bi].color_primary_zw.x);
	vec3 c2 = vec3(bodies[bi].color_secondary_xy.x, bodies[bi].color_secondary_xy.y, bodies[bi].color_secondary_zw.x);
	vec3 c3 = vec3(bodies[bi].color_tertiary_r, bodies[bi].color_tertiary_g, bodies[bi].color_tertiary_b);
	float detail = float(max(bodies[bi].texture_detail_scale, 0.1));
	float noise_scale = float(max(bodies[bi].noise_scale, 0.1)) * detail;
	float roughness = float(clamp(bodies[bi].noise_roughness, 0.05, 1.0));
	uint octaves = clamp(pc.body_noise_octaves, 1u, 6u);
	float cos_t = float(clamp(nrm.z, -1.0, 1.0));
	float theta = acos(cos_t);
	float sin_th = sin(theta);
	vec2 azimuth_vector = vec2(float(nrm.x), float(nrm.y));
	float base_azimuth = (dot(azimuth_vector, azimuth_vector) > 1e-18) ? atan(azimuth_vector.y, azimuth_vector.x) : 0.0;
	float phi = base_azimuth;
	vec3 sph = vec3(sin_th * cos(phi), sin_th * sin(phi), cos_t);
	vec3 sp = sph * noise_scale;
	bool is_photo = (bodies[bi].surface_texture_mode >= 13u);
	float n_val = is_photo ? 0.0 : surface_fbm(sp, octaves, roughness);
	float n_sec = is_photo ? 0.0 : surface_fbm(sp * 2.3 + vec3(11.0, -7.0, 3.0), octaves, roughness);
	float vdn = float(view_dot_n);
	float sun = float(sun_facing);
	uint mode = bodies[bi].surface_texture_mode;
	float emission_base = float(bodies[bi].emission_intensity);
	vec3 col = c1;

	if (mode == 0u) {
		if (n_val < 0.0) {
			float t = clamp((n_val + 1.0) * 0.5, 0.0, 1.0);
			col = vec3(0.02 + 0.05 * t, 0.15 + 0.25 * t, 0.5 + 0.4 * t);
			col += pow(vdn, 32.0) * vec3(0.8, 0.8, 0.9);
		} else {
			col = mix(c1, c2, clamp(n_val * 2.0, 0.0, 1.0));
		}
	} else if (mode == 1u) {
		col = c1;
	} else if (mode == 2u) {
		float t = clamp((n_val + 1.0) * 0.5, 0.0, 1.0);
		vec3 mid = (c1 + c2) * 0.5;
		col = (t < 0.5) ? mix(c1, mid, t * 2.0) : mix(mid, c2, (t - 0.5) * 2.0);
	} else if (mode == 3u) {
		float band = sin(theta * 16.0 + n_val * 4.0);
		col = mix(c1, c2, clamp((band + 1.0) * 0.5, 0.0, 1.0));
	} else if (mode == 4u) {
		float crater = (n_val > 0.25) ? 0.65 : 1.0;
		float rim = (n_val > 0.2 && n_val < 0.3) ? 1.25 : 1.0;
		col = c1 * crater * rim;
		float speckle_t = clamp((n_sec + 1.0) * 0.35, 0.0, 1.0);
		col = mix(col, c2, speckle_t * 0.3);
	} else if (mode == 5u) {
		float gran = pow(abs(n_val), 0.6);
		float limb = 0.4 + 0.6 * vdn;
		float em = max(emission_base, 1.5);
		col = (c1 * gran + vec3(0.25, 0.18, 0.08)) * limb * em;
	} else if (mode == 6u) {
		float flow = sin(phi * 6.0 + n_val * 5.0 + n_sec * 3.0);
		float streak = clamp(flow * 0.5 + 0.5, 0.0, 1.0);
		float heat = clamp(abs(n_sec) * 1.4, 0.0, 1.0);
		float em = max(emission_base, 1.0);
		col = vec3((0.95 + 0.35 * heat) * (0.55 + 0.45 * streak), (0.55 + 0.25 * heat) * (0.55 + 0.45 * streak), (0.20 + 0.10 * heat) * (0.35 + 0.25 * streak)) * em;
	} else if (mode == 7u) {
		float vein = sin((sp.x + sp.y + sp.z) * 3.0 + n_val * 8.0 * detail);
		float vein_sharp = pow(abs(vein), 0.15);
		float base_t = clamp((n_sec + 1.0) * 0.5, 0.0, 1.0);
		col = mix(c1, c2, base_t) * vein_sharp + c3 * (1.0 - vein_sharp);
	} else if (mode == 8u) {
		float band_freq = 10.0 + detail * 6.0;
		float band = sin(theta * band_freq + n_val * 2.5);
		col = mix(c1, c2, clamp((band + 1.0) * 0.5, 0.0, 1.0));
		float polar = pow(abs(cos_t), 3.0) * float(clamp(bodies[bi].polar_cap_strength, 0.0, 1.0));
		col = mix(col, c3, polar);
		if (bodies[bi].ring_system_enabled > 0.5) {
			float eq = pow(clamp(1.0 - abs(theta - 1.5707963) * 3.5, 0.0, 1.0), 2.0) * 0.35;
			col *= (1.0 - eq);
		}
	} else if (mode == 9u) {
		float crack = pow(clamp(1.0 - abs(n_val) * 2.2, 0.0, 1.0), 6.0);
		col = mix(c1, c2, crack);
		float shimmer = clamp((n_sec + 1.0) * 0.25, 0.0, 0.5);
		col = mix(col, c3, shimmer);
	} else if (mode == 10u) {
		float crack_glow = pow(clamp(1.0 - abs(n_val) * 1.8, 0.0, 1.0), 4.0);
		col = mix(c1, c3 * 2.2, crack_glow);
		float patchiness = clamp((n_sec + 1.0) * 0.5, 0.0, 1.0);
		col = mix(col, c2, patchiness * 0.3);
	} else if (mode == 11u) {
		col = mix(c1, c2, clamp((n_val + 1.0) * 0.5, 0.0, 1.0));
		city_speckle = clamp((n_sec + 1.0) * 0.5, 0.0, 1.0);
	} else if (mode == 12u) {
		float w1 = surface_fbm(sp * 0.5, 3u, 0.6);
		float w2 = surface_fbm(sp * 1.7 + vec3(5.0, 0.0, -5.0), 3u, 0.6);
		float t1 = clamp((w1 + 1.0) * 0.5, 0.0, 1.0);
		float t2 = clamp((w2 + 1.0) * 0.5, 0.0, 1.0);
		col = c1 * (1.0 - t1) * (1.0 - t2) + c2 * t1 * (1.0 - t2) + c3 * t2;
	} else if (mode >= 13u) {
		col = shade_photographic_surface(bi, phi, cos_t, sun, vdn, earth_footprint_pixels, c1, emissive);
	} else {
		col = mix(c1, c2, clamp((n_val + 1.0) * 0.5, 0.0, 1.0));
	}

	if (mode != 8u && !is_photo) {
		float polar_strength = float(clamp(bodies[bi].polar_cap_strength, 0.0, 1.0));
		if (polar_strength > 0.0) {
			col = mix(col, c3, pow(abs(cos_t), 3.0) * polar_strength);
		}
		if (bodies[bi].ring_system_enabled > 0.5) {
			float eq = pow(clamp(1.0 - abs(theta - 1.5707963) * 3.5, 0.0, 1.0), 2.0) * 0.35;
			col *= (1.0 - eq);
		}
	}
	if (mode != 11u && !is_photo && bodies[bi].night_side_light_intensity > 0.0) {
		city_speckle = clamp((n_sec + 1.0) * 0.5, 0.0, 1.0);
	}

	uint layer_total = min(bodies[bi].surface_layer_count, 4u);
	for (uint li = 0u; li < layer_total; ++li) {
		if (bodies[bi].surface_layers[li].ids_b.x == 0u) continue;
		vec4 lc = bodies[bi].surface_layers[li].color;
		vec4 pa = bodies[bi].surface_layers[li].params_a;
		vec4 pb = bodies[bi].surface_layers[li].params_b;
		uvec4 ia = bodies[bi].surface_layers[li].ids_a;
		uint layer_octaves = clamp(bodies[bi].surface_layers[li].ids_b.y, 1u, 6u);
		if (pa.x <= 0.0) continue;
		float layer_phi = phi + pb.z * float(pc.time);
		vec3 lp = vec3(sin_th * cos(layer_phi), sin_th * sin(layer_phi), cos_t);
		float v = surface_pattern_value(ia.x, lp, theta, layer_phi, pa.y, layer_octaves, ia.w);
		v = clamp((v - 0.5) * pa.z + 0.5, 0.0, 1.0);
		v = smoothstep(pa.w, pa.w + max(pb.x, 0.001), v);
		float m = surface_mask_value(ia.z, cos_t, sun, pb.y);
		float a = clamp(pa.x * m * v, 0.0, 1.0);
		col = surface_apply_blend(ia.y, col, lc.rgb, a);
		emissive += lc.rgb * (a * pb.w);
	}

	return col;
}

dvec3 source_spin_axis(uint bi) {
	dvec3 axis = dvec3(bodies[bi].spin_axis_x, bodies[bi].spin_axis_y, bodies[bi].spin_axis_z);
	double axis_length = length(axis);
	return (axis_length > 1e-12) ? (axis / axis_length) : dvec3(0.0, 0.0, 1.0);
}

void source_frame(dvec3 axis, out dvec3 frame_x, out dvec3 frame_y) {
	dvec3 helper = (abs(axis.z) < 0.9) ? dvec3(0.0, 0.0, 1.0) : dvec3(1.0, 0.0, 0.0);
	frame_x = normalize(cross(helper, axis));
	frame_y = cross(axis, frame_x);
}

bool segment_captured(dvec3 rel_start, dvec3 seg_vec, double radius) {
	double inverse_radius = 1.0 / max(radius, 1e-12);
	dvec3 s = rel_start * inverse_radius;
	dvec3 d = seg_vec * inverse_radius;
	double a_coeff = dot(d, d);
	if (a_coeff <= 1e-30) return false;
	double b_coeff = 2.0 * dot(s, d);
	double c_coeff = dot(s, s) - 1.0;
	if (c_coeff <= 0.0) return b_coeff < 0.0;
	double discriminant = b_coeff * b_coeff - 4.0 * a_coeff * c_coeff;
	if (discriminant < 0.0) return false;
	double t_entry = (-b_coeff - sqrt(discriminant)) / (2.0 * a_coeff);
	return t_entry >= 0.0 && t_entry <= 1.0;
}

bool intersect_subsidiary_sources(dvec3 seg_start, dvec3 seg_end, out vec3 out_color, out double out_opacity, out bool out_absorbed) {
	out_color = vec3(0.0);
	out_opacity = 0.0;
	out_absorbed = false;
	dvec3 seg_vec = seg_end - seg_start;
	double seg_len_sq = dot(seg_vec, seg_vec);
	if (seg_len_sq <= 1e-18) return false;

	bool any_hit = false;
	vec3 rim_total = vec3(0.0);
	for (uint bi = 0u; bi < pc.body_count; ++bi) {
		if (bodies[bi].preset_3d != 8u) continue;
		double m = max(bodies[bi].mass, 1e-9);
		double a_star = clamp(bodies[bi].spin_parameter, -0.9999, 0.9999);
		double a_spin = a_star * m;
		double rh = m + sqrt(max(m * m - a_spin * a_spin, 0.0));
		dvec3 bpos = dvec3(bodies[bi].position_xy.x, bodies[bi].position_xy.y, bodies[bi].position_zw.x);

		double req = sqrt(rh * rh + a_spin * a_spin);
		dvec3 source_axis = source_spin_axis(bi);
		dvec3 source_fx;
		dvec3 source_fy;
		source_frame(source_axis, source_fx, source_fy);
		dvec3 o = seg_start - bpos;
		dvec3 lo = dvec3(dot(o, source_fx) / req, dot(o, source_fy) / req, dot(o, source_axis) / rh);
		dvec3 lv = dvec3(dot(seg_vec, source_fx) / req, dot(seg_vec, source_fy) / req, dot(seg_vec, source_axis) / rh);
		dvec3 lo_end = lo + lv;
		double q_a = dot(lv, lv);
		double q_b = 2.0 * dot(lo, lv);
		double q_c = dot(lo, lo) - 1.0;
		if (q_c <= 0.0 || dot(lo_end, lo_end) <= 1.0) {
			out_absorbed = true;
			return true;
		}
		double discr = q_b * q_b - 4.0 * q_a * q_c;
		if (q_a > 1e-30 && discr >= 0.0) {
			double sqrt_discr = sqrt(discr);
			double t1 = (-q_b - sqrt_discr) / (2.0 * q_a);
			double t2 = (-q_b + sqrt_discr) / (2.0 * q_a);
			if ((t1 >= 0.0 && t1 <= 1.0) || (t2 >= 0.0 && t2 <= 1.0)) {
				out_absorbed = true;
				return true;
			}
		}

		double rim_seg_len = sqrt(seg_len_sq);
		double rim_t = clamp(-dot(lo, lv) / max(q_a, 1e-30), 0.0, 1.0);
		double rim_d = length(lo + rim_t * lv);
		double rim_band = 0.12;
		if (rim_d > 1.0 && rim_d < 1.0 + rim_band) {
			double rim_ring = 1.0 - (rim_d - 1.0) / rim_band;
			double rim_i = rim_ring * rim_ring * min(rim_seg_len / (rim_band * req), 1.0) * 0.35;
			rim_total += vec3(1.0, 0.75, 0.45) * float(rim_i);
		}

		double prev_z_rel = lo.z * rh;
		double curr_z_rel = lo_end.z * rh;
		double z_span = curr_z_rel - prev_z_rel;
		if (prev_z_rel * curr_z_rel <= 0.0 && abs(z_span) > 1e-15) {
			double isco = kerr_isco_radius_prograde_retrograde(m, a_spin);
			double disk_inner = isco * double(max(bodies[bi].disk.inner_radius_scale, 1.0));
			double disk_outer = max(double(bodies[bi].disk.outer_radius_mass_units) * m, disk_inner * 1.05);
			double s_cross = clamp(abs(prev_z_rel) / abs(z_span), 0.0, 1.0);
			dvec3 cross_pos = lo + s_cross * lv;
			double cross_x = cross_pos.x * req;
			double cross_y = cross_pos.y * req;
			double r_cross = sqrt(max(cross_x * cross_x + cross_y * cross_y - a_spin * a_spin, 0.0));
			if (bodies[bi].disk.enabled > 0.5 && r_cross >= disk_inner && r_cross <= disk_outer) {
				dvec3 segment_local = dvec3(lv.x * req, lv.y * req, lv.z * rh);
				double l_over_e = -(cross_x * segment_local.y - cross_y * segment_local.x) / max(length(segment_local), 1e-30);
				double g_doppler = disk_redshift(m, a_spin, r_cross, l_over_e);
				double azimuth = double(atan(float(cross_y), float(cross_x))) - double(atan(float(a_spin), float(max(r_cross, 1e-12))));
				vec3 shaded_rgb;
				double shaded_opacity;
				disk_shade(bodies[bi].disk, m, a_spin, disk_inner, disk_outer, r_cross, azimuth, g_doppler, pc.time, 1.0, shaded_rgb, shaded_opacity);
				out_color = shaded_rgb;
				out_opacity = shaded_opacity;
				any_hit = true;
			}
		}
		double capture_radius = max(0.9 * m * (5.196152422706632 - 0.55 * a_star * a_star), req * 1.05);
		if (out_opacity <= 0.0 && segment_captured(o, seg_vec, capture_radius)) {
			out_absorbed = true;
			return true;
		}
	}
	if (rim_total.x + rim_total.y + rim_total.z > 0.0) {
		out_color += rim_total;
		any_hit = true;
	}
	return any_hit;
}

struct LightSample {
	dvec3 direction;
	double dist;
	float intensity;
	vec3 color;
	bool lit;
	bool at_origin;
	int source_index;
};

const float EMITTER_THRESHOLD = 1e-3;
const uint BEACON_BODY_ID_BASE = 0xFFFF0000u;

dvec3 body_center(uint bi) {
	return dvec3(bodies[bi].position_xy.x, bodies[bi].position_xy.y, bodies[bi].position_zw.x);
}

vec3 body_primary_color(uint bi) {
	return vec3(bodies[bi].color_primary_xy.x, bodies[bi].color_primary_xy.y, bodies[bi].color_primary_zw.x);
}

void place_light(inout LightSample s, dvec3 position, dvec3 hit, bool at_origin) {
	dvec3 delta = position - hit;
	double d = length(delta);
	s.dist = d;
	s.direction = (d > 1e-9) ? (delta / d) : dvec3(0.0, 0.0, 1.0);
	s.at_origin = at_origin;
}

LightSample resolve_body_light(dvec3 hit, uint self_index) {
	LightSample s;
	s.direction = dvec3(0.0, 0.0, 1.0);
	s.dist = 1.0e30;
	s.intensity = pc.light_intensity;
	s.color = vec3(pc.light_color_r, pc.light_color_g, pc.light_color_b);
	s.lit = true;
	s.at_origin = false;
	s.source_index = -1;

	if (self_index < pc.body_count && bodies[self_index].body_id >= BEACON_BODY_ID_BASE) {
		s.lit = false;
		s.intensity = 1.0;
		s.color = vec3(1.0);
		return s;
	}

	uint mode = min(pc.light_source_mode, 6u);
	if (mode == 6u) {
		s.lit = false;
		return s;
	}

	if (mode == 1u) {
		place_light(s, spherical_to_cartesian(pc.observer_position.y, pc.observer_position.z, pc.observer_position.w), hit, false);
	} else if (mode == 2u) {
		dvec3 d = dvec3(pc.light_direction_x, pc.light_direction_y, pc.light_direction_z);
		double dl = length(d);
		s.direction = (dl > 1e-9) ? (d / dl) : dvec3(0.0, 0.0, 1.0);
	} else if (mode == 3u) {
		place_light(s, dvec3(pc.light_position_x, pc.light_position_y, pc.light_position_z), hit, false);
	} else if (mode == 4u || mode == 5u) {
		int found = -1;
		double best = 1.0e30;
		for (uint bi = 0u; bi < pc.body_count; ++bi) {
			if (bi == self_index) continue;
			if (mode == 5u) {
				if (bodies[bi].body_id == pc.light_source_body_id) {
					found = int(bi);
					break;
				}
			} else if (bodies[bi].preset_3d != 8u && bodies[bi].emission_intensity > double(EMITTER_THRESHOLD)) {
				dvec3 delta = body_center(bi) - hit;
				double d2 = dot(delta, delta);
				if (d2 < best) {
					best = d2;
					found = int(bi);
				}
			}
		}
		if (found >= 0) {
			place_light(s, body_center(uint(found)), hit, false);
			s.source_index = found;
			s.color *= body_primary_color(uint(found));
		} else {
			place_light(s, dvec3(0.0), hit, true);
		}
	} else {
		place_light(s, dvec3(0.0), hit, true);
	}

	if (pc.light_attenuation_mode == 1u && s.dist < 5.0e29) {
		double ratio = double(pc.light_reference_distance) / max(s.dist, 1e-6);
		s.intensity = pc.light_intensity * float(min(ratio * ratio, 64.0));
	}
	return s;
}

float wrapped_diffuse(float ndl, float softness) {
	float w = clamp(softness, 0.0, 1.0);
	return clamp((ndl + w) / (1.0 + w), 0.0, 1.0);
}

bool light_is_occluded(dvec3 hit, LightSample s, uint self_index) {
	if (s.dist < 1e-6) return false;
	uint casters_tested = 0u;
	uint caster_limit = max(pc.body_shadow_caster_limit, 1u);
	for (uint bi = 0u; bi < pc.body_count; ++bi) {
		if (casters_tested >= caster_limit) break;
		if (bi == self_index || int(bi) == s.source_index || bodies[bi].body_id >= BEACON_BODY_ID_BASE) continue;
		++casters_tested;
		dvec3 to_body = body_center(bi) - hit;
		double proj = dot(to_body, s.direction);
		if (proj <= 1e-6 || proj >= s.dist) continue;
		dvec3 closest = hit + s.direction * proj - body_center(bi);
		double occluder_radius = max(bodies[bi].radius, 1e-6) * max(bodies[bi].oblateness_ratio, 1.0);
		if (dot(closest, closest) < occluder_radius * occluder_radius) return true;
	}
	if (!s.at_origin && pc.horizon_radius > 0.0) {
		double proj_h = dot(-hit, s.direction);
		if (proj_h > 1e-6 && proj_h < s.dist) {
			dvec3 closest_h = hit + s.direction * proj_h;
			if (dot(closest_h, closest_h) < pc.horizon_radius * pc.horizon_radius) return true;
		}
	}
	return false;
}

vec3 emitted_irradiance(dvec3 hit, dvec3 nrm, uint self_index, int excluded_index) {
	vec3 total = vec3(0.0);
	double reference = double(pc.body_emission_lighting_reference_distance);
	double gain = double(pc.body_emission_lighting_gain);
	uint sources_used = 0u;
	uint source_limit = max(pc.body_emission_source_limit, 1u);
	for (uint bi = 0u; bi < pc.body_count; ++bi) {
		if (sources_used >= source_limit) break;
		if (bi == self_index || int(bi) == excluded_index) continue;
		double emission = bodies[bi].emission_intensity;
		if (bodies[bi].preset_3d == 8u || emission <= double(EMITTER_THRESHOLD)) continue;
		++sources_used;
		dvec3 delta = body_center(bi) - hit;
		double d = length(delta);
		if (d < 1e-9) continue;
		double n_dot_l = dot(nrm, delta) / d;
		if (n_dot_l <= 0.0) continue;
		double effective_distance = max(d, max(bodies[bi].radius, 1e-6));
		double ratio = reference / effective_distance;
		double weight = gain * emission * min(ratio * ratio, 16.0) * n_dot_l;
		total += float(weight) * body_primary_color(bi);
	}
	return total;
}

dvec4 body_orientation(uint bi) {
	dvec4 q = dvec4(bodies[bi].orientation_w, bodies[bi].orientation_x, bodies[bi].orientation_y, bodies[bi].orientation_z);
	double length_squared = dot(q, q);
	return (length_squared > 1e-24) ? (q * inversesqrt(length_squared)) : dvec4(1.0, 0.0, 0.0, 0.0);
}

dvec3 quat_rotate(dvec4 q, dvec3 v) {
	dvec3 u = q.yzw;
	dvec3 t = 2.0 * cross(u, v);
	return v + q.x * t + cross(u, t);
}

dvec3 quat_rotate_inverse(dvec4 q, dvec3 v) {
	return quat_rotate(dvec4(q.x, -q.yzw), v);
}

bool intersect_bodies(dvec3 ray_pos, dvec3 ray_dir, double max_dist, out vec3 out_color, out uint out_status, out double out_hit_dist) {
	bool hit_any = false;
	double best_t = max_dist;
	vec3 best_color = vec3(0.0);
	uint lighting_detail = min(pc.body_lighting_detail, 2u);

	for (uint bi = 0u; bi < pc.body_count; ++bi) {
		if (bodies[bi].preset_3d == 8u) continue;
		dvec3 bpos = dvec3(bodies[bi].position_xy.x, bodies[bi].position_xy.y, bodies[bi].position_zw.x);
		if (any(isnan(bpos)) || any(isinf(bpos)) || isnan(bodies[bi].radius) || isinf(bodies[bi].radius)) continue;
		double radius = clamp(bodies[bi].radius, 1e-6, 1.0e15);
		double oblateness = clamp(bodies[bi].oblateness_ratio, 0.1, 5.0);

		double scale_a = radius;
		double scale_b = radius;
		double scale_c = radius;
		uint geom = bodies[bi].geometry_model;
		if (geom == 0u) {
			scale_c = radius * oblateness;
		} else if (geom == 2u) {
			scale_c = radius / max(oblateness, 0.1);
		} else if (geom == 3u) {
			scale_b = radius * 0.85;
			scale_c = radius * oblateness;
		}

		dvec3 o = ray_pos - bpos;
		double bound_radius = max(scale_a, max(scale_b, scale_c));
		double max_reach = bound_radius + best_t;
		double dist_sq = dot(o, o);
		if (dist_sq > max_reach * max_reach) continue;
		double bound_b = dot(o, ray_dir);
		double bound_disc = bound_b * bound_b - (dist_sq - bound_radius * bound_radius);
		if (bound_disc < 0.0) continue;
		double bound_root = sqrt(bound_disc);
		if (-bound_b + bound_root < 1e-5 || -bound_b - bound_root > best_t) continue;

		double inv_a2 = 1.0 / (scale_a * scale_a);
		double inv_b2 = 1.0 / (scale_b * scale_b);
		double inv_c2 = 1.0 / (scale_c * scale_c);

		dvec4 body_q = body_orientation(bi);
		dvec3 local_o = quat_rotate_inverse(body_q, o);
		dvec3 local_d = quat_rotate_inverse(body_q, ray_dir);

		double A = local_d.x * local_d.x * inv_a2 + local_d.y * local_d.y * inv_b2 + local_d.z * local_d.z * inv_c2;
		double B = 2.0 * (local_o.x * local_d.x * inv_a2 + local_o.y * local_d.y * inv_b2 + local_o.z * local_d.z * inv_c2);
		double C = local_o.x * local_o.x * inv_a2 + local_o.y * local_o.y * inv_b2 + local_o.z * local_o.z * inv_c2 - 1.0;

		double discr = B * B - 4.0 * A * C;
		if (!(A > 1e-300) || !(discr >= 0.0)) continue;
		double sqrt_discr = sqrt(discr);
		double t1 = (-B - sqrt_discr) / (2.0 * A);
		double t2 = (-B + sqrt_discr) / (2.0 * A);
		double t = -1.0;
		if (t1 > 1e-5) t = t1;
		else if (t2 > 1e-5) t = t2;
		if (t <= 1e-5 || t >= best_t) continue;

		dvec3 hit_pos = ray_pos + ray_dir * t;
		dvec3 local_hit = local_o + local_d * t;
		dvec3 local_nrm = dvec3(local_hit.x * inv_a2, local_hit.y * inv_b2, local_hit.z * inv_c2);
		double n_len = length(local_nrm);
		if (n_len > 1e-12) local_nrm = local_nrm / n_len;
		dvec3 nrm = quat_rotate(body_q, local_nrm);

		double dist_to_cam = length(o);
		double angular_pixel_size = pc.field_of_view_rad / max(double(pc.screen_width), 1.0);
		double max_axis = max(scale_a, max(scale_b, scale_c));
		double apparent_radius = double(asin(float(clamp(max_axis / max(dist_to_cam, 1e-9), 0.0, 1.0))));
		double coverage = clamp(apparent_radius / max(angular_pixel_size, 1e-12), 0.0, 1.0e7);

		bool is_point_lod = (pc.body_render_low_power_mode == 0u) && (coverage < double(max(pc.body_render_point_pixel_threshold, 1u)));
		bool is_simple_lod = (pc.body_render_low_power_mode != 0u) || is_point_lod || (coverage < double(pc.body_render_lod_pixel_threshold));

		vec3 surf = vec3(bodies[bi].color_primary_xy.x, bodies[bi].color_primary_xy.y, bodies[bi].color_primary_zw.x);

		vec3 surface_emissive = vec3(0.0);
		float surface_city_speckle = 0.0;
		double surface_view_dot_n = max(0.0, dot(-ray_dir, nrm));
		LightSample body_light = resolve_body_light(hit_pos, bi);
		double surface_sun_facing = body_light.lit ? dot(nrm, body_light.direction) : 1.0;
		bool photo_surface = (bodies[bi].surface_texture_mode >= 13u) && (pc.body_render_low_power_mode == 0u);
		if (!is_simple_lod || photo_surface) {
			surf = shade_body_surface(bi, local_nrm, surface_sun_facing, surface_view_dot_n, surface_emissive, surface_city_speckle, float(coverage) * 6.28318531);
		}

		double view_dot_n = max(0.0, dot(-ray_dir, nrm));
		double raw_ndl = body_light.lit ? dot(nrm, body_light.direction) : 1.0;
		bool shadowed = false;
		if (!is_point_lod && lighting_detail != 0u && body_light.lit && raw_ndl > 0.0 && (pc.render_flags & (1u << 16)) != 0u) {
			shadowed = light_is_occluded(hit_pos, body_light, bi);
		}

		vec3 light_factor = vec3(1.0);
		vec3 specular_add = vec3(0.0);
		if (!is_point_lod) {
			float terminator_softness = photo_surface ? max(pc.light_terminator_softness, float(bodies[bi].earth_terminator_softness)) : pc.light_terminator_softness;
			float lit_amount = body_light.lit ? (shadowed ? 0.0 : wrapped_diffuse(float(raw_ndl), terminator_softness)) : 1.0;
			float ambient_level = body_light.lit ? pc.light_ambient : 0.0;
			light_factor = vec3(ambient_level) + body_light.color * (lit_amount * body_light.intensity);
			if (pc.body_emission_lighting_enabled != 0u && lighting_detail != 0u) {
				light_factor += emitted_irradiance(hit_pos, nrm, bi, body_light.source_index);
			}
			if (lighting_detail != 0u && body_light.lit && !shadowed && raw_ndl > 0.0) {
				dvec3 half_vec = body_light.direction - ray_dir;
				double half_len = length(half_vec);
				if (half_len > 1e-9) {
					double spec_dot = max(0.0, dot(nrm, half_vec / half_len));
					double rough = clamp(bodies[bi].specular_roughness, 0.0, 1.0);
					double shininess = 4.0 + (1.0 - rough) * 80.0;
					float spec = pow(float(spec_dot), float(shininess)) * float((1.0 - rough) * 0.6);
					specular_add = body_light.color * (spec * body_light.intensity * pc.light_specular_scale);
				}
			}
		}
		light_factor += vec3(float(max(bodies[bi].emission_intensity, 0.0)));
		surf = surf * light_factor + specular_add;
		if (!is_point_lod) {
			double night_gain = clamp(1.0 - max(0.0, surface_sun_facing) * 5.0, 0.0, 1.0);
			float city_glow = float(night_gain * bodies[bi].night_side_light_intensity) * surface_city_speckle;
			surf += vec3(1.1, 0.95, 0.6) * city_glow;
		}
		surf += surface_emissive;

		if ((pc.render_flags & (1u << 13)) != 0u) {
			dvec3 vel = dvec3(bodies[bi].velocity_xy.x, bodies[bi].velocity_xy.y, bodies[bi].velocity_zw.x);
			double v_sq = dot(vel, vel);
			if (v_sq > 1e-12) {
				double beta = min(sqrt(v_sq), 0.9999);
				double beta_dot_n = dot(vel, ray_dir) / beta;
				double gamma = 1.0 / sqrt(1.0 - beta * beta);
				double doppler = 1.0 / (gamma * (1.0 - beta * beta_dot_n));
				float d_factor = float(clamp(doppler * doppler * doppler, 0.1, 10.0));
				surf *= d_factor;
			}
		}

		if ((pc.render_flags & (1u << 14)) != 0u && bodies[bi].mass > 0.0) {
			double z_factor = sqrt(max(1.0 - 2.0 * bodies[bi].mass / radius, 0.05));
			surf *= vec3(float(z_factor), float(z_factor * 0.9), float(z_factor * 0.7));
		}

		if ((pc.render_flags & (1u << 15)) != 0u && !is_simple_lod && bodies[bi].atmosphere_mode != 2u) {
			float rim = pow(1.0 - float(view_dot_n), 3.0);
			float atmo_thick = float(bodies[bi].atmosphere_thickness * pc.body_atmosphere_global_intensity);
			vec3 acol = vec3(bodies[bi].atmosphere_color_xy.x, bodies[bi].atmosphere_color_xy.y, bodies[bi].atmosphere_color_zw.x);
			float aa = float(bodies[bi].atmosphere_color_zw.y);
			surf = surf * (1.0 - rim * aa) + acol * rim * atmo_thick * 2.5;
		}

		best_t = t;
		if (any(isnan(surf)) || any(isinf(surf))) surf = vec3(0.0);
		best_color = clamp(surf, 0.0, 10.0);
		hit_any = true;
	}

	out_color = best_color;
	out_status = hit_any ? 16u : 0u;
	out_hit_dist = best_t;
	return hit_any;
}

bool attempt_analytic_space_skip(inout double ray_r, inout double ray_th, inout double ray_phi, inout double ray_pr, inout double ray_pth, inout double ray_pphi, double space_skip_radius, double escape_radius, double mass) {
	if (ray_r <= space_skip_radius) {
		return false;
	}

	dvec2 sincos_th = precise_sincos(ray_th);
	double sin_t = sincos_th.x;
	double cos_t = sincos_th.y;
	float phi_f = float(ray_phi);
	double sin_p = double(sin(phi_f));
	double cos_p = double(cos(phi_f));

	double px = ray_r * sin_t * cos_p;
	double py = ray_r * sin_t * sin_p;
	double pz = ray_r * cos_t;

	double local_radial = ray_pr / sqrt(max(1.0 - 2.0 * mass / ray_r, 1e-6));
	double dx = -(local_radial * sin_t * cos_p + ray_r * ray_pth * cos_t * cos_p - ray_r * sin_t * ray_pphi * sin_p);
	double dy = -(local_radial * sin_t * sin_p + ray_r * ray_pth * cos_t * sin_p + ray_r * sin_t * ray_pphi * cos_p);
	double dz = -(local_radial * cos_t - ray_r * ray_pth * sin_t);

	double dir_norm_sq = dx * dx + dy * dy + dz * dz;
	if (dir_norm_sq <= 1e-30) {
		return false;
	}

	double cross_x = py * dz - pz * dy;
	double cross_y = pz * dx - px * dz;
	double cross_z = px * dy - py * dx;
	double cross_norm = sqrt(cross_x * cross_x + cross_y * cross_y + cross_z * cross_z);
	double dir_norm_for_impact = sqrt(dir_norm_sq);
	double impact_parameter_relative = (dir_norm_for_impact > 1e-30) ? (cross_norm / dir_norm_for_impact) : 0.0;
	if (impact_parameter_relative > mass * 0.05 && mass > 0.0) {
		double impact_parameter = impact_parameter_relative;
		double deflection = min(4.0 * mass / max(impact_parameter, mass * 1e-6), 0.6);
		double nx = cross_x / cross_norm;
		double ny = cross_y / cross_norm;
		double nz = cross_z / cross_norm;
		double wx = ny * dz - nz * dy;
		double wy = nz * dx - nx * dz;
		double wz = nx * dy - ny * dx;
		float defl_f = float(deflection);
		double cos_a = double(cos(defl_f));
		double sin_a = double(sin(defl_f));
		double rdx = dx * cos_a + wx * sin_a;
		double rdy = dy * cos_a + wy * sin_a;
		double rdz = dz * cos_a + wz * sin_a;
		dx = rdx;
		dy = rdy;
		dz = rdz;
	}

	double p_dot_d = px * dx + py * dy + pz * dz;
	double p_dot_p = px * px + py * py + pz * pz;

	double t_skip = -1.0;
	{
		double c_coeff = p_dot_p - space_skip_radius * space_skip_radius;
		double b_coeff = 2.0 * p_dot_d;
		double discr = b_coeff * b_coeff - 4.0 * dir_norm_sq * c_coeff;
		if (discr >= 0.0) {
			double sqrt_discr = sqrt(discr);
			double t1 = (-b_coeff - sqrt_discr) / (2.0 * dir_norm_sq);
			double t2 = (-b_coeff + sqrt_discr) / (2.0 * dir_norm_sq);
			if (t1 > 1e-9) t_skip = t1;
			if (t2 > 1e-9 && (t_skip < 0.0 || t2 < t_skip)) t_skip = t2;
		}
	}

	double t_escape = -1.0;
	{
		double c_coeff = p_dot_p - escape_radius * escape_radius;
		double b_coeff = 2.0 * p_dot_d;
		double discr = b_coeff * b_coeff - 4.0 * dir_norm_sq * c_coeff;
		if (discr >= 0.0) {
			double sqrt_discr = sqrt(discr);
			double t1 = (-b_coeff - sqrt_discr) / (2.0 * dir_norm_sq);
			double t2 = (-b_coeff + sqrt_discr) / (2.0 * dir_norm_sq);
			if (t1 > 1e-9) t_escape = t1;
			if (t2 > 1e-9 && (t_escape < 0.0 || t2 < t_escape)) t_escape = t2;
		}
	}

	double t_leap;
	if (t_skip > 0.0 && t_escape > 0.0) {
		t_leap = min(t_skip, t_escape);
	} else if (t_skip > 0.0) {
		t_leap = t_skip;
	} else if (t_escape > 0.0) {
		t_leap = t_escape;
	} else {
		return false;
	}

	if (t_leap <= 1e-6) {
		return false;
	}

	double new_px = px + t_leap * dx;
	double new_py = py + t_leap * dy;
	double new_pz = pz + t_leap * dz;

	double new_r = sqrt(new_px * new_px + new_py * new_py + new_pz * new_pz);
	if (new_r <= 1e-9) {
		return false;
	}

	float new_cos_theta_f = float(clamp(new_pz / new_r, -1.0, 1.0));
	double new_theta = double(acos(new_cos_theta_f));
	double new_phi = double(atan(float(new_py), float(new_px)));

	dvec2 sincos_new_th = precise_sincos(new_theta);
	double new_sin_t = sincos_new_th.x;
	double safe_sin_t = (abs(new_sin_t) > 1e-9) ? new_sin_t : ((new_sin_t >= 0.0) ? 1e-9 : -1e-9);

	double new_local_f = max(1.0 - 2.0 * mass / new_r, 1e-6);
	double inv_dir_len = 1.0 / sqrt(dir_norm_sq);
	double travel_x = dx * inv_dir_len;
	double travel_y = dy * inv_dir_len;
	double travel_z = dz * inv_dir_len;
	double travel_radial = (new_px * travel_x + new_py * travel_y + new_pz * travel_z) / new_r;
	double inv_sqrt_new_f = 1.0 / sqrt(new_local_f);
	double new_pr = -travel_radial;
	double new_pth = -((travel_radial * (new_pz / new_r) - travel_z) / (new_r * safe_sin_t)) * inv_sqrt_new_f;
	double r2_sin2 = new_r * new_r * new_sin_t * new_sin_t;
	double new_pphi = (abs(r2_sin2) > 1e-12) ? (-((new_px * travel_y - new_py * travel_x) / r2_sin2) * inv_sqrt_new_f) : 0.0;

	ray_r = new_r;
	ray_th = new_theta;
	ray_phi = new_phi;
	ray_pr = new_pr;
	ray_pth = new_pth;
	ray_pphi = new_pphi;
	return true;
}

void apply_subsidiary_deflection(inout double ray_r, double ray_th, double ray_phi, inout double ray_pr, inout double ray_pth, inout double ray_pphi, double dt) {
	if (pc.body_count == 0u) return;

	dvec3 pos = spherical_to_cartesian(ray_r, ray_th, ray_phi);
	dvec2 sincos_th = precise_sincos(ray_th);
	double sin_t = sincos_th.x;
	double cos_t = sincos_th.y;
	float phi_f = float(ray_phi);
	double sin_p = double(sin(phi_f));
	double cos_p = double(cos(phi_f));

	dvec3 v = dvec3(
		ray_pr * sin_t * cos_p + ray_r * ray_pth * cos_t * cos_p - ray_r * sin_t * ray_pphi * sin_p,
		ray_pr * sin_t * sin_p + ray_r * ray_pth * cos_t * sin_p + ray_r * sin_t * ray_pphi * cos_p,
		ray_pr * cos_t - ray_r * ray_pth * sin_t
	);
	double speed = length(v);
	if (speed < 1e-12) return;
	dvec3 dir = v / speed;
	bool any_correction = false;

	for (uint bi = 0u; bi < pc.body_count; ++bi) {
		if (bodies[bi].preset_3d != 8u) continue;
		dvec3 bpos = dvec3(bodies[bi].position_xy.x, bodies[bi].position_xy.y, bodies[bi].position_zw.x);
		double m = max(bodies[bi].mass, 1e-9);
		double a_star = clamp(bodies[bi].spin_parameter, -0.9999, 0.9999);
		double a_spin = a_star * m;
		double rh = m + sqrt(max(m * m - a_spin * a_spin, 0.0));

		dvec3 rel = pos - bpos;
		double r_len = length(rel);
		dvec3 deflection_axis = source_spin_axis(bi);
		dvec3 deflection_fx;
		dvec3 deflection_fy;
		source_frame(deflection_axis, deflection_fx, deflection_fy);
		double horizon_equatorial = sqrt(rh * rh + a_spin * a_spin);
		dvec3 scaled_rel = dvec3(dot(rel, deflection_fx) / horizon_equatorial, dot(rel, deflection_fy) / horizon_equatorial, dot(rel, deflection_axis) / rh);
		if (length(scaled_rel) < 1.5) continue;
		if (r_len > m * 2000.0) continue;

		double proj = dot(rel, dir);
		dvec3 perp = rel - proj * dir;
		double impact_param = length(perp);
		if (impact_param < rh * 0.1) continue;

		double cross_x = rel.y * dir.z - rel.z * dir.y;
		double cross_y = rel.z * dir.x - rel.x * dir.z;
		double cross_z = rel.x * dir.y - rel.y * dir.x;
		double cross_norm = sqrt(cross_x * cross_x + cross_y * cross_y + cross_z * cross_z);
		if (cross_norm < 1e-12) continue;
		dvec3 n_axis = dvec3(cross_x, cross_y, cross_z) / cross_norm;

		double monopole_term = 2.0 * m * impact_param;
		double gravitomagnetic_term = -2.0 * a_spin * m * dot(deflection_axis, n_axis);
		double quadrupole_term = 5.890486225480862 * m * m;
		double total_deflection = min(max(monopole_term + gravitomagnetic_term + quadrupole_term, 0.0) * abs(dt) * speed / (r_len * r_len * r_len), 0.5);
		if (total_deflection < 1e-14) continue;

		double wx = n_axis.y * dir.z - n_axis.z * dir.y;
		double wy = n_axis.z * dir.x - n_axis.x * dir.z;
		double wz = n_axis.x * dir.y - n_axis.y * dir.x;

		float defl_f = float(total_deflection);
		double cos_a = double(cos(defl_f));
		double sin_a = double(sin(defl_f));
		dvec3 new_dir = dir * cos_a + dvec3(wx, wy, wz) * sin_a;
		double new_len = length(new_dir);
		if (new_len > 1e-12) {
			dir = new_dir / new_len;
			any_correction = true;
		}
	}

	if (!any_correction) return;

	dvec3 new_v = dir * speed;
	double safe_sin_t = (abs(sin_t) > 1e-9) ? sin_t : ((sin_t >= 0.0) ? 1e-9 : -1e-9);
	ray_pr = new_v.x * sin_t * cos_p + new_v.y * sin_t * sin_p + new_v.z * cos_t;
	ray_pth = (new_v.x * cos_t * cos_p + new_v.y * cos_t * sin_p - new_v.z * sin_t) / max(ray_r, 1e-9);
	ray_pphi = (-new_v.x * sin_p + new_v.y * cos_p) / max(ray_r * safe_sin_t, 1e-9);
}

dvec2 sincos_wide(double angle) {
	double h = angle * 0.125;
	double h2 = h * h;
	double sin_h = h * (1.0 - h2 * (1.0 / 6.0 - h2 * (1.0 / 120.0 - h2 * (1.0 / 5040.0 - h2 * (1.0 / 362880.0 - h2 / 39916800.0)))));
	double cos_h = 1.0 - h2 * (0.5 - h2 * (1.0 / 24.0 - h2 * (1.0 / 720.0 - h2 * (1.0 / 40320.0 - h2 * (1.0 / 3628800.0 - h2 / 479001600.0)))));
	double sin_2h = 2.0 * sin_h * cos_h;
	double cos_2h = 1.0 - 2.0 * sin_h * sin_h;
	double sin_4h = 2.0 * sin_2h * cos_2h;
	double cos_4h = 1.0 - 2.0 * sin_2h * sin_2h;
	double sin_8h = 2.0 * sin_4h * cos_4h;
	double cos_8h = 1.0 - 2.0 * sin_4h * sin_4h;
	return dvec2(sin_8h, cos_8h);
}

double atan2_wide(double y, double x) {
	if (abs(x) + abs(y) < 1e-300) {
		return 0.0;
	}
	double angle = double(atan(float(y), float(x)));
	for (int iteration = 0; iteration < 2; ++iteration) {
		dvec2 sc = sincos_wide(angle);
		double residual = x * sc.x - y * sc.y;
		double slope = x * sc.y + y * sc.x;
		if (abs(slope) > 1e-300) {
			angle -= residual / slope;
		}
	}
	return angle;
}

dvec3 schwarzschild_null_accel(dvec3 pos, double angular_momentum_sq, double rs) {
	double r2 = max(dot(pos, pos), 1e-30);
	double r = sqrt(r2);
	return pos * (-1.5 * rs * angular_momentum_sq / (r2 * r2 * r));
}

void schwarzschild_null_step(inout double ray_r, inout double ray_th, inout double ray_phi, inout double ray_pr, inout double ray_pth, inout double ray_pphi, double dt, double rs) {
	const double two_pi = 6.283185307179586;
	dvec2 sc_th = sincos_wide(ray_th);
	double phi_reduced = ray_phi - two_pi * floor((ray_phi + PI_D) / two_pi);
	dvec2 sc_ph = sincos_wide(phi_reduced);
	double sin_t = sc_th.x;
	double cos_t = sc_th.y;
	double sin_p = sc_ph.x;
	double cos_p = sc_ph.y;

	dvec3 pos = ray_r * dvec3(sin_t * cos_p, sin_t * sin_p, cos_t);
	dvec3 vel = dvec3(
		ray_pr * sin_t * cos_p + ray_r * ray_pth * cos_t * cos_p - ray_r * sin_t * ray_pphi * sin_p,
		ray_pr * sin_t * sin_p + ray_r * ray_pth * cos_t * sin_p + ray_r * sin_t * ray_pphi * cos_p,
		ray_pr * cos_t - ray_r * ray_pth * sin_t
	);

	dvec3 angular = cross(pos, vel);
	double h2 = dot(angular, angular);
	double half_dt = 0.5 * dt;

	dvec3 k1x = vel;
	dvec3 k1v = schwarzschild_null_accel(pos, h2, rs);
	dvec3 p1 = pos + half_dt * k1x;
	dvec3 v1 = vel + half_dt * k1v;
	dvec3 k2x = v1;
	dvec3 k2v = schwarzschild_null_accel(p1, h2, rs);
	dvec3 p2 = pos + half_dt * k2x;
	dvec3 v2 = vel + half_dt * k2v;
	dvec3 k3x = v2;
	dvec3 k3v = schwarzschild_null_accel(p2, h2, rs);
	dvec3 p3 = pos + dt * k3x;
	dvec3 v3 = vel + dt * k3v;
	dvec3 k4x = v3;
	dvec3 k4v = schwarzschild_null_accel(p3, h2, rs);

	double sixth = dt / 6.0;
	pos += sixth * (k1x + 2.0 * k2x + 2.0 * k3x + k4x);
	vel += sixth * (k1v + 2.0 * k2v + 2.0 * k3v + k4v);

	double rho2 = pos.x * pos.x + pos.y * pos.y;
	double rho = sqrt(rho2);
	double r_new = sqrt(rho2 + pos.z * pos.z);
	if (r_new < 1e-30) {
		return;
	}

	ray_r = r_new;
	ray_th = atan2_wide(rho, pos.z);
	ray_pr = dot(pos, vel) / r_new;
	if (rho > 1e-13 * r_new) {
		double phi_new = atan2_wide(pos.y, pos.x);
		double delta = phi_new - ray_phi;
		delta -= two_pi * floor(delta / two_pi + 0.5);
		ray_phi += delta;
		ray_pth = (pos.z * (pos.x * vel.x + pos.y * vel.y) - rho2 * vel.z) / (r_new * r_new * rho);
		ray_pphi = (pos.x * vel.y - pos.y * vel.x) / rho2;
	} else {
		double lateral_speed = sqrt(vel.x * vel.x + vel.y * vel.y);
		if (lateral_speed > 0.0) {
			double phi_new = atan2_wide(vel.y, vel.x);
			double delta = phi_new - ray_phi;
			delta -= two_pi * floor(delta / two_pi + 0.5);
			ray_phi += delta;
		}
		ray_pth = ((pos.z >= 0.0) ? lateral_speed : -lateral_speed) / r_new;
		ray_pphi = 0.0;
	}
}

void kerr_newman_rk4_step(inout double ray_r, inout double ray_th, inout double ray_phi, inout dvec4 u, double dt, double mass, double a, double rq2) {
	double half_dt = 0.5 * dt;

	dvec3 x0 = dvec3(ray_r, ray_th, ray_phi);
	dvec4 u0 = u;

	dvec3 k1x = dvec3(u0.y, u0.z, u0.w);
	dvec4 k1u = kerr_newman_geodesic_derivative(u0, x0.x, x0.y, mass, a, rq2);

	dvec3 x1 = x0 + half_dt * k1x;
	dvec4 u1 = u0 + half_dt * k1u;
	dvec3 k2x = dvec3(u1.y, u1.z, u1.w);
	dvec4 k2u = kerr_newman_geodesic_derivative(u1, x1.x, x1.y, mass, a, rq2);

	dvec3 x2 = x0 + half_dt * k2x;
	dvec4 u2 = u0 + half_dt * k2u;
	dvec3 k3x = dvec3(u2.y, u2.z, u2.w);
	dvec4 k3u = kerr_newman_geodesic_derivative(u2, x2.x, x2.y, mass, a, rq2);

	dvec3 x3 = x0 + dt * k3x;
	dvec4 u3 = u0 + dt * k3u;
	dvec3 k4x = dvec3(u3.y, u3.z, u3.w);
	dvec4 k4u = kerr_newman_geodesic_derivative(u3, x3.x, x3.y, mass, a, rq2);

	double sixth = dt / 6.0;
	dvec3 x_new = x0 + sixth * (k1x + 2.0 * k2x + 2.0 * k3x + k4x);
	dvec4 u_new = u0 + sixth * (k1u + 2.0 * k2u + 2.0 * k3u + k4u);
	ray_r = x_new.x;
	ray_th = x_new.y;
	ray_phi = x_new.z;
	u = u_new;
}

double dm_fraction_nfw(double x) {
	if (x < 0.25) {
		double power = x * x;
		double sign_value = 1.0;
		double sum = 0.0;
		for (int k = 2; k <= 20; ++k) {
			sum += sign_value * power * double(k - 1) / double(k);
			power *= x;
			sign_value = -sign_value;
		}
		return sum;
	}
	return double(log(float(1.0 + x))) - x / (1.0 + x);
}

double dm_fraction_burkert(double x) {
	if (x < 0.6) {
		double x4 = x * x * x * x;
		double p3 = x * x * x;
		double p4 = x4;
		double sum = 0.0;
		for (int j = 0; j < 10; ++j) {
			sum += 2.0 * p3 / double(4 * j + 3) - 2.0 * p4 / double(4 * j + 4);
			p3 *= x4;
			p4 *= x4;
		}
		return sum;
	}
	return double(log(float(1.0 + x))) + 0.5 * double(log(float(1.0 + x * x))) - double(atan(float(x)));
}

double dm_fraction_cored_isothermal(double x) {
	if (x < 0.3) {
		double x2 = x * x;
		double power = x2 * x;
		double sign_value = 1.0;
		double sum = 0.0;
		for (int k = 1; k <= 10; ++k) {
			sum += sign_value * power / double(2 * k + 1);
			power *= x2;
			sign_value = -sign_value;
		}
		return sum;
	}
	return x - double(atan(float(x)));
}

double dm_fraction_einasto(double x, double alpha, double lgamma_s) {
	double s = 3.0 / alpha;
	double y = (2.0 / alpha) * double(pow(float(x), float(alpha)));
	if (y < 1e-30) return 0.0;
	if (y > s + 14.0 * sqrt(s) + 40.0) return 1.0;
	double log_prefactor = s * double(log(float(y))) - y - lgamma_s - double(log(float(s)));
	double term = 1.0;
	double sum = 1.0;
	for (int n = 1; n <= 320; ++n) {
		term *= y / (s + double(n));
		sum += term;
		if (term < 1e-14 * sum) break;
	}
	return min(exp_d(log_prefactor) * sum, 1.0);
}

const double DM_SOLITON_B = 0.091;

double dm_fraction_moore(double x) {
	double y = x * sqrt(x);
	if (y < 1e-4) return y * (1.0 - 0.5 * y + y * y / 3.0);
	return log_d(1.0 + y);
}

double dm_fraction_beta_model(double x) {
	if (x < 0.15) {
		double x2 = x * x;
		return x * x2 * (1.0 / 3.0 - x2 * (0.3 - x2 * (15.0 / 56.0 - x2 * 35.0 / 144.0)));
	}
	return log_d(x + sqrt(x * x + 1.0)) - x / sqrt(1.0 + x * x);
}

double dm_fraction_soliton(double x) {
	if (x < 0.3) {
		double x2 = x * x;
		return x * x2 * (1.0 / 3.0 - x2 * (8.0 * DM_SOLITON_B / 5.0 - x2 * 36.0 * DM_SOLITON_B * DM_SOLITON_B / 7.0));
	}
	double theta = double(atan(float(sqrt(DM_SOLITON_B) * x)));
	dvec2 sc = precise_sincos(theta);
	double s = sc.x;
	double c = sc.y;
	double c2 = c * c;
	double c_odd = c;
	double current = theta;
	double i12 = 0.0;
	for (int n = 2; n <= 14; n += 2) {
		current = c_odd * s / double(n) + double(n - 1) / double(n) * current;
		if (n == 12) i12 = current;
		c_odd *= c2;
	}
	return (current - i12) / (DM_SOLITON_B * sqrt(DM_SOLITON_B));
}

double dm_enclosed_fraction(uint profile, double x, double shape, double lgamma_s) {
	if (x <= 0.0) return 0.0;
	if (profile == 0u) return dm_fraction_nfw(x);
	if (profile == 1u) {
		double u = x / (1.0 + x);
		return u * u;
	}
	if (profile == 2u) return dm_fraction_burkert(x);
	if (profile == 3u) return dm_fraction_einasto(x, shape, lgamma_s);
	if (profile == 4u) {
		double q = 1.0 + x * x;
		return x * x * x / (q * sqrt(q));
	}
	if (profile == 5u) return dm_fraction_cored_isothermal(x);
	if (profile == 6u) return x;
	if (profile == 7u) return double(pow(float(x / (1.0 + x)), float(3.0 - shape)));
	if (profile == 9u) return x / (1.0 + x);
	if (profile == 10u) return dm_fraction_moore(x);
	if (profile == 11u) return dm_fraction_soliton(x);
	if (profile == 12u) return dm_fraction_beta_model(x);
	return 1.0;
}

double dm_fraction_derivative(uint profile, double x, double shape, double lgamma_s) {
	if (x <= 0.0) return 0.0;
	if (profile == 0u) {
		double u = 1.0 + x;
		return x / (u * u);
	}
	if (profile == 1u) {
		double u = 1.0 + x;
		return 2.0 * x / (u * u * u);
	}
	if (profile == 2u) return 2.0 * x * x / ((1.0 + x) * (1.0 + x * x));
	if (profile == 3u) {
		double s = 3.0 / shape;
		double y = (2.0 / shape) * double(pow(float(x), float(shape)));
		if (y < 1e-30 || y > s + 14.0 * sqrt(s) + 120.0) return 0.0;
		double log_value = (s - 1.0) * double(log(float(y))) - y - lgamma_s;
		return exp_d(log_value) * 2.0 * double(pow(float(x), float(shape - 1.0)));
	}
	if (profile == 4u) {
		double q = 1.0 + x * x;
		return 3.0 * x * x / (q * q * sqrt(q));
	}
	if (profile == 5u) return x * x / (1.0 + x * x);
	if (profile == 6u) return 1.0;
	if (profile == 7u) {
		double k = 3.0 - shape;
		double u = x / (1.0 + x);
		double v = 1.0 + x;
		return k * double(pow(float(u), float(k - 1.0))) / (v * v);
	}
	if (profile == 9u) {
		double v = 1.0 + x;
		return 1.0 / (v * v);
	}
	if (profile == 10u) return 1.5 * sqrt(x) / (1.0 + x * sqrt(x));
	if (profile == 11u) {
		double q = 1.0 + DM_SOLITON_B * x * x;
		double q2 = q * q;
		double q4 = q2 * q2;
		return x * x / (q4 * q4);
	}
	if (profile == 12u) {
		double q = 1.0 + x * x;
		return x * x / (q * sqrt(q));
	}
	return 0.0;
}

dvec3 dm_halo_local(DarkMatterHalo halo, dvec3 position) {
	dvec3 rel = position - dvec3(double(halo.position_x), double(halo.position_y), double(halo.position_z));
	return dvec3(
		rel.x * double(halo.basis[0]) + rel.y * double(halo.basis[1]) + rel.z * double(halo.basis[2]),
		rel.x * double(halo.basis[3]) + rel.y * double(halo.basis[4]) + rel.z * double(halo.basis[5]),
		rel.x * double(halo.basis[6]) + rel.y * double(halo.basis[7]) + rel.z * double(halo.basis[8])
	);
}

double dm_halo_radius(DarkMatterHalo halo, dvec3 local_position) {
	double qy = max(double(halo.axis_ratio_y), 0.05);
	double qz = max(double(halo.axis_ratio_z), 0.05);
	return length(dvec3(local_position.x, local_position.y / qy, local_position.z / qz));
}

dvec3 dm_halo_acceleration(DarkMatterHalo halo, dvec3 position) {
	dvec3 local_position = dm_halo_local(halo, position);
	double m = dm_halo_radius(halo, local_position);
	if (m < 1e-12) return dvec3(0.0);
	double qy = max(double(halo.axis_ratio_y), 0.05);
	double qz = max(double(halo.axis_ratio_z), 0.05);
	double a = max(double(halo.scale_radius), 1e-9);
	double truncation = double(halo.truncation_radius);
	double reach = (truncation > 0.0) ? min(m, truncation) : m;
	double enclosed = double(halo.mass_norm) * dm_enclosed_fraction(halo.profile, reach / a, double(halo.shape), double(halo.shape_aux));
	double softening = double(halo.softening);
	double denominator = m * m + softening * softening;
	double magnitude = enclosed * m / (denominator * sqrt(denominator));
	dvec3 local_acceleration = -magnitude * dvec3(local_position.x, local_position.y / (qy * qy), local_position.z / (qz * qz)) / m;
	dvec3 axis_x = dvec3(double(halo.basis[0]), double(halo.basis[1]), double(halo.basis[2]));
	dvec3 axis_y = dvec3(double(halo.basis[3]), double(halo.basis[4]), double(halo.basis[5]));
	dvec3 axis_z = dvec3(double(halo.basis[6]), double(halo.basis[7]), double(halo.basis[8]));
	return (local_acceleration.x * axis_x + local_acceleration.y * axis_y + local_acceleration.z * axis_z) * double(halo.lens_scale);
}

dvec3 dm_total_acceleration(dvec3 position) {
	dvec3 total = dvec3(0.0);
	uint count = min(pc.dark_matter.halo_count, 64u);
	for (uint i = 0u; i < count; ++i) {
		DarkMatterHalo halo = pc.dark_matter.halos[i];
		if ((halo.flags & 2u) == 0u) continue;
		total += dm_halo_acceleration(halo, position);
	}
	return total;
}

dvec3 dark_matter_kick(dvec3 position, dvec3 velocity, double dt) {
	double speed_sq = dot(velocity, velocity);
	if (speed_sq < 1e-24) return velocity;
	double speed = sqrt(speed_sq);
	dvec3 direction = velocity / speed;
	dvec3 g = dm_total_acceleration(position) * double(pc.dark_matter.lensing_strength);
	dvec3 g_perp = g - dot(g, direction) * direction;
	double angle = 2.0 * length(g_perp) * abs(dt) * speed;
	if (angle < 1e-18) return velocity;
	double limiter = (angle > 0.2) ? (0.2 / angle) : 1.0;
	dvec3 kicked = velocity + dt * 2.0 * speed_sq * limiter * g_perp;
	double kicked_length = length(kicked);
	return (kicked_length > 1e-18) ? kicked * (speed / kicked_length) : velocity;
}

void dark_matter_apply_spherical(dvec3 previous_position, double ray_r, double ray_th, double ray_phi, inout double ray_pr, inout double ray_pth, inout double ray_pphi, double dt) {
	dvec3 current_position = spherical_to_cartesian(ray_r, ray_th, ray_phi);
	dvec2 sincos_th = precise_sincos(ray_th);
	double sin_t = sincos_th.x;
	double cos_t = sincos_th.y;
	float phi_f = float(ray_phi);
	double sin_p = double(sin(phi_f));
	double cos_p = double(cos(phi_f));
	dvec3 velocity = dvec3(
		ray_pr * sin_t * cos_p + ray_r * ray_pth * cos_t * cos_p - ray_r * sin_t * ray_pphi * sin_p,
		ray_pr * sin_t * sin_p + ray_r * ray_pth * cos_t * sin_p + ray_r * sin_t * ray_pphi * cos_p,
		ray_pr * cos_t - ray_r * ray_pth * sin_t
	);
	dvec3 kicked = dark_matter_kick(0.5 * (previous_position + current_position), velocity, dt);
	double safe_sin_t = (abs(sin_t) > 1e-9) ? sin_t : ((sin_t >= 0.0) ? 1e-9 : -1e-9);
	ray_pr = kicked.x * sin_t * cos_p + kicked.y * sin_t * sin_p + kicked.z * cos_t;
	ray_pth = (kicked.x * cos_t * cos_p + kicked.y * cos_t * sin_p - kicked.z * sin_t) / max(ray_r, 1e-9);
	ray_pphi = (-kicked.x * sin_p + kicked.y * cos_p) / max(ray_r * safe_sin_t, 1e-9);
}

double dark_matter_step_limit(dvec3 position) {
	double limit = 1.0e30;
	uint count = min(pc.dark_matter.halo_count, 64u);
	for (uint i = 0u; i < count; ++i) {
		DarkMatterHalo halo = pc.dark_matter.halos[i];
		if ((halo.flags & 6u) == 0u) continue;
		double m = dm_halo_radius(halo, dm_halo_local(halo, position));
		double a = max(double(halo.scale_radius), 1e-9);
		limit = min(limit, max(double(pc.dark_matter.step_fraction) * max(m, 0.5 * a), 1e-4));
	}
	return limit;
}

vec3 dark_matter_emission(dvec3 position, double segment_length) {
	vec3 total = vec3(0.0);
	if ((pc.dark_matter.flags & 2u) == 0u) return total;
	uint count = min(pc.dark_matter.halo_count, 64u);
	uint mode = uint(max(pc.dark_matter.visual_mode, 0.0) + 0.5);
	for (uint i = 0u; i < count; ++i) {
		DarkMatterHalo halo = pc.dark_matter.halos[i];
		if ((halo.flags & 4u) == 0u) continue;
		double m = dm_halo_radius(halo, dm_halo_local(halo, position));
		double truncation = double(halo.truncation_radius);
		double a = max(double(halo.scale_radius), 1e-9);
		double column;
		if (mode == 0u) {
			if (truncation > 0.0 && m > truncation) continue;
			double x = max(m / a, 1e-6);
			double density = dm_fraction_derivative(halo.profile, x, double(halo.shape), double(halo.shape_aux)) / (x * x);
			column = density * segment_length / a;
		} else {
			double reach = (truncation > 0.0) ? min(m, truncation) : m;
			double enclosed = double(halo.mass_norm) * dm_enclosed_fraction(halo.profile, reach / a, double(halo.shape), double(halo.shape_aux));
			double softening = double(halo.softening);
			double denominator = max(m * m + softening * softening, 1e-24);
			double field_strength = enclosed * m / (denominator * sqrt(denominator));
			double norm = max(double(halo.mass_norm), 1e-30);
			double ratio = (mode == 1u) ? (field_strength * a * a / norm) : (field_strength * m * a / norm);
			column = ratio * segment_length / a;
		}
		column = column / (1.0 + column);
		total += vec3(halo.tint_r, halo.tint_g, halo.tint_b) * float(column * double(halo.visual_gain));
	}
	return total * pc.dark_matter.visual_intensity;
}

double subsidiary_step_guard(dvec3 pos) {
	if (pc.body_count == 0u) return 1.0;
	double nearest_ratio = 1.0e30;
	for (uint bi = 0u; bi < pc.body_count; ++bi) {
		if (bodies[bi].preset_3d != 8u) continue;
		double m_b = max(bodies[bi].mass, 1e-9);
		double a_star = clamp(bodies[bi].spin_parameter, -0.9999, 0.9999);
		double a_spin = a_star * m_b;
		double rh_b = m_b + sqrt(max(m_b * m_b - a_spin * a_spin, 0.0));
		dvec3 bpos = dvec3(bodies[bi].position_xy.x, bodies[bi].position_xy.y, bodies[bi].position_zw.x);
		dvec3 guard_axis = source_spin_axis(bi);
		dvec3 guard_fx;
		dvec3 guard_fy;
		source_frame(guard_axis, guard_fx, guard_fy);
		dvec3 guard_rel = pos - bpos;
		double guard_equatorial = sqrt(rh_b * rh_b + a_spin * a_spin);
		nearest_ratio = min(nearest_ratio, length(dvec3(dot(guard_rel, guard_fx) / guard_equatorial, dot(guard_rel, guard_fy) / guard_equatorial, dot(guard_rel, guard_axis) / max(rh_b, 1e-9))));
	}
	if (nearest_ratio > 1.0e29) return 1.0;
	return clamp(nearest_ratio / 8.0, 0.03, 1.0);
}

void ks_field(dvec3 x, double mass, double a, out double r, out double h, out dvec3 k) {
	double a2 = a * a;
	double z2 = x.z * x.z;
	double diff = dot(x, x) - a2;
	double r2 = max(0.5 * (diff + sqrt(diff * diff + 4.0 * a2 * z2)), 1e-24);
	r = sqrt(r2);
	double den = r2 * r2 + a2 * z2;
	double rpa = r2 + a2;
	h = mass * r2 * r / den;
	k = dvec3((r * x.x + a * x.y) / rpa, (r * x.y - a * x.x) / rpa, x.z / r);
}

void ks_source_terms(dvec3 x, dvec3 p, double mass, double a, out dvec3 dx, out dvec3 dp) {
	double r;
	double h;
	dvec3 k;
	ks_field(x, mass, a, r, h, k);
	double a2 = a * a;
	double z2 = x.z * x.z;
	double r2 = r * r;
	double r3 = r2 * r;
	double r4 = r2 * r2;
	double den = r4 + a2 * z2;
	double den2 = den * den;
	double rpa = r2 + a2;
	double inv_rpa2 = 1.0 / (rpa * rpa);
	double s = dot(k, p) + 1.0;

	dx = -2.0 * h * s * k;

	dvec3 dr = dvec3(r3 * x.x / den, r3 * x.y / den, r * rpa * x.z / den);
	double bracket = 3.0 * a2 * z2 - r4;
	dvec3 dh = mass * dr * r2 * bracket / den2;
	dh.z -= 2.0 * mass * a2 * r3 * x.z / den2;

	double nx = r * x.x + a * x.y;
	double ny = r * x.y - a * x.x;
	dvec3 dk_dot_p;
	dk_dot_p.x = (((dr.x * x.x + r) * rpa - nx * 2.0 * r * dr.x) * inv_rpa2) * p.x
		+ (((dr.x * x.y - a) * rpa - ny * 2.0 * r * dr.x) * inv_rpa2) * p.y
		+ (-x.z * dr.x / r2) * p.z;
	dk_dot_p.y = (((dr.y * x.x + a) * rpa - nx * 2.0 * r * dr.y) * inv_rpa2) * p.x
		+ (((dr.y * x.y + r) * rpa - ny * 2.0 * r * dr.y) * inv_rpa2) * p.y
		+ (-x.z * dr.y / r2) * p.z;
	dk_dot_p.z = (((dr.z * x.x) * rpa - nx * 2.0 * r * dr.z) * inv_rpa2) * p.x
		+ (((dr.z * x.y) * rpa - ny * 2.0 * r * dr.z) * inv_rpa2) * p.y
		+ ((r - x.z * dr.z) / r2) * p.z;

	dp = dh * s * s + 2.0 * h * s * dk_dot_p;
}

void ks_rhs(dvec3 x, dvec3 p, double mass, double a, out dvec3 dx, out dvec3 dp) {
	dvec3 perturbation;
	ks_source_terms(x, p, mass, a, perturbation, dp);
	dx = p + perturbation;
}

void ks_rk4_step(inout dvec3 x, inout dvec3 p, double dt, double mass, double a) {
	dvec3 k1x;
	dvec3 k1p;
	dvec3 k2x;
	dvec3 k2p;
	dvec3 k3x;
	dvec3 k3p;
	dvec3 k4x;
	dvec3 k4p;
	ks_rhs(x, p, mass, a, k1x, k1p);
	ks_rhs(x + 0.5 * dt * k1x, p + 0.5 * dt * k1p, mass, a, k2x, k2p);
	ks_rhs(x + 0.5 * dt * k2x, p + 0.5 * dt * k2p, mass, a, k3x, k3p);
	ks_rhs(x + dt * k3x, p + dt * k3p, mass, a, k4x, k4p);
	double sixth = dt / 6.0;
	x += sixth * (k1x + 2.0 * k2x + 2.0 * k3x + k4x);
	p += sixth * (k1p + 2.0 * k2p + 2.0 * k3p + k4p);
}

double ks_metric_dot(dvec4 a, dvec4 b, double h, dvec3 k) {
	double la = a.x + dot(k, a.yzw);
	double lb = b.x + dot(k, b.yzw);
	return -a.x * b.x + dot(a.yzw, b.yzw) + 2.0 * h * la * lb;
}

dvec3 ks_initial_momentum(dvec3 x, double mass, double a, dvec3 outward) {
	double r;
	double h;
	dvec3 k;
	ks_field(x, mass, a, r, h, k);
	double u0 = 1.0 / sqrt(max(1.0 - 2.0 * h, 1e-6));
	double shift = 2.0 * h * u0 * u0;
	dvec4 e1 = dvec4(shift * k.x, 1.0, 0.0, 0.0);
	dvec4 e2 = dvec4(shift * k.y, 0.0, 1.0, 0.0);
	dvec4 e3 = dvec4(shift * k.z, 0.0, 0.0, 1.0);
	e1 /= sqrt(max(ks_metric_dot(e1, e1, h, k), 1e-30));
	e2 -= ks_metric_dot(e2, e1, h, k) * e1;
	e2 /= sqrt(max(ks_metric_dot(e2, e2, h, k), 1e-30));
	e3 -= ks_metric_dot(e3, e1, h, k) * e1;
	e3 -= ks_metric_dot(e3, e2, h, k) * e2;
	e3 /= sqrt(max(ks_metric_dot(e3, e3, h, k), 1e-30));
	dvec4 v = dvec4(u0, 0.0, 0.0, 0.0) - outward.x * e1 - outward.y * e2 - outward.z * e3;
	double lv = v.x + dot(k, v.yzw);
	double pt = -v.x + 2.0 * h * lv;
	dvec3 p = v.yzw + 2.0 * h * lv * k;
	return p / max(-pt, 1e-12);
}

double ext_tanh(double x) {
	return 1.0 - 2.0 / (exp_d(2.0 * x) + 1.0);
}

void warp_shape(double rs, out double f, out double df) {
	double sigma = max(pc.warp_wall_sharpness, 1.0e-3);
	double radius = max(pc.warp_bubble_radius, 1.0e-3);
	double tp = ext_tanh(sigma * (rs + radius));
	double tm = ext_tanh(sigma * (rs - radius));
	double tr = ext_tanh(sigma * radius);
	f = (tp - tm) / (2.0 * tr);
	df = sigma * ((1.0 - tp * tp) - (1.0 - tm * tm)) / (2.0 * tr);
}

double tabulated_hubble(double a) {
	uint n = min(pc.cosmology.table_size, 192u);
	if (n < 2u) return max(double(pc.cosmology.hubble0), 1.0e-6);
	double log_min = double(pc.cosmology.table_log_a_min);
	double span = max(double(pc.cosmology.table_log_a_max) - log_min, 1.0e-9);
	double x = clamp((double(log(float(max(a, 1.0e-6)))) - log_min) / span, 0.0, 1.0) * double(n - 1u);
	uint i0 = min(uint(x), n - 2u);
	double f = x - double(i0);
	double log_e = double(pc.cosmology.log_hubble[i0]) * (1.0 - f) + double(pc.cosmology.log_hubble[i0 + 1u]) * f;
	return double(pc.cosmology.hubble0) * exp_d(log_e);
}

double flrw_hubble(double a) {
	if (pc.metric_type == 11u || pc.metric_type == 12u) {
		return tabulated_hubble(a);
	}
	double h0 = max(sqrt(max(pc.cosmological_lambda, 0.0) / 2.1), 1.0e-3);
	double inv_a = 1.0 / max(a, 1.0e-6);
	double inv_a3 = inv_a * inv_a * inv_a;
	return h0 * sqrt(9.0e-5 * inv_a3 * inv_a + 0.3 * inv_a3 + 0.7);
}

dvec4 warp_acceleration(dvec3 x, dvec4 u) {
	double rs = max(length(x), 1.0e-9);
	double f;
	double df;
	warp_shape(rs, f, df);
	double s = pc.warp_velocity * f;
	dvec3 grad = (pc.warp_velocity * df / rs) * x;
	double ut = u.x;
	dvec3 us = u.yzw;
	double ug = dot(us, grad);
	double term_common = s * ut * ut - ut * us.x;
	double a_t = ug * (2.0 * s * ut - us.x);
	double a_x = -ug * ut - grad.x * term_common;
	double a_y = -grad.y * term_common;
	double a_z = -grad.z * term_common;
	return dvec4(a_t + s * a_x, s * a_t - (1.0 - s * s) * a_x, -a_y, -a_z);
}

dvec4 wormhole_acceleration(dvec4 x, dvec4 u) {
	double b0 = max(pc.wormhole_throat, 1.0e-3);
	double l = x.y;
	double r2 = l * l + b0 * b0;
	double r = sqrt(r2);
	double tidal = pc.wormhole_tidal_potential;
	double dphi = tidal * l / (r2 * r);
	double e2 = exp_d(-2.0 * tidal / r);
	dvec2 sc = precise_sincos(x.z);
	double sin_t = sc.x;
	double cos_t = sc.y;
	double safe_sin = (abs(sin_t) > 1.0e-9) ? sin_t : ((sin_t >= 0.0) ? 1.0e-9 : -1.0e-9);
	double g = l / r2;
	return dvec4(
		-2.0 * dphi * u.x * u.y,
		-dphi * e2 * u.x * u.x + l * u.z * u.z + l * sin_t * sin_t * u.w * u.w,
		-2.0 * g * u.y * u.z + sin_t * cos_t * u.w * u.w,
		-2.0 * g * u.y * u.w - 2.0 * (cos_t / safe_sin) * u.z * u.w
	);
}

void ext_derivative(uint kind, dvec4 x, dvec4 u, out dvec4 dx, out dvec4 du) {
	if (kind == 7u) {
		double a = max(x.x, 1.0e-6);
		double h = flrw_hubble(a);
		double speed_sq = dot(u.yzw, u.yzw);
		dx = dvec4(a * h * u.x, u.yzw);
		du = dvec4(-a * a * h * speed_sq, -2.0 * h * u.x * u.yzw);
	} else if (kind == 8u) {
		dx = u;
		du = wormhole_acceleration(x, u);
	} else {
		dx = u;
		du = warp_acceleration(x.yzw, u);
	}
}

void ext_rk4(uint kind, inout dvec4 x, inout dvec4 u, double dt) {
	dvec4 k1x;
	dvec4 k1u;
	dvec4 k2x;
	dvec4 k2u;
	dvec4 k3x;
	dvec4 k3u;
	dvec4 k4x;
	dvec4 k4u;
	ext_derivative(kind, x, u, k1x, k1u);
	ext_derivative(kind, x + 0.5 * dt * k1x, u + 0.5 * dt * k1u, k2x, k2u);
	ext_derivative(kind, x + 0.5 * dt * k2x, u + 0.5 * dt * k2u, k3x, k3u);
	ext_derivative(kind, x + dt * k3x, u + dt * k3u, k4x, k4u);
	double sixth = dt / 6.0;
	x += sixth * (k1x + 2.0 * k2x + 2.0 * k3x + k4x);
	u += sixth * (k1u + 2.0 * k2u + 2.0 * k3u + k4u);
}

dvec3 ext_cartesian(uint kind, dvec4 x, double b0) {
	if (kind == 8u) {
		return spherical_to_cartesian(sqrt(x.y * x.y + b0 * b0), x.z, x.w);
	}
	return x.yzw;
}

void trace_extended_metric(dvec3 ray_dir, out dvec3 accum_out, out uint status_out, out uint iters_out, out double redshift_out) {
	uint kind = (pc.metric_type == 11u || pc.metric_type == 12u) ? 7u : pc.metric_type;
	double obs_r = max(pc.observer_position.y, 1.0e-6);
	double obs_th = clamp(pc.observer_position.z, 0.001, PI_D - 0.001);
	double obs_ph = pc.observer_position.w;
	dvec3 obs_cart = spherical_to_cartesian(obs_r, obs_th, obs_ph);
	dvec2 sc_obs = precise_sincos(obs_th);
	double sin_po = double(sin(float(obs_ph)));
	double cos_po = double(cos(float(obs_ph)));
	dvec3 er = dvec3(sc_obs.x * cos_po, sc_obs.x * sin_po, sc_obs.y);
	dvec3 eth = dvec3(sc_obs.y * cos_po, sc_obs.y * sin_po, -sc_obs.x);
	dvec3 eph = dvec3(-sin_po, cos_po, 0.0);
	double b0 = max(pc.wormhole_throat, 1.0e-3);

	dvec4 x = dvec4(0.0, obs_cart);
	dvec4 u = dvec4(-1.0, ray_dir);
	if (kind == 8u) {
		double r_areal = max(obs_r, b0 * 1.0001);
		double l0 = sqrt(max(r_areal * r_areal - b0 * b0, 0.0));
		x = dvec4(0.0, l0, obs_th, obs_ph);
		u = dvec4(-exp_d(pc.wormhole_tidal_potential / r_areal), dot(ray_dir, er), dot(ray_dir, eth) / r_areal, dot(ray_dir, eph) / (r_areal * sc_obs.x));
	} else if (kind == 9u) {
		double wf;
		double wdf;
		warp_shape(length(obs_cart), wf, wdf);
		u = dvec4(-1.0, ray_dir.x - pc.warp_velocity * wf, ray_dir.y, ray_dir.z);
	} else {
		x = dvec4(1.0, obs_cart);
	}

	dvec3 accum = dvec3(0.0);
	double throughput = 1.0;
	uint status = 0u;
	uint iters = 0u;
	double redshift = 1.0;
	bool exited = false;
	bool bodies_traced = ((pc.render_flags & (1u << 12)) != 0u) && pc.body_count > 0u;
	bool dark_matter_active = pc.dark_matter.halo_count > 0u && pc.dark_matter.flags != 0u && kind != 8u;
	double escape = max(pc.escape_radius, 1.0);
	double warp_radius = max(pc.warp_bubble_radius, 1.0e-3);
	double warp_sigma = max(pc.warp_wall_sharpness, 1.0e-3);
	double far_scale = pc.far_field_step_scale;
	dvec3 prev_cart = ext_cartesian(kind, x, b0);
	bool prev_valid = (kind != 8u) || (x.y > 0.0);

	for (uint step = 0u; step < pc.max_integration_steps && throughput > 0.01; ++step) {
		iters = step + 1u;
		double radius_xyz = length(x.yzw);
		if (kind == 8u && abs(x.y) >= escape) {
			exited = true;
			break;
		}
		if (kind == 9u && radius_xyz >= escape) {
			exited = true;
			break;
		}
		if (kind == 7u) {
			if (x.x < 1.0e-3) {
				status = 1u;
				throughput = 0.0;
				break;
			}
			if (radius_xyz >= escape) {
				exited = true;
				break;
			}
		}

		double dt_mag;
		if (kind == 8u) {
			double r_areal = sqrt(x.y * x.y + b0 * b0);
			dvec2 sc = precise_sincos(x.z);
			double pole_guard = clamp(abs(sc.x) * 12.0 * pc.pole_guard_precision_scale, 0.02, 1.0);
			double far_factor = 1.0 + (far_scale - 1.0) * clamp((r_areal - 20.0 * b0) / max(80.0 * b0, 1.0e-9), 0.0, 1.0);
			dt_mag = clamp(pc.step_size_factor * sqrt(r_areal * b0) * far_factor, pc.min_step_size, pc.max_step_size * far_scale) * pole_guard;
		} else if (kind == 9u) {
			double wall_scale = abs(radius_xyz - warp_radius) + 1.0 / warp_sigma;
			double far_factor = 1.0 + (far_scale - 1.0) * clamp((radius_xyz - 3.0 * warp_radius) / max(10.0 * warp_radius, 1.0e-9), 0.0, 1.0);
			dt_mag = clamp(pc.step_size_factor * wall_scale * far_factor, pc.min_step_size, pc.max_step_size * far_scale);
		} else {
			double h = flrw_hubble(x.x);
			double speed = max(length(u.yzw), 1.0e-9);
			double spatial_step = pc.step_size_factor * 30.0 / speed;
			double time_step = 0.03 / max(h * abs(u.x), 1.0e-12);
			dt_mag = clamp(min(spatial_step, time_step), 1.0e-9, pc.max_step_size * far_scale);
		}
		if (dark_matter_active) {
			dt_mag = min(dt_mag, dark_matter_step_limit(prev_cart) / max(length(u.yzw), 1.0));
		}

		ext_rk4(kind, x, u, dt_mag);

		if (any(isnan(x)) || any(isinf(x)) || any(isnan(u)) || any(isinf(u))) {
			status = 1u;
			throughput = 0.0;
			break;
		}

		if (kind == 8u) {
			if (x.z < 0.0) {
				x.z = -x.z;
				x.w += PI_D;
				u.z = -u.z;
			} else if (x.z > PI_D) {
				x.z = 2.0 * PI_D - x.z;
				x.w += PI_D;
				u.z = -u.z;
			}
		}

		dvec3 cart = ext_cartesian(kind, x, b0);
		if (dark_matter_active) {
			dvec3 middle = 0.5 * (prev_cart + cart);
			if (kind == 9u) {
				double wf;
				double wdf;
				warp_shape(length(x.yzw), wf, wdf);
				dvec3 shift = dvec3(pc.warp_velocity * wf, 0.0, 0.0);
				u = dvec4(u.x, dark_matter_kick(middle, u.yzw + shift, dt_mag) - shift);
			} else {
				u = dvec4(u.x, dark_matter_kick(middle, u.yzw, dt_mag));
			}
			accum += throughput * dvec3(dark_matter_emission(middle, length(cart - prev_cart)));
		}

		bool cart_valid = (kind != 8u) || (x.y > 0.0);
		if (bodies_traced && prev_valid && cart_valid) {
			dvec3 segment = cart - prev_cart;
			double segment_length = length(segment);
			if (segment_length > 1.0e-12) {
				vec3 body_color;
				uint body_status;
				double body_dist;
				if (intersect_bodies(prev_cart, segment / segment_length, segment_length, body_color, body_status, body_dist)) {
					accum += throughput * dvec3(body_color);
					status |= 16u;
					throughput = 0.0;
					break;
				}
			}
		}
		prev_cart = cart;
		prev_valid = cart_valid;
	}

	if (exited) {
		dvec3 sky_dir = (kind == 8u) ? spherical_to_cartesian(1.0, x.z, x.w) : (u.yzw / max(length(u.yzw), 1.0e-12));
		vec3 sky = compute_sky_radiance(sky_dir, pc.sky_rotation_rad);
		if (kind == 8u && x.y < 0.0) {
			sky = sky.bgr;
		}
		if (kind == 7u) {
			float a = float(x.x);
			sky *= vec3(a * a, a * a * a, a * a * a * a);
			redshift = x.x;
		}
		accum += throughput * dvec3(sky);
		status |= 2u;
	}

	accum_out = accum;
	status_out = status;
	iters_out = iters;
	redshift_out = redshift;
}

const uint MS_MAX = 16u;

shared dvec4 ms_position_mass[MS_MAX];
shared dvec4 ms_axis_spin[MS_MAX];
shared dvec4 ms_frame_x_horizon[MS_MAX];
shared dvec4 ms_frame_y_equatorial[MS_MAX];
shared dvec2 ms_disk_range[MS_MAX];
shared uint ms_body_slot[MS_MAX];
shared uint ms_source_count;

double ms_potential_cache[MS_MAX];
dvec3 ms_direction_cache[MS_MAX];

dvec3 ms_to_local(uint i, dvec3 d) {
	return dvec3(dot(d, ms_frame_x_horizon[i].xyz), dot(d, ms_frame_y_equatorial[i].xyz), dot(d, ms_axis_spin[i].xyz));
}

dvec3 ms_to_world(uint i, dvec3 l) {
	return l.x * ms_frame_x_horizon[i].xyz + l.y * ms_frame_y_equatorial[i].xyz + l.z * ms_axis_spin[i].xyz;
}

void ms_build_sources() {
	ms_source_count = 0u;
	if (pc.metric_type != 1u && pc.metric_type != 2u && pc.metric_type != 3u) {
		return;
	}
	double m = max(pc.metric_mass, 1e-4);
	double a = (pc.metric_type == 1u) ? 0.0 : clamp(pc.metric_spin, -0.999 * m, 0.999 * m);
	double rh = m + sqrt(max(m * m - a * a, 0.0));
	double isco = kerr_isco_radius_prograde_retrograde(m, a);
	double inner = isco * double(max(pc.primary_disk.inner_radius_scale, 1.0));
	double outer = max(double(pc.primary_disk.outer_radius_mass_units) * m, inner * 1.05);
	bool primary_disk_on = pc.primary_disk.enabled > 0.5 && pc.hydro_disk.model != 2u;
	ms_position_mass[0] = dvec4(0.0, 0.0, 0.0, m);
	ms_axis_spin[0] = dvec4(0.0, 0.0, 1.0, a);
	ms_frame_x_horizon[0] = dvec4(1.0, 0.0, 0.0, rh);
	ms_frame_y_equatorial[0] = dvec4(0.0, 1.0, 0.0, sqrt(rh * rh + a * a));
	ms_disk_range[0] = primary_disk_on ? dvec2(inner, outer) : dvec2(-1.0, -1.0);
	ms_body_slot[0] = 0xFFFFFFFFu;
	uint count = 1u;
	for (uint bi = 0u; bi < pc.body_count && count < MS_MAX; ++bi) {
		if (bodies[bi].preset_3d != 8u) continue;
		double mb = max(bodies[bi].mass, 1e-9);
		double ab = clamp(bodies[bi].spin_parameter, -0.9999, 0.9999) * mb;
		double rhb = mb + sqrt(max(mb * mb - ab * ab, 0.0));
		dvec3 axis = source_spin_axis(bi);
		dvec3 fx;
		dvec3 fy;
		source_frame(axis, fx, fy);
		double isco_b = kerr_isco_radius_prograde_retrograde(mb, ab);
		double inner_b = isco_b * double(max(bodies[bi].disk.inner_radius_scale, 1.0));
		double outer_b = max(double(bodies[bi].disk.outer_radius_mass_units) * mb, inner_b * 1.05);
		ms_position_mass[count] = dvec4(body_center(bi), mb);
		ms_axis_spin[count] = dvec4(axis, ab);
		ms_frame_x_horizon[count] = dvec4(fx, rhb);
		ms_frame_y_equatorial[count] = dvec4(fy, sqrt(rhb * rhb + ab * ab));
		ms_disk_range[count] = (bodies[bi].disk.enabled > 0.5) ? dvec2(inner_b, outer_b) : dvec2(-1.0, -1.0);
		ms_body_slot[count] = bi;
		++count;
	}
	ms_source_count = count;
}

void ms_source_terms(uint i, dvec3 x, dvec3 p, out dvec3 ddx, out dvec3 ddp) {
	dvec4 pm = ms_position_mass[i];
	dvec3 local_dx;
	dvec3 local_dp;
	ks_source_terms(ms_to_local(i, x - pm.xyz), ms_to_local(i, p), pm.w, ms_axis_spin[i].w, local_dx, local_dp);
	ddx = ms_to_world(i, local_dx);
	ddp = ms_to_world(i, local_dp);
}

void ms_rhs(dvec3 x, dvec3 p, out dvec3 dx, out dvec3 dp) {
	dx = p;
	dp = dvec3(0.0);
	for (uint i = 0u; i < ms_source_count; ++i) {
		dvec3 ddx;
		dvec3 ddp;
		ms_source_terms(i, x, p, ddx, ddp);
		dx += ddx;
		dp += ddp;
	}
}

void ms_rk4_step(inout dvec3 x, inout dvec3 p, double dt) {
	dvec3 k1x;
	dvec3 k1p;
	dvec3 k2x;
	dvec3 k2p;
	dvec3 k3x;
	dvec3 k3p;
	dvec3 k4x;
	dvec3 k4p;
	ms_rhs(x, p, k1x, k1p);
	ms_rhs(x + 0.5 * dt * k1x, p + 0.5 * dt * k1p, k2x, k2p);
	ms_rhs(x + 0.5 * dt * k2x, p + 0.5 * dt * k2p, k3x, k3p);
	ms_rhs(x + dt * k3x, p + dt * k3p, k4x, k4p);
	double sixth = dt / 6.0;
	x += sixth * (k1x + 2.0 * k2x + 2.0 * k3x + k4x);
	p += sixth * (k1p + 2.0 * k2p + 2.0 * k3p + k4p);
}

double ms_metric_dot(dvec4 a, dvec4 b, uint count) {
	double value = -a.x * b.x + dot(a.yzw, b.yzw);
	for (uint i = 0u; i < count; ++i) {
		double la = a.x + dot(ms_direction_cache[i], a.yzw);
		double lb = b.x + dot(ms_direction_cache[i], b.yzw);
		value += 2.0 * ms_potential_cache[i] * la * lb;
	}
	return value;
}

dvec4 ms_lift(dvec3 v, double inverse_lapse_sq, uint count) {
	double shift = 0.0;
	for (uint i = 0u; i < count; ++i) {
		shift += ms_potential_cache[i] * dot(ms_direction_cache[i], v);
	}
	return dvec4(2.0 * shift * inverse_lapse_sq, v);
}

dvec3 ms_initial_momentum(dvec3 x, dvec3 outward) {
	uint count = ms_source_count;
	double potential_sum = 0.0;
	for (uint i = 0u; i < count; ++i) {
		double radius;
		double potential;
		dvec3 local_direction;
		ks_field(ms_to_local(i, x - ms_position_mass[i].xyz), ms_position_mass[i].w, ms_axis_spin[i].w, radius, potential, local_direction);
		ms_potential_cache[i] = potential;
		ms_direction_cache[i] = ms_to_world(i, local_direction);
		potential_sum += potential;
	}
	double inverse_lapse_sq = 1.0 / max(1.0 - 2.0 * potential_sum, 1e-6);
	double u0 = sqrt(inverse_lapse_sq);
	dvec4 e1 = ms_lift(dvec3(1.0, 0.0, 0.0), inverse_lapse_sq, count);
	dvec4 e2 = ms_lift(dvec3(0.0, 1.0, 0.0), inverse_lapse_sq, count);
	dvec4 e3 = ms_lift(dvec3(0.0, 0.0, 1.0), inverse_lapse_sq, count);
	e1 /= sqrt(max(ms_metric_dot(e1, e1, count), 1e-30));
	e2 -= ms_metric_dot(e2, e1, count) * e1;
	e2 /= sqrt(max(ms_metric_dot(e2, e2, count), 1e-30));
	e3 -= ms_metric_dot(e3, e1, count) * e1;
	e3 -= ms_metric_dot(e3, e2, count) * e2;
	e3 /= sqrt(max(ms_metric_dot(e3, e3, count), 1e-30));
	dvec4 v = dvec4(u0, 0.0, 0.0, 0.0) - outward.x * e1 - outward.y * e2 - outward.z * e3;
	dvec3 momentum = v.yzw;
	double time_component = -v.x;
	for (uint i = 0u; i < count; ++i) {
		double lv = v.x + dot(ms_direction_cache[i], v.yzw);
		time_component += 2.0 * ms_potential_cache[i] * lv;
		momentum += 2.0 * ms_potential_cache[i] * lv * ms_direction_cache[i];
	}
	return momentum / max(-time_component, 1e-12);
}

bool ms_inside_horizon(dvec3 x) {
	for (uint i = 0u; i < ms_source_count; ++i) {
		dvec3 l = ms_to_local(i, x - ms_position_mass[i].xyz);
		double a = ms_axis_spin[i].w;
		double a2 = a * a;
		double diff = dot(l, l) - a2;
		double r2 = max(0.5 * (diff + sqrt(diff * diff + 4.0 * a2 * l.z * l.z)), 1e-24);
		double r = sqrt(r2);
		double rh = ms_frame_x_horizon[i].w;
		if (r <= rh * 1.0001 || (r2 - 2.0 * ms_position_mass[i].w * r + a2) <= 0.0) return true;
	}
	return false;
}

bool ms_horizon_entry(uint i, dvec3 from, dvec3 to, out double t) {
	t = 2.0;
	dvec3 origin = ms_position_mass[i].xyz;
	double inverse_eq = 1.0 / max(ms_frame_y_equatorial[i].w * 1.0001, 1e-12);
	double inverse_pol = 1.0 / max(ms_frame_x_horizon[i].w * 1.0001, 1e-12);
	dvec3 ls = ms_to_local(i, from - origin);
	dvec3 le = ms_to_local(i, to - origin);
	dvec3 s = dvec3(ls.x * inverse_eq, ls.y * inverse_eq, ls.z * inverse_pol);
	dvec3 e = dvec3(le.x * inverse_eq, le.y * inverse_eq, le.z * inverse_pol);
	dvec3 d = e - s;
	double c = dot(s, s) - 1.0;
	if (c <= 0.0) {
		t = 0.0;
		return true;
	}
	double qa = dot(d, d);
	if (qa <= 1e-30) {
		if (dot(e, e) <= 1.0) {
			t = 0.5;
			return true;
		}
		return false;
	}
	double qb = 2.0 * dot(s, d);
	double discriminant = qb * qb - 4.0 * qa * c;
	if (discriminant >= 0.0) {
		double sqrt_disc = sqrt(discriminant);
		double t1 = (-qb - sqrt_disc) / (2.0 * qa);
		double t2 = (-qb + sqrt_disc) / (2.0 * qa);
		if (t1 >= 0.0 && t1 <= 1.0) {
			t = t1;
			return true;
		}
		if (t2 >= 0.0 && t2 <= 1.0) {
			t = t2;
			return true;
		}
	}
	if (dot(e, e) <= 1.0) {
		t = clamp(-qb / (2.0 * qa), 0.0, 1.0);
		return true;
	}
	return false;
}

bool ms_disk_crossing(uint i, dvec3 from, dvec3 to, dvec3 p_from, dvec3 p_to, out double t, out double radius, out double azimuth, out double lz) {
	t = 2.0;
	radius = 0.0;
	azimuth = 0.0;
	lz = 0.0;
	dvec2 range = ms_disk_range[i];
	if (range.x < 0.0) return false;
	dvec3 origin = ms_position_mass[i].xyz;
	dvec3 ls = ms_to_local(i, from - origin);
	dvec3 le = ms_to_local(i, to - origin);
	double dz = le.z - ls.z;
	if (ls.z * le.z > 0.0 || abs(dz) <= 1.0e-15) return false;
	double s = clamp(abs(ls.z) / abs(dz), 0.0, 1.0);
	dvec3 c = ls + s * (le - ls);
	double spin = ms_axis_spin[i].w;
	double r = sqrt(max(c.x * c.x + c.y * c.y - spin * spin, 0.0));
	if (r < range.x || r > range.y || r <= ms_frame_x_horizon[i].w * 1.02) return false;
	dvec3 pl = ms_to_local(i, p_from + s * (p_to - p_from));
	t = s;
	radius = r;
	azimuth = atan2_wide(c.y, c.x) - atan2_wide(spin, r);
	double pl_mag = length(pl);
	lz = (c.x * pl.y - c.y * pl.x) / max(pl_mag, 1e-30);
	return true;
}

void trace_multi_source(dvec3 ray_dir, out dvec3 accum_out, out uint status_out, out uint iters_out, out double redshift_out) {
	double obs_r = max(pc.observer_position.y, 1.0e-6);
	double obs_th = clamp(pc.observer_position.z, 0.001, PI_D - 0.001);
	dvec3 origin = spherical_to_cartesian(obs_r, obs_th, pc.observer_position.w);
	dvec3 x = origin;
	dvec3 accum = dvec3(0.0);
	double throughput = 1.0;
	uint status = 0u;
	uint iters = 0u;
	double redshift = 1.0;
	bool escaped = false;

	if (ms_inside_horizon(x)) {
		accum_out = accum;
		status_out = 1u;
		iters_out = 0u;
		redshift_out = 0.0;
		return;
	}

	dvec3 p = ms_initial_momentum(x, ray_dir);
	bool bodies_traced = ((pc.render_flags & (1u << 12)) != 0u) && pc.body_count > 0u;
	bool dark_matter_enabled = pc.dark_matter.halo_count > 0u && pc.dark_matter.flags != 0u;
	bool torus_enabled = pc.primary_disk.enabled > 0.5 && pc.hydro_disk.model == 2u;
	double primary_mass = ms_position_mass[0].w;
	double primary_spin = ms_axis_spin[0].w;
	double angular_pixel_size = pc.field_of_view_rad / max(double(pc.screen_width), 1.0);
	double crossing_t[MS_MAX];
	double c_rad[MS_MAX];
	double c_az[MS_MAX];
	double c_lz[MS_MAX];

	for (uint step = 0u; step < pc.max_integration_steps && throughput > 0.01; ++step) {
		iters = step + 1u;
		if (length(x) >= pc.escape_radius) {
			escaped = true;
			break;
		}

		if (ms_inside_horizon(x)) {
			status |= 1u;
			throughput = 0.0;
			break;
		}

		double scale = 1.0e30;
		double far_blend = 1.0;
		for (uint i = 0u; i < ms_source_count; ++i) {
			dvec4 pm_i = ms_position_mass[i];
			double rh_i = ms_frame_x_horizon[i].w;
			dvec3 l = ms_to_local(i, x - pm_i.xyz);
			double a = ms_axis_spin[i].w;
			double a2 = a * a;
			double diff = dot(l, l) - a2;
			double r2 = max(0.5 * (diff + sqrt(diff * diff + 4.0 * a2 * l.z * l.z)), 1e-24);
			double r = sqrt(r2);
			double r_dist = max(r - rh_i, 0.005 * pm_i.w);
			scale = min(scale, sqrt(r * r_dist));
			scale = min(scale, max(0.35 * r_dist, pc.min_step_size));
			far_blend = min(far_blend, clamp((r - 20.0 * rh_i) / max(80.0 * rh_i, 1e-9), 0.0, 1.0));
		}
		double far_factor = 1.0 + (pc.far_field_step_scale - 1.0) * far_blend;
		double dt_mag = clamp(pc.step_size_factor * scale * far_factor, pc.min_step_size, pc.max_step_size * far_factor);
		if (dark_matter_enabled) {
			dt_mag = min(dt_mag, dark_matter_step_limit(x));
		}
		double dt = -dt_mag;

		dvec3 x_prev = x;
		dvec3 p_prev = p;
		ms_rk4_step(x, p, dt);

		if (any(isnan(x)) || any(isinf(x)) || any(isnan(p)) || any(isinf(p))) {
			status |= 1u;
			throughput = 0.0;
			break;
		}

		if (dark_matter_enabled) {
			dvec3 middle = 0.5 * (x_prev + x);
			p = dark_matter_kick(middle, p, dt);
			accum += throughput * dvec3(dark_matter_emission(middle, length(x - x_prev)));
		}

		dvec3 segment = x - x_prev;
		double segment_length = length(segment);
		if (segment_length <= 1.0e-14) continue;

		if (torus_enabled) {
			double torus_ratio = x_prev.x * p_prev.y - x_prev.y * p_prev.x;
			vec3 torus_rgb;
			double torus_opacity;
			double torus_redshift;
			torus_integrate_segment(x_prev, x, torus_ratio, primary_mass, primary_spin, torus_rgb, torus_opacity, torus_redshift);
			if (torus_opacity > 1e-6) {
				status |= 4u;
				redshift = torus_redshift;
				accum += throughput * dvec3(torus_rgb);
				throughput *= (1.0 - torus_opacity);
			}
		}
		if (pc.jet.enabled > 0.5) {
			vec3 jet_rgb;
			double jet_transmittance;
			if (jet_integrate_segment(x_prev, x, jet_rgb, jet_transmittance)) {
				accum += throughput * dvec3(jet_rgb);
				throughput *= jet_transmittance;
				status |= 32u;
			}
		}

		double absorb_t = 2.0;
		for (uint i = 0u; i < ms_source_count; ++i) {
			double horizon_t;
			if (ms_horizon_entry(i, x_prev, x, horizon_t)) {
				absorb_t = min(absorb_t, horizon_t);
			}
			double crossing_param;
			double crossing_radius;
			double crossing_azimuth;
			double crossing_lz;
			if (ms_disk_crossing(i, x_prev, x, p_prev, p, crossing_param, crossing_radius, crossing_azimuth, crossing_lz)) {
				crossing_t[i] = crossing_param;
				c_rad[i] = crossing_radius;
				c_az[i] = crossing_azimuth;
				c_lz[i] = crossing_lz;
			} else {
				crossing_t[i] = -1.0;
			}
		}

		double body_t = 2.0;
		vec3 body_color = vec3(0.0);
		if (bodies_traced) {
			uint body_status;
			double body_distance;
			if (intersect_bodies(x_prev, segment / segment_length, segment_length, body_color, body_status, body_distance)) {
				body_t = body_distance / segment_length;
			}
		}

		double limit_t = min(absorb_t, body_t);
		for (uint pass = 0u; pass < ms_source_count && throughput > 0.01; ++pass) {
			uint pick = MS_MAX;
			double best = limit_t;
			for (uint i = 0u; i < ms_source_count; ++i) {
				if (crossing_t[i] >= 0.0 && crossing_t[i] < best) {
					best = crossing_t[i];
					pick = i;
				}
			}
			if (pick == MS_MAX) break;
			crossing_t[pick] = -1.0;

			double r_c = c_rad[pick];
			double az_c = c_az[pick];
			double lz_c = c_lz[pick];

			dvec4 pm = ms_position_mass[pick];
			double spin_s = ms_axis_spin[pick].w;
			dvec2 range = ms_disk_range[pick];
			double g_doppler = disk_redshift(pm.w, spin_s, r_c, lz_c);
			double view_distance = max(length(origin - pm.xyz), 1.0e-9);
			double detail = clamp((2.0 * ms_frame_x_horizon[pick].w / view_distance) / max(angular_pixel_size * 24.0, 1.0e-9), 0.0, 1.0);
			vec3 shaded_rgb;
			double shaded_opacity;
			if (pick == 0u) {
				double nt_base = (pc.hydro_disk.model == 1u) ? nt_base_temperature(r_c, pm.w, spin_s) : -1.0;
				disk_shade_with_base(pc.primary_disk, pm.w, spin_s, range.x, range.y, r_c, az_c, g_doppler, pc.time, detail, nt_base, shaded_rgb, shaded_opacity);
			} else {
				disk_shade(bodies[ms_body_slot[pick]].disk, pm.w, spin_s, range.x, range.y, r_c, az_c, g_doppler, pc.time, detail, shaded_rgb, shaded_opacity);
			}
			redshift = g_doppler;
			status |= 4u;
			accum += throughput * dvec3(shaded_rgb);
			throughput *= (1.0 - shaded_opacity);
		}

		if (throughput > 0.01 && body_t <= absorb_t && body_t <= 1.0) {
			accum += throughput * dvec3(body_color);
			status |= 16u;
			throughput = 0.0;
			break;
		}
		if (absorb_t <= 1.0) {
			status |= 1u;
			throughput = 0.0;
			break;
		}
	}

	if (!escaped && (status & 1u) == 0u && throughput > 0.01) {
		for (uint i = 0u; i < ms_source_count; ++i) {
			dvec3 l = ms_to_local(i, x - ms_position_mass[i].xyz);
			double a = ms_axis_spin[i].w;
			double a2 = a * a;
			double diff = dot(l, l) - a2;
			double r = sqrt(max(0.5 * (diff + sqrt(diff * diff + 4.0 * a2 * l.z * l.z)), 1e-24));
			if (r < 6.0 * ms_position_mass[i].w) {
				throughput = 0.0;
			}
		}
	}

	if (escaped || throughput > 0.01) {
		dvec3 flow;
		dvec3 unused_momentum;
		ms_rhs(x, p, flow, unused_momentum);
		dvec3 dir_out = -flow / max(length(flow), 1.0e-12);
		bool exit_body_hit = false;
		if (bodies_traced) {
			vec3 exit_color;
			uint exit_status;
			double exit_distance;
			exit_body_hit = intersect_bodies(x, dir_out, 1e30, exit_color, exit_status, exit_distance);
			if (exit_body_hit) {
				accum += throughput * dvec3(exit_color);
				status |= 16u;
			}
		}
		if (!exit_body_hit) {
			accum += throughput * dvec3(compute_sky_radiance(dir_out, pc.sky_rotation_rad));
			status |= 2u;
		}
	}

	accum_out = accum;
	status_out = status;
	iters_out = iters;
	redshift_out = redshift;
}

#include "spacetime_teves_metric.glsl"
#include "spacetime_spherical_tracer.glsl"

void main() {
	uint spectral_index = gl_LocalInvocationIndex;
	if (spectral_index < 33u) {
		float spectral_lambda_nm = 380.0 + float(spectral_index) * (400.0 / 32.0);
		float trapezoid_weight = (spectral_index == 0u || spectral_index == 32u) ? 0.5 : 1.0;
		cie_weight_table[spectral_index] = trapezoid_weight * vec3(cie_x_bar(spectral_lambda_nm), cie_y_bar(spectral_lambda_nm), cie_z_bar(spectral_lambda_nm));
	}
	if (gl_LocalInvocationIndex == 0u) {
		ms_build_sources();
	}
	memoryBarrierShared();
	barrier();
	uint tile_x = gl_WorkGroupID.x * 16u;
	uint tile_y = gl_WorkGroupID.y * 16u;
	#ifdef RELATIVISTIC_CLUSTER_TILE
	uint tile_column = tile_x + gl_LocalInvocationID.x;
	uint px = pc.tile_origin_x + tile_column;
#else
	uint px = tile_x + gl_LocalInvocationID.x;
#endif
	uint local_row = tile_y + gl_LocalInvocationID.y;
	#ifdef RELATIVISTIC_CLUSTER_TILE
	uint py = pc.tile_origin_y + local_row;
#else
	uint py = pc.dispatch_row_offset + local_row;
#endif

		#ifdef RELATIVISTIC_CLUSTER_TILE
	if (tile_column < pc.tile_extent_x && local_row < pc.tile_extent_y && px < pc.screen_width && py < pc.screen_height) {
#else
	if (px < pc.screen_width && local_row < pc.dispatch_row_count && py < pc.screen_height) {
#endif
		#ifdef RELATIVISTIC_CLUSTER_TILE
		uint pixel_index = local_row * pc.tile_extent_x + tile_column;
#else
		uint pixel_index = local_row * pc.screen_width + px;
#endif

		double aspect = double(pc.screen_width) / double(pc.screen_height);
		double v_norm = 1.0 - (double(py) + 0.5) / double(pc.screen_height) * 2.0;
		bool is_allsky = (pc.projection_mode == 3u || pc.projection_mode == 7u);
		double u_raw = (double(px) + 0.5) / double(pc.screen_width) * 2.0 - 1.0;
		double u_coord = is_allsky ? u_raw : (u_raw * aspect);

	dvec3 n_local = compute_ray_direction(pc.projection_mode, u_coord, v_norm, pc.field_of_view_rad);

	dvec3 fwd = pc.tetrad_e1.yzw;
	dvec3 rgt = pc.tetrad_e2.yzw;
	dvec3 up  = pc.tetrad_e3.yzw;

	dvec3 ray_dir = n_local.x * fwd + n_local.z * rgt + n_local.y * up;

	bool subsidiary_sources_present = false;
	for (uint sbi = 0u; sbi < pc.body_count; ++sbi) {
		if (bodies[sbi].preset_3d == 8u) { subsidiary_sources_present = true; break; }
	}

	bool dark_matter_active = pc.dark_matter.halo_count > 0u && pc.dark_matter.flags != 0u;
	bool early_done = false;
	{
		double obs_r0 = pc.observer_position.y;
		double obs_th0 = pc.observer_position.z;
		double obs_ph0 = pc.observer_position.w;
		dvec3 obs_pos0 = spherical_to_cartesian(obs_r0, obs_th0, obs_ph0);

		if ((pc.render_flags & (1u << 12)) != 0u && pc.body_count > 0u && ((pc.metric_type == 0u && !subsidiary_sources_present && !dark_matter_active) || (pc.render_flags & (1u << 17)) != 0u)) {
			vec3 body_color;
			uint body_status;
			double body_dist;
			if (intersect_bodies(obs_pos0, ray_dir, 1e30, body_color, body_status, body_dist)) {
				vec3 mapped_body = apply_tonemapping(body_color, pc.tonemapping_mode, pc.camera_exposure);
				pixels[pixel_index].rgba = vec4(mapped_body, 1.0);
				pixels[pixel_index].redshift = 1.0;
				pixels[pixel_index].affine_parameter = 0.0;
				pixels[pixel_index].status_flags = body_status;
				pixels[pixel_index].iterations_used = 0u;
				early_done = true;
			}
		}

		if (!early_done && (pc.render_flags & (1u << 17)) != 0u) {
			vec3 sky_only = compute_sky_radiance(ray_dir, pc.sky_rotation_rad);
			vec3 mapped_sky = apply_tonemapping(sky_only, pc.tonemapping_mode, pc.camera_exposure);
			pixels[pixel_index].rgba = vec4(mapped_sky, 1.0);
			pixels[pixel_index].redshift = 1.0;
			pixels[pixel_index].affine_parameter = 0.0;
			pixels[pixel_index].status_flags = 2u;
			pixels[pixel_index].iterations_used = 0u;
			early_done = true;
		}
	}

	if (!early_done && ms_source_count > 1u) {
		dvec3 ms_accum;
		uint ms_status;
		uint ms_iters;
		double ms_redshift;
		trace_multi_source(ray_dir, ms_accum, ms_status, ms_iters, ms_redshift);
		vec3 ms_mapped = apply_tonemapping(vec3(ms_accum), pc.tonemapping_mode, pc.camera_exposure);
		pixels[pixel_index].rgba = vec4(ms_mapped, 1.0);
		pixels[pixel_index].redshift = float(ms_redshift);
		pixels[pixel_index].affine_parameter = float(ms_iters) * 0.05;
		pixels[pixel_index].status_flags = ms_status;
		pixels[pixel_index].iterations_used = ms_iters;
		early_done = true;
	}

	if (!early_done && pc.metric_type >= 10u && pc.metric_type <= 15u && pc.metric_type != 11u && pc.metric_type != 12u) {
		dvec3 sph_accum;
		uint sph_status;
		uint sph_iters;
		double sph_redshift;
		trace_spherical_spacetime(ray_dir, sph_accum, sph_status, sph_iters, sph_redshift);
		vec3 sph_mapped = apply_tonemapping(vec3(sph_accum), pc.tonemapping_mode, pc.camera_exposure);
		pixels[pixel_index].rgba = vec4(sph_mapped, 1.0);
		pixels[pixel_index].redshift = float(sph_redshift);
		pixels[pixel_index].affine_parameter = float(sph_iters) * 0.05;
		pixels[pixel_index].status_flags = sph_status;
		pixels[pixel_index].iterations_used = sph_iters;
		early_done = true;
	}

	if (!early_done && ((pc.metric_type >= 7u && pc.metric_type <= 9u) || pc.metric_type == 11u || pc.metric_type == 12u)) {
		dvec3 ext_accum;
		uint ext_status;
		uint ext_iters;
		double ext_redshift;
		trace_extended_metric(ray_dir, ext_accum, ext_status, ext_iters, ext_redshift);
		vec3 ext_mapped = apply_tonemapping(vec3(ext_accum), pc.tonemapping_mode, pc.camera_exposure);
		pixels[pixel_index].rgba = vec4(ext_mapped, 1.0);
		pixels[pixel_index].redshift = float(ext_redshift);
		pixels[pixel_index].affine_parameter = float(ext_iters) * 0.05;
		pixels[pixel_index].status_flags = ext_status;
		pixels[pixel_index].iterations_used = ext_iters;
		early_done = true;
	}

	if (!early_done) {
		double m = (pc.metric_type == 0u) ? 0.0 : max(pc.metric_mass, 1e-4);
		double raw_spin = clamp(pc.metric_spin, -0.999 * m, 0.999 * m);
		double a_spin = (pc.metric_type == 4u) ? 0.0 : raw_spin;
		double kn_charge_sq = (pc.metric_type == 4u || pc.metric_type == 5u) ? (pc.metric_charge * pc.metric_charge) : 0.0;
		double rs = 2.0 * m;
		double rh = (abs(a_spin) > 1e-12 || kn_charge_sq > 1e-12) ? (m + sqrt(max(m * m - a_spin * a_spin - kn_charge_sq, 0.0))) : rs;

		uint status = 0u;
		uint iters = 0u;
		dvec3 accum = dvec3(0.0);
		double redshift_rec = 1.0;

		bool needs_ray_march = (pc.metric_type != 0u) || (subsidiary_sources_present && (pc.render_flags & (1u << 12)) != 0u && pc.body_count > 0u && (pc.render_flags & (1u << 17)) == 0u) || (dark_matter_active && (pc.render_flags & (1u << 17)) == 0u);

		if (!needs_ray_march) {
			iters = 1u;
			vec3 sky = compute_sky_radiance(ray_dir, pc.sky_rotation_rad);
			accum = dvec3(sky);
			status |= 2u;
		} else {
			bool has_accretion_disk = (pc.metric_type == 1u || pc.metric_type == 2u || pc.metric_type == 3u || pc.metric_type == 4u || pc.metric_type == 5u);
			bool use_kerr_newman_metric = (pc.metric_type == 2u || pc.metric_type == 4u || pc.metric_type == 5u) && (abs(a_spin) > 1e-9 * m || kn_charge_sq > 1e-18 * m * m);
			bool use_kerr_schild = use_kerr_newman_metric && pc.metric_type == 2u;
			double isco = use_kerr_newman_metric ? kerr_isco_radius_prograde_retrograde(m, a_spin) : ((abs(a_spin) > 1e-12) ? max(rh * 1.05, 6.0 * m - 4.0 * a_spin) : (6.0 * m));
			double disk_inner = isco * double(max(pc.primary_disk.inner_radius_scale, 1.0));
			double disk_outer = max(double(pc.primary_disk.outer_radius_mass_units) * m, disk_inner * 1.05);

			double r_obs = max(pc.observer_position.y, rh * 1.02);
			double theta_obs = clamp(pc.observer_position.z, 0.001, PI_D - 0.001);
			double phi_obs = pc.observer_position.w;

			double angular_pixel_size = pc.field_of_view_rad / max(double(pc.screen_width), 1.0);
			double bh_angular_diameter = (2.0 * rh) / r_obs;
			double turbulence_aa_factor = clamp(bh_angular_diameter / max(angular_pixel_size * 24.0, 1e-9), 0.0, 1.0);

			float phi_obs_f = float(phi_obs);
			dvec2 sincos_theta_obs = precise_sincos(theta_obs);
			double sin_to = sincos_theta_obs.x;
			double cos_to = sincos_theta_obs.y;
			double sin_po = double(sin(phi_obs_f));
			double cos_po = double(cos(phi_obs_f));

			dvec3 er = dvec3(sin_to * cos_po, sin_to * sin_po, cos_to);
			dvec3 eth = dvec3(cos_to * cos_po, cos_to * sin_po, -sin_to);
			dvec3 eph = dvec3(-sin_po, cos_po, 0.0);

			double n_r = dot(ray_dir, er);
			double n_th = dot(ray_dir, eth);
			double n_ph = dot(ray_dir, eph);

			double ray_r = r_obs;
			double ray_th = theta_obs;
			double ray_phi = phi_obs;
			double ray_pr;
			double ray_pth;
			double ray_pphi;
			double ray_p0 = 1.0;
			double E_cons = 1.0;
			double Lz_cons = 0.0;
			dvec3 ks_pos = dvec3(0.0);
			dvec3 ks_mom = dvec3(0.0);
			dvec3 ks_vel = dvec3(0.0, 0.0, 1.0);

			if (use_kerr_newman_metric) {
				double g00, g03, g11, g22, g33;
				double e0_t, e0_phi, e1_r, e2_th, e3_phi;
				kerr_newman_zamo_frame(r_obs, theta_obs, m, a_spin, kn_charge_sq, g00, g03, g11, g22, g33, e0_t, e0_phi, e1_r, e2_th, e3_phi);
				ray_p0 = e0_t;
				ray_pr = -n_r * e1_r;
				ray_pth = -n_th * e2_th;
				ray_pphi = e0_phi - n_ph * e3_phi;
				E_cons = -(g00 * ray_p0 + g03 * ray_pphi);
				Lz_cons = g03 * ray_p0 + g33 * ray_pphi;
				if (use_kerr_schild) {
					ks_pos = dvec3((r_obs * cos_po - a_spin * sin_po) * sin_to, (r_obs * sin_po + a_spin * cos_po) * sin_to, r_obs * cos_to);
					ks_mom = ks_initial_momentum(ks_pos, m, a_spin, ray_dir);
					E_cons = 1.0;
					Lz_cons = ks_pos.x * ks_mom.y - ks_pos.y * ks_mom.x;
				}
			} else {
				double factor_obs = max(1.0 - rs / r_obs, 1e-6);
				double sqrt_factor_obs = sqrt(factor_obs);
				ray_pr = -n_r;
				ray_pth = -n_th / (r_obs * sqrt_factor_obs);
				ray_pphi = -n_ph / (r_obs * sin_to * sqrt_factor_obs);
				Lz_cons = ray_pphi * (r_obs * r_obs * sin_to * sin_to);
			}

			double throughput = 1.0;

			bool bodies_traced = (pc.render_flags & (1u << 12)) != 0u && pc.body_count > 0u && (pc.render_flags & (1u << 17)) == 0u;
			dvec3 curr_body_cart_pos = bodies_traced ? spherical_to_cartesian(ray_r, ray_th, ray_phi) : dvec3(0.0);

			uint effective_max_steps = pc.max_integration_steps;
			if ((pc.render_flags & (1u << 9)) != 0u && pc.lod_distance_threshold > 0.0 && r_obs > pc.lod_distance_threshold) {
				effective_max_steps = min(pc.max_integration_steps, pc.lod_reduced_steps);
			}

			for (uint step = 0u; step < effective_max_steps && throughput > 0.01; ++step) {
				iters = step + 1u;

				double delta_kn = kerr_newman_delta(ray_r, m, a_spin, kn_charge_sq);
				if (ray_r <= rh * 1.0001 || delta_kn <= 0.0) {
					status = 1u;
					throughput = 0.0;
					break;
				}
				if (ray_r >= pc.escape_radius) {
					status = 2u;
					break;
				}

				if (!use_kerr_newman_metric && !subsidiary_sources_present && !dark_matter_active && (pc.render_flags & (1u << 10)) != 0u) {
					double effective_skip_r = has_accretion_disk ? max(pc.space_skip_radius_scale * m, disk_outer * 1.05) : max(pc.space_skip_radius_scale * m, rh * 2.0);
					if (ray_r > effective_skip_r) {
						dvec3 skip_origin = spherical_to_cartesian(ray_r, ray_th, ray_phi);
						if (attempt_analytic_space_skip(ray_r, ray_th, ray_phi, ray_pr, ray_pth, ray_pphi, effective_skip_r, pc.escape_radius, m)) {
							if (bodies_traced) {
								dvec3 skip_vector = spherical_to_cartesian(ray_r, ray_th, ray_phi) - skip_origin;
								double skip_length = length(skip_vector);
								vec3 skip_color;
								uint skip_status;
								double skip_dist;
								if (skip_length > 1e-12 && intersect_bodies(skip_origin, skip_vector / skip_length, skip_length, skip_color, skip_status, skip_dist)) {
									accum += throughput * dvec3(skip_color);
									status |= 16u;
									throughput = 0.0;
									break;
								}
								curr_body_cart_pos = spherical_to_cartesian(ray_r, ray_th, ray_phi);
							}
							continue;
						}
					}
				}

				double r_scale = max(ray_r - rh, 0.02 * m);
				dvec2 sincos_ray_th = precise_sincos(ray_th);
				double sin_t = sincos_ray_th.x;
				double cos_t = sincos_ray_th.y;
				double pole_guard = (use_kerr_newman_metric && !use_kerr_schild) ? clamp(abs(sin_t) * 12.0 * pc.pole_guard_precision_scale, 0.02, 1.0) : 1.0;
				double far_field_factor = 1.0 + (pc.far_field_step_scale - 1.0) * clamp((ray_r - 20.0 * rh) / max(80.0 * rh, 1e-9), 0.0, 1.0);
				double subsidiary_guard = subsidiary_step_guard(spherical_to_cartesian(ray_r, ray_th, ray_phi));
				double dt_magnitude = clamp(pc.step_size_factor * sqrt(ray_r * r_scale) * far_field_factor, pc.min_step_size, pc.max_step_size * pc.far_field_step_scale) * pole_guard * subsidiary_guard;
				if (dark_matter_active) {
					dt_magnitude = min(dt_magnitude, dark_matter_step_limit(spherical_to_cartesian(ray_r, ray_th, ray_phi)));
				}
				double dt = -dt_magnitude;

				double prev_r = ray_r;
				double prev_th = ray_th;
				double prev_phi = ray_phi;
				double prev_pphi = ray_pphi;

				if (use_kerr_newman_metric) {
					dvec4 u_state = dvec4(ray_p0, ray_pr, ray_pth, ray_pphi);
					if (use_kerr_schild) {
						ks_rk4_step(ks_pos, ks_mom, dt, m, a_spin);
						dvec3 ks_unused_dp;
						ks_rhs(ks_pos, ks_mom, m, a_spin, ks_vel, ks_unused_dp);
						double ks_a2 = a_spin * a_spin;
						double ks_diff = dot(ks_pos, ks_pos) - ks_a2;
						double ks_r2 = max(0.5 * (ks_diff + sqrt(ks_diff * ks_diff + 4.0 * ks_a2 * ks_pos.z * ks_pos.z)), 1e-24);
						ray_r = sqrt(ks_r2);
						ray_th = atan2_wide(sqrt(max(ks_r2 - ks_pos.z * ks_pos.z, 0.0)), ks_pos.z);
						double ks_phi = atan2_wide(ks_pos.y, ks_pos.x) - atan2_wide(a_spin, ray_r);
						double ks_delta = ks_phi - ray_phi;
						ks_delta -= 6.283185307179586 * floor(ks_delta / 6.283185307179586 + 0.5);
						ray_phi += ks_delta;
					} else {
						kerr_newman_rk4_step(ray_r, ray_th, ray_phi, u_state, dt, m, a_spin, kn_charge_sq);
					}
					ray_p0 = u_state.x;
					ray_pr = u_state.y;
					ray_pth = u_state.z;
					ray_pphi = u_state.w;
				} else {
					schwarzschild_null_step(ray_r, ray_th, ray_phi, ray_pr, ray_pth, ray_pphi, dt, rs);
				}

				if (bodies_traced) {
					apply_subsidiary_deflection(ray_r, ray_th, ray_phi, ray_pr, ray_pth, ray_pphi, dt);
				}

				if (dark_matter_active) {
					dvec3 dm_previous = spherical_to_cartesian(prev_r, prev_th, prev_phi);
					dvec3 dm_current = spherical_to_cartesian(ray_r, ray_th, ray_phi);
					dvec3 dm_middle = 0.5 * (dm_previous + dm_current);
					if (use_kerr_schild) {
						ks_mom = dark_matter_kick(dm_middle, ks_mom, dt);
					} else {
						dark_matter_apply_spherical(dm_previous, ray_r, ray_th, ray_phi, ray_pr, ray_pth, ray_pphi, dt);
					}
					accum += throughput * dvec3(dark_matter_emission(dm_middle, length(dm_current - dm_previous)));
				}

				if (ray_th < 0.0) {
					ray_th = -ray_th;
					ray_phi += PI_D;
					ray_pth = -ray_pth;
				} else if (ray_th > PI_D) {
					ray_th = 2.0 * PI_D - ray_th;
					ray_phi += PI_D;
					ray_pth = -ray_pth;
				}

				vec3 body_segment_color = vec3(0.0);
				bool body_segment_hit = false;
				if (bodies_traced) {
					dvec3 next_body_cart_pos = spherical_to_cartesian(ray_r, ray_th, ray_phi);
					dvec3 segment_vector = next_body_cart_pos - curr_body_cart_pos;
					double segment_length = length(segment_vector);
					if (segment_length > 1e-12) {
						uint segment_status;
						double segment_dist;
						body_segment_hit = intersect_bodies(curr_body_cart_pos, segment_vector / segment_length, segment_length, body_segment_color, segment_status, segment_dist);
					}

					vec3 subsidiary_color;
					double subsidiary_opacity;
					bool subsidiary_absorbed;
					if (intersect_subsidiary_sources(curr_body_cart_pos, next_body_cart_pos, subsidiary_color, subsidiary_opacity, subsidiary_absorbed)) {
						if (subsidiary_absorbed) {
							status = 1u;
							throughput = 0.0;
							break;
						}
						accum += throughput * dvec3(subsidiary_color);
						throughput *= (1.0 - subsidiary_opacity);
					}

					curr_body_cart_pos = next_body_cart_pos;
				}

				if (has_accretion_disk && pc.primary_disk.enabled > 0.5 && pc.hydro_disk.model == 2u) {
					dvec3 torus_from = spherical_to_cartesian(prev_r, prev_th, prev_phi);
					dvec3 torus_to = spherical_to_cartesian(ray_r, ray_th, ray_phi);
					double torus_sin = double(sin(float(ray_th)));
					double torus_angular_ratio = ((use_kerr_newman_metric && !use_kerr_schild) ? (ray_pphi * ray_r * ray_r * torus_sin * torus_sin) : Lz_cons) / max(abs(E_cons), 1e-12);
					vec3 torus_rgb;
					double torus_opacity;
					double torus_redshift;
					torus_integrate_segment(torus_from, torus_to, torus_angular_ratio, m, use_kerr_newman_metric ? a_spin : 0.0, torus_rgb, torus_opacity, torus_redshift);
					if (torus_opacity > 1e-6) {
						status |= 4u;
						redshift_rec = torus_redshift;
						accum += throughput * dvec3(torus_rgb);
						throughput *= (1.0 - torus_opacity);
					}
				}

				if (pc.jet.enabled > 0.5) {
					vec3 jet_rgb;
					double jet_transmittance;
					if (jet_integrate_segment(spherical_to_cartesian(prev_r, prev_th, prev_phi), spherical_to_cartesian(ray_r, ray_th, ray_phi), jet_rgb, jet_transmittance)) {
						accum += throughput * dvec3(jet_rgb);
						throughput *= jet_transmittance;
						status |= 32u;
					}
				}

				double mid_plane = PI_D * 0.5;
				if (has_accretion_disk && pc.hydro_disk.model != 2u && (prev_th - mid_plane) * (ray_th - mid_plane) <= 0.0) {
					double d_th_span = abs(ray_th - prev_th);
					double s_cross = (d_th_span > 1e-12) ? clamp(abs(prev_th - mid_plane) / d_th_span, 0.0, 1.0) : 0.5;
					double r_cross = prev_r + s_cross * (ray_r - prev_r);
					double phi_cross = prev_phi + s_cross * (ray_phi - prev_phi);
					double pphi_cross = prev_pphi + s_cross * (ray_pphi - prev_pphi);

					if (pc.primary_disk.enabled > 0.5 && r_cross >= disk_inner && r_cross <= disk_outer) {
						status |= 4u;

						double lz_at_cross = (use_kerr_newman_metric && !use_kerr_schild) ? (pphi_cross * r_cross * r_cross) : Lz_cons;
						double l_over_e = lz_at_cross / max(abs(E_cons), 1e-12);
						double g_doppler = disk_redshift(m, use_kerr_newman_metric ? a_spin : 0.0, r_cross, l_over_e);
						redshift_rec = g_doppler;

						vec3 shaded_rgb;
						double shaded_opacity;
						double disk_spin_used = use_kerr_newman_metric ? a_spin : 0.0;
						double nt_base = (pc.hydro_disk.model == 1u) ? nt_base_temperature(r_cross, m, disk_spin_used) : -1.0;
						disk_shade_with_base(pc.primary_disk, m, disk_spin_used, disk_inner, disk_outer, r_cross, phi_cross, g_doppler, pc.time, turbulence_aa_factor, nt_base, shaded_rgb, shaded_opacity);

						accum += throughput * dvec3(shaded_rgb);
						throughput *= (1.0 - shaded_opacity);
					}
				}
				if (body_segment_hit && throughput > 0.01) {
					accum += throughput * dvec3(body_segment_color);
					status |= 16u;
					throughput = 0.0;
					break;
				}
			}

			if ((status & 3u) == 0u && ray_r < 3.0 * rs) {
				throughput = 0.0;
			}

			if ((status & 2u) != 0u || throughput > 0.01) {
				float ray_phi_f2 = float(ray_phi);
				dvec2 sincos_exit_th = precise_sincos(ray_th);
				double sin_t = sincos_exit_th.x;
				double cos_t = sincos_exit_th.y;
				double sin_p = double(sin(ray_phi_f2));
				double cos_p = double(cos(ray_phi_f2));

				double exit_radial = ray_pr / sqrt(max(1.0 - rs / ray_r, 1e-6));
				double pxr = -(exit_radial * sin_t * cos_p + ray_r * ray_pth * cos_t * cos_p - ray_r * sin_t * ray_pphi * sin_p);
				double pyr = -(exit_radial * sin_t * sin_p + ray_r * ray_pth * cos_t * sin_p + ray_r * sin_t * ray_pphi * cos_p);
				double pzr = -(exit_radial * cos_t - ray_r * ray_pth * sin_t);

				double p_len = sqrt(pxr * pxr + pyr * pyr + pzr * pzr);
				double inv_plen = (p_len > 1e-12) ? (1.0 / p_len) : 1.0;
				dvec3 dir_out = dvec3(pxr * inv_plen, pyr * inv_plen, pzr * inv_plen);
				if (use_kerr_schild) {
					dir_out = -ks_vel / max(length(ks_vel), 1e-12);
				}

				bool exit_body_hit = false;
				if (bodies_traced) {
					vec3 exit_color;
					uint exit_status;
					double exit_dist;
					dvec3 exit_origin = spherical_to_cartesian(ray_r, ray_th, ray_phi);
					exit_body_hit = intersect_bodies(exit_origin, dir_out, 1e30, exit_color, exit_status, exit_dist);
					if (exit_body_hit) {
						accum += throughput * dvec3(exit_color);
						status |= 16u;
					}
				}
				if (!exit_body_hit) {
					vec3 sky = compute_sky_radiance(dir_out, pc.sky_rotation_rad);
					accum += throughput * dvec3(sky);
					status |= 2u;
				}
			}
		}

		vec3 mapped = apply_tonemapping(vec3(accum), pc.tonemapping_mode, pc.camera_exposure);

		pixels[pixel_index].rgba = vec4(mapped, 1.0);
		pixels[pixel_index].redshift = float(redshift_rec);
		pixels[pixel_index].affine_parameter = float(iters) * 0.05;
		pixels[pixel_index].status_flags = status;
		pixels[pixel_index].iterations_used = iters;
	}
	}
}
