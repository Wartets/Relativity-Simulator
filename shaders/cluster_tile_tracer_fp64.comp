const double kPi = 3.14159265358979323846;
const uint kPixelHorizon = 1u;
const uint kPixelCelestial = 2u;
const uint kPixelDisk = 4u;

dvec3 compute_ray_direction(uint px, uint py) {
	double aspect = double(pc.screen_width) / double(pc.screen_height);
	double u = (double(px) + 0.5) / double(pc.screen_width) * 2.0 - 1.0;
	double v = 1.0 - (double(py) + 0.5) / double(pc.screen_height) * 2.0;

	if (pc.projection_mode == 3u || pc.projection_mode == 7u) {
		float lon = float(u * kPi);
		float lat = float(v * (kPi * 0.5));
		return dvec3(double(cos(lat) * cos(lon)), double(cos(lat) * sin(lon)), double(sin(lat)));
	}

	double tan_fov = double(tan(float(pc.field_of_view_rad * 0.5)));
	dvec3 dir = dvec3(1.0, u * aspect * tan_fov, v * tan_fov);
	return normalize(dir);
}

vec3 aces_tonemap(vec3 color, float exposure) {
	vec3 x = color * exp2(exposure);
	const float a = 2.51f;
	const float b = 0.03f;
	const float c = 2.43f;
	const float d = 0.59f;
	const float e = 0.14f;
	return clamp((x * (a * x + b)) / (x * (c * x + d) + e), 0.0f, 1.0f);
}

void main() {
	uint tile_col = gl_GlobalInvocationID.x;
	uint tile_row = gl_GlobalInvocationID.y;

	if (tile_col >= pc.tile_extent_x || tile_row >= pc.tile_extent_y) {
		return;
	}

	uint px = pc.tile_origin_x + tile_col;
	uint py = pc.tile_origin_y + tile_row;

	if (px >= pc.screen_width || py >= pc.screen_height) {
		return;
	}

	uint out_index = tile_row * pc.tile_extent_x + tile_col;

	dvec3 local_dir = compute_ray_direction(px, py);
	dvec3 fwd = pc.tetrad_e1.yzw;
	dvec3 rgt = pc.tetrad_e2.yzw;
	dvec3 up  = pc.tetrad_e3.yzw;
	dvec3 world_dir = normalize(local_dir.x * fwd + local_dir.y * rgt + local_dir.z * up);

	double r = max(pc.observer_position.y, pc.horizon_radius * 1.01);
	double theta = clamp(pc.observer_position.z, 0.001, kPi - 0.001);
	double phi = pc.observer_position.w;

	double sin_t = double(sin(float(theta)));
	double cos_t = double(cos(float(theta)));
	double sin_p = double(sin(float(phi)));
	double cos_p = double(cos(float(phi)));

	dvec3 er = dvec3(sin_t * cos_p, sin_t * sin_p, cos_t);
	dvec3 eth = dvec3(cos_t * cos_p, cos_t * sin_p, -sin_t);
	dvec3 eph = dvec3(-sin_p, cos_p, 0.0);

	double n_r = dot(world_dir, er);
	double n_th = dot(world_dir, eth);
	double n_ph = dot(world_dir, eph);

	double rs = 2.0 * max(pc.metric_mass, 1e-6);
	double rh = pc.horizon_radius;
	double f_obs = max(1.0 - rs / r, 1e-6);
	double sqrt_f_obs = sqrt(f_obs);

	double pr = -n_r;
	double ptheta = -n_th / (r * sqrt_f_obs);
	double pphi = -n_ph / (r * sin_t * sqrt_f_obs);

	vec3 accumulated_radiance = vec3(0.0f);
	float throughput = 1.0f;
	uint status = 0u;
	uint iters = 0u;

	uint max_steps = pc.max_integration_steps;
	for (uint step = 0u; step < max_steps && throughput > 0.01f; ++step) {
		iters = step + 1u;

		if (r <= rh * 1.0001) {
			status |= kPixelHorizon;
			throughput = 0.0f;
			break;
		}

		if (r >= pc.escape_radius) {
			status |= kPixelCelestial;
			break;
		}

		double r_scale = max(r - rh, 0.02 * pc.metric_mass);
		double dt = -clamp(pc.step_size_factor * sqrt(r * r_scale), pc.min_step_size, pc.max_step_size);

		double f = 1.0 - rs / r;
		double dr = f * pr;
		double dtheta = ptheta;
		double dphi = pphi;

		double dpr = -(rs / (2.0 * r * r * f)) * pr * pr + r * (ptheta * ptheta + sin_t * sin_t * pphi * pphi);
		double dptheta = -2.0 / r * pr * ptheta + sin_t * cos_t * pphi * pphi;
		double dpphi = -2.0 / r * pr * pphi - 2.0 * (cos_t / max(sin_t, 1e-6)) * ptheta * pphi;

		r += dr * dt;
		theta += dtheta * dt;
		phi += dphi * dt;
		pr += dpr * dt;
		ptheta += dptheta * dt;
		pphi += dpphi * dt;

		sin_t = double(sin(float(theta)));
		cos_t = double(cos(float(theta)));
	}

	if ((status & kPixelHorizon) == 0u) {
		float u_sky = float((phi + kPi) / (2.0 * kPi));
		float v_sky = float(theta / kPi);
		vec3 sky = texture(sky_panorama, vec2(u_sky, v_sky)).rgb;
		accumulated_radiance += throughput * sky;
		status |= kPixelCelestial;
	}

	vec3 mapped = aces_tonemap(accumulated_radiance, float(pc.camera_exposure));

	pixels[out_index].r = mapped.r;
	pixels[out_index].g = mapped.g;
	pixels[out_index].b = mapped.b;
	pixels[out_index].a = 1.0f;
	pixels[out_index].redshift = 1.0f;
	pixels[out_index].affine_parameter = float(iters) * 0.05f;
	pixels[out_index].status_flags = status;
	pixels[out_index].iterations_used = iters;
}
