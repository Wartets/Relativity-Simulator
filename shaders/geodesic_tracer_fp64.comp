const double PI_D = 3.14159265358979323846;

uint hash_u32(uint x) {
	x ^= x >> 16;
	x *= 0x7feb352dU;
	x ^= x >> 15;
	x *= 0x846ca68bU;
	x ^= x >> 16;
	return x;
}

float hash_to_float(uint x) {
	return float(hash_u32(x) & 0x00FFFFFFU) * (1.0 / 16777216.0);
}

dvec2 precise_sincos(double theta) {
	double h = theta * 0.25;
	double h2 = h * h;
	double sin_h = h * (1.0 - h2 * (1.0 / 6.0 - h2 * (1.0 / 120.0 - h2 * (1.0 / 5040.0 - h2 / 362880.0))));
	double cos_h = 1.0 - h2 * (0.5 - h2 * (1.0 / 24.0 - h2 * (1.0 / 720.0 - h2 / 40320.0)));
	double sin_2h = 2.0 * sin_h * cos_h;
	double cos_2h = 1.0 - 2.0 * sin_h * sin_h;
	double sin_4h = 2.0 * sin_2h * cos_2h;
	double cos_4h = 1.0 - 2.0 * sin_2h * sin_2h;
	return dvec2(sin_4h, cos_4h);
}

dvec3 spherical_to_cartesian(double r, double theta, double phi) {
	dvec2 sincos_theta = precise_sincos(theta);
	float phi_f = float(phi);
	double r_sin_theta = r * sincos_theta.x;
	return dvec3(r_sin_theta * double(cos(phi_f)), r_sin_theta * double(sin(phi_f)), r * sincos_theta.y);
}

double cbrt_d(double x) {
	float xf = float(x);
	float sign_x = (xf < 0.0) ? -1.0 : 1.0;
	float result = sign_x * pow(abs(xf), 1.0 / 3.0);
	return double(result);
}

double kerr_newman_delta(double r, double mass, double a, double rq2) {
	return r * r - 2.0 * mass * r + a * a + rq2;
}

double kerr_isco_radius_prograde_retrograde(double mass, double a) {
	double a_star = clamp(a / mass, -0.9999999, 0.9999999);
	double abs_a = abs(a_star);
	double orbit_sign = (a_star >= 0.0) ? -1.0 : 1.0;
	double cbrt_term = cbrt_d(max(1.0 - abs_a * abs_a, 0.0));
	double z1 = 1.0 + cbrt_term * (cbrt_d(1.0 + abs_a) + cbrt_d(1.0 - abs_a));
	double z2 = sqrt(3.0 * abs_a * abs_a + z1 * z1);
	double r_isco_over_m = 3.0 + z2 + orbit_sign * sqrt(max((3.0 - z1) * (3.0 + z1 + 2.0 * z2), 0.0));
	return r_isco_over_m * mass;
}

void kerr_newman_zamo_frame(
	double r, double theta, double mass, double a, double rq2,
	out double g00, out double g03, out double g11, out double g22, out double g33,
	out double e0_t, out double e0_phi, out double e1_r, out double e2_th, out double e3_phi
) {
	float theta_f = float(theta);
	double sin_t = double(sin(theta_f));
	double cos_t = double(cos(theta_f));
	double sin2_t = sin_t * sin_t;
	double cos2_t = cos_t * cos_t;
	double a2 = a * a;
	double r2 = r * r;
	double rho2 = r2 + a2 * cos2_t;
	double delta = kerr_newman_delta(r, mass, a, rq2);
	double two_mr_minus_q2 = 2.0 * mass * r - rq2;
	double sigma = (r2 + a2) * (r2 + a2) - a2 * delta * sin2_t;

	g00 = -(1.0 - two_mr_minus_q2 / rho2);
	g03 = -(two_mr_minus_q2 * a * sin2_t) / rho2;
	g11 = rho2 / delta;
	g22 = rho2;
	g33 = (sigma * sin2_t) / rho2;

	double omega = -g03 / max(g33, 1e-30);
	double lapse_sq = -(g00 + omega * g03);
	double alpha = sqrt(max(lapse_sq, 1e-30));
	e0_t = 1.0 / alpha;
	e0_phi = omega / alpha;
	e1_r = 1.0 / sqrt(max(g11, 1e-30));
	e2_th = 1.0 / sqrt(max(g22, 1e-30));
	e3_phi = 1.0 / sqrt(max(g33, 1e-30));
}

dvec4 kerr_newman_geodesic_derivative(dvec4 u, double r, double theta, double mass, double a, double rq2) {
	float theta_f = float(theta);
	double sin_t = double(sin(theta_f));
	double cos_t = double(cos(theta_f));
	double sin2_t = sin_t * sin_t;
	double cos2_t = cos_t * cos_t;
	double a2 = a * a;
	double r2 = r * r;
	double rho2 = r2 + a2 * cos2_t;
	double inv_rho2 = 1.0 / rho2;
	double inv_rho4 = inv_rho2 * inv_rho2;
	double delta = kerr_newman_delta(r, mass, a, rq2);
	double inv_delta = 1.0 / delta;
	double inv_delta2 = inv_delta * inv_delta;
	double inv_rho2_delta = inv_rho2 * inv_delta;
	double two_mr_minus_q2 = 2.0 * mass * r - rq2;

	double d1_ratio = (2.0 * mass * rho2 - two_mr_minus_q2 * 2.0 * r) * inv_rho4;
	double d1_g00 = d1_ratio;
	double d1_g03 = -a * sin2_t * d1_ratio;
	double d1_delta = 2.0 * (r - mass);
	double d1_g11 = (2.0 * r * delta - rho2 * d1_delta) * inv_delta2;
	double d1_g22 = 2.0 * r;
	double sigma = (r2 + a2) * (r2 + a2) - a2 * delta * sin2_t;
	double d1_sigma = 4.0 * r * (r2 + a2) - a2 * d1_delta * sin2_t;
	double d1_g33 = sin2_t * (d1_sigma * rho2 - sigma * 2.0 * r) * inv_rho4;

	double sin_cos = sin_t * cos_t;
	double d2_rho2 = -2.0 * a2 * sin_cos;
	double d2_ratio = -two_mr_minus_q2 * d2_rho2 * inv_rho4;
	double d2_g00 = d2_ratio;
	double d2_g03 = -a * (2.0 * sin_cos * two_mr_minus_q2 * rho2 - two_mr_minus_q2 * sin2_t * d2_rho2) * inv_rho4;
	double d2_g11 = d2_rho2 * inv_delta;
	double d2_g22 = d2_rho2;
	double d2_sigma = -2.0 * a2 * delta * sin_cos;
	double d2_term = 2.0 * sin_cos * sigma * rho2 + sin2_t * d2_sigma * rho2 - sigma * sin2_t * d2_rho2;
	double d2_g33 = d2_term * inv_rho4;

	double inv_g00 = -sigma * inv_rho2_delta;
	double inv_g03 = -(two_mr_minus_q2 * a) * inv_rho2_delta;
	double inv_g11 = delta * inv_rho2;
	double inv_g22 = inv_rho2;
	double safe_sin2_t = max(sin2_t, 1e-12);
	double inv_g33 = (delta - a2 * sin2_t) * (inv_rho2_delta / safe_sin2_t);

	double p0 = u.x, p1 = u.y, p2 = u.z, p3 = u.w;

	double term0 = d1_g00 * p1 * p0 + d2_g00 * p2 * p0 + d1_g03 * p1 * p3 + d2_g03 * p2 * p3;
	double term1 = -0.5 * (d1_g00 * p0 * p0 + d1_g11 * p1 * p1 + d1_g22 * p2 * p2 + d1_g33 * p3 * p3 + 2.0 * d1_g03 * p0 * p3) + d1_g11 * p1 * p1 + d2_g11 * p2 * p1;
	double term2 = -0.5 * (d2_g00 * p0 * p0 + d2_g11 * p1 * p1 + d2_g22 * p2 * p2 + d2_g33 * p3 * p3 + 2.0 * d2_g03 * p0 * p3) + d1_g22 * p1 * p2 + d2_g22 * p2 * p2;
	double term3 = d1_g03 * p1 * p0 + d2_g03 * p2 * p0 + d1_g33 * p1 * p3 + d2_g33 * p2 * p3;

	dvec4 acc;
	acc.x = -(inv_g00 * term0 + inv_g03 * term3);
	acc.y = -inv_g11 * term1;
	acc.z = -inv_g22 * term2;
	acc.w = -(inv_g03 * term0 + inv_g33 * term3);
	return acc;
}

dvec3 compute_pinhole_ray(double u, double v, double fov) {
	double tan_half = double(tan(float(fov * 0.5)));
	double n1 = 1.0;
	double n2 = v * tan_half;
	double n3 = u * tan_half;
	double len = sqrt(n1 * n1 + n2 * n2 + n3 * n3);
	double inv_len = (len > 0.0) ? (1.0 / len) : 1.0;
	return dvec3(n1 * inv_len, n2 * inv_len, n3 * inv_len);
}

dvec3 compute_fisheye_stereographic_ray(double u, double v, double fov) {
	double max_fov = clamp(fov * 1.6, 0.1, 260.0 * 0.017453292519943295);
	double r = sqrt(u * u + v * v);
	if (r < 1e-15) return dvec3(1.0, 0.0, 0.0);
	double half_max_fov = max_fov * 0.5;
	float tan_half_max_fov = tan(float(half_max_fov * 0.5));
	double theta = double(2.0 * atan(float(r) * tan_half_max_fov));
	float theta_f = float(theta);
	double sin_t = double(sin(theta_f));
	double cos_t = double(cos(theta_f));
	double n1 = cos_t;
	double n2 = v * (sin_t / r);
	double n3 = u * (sin_t / r);
	double len = sqrt(n1 * n1 + n2 * n2 + n3 * n3);
	double inv_len = (len > 0.0) ? (1.0 / len) : 1.0;
	return dvec3(n1 * inv_len, n2 * inv_len, n3 * inv_len);
}

dvec3 compute_fisheye_equidistant_ray(double u, double v, double fov) {
	double r = sqrt(u * u + v * v);
	if (r < 1e-15) return dvec3(1.0, 0.0, 0.0);
	double theta = min(r * fov * 0.5, PI_D);
	float theta_f = float(theta);
	double sin_t = double(sin(theta_f));
	double cos_t = double(cos(theta_f));
	double n1 = cos_t;
	double n2 = v * (sin_t / r);
	double n3 = u * (sin_t / r);
	double len = sqrt(n1 * n1 + n2 * n2 + n3 * n3);
	double inv_len = (len > 0.0) ? (1.0 / len) : 1.0;
	return dvec3(n1 * inv_len, n2 * inv_len, n3 * inv_len);
}

dvec3 compute_fisheye_orthographic_ray(double u, double v, double fov) {
	double r = sqrt(u * u + v * v);
	double sin_half_fov = double(sin(float(clamp(fov * 0.5, 0.01, PI_D * 0.499))));
	double sin_t = clamp(r * sin_half_fov, 0.0, 1.0);
	double cos_t = sqrt(max(1.0 - sin_t * sin_t, 0.0));
	if (r < 1e-15) return dvec3(1.0, 0.0, 0.0);
	double n1 = cos_t;
	double n2 = v * (sin_t / r);
	double n3 = u * (sin_t / r);
	double len = sqrt(n1 * n1 + n2 * n2 + n3 * n3);
	double inv_len = (len > 0.0) ? (1.0 / len) : 1.0;
	return dvec3(n1 * inv_len, n2 * inv_len, n3 * inv_len);
}

dvec3 compute_panini_cylindrical_ray(double u, double v, double fov) {
	double d = 1.0;
	double tan_h = double(tan(float(fov * 0.5)));
	double px = u * tan_h;
	double py = v * tan_h;
	double s = (d + 1.0) / (d + sqrt(max(1.0 + (1.0 - d * d) * px * px / ((d + 1.0) * (d + 1.0)), 1e-15)));
	double sin_phi = (px * s) / (d + 1.0);
	double cos_phi = sqrt(max(1.0 - sin_phi * sin_phi, 0.0));
	double n1 = cos_phi;
	double n2 = py;
	double n3 = sin_phi;
	double len = sqrt(n1 * n1 + n2 * n2 + n3 * n3);
	double inv_len = (len > 0.0) ? (1.0 / len) : 1.0;
	return dvec3(n1 * inv_len, n2 * inv_len, n3 * inv_len);
}

dvec3 compute_hammer_aitoff_ray(double u, double v, double fov) {
	double zoom = (60.0 * 0.017453292519943295) / max(fov, 0.01);
	double sqrt2 = 1.4142135623730951;
	double x = clamp(u * zoom * sqrt2, -sqrt2, sqrt2);
	double y = clamp(v * zoom * sqrt2 * 0.5, -sqrt2 * 0.5, sqrt2 * 0.5);
	double z = sqrt(max(1.0 - (x * x * 0.25) - (y * y), 1e-15));
	double phi = double(2.0 * atan(float(z * x), float(2.0 * (2.0 * z * z - 1.0))));
	double theta = (PI_D * 0.5) - double(asin(float(clamp(z * y * sqrt2, -1.0, 1.0))));
	float theta_f = float(theta);
	float phi_f = float(phi);
	double sin_t = double(sin(theta_f));
	double cos_t = double(cos(theta_f));
	double sin_p = double(sin(phi_f));
	double cos_p = double(cos(phi_f));
	return dvec3(sin_t * cos_p, cos_t, sin_t * sin_p);
}

dvec3 compute_equirectangular_360_ray(double u, double v, double fov) {
	double fov_scale = fov / (60.0 * 0.017453292519943295);
	double phi = u * PI_D * fov_scale;
	double theta = clamp((PI_D * 0.5) - v * (PI_D * 0.5) * fov_scale, 0.0001, PI_D - 0.0001);
	float theta_f = float(theta);
	float phi_f = float(phi);
	double sin_t = double(sin(theta_f));
	double cos_t = double(cos(theta_f));
	double sin_p = double(sin(phi_f));
	double cos_p = double(cos(phi_f));
	double n1 = sin_t * cos_p;
	double n2 = cos_t;
	double n3 = sin_t * sin_p;
	double len = sqrt(n1 * n1 + n2 * n2 + n3 * n3);
	double inv_len = (len > 0.0) ? (1.0 / len) : 1.0;
	return dvec3(n1 * inv_len, n2 * inv_len, n3 * inv_len);
}

dvec3 compute_ray_direction(uint mode, double u, double v, double fov) {
	if (mode == 2u) return compute_fisheye_stereographic_ray(u, v, fov);
	if (mode == 3u) return compute_equirectangular_360_ray(u, v, fov);
	if (mode == 4u) return compute_fisheye_equidistant_ray(u, v, fov);
	if (mode == 5u) return compute_fisheye_orthographic_ray(u, v, fov);
	if (mode == 6u) return compute_panini_cylindrical_ray(u, v, fov);
	if (mode == 7u) return compute_hammer_aitoff_ray(u, v, fov);
	return compute_pinhole_ray(u, v, fov);
}

vec3 sample_celestial_starfield(vec3 dir, float star_density, float star_brightness, float nebula_intensity, float brightness_variation, float size_variation, float color_variation, float temperature_bias, uint seed) {
	float theta = acos(clamp(dir.z, -1.0, 1.0));
	float phi = atan(dir.y, dir.x);
	float u = (phi + 3.14159265) * (1.0 / (2.0 * 3.14159265));
	float v = theta * (1.0 / 3.14159265);

	float gal_lat = 0.5 - v;
	float gal_band = exp(-(gal_lat * gal_lat) / 0.015);
	float gal_core = exp(-(gal_lat * gal_lat) / 0.008) * exp(-pow(u - 0.5, 2.0) / 0.05);
	float nebula_scale = max(nebula_intensity, 0.0);

	vec3 col = vec3(
		(0.015 * gal_band + 0.12 * gal_core) * nebula_scale,
		(0.020 * gal_band + 0.09 * gal_core) * nebula_scale,
		(0.045 * gal_band + 0.06 * gal_core) * nebula_scale
	);

	float u_grid = u * 720.0;
	float v_grid = v * 360.0;
	int iu = int(floor(u_grid));
	int iv = int(floor(v_grid));
	uint cell_seed = uint(iu * 73856093 ^ iv * 19349663) ^ (seed * 2654435761u);
	float star_prob = hash_to_float(cell_seed);
	float star_threshold = clamp(1.0 - 0.12 * max(star_density, 0.0), 0.0, 0.999);

	if (star_prob > star_threshold) {
		float off_u = hash_to_float(cell_seed + 101u);
		float off_v = hash_to_float(cell_seed + 202u);
		float du = (u_grid - float(iu)) - off_u;
		float dv = (v_grid - float(iv)) - off_v;

		float size_rand = hash_to_float(cell_seed + 707u);
		float radius_sq_limit = clamp(0.12 + max(size_variation, 0.0) * (0.05 + 0.55 * size_rand), 0.05, 1.1);
		float d2 = du * du + dv * dv;
		if (d2 < radius_sq_limit) {
			float brightness_exponent = 1.0 + clamp(brightness_variation, 0.0, 1.0) * 8.0;
			float base = pow(hash_to_float(cell_seed + 303u), brightness_exponent) * 4.5;
			float falloff = exp(-d2 * (3.2 / radius_sq_limit));

			float color_temp = clamp(hash_to_float(cell_seed + 404u) - clamp(temperature_bias, -1.0, 1.0) * 0.3, 0.0, 1.0);
			vec3 star_tint = vec3(1.0);
			if (color_temp < 0.3) star_tint = vec3(0.8, 0.85, 1.3);
			else if (color_temp > 0.7) star_tint = vec3(1.3, 0.85, 0.6);
			float color_mix = clamp(color_variation, 0.0, 2.0);
			star_tint = vec3(1.0) + (star_tint - vec3(1.0)) * color_mix;

			float lum = base * falloff * max(star_brightness, 0.0);
			col += star_tint * lum;
		}
	}
	return col;
}

vec3 sample_deep_field_galaxies(vec3 dir, uint seed, double density, double brightness, double size_scale) {
	if (density <= 0.0) return vec3(0.0);
	float theta = acos(clamp(dir.z, -1.0, 1.0));
	float phi = atan(dir.y, dir.x);
	float u = (phi + 3.14159265) * (1.0 / (2.0 * 3.14159265));
	float v = theta * (1.0 / 3.14159265);

	const float grid_u = 48.0;
	const float grid_v = 24.0;
	float u_grid = u * grid_u;
	float v_grid = v * grid_v;
	int iu = int(floor(u_grid));
	int iv = int(floor(v_grid));
	uint cell_seed = uint(iu * 668265263 ^ iv * 2246822519u) ^ (seed * 40503u);

	float presence = hash_to_float(cell_seed);
	float threshold = clamp(1.0 - 0.4 * clamp(float(density), 0.0, 4.0), 0.0, 0.999);
	if (presence <= threshold) return vec3(0.0);

	float off_u = hash_to_float(cell_seed + 11u);
	float off_v = hash_to_float(cell_seed + 22u);
	float du = (u_grid - float(iu)) - off_u;
	float dv = (v_grid - float(iv)) - off_v;
	float footprint = max(float(size_scale), 0.05) * max(float(size_scale), 0.05) * 1.4;
	float dist_sq = du * du + dv * dv;
	if (dist_sq > footprint) return vec3(0.0);

	float r = sqrt(dist_sq);
	float angle = atan(dv, du);
	float spiral = 0.5 + 0.5 * sin(angle * 3.0 + log(r + 0.08) * 6.0);
	float core = exp(-dist_sq * (5.0 / max(footprint, 1e-6)));
	float arms = spiral * exp(-dist_sq * (1.4 / max(footprint, 1e-6))) * 0.5;

	float base_brightness = pow(hash_to_float(cell_seed + 33u), 3.5) * 1.6;
	float lum = base_brightness * (core + arms) * float(max(brightness, 0.0));

	bool warm_tint = hash_to_float(cell_seed + 44u) > 0.5;
	float tr = warm_tint ? 0.95 : 0.55;
	float tg = warm_tint ? 0.80 : 0.70;
	float tb = warm_tint ? 0.55 : 1.05;

	return vec3(tr * lum, tg * lum, tb * lum);
}

double body_fbm(dvec3 p, uint octaves, double roughness);

vec3 sample_dust_clouds(dvec3 dir_d, uint seed, double density, double intensity, double scale) {
	if (density <= 0.0) return vec3(0.0);
	double freq = clamp(double(scale), 0.1, 10.0) * 2.2;
	double seed_offset = double(seed % 4096u) * 0.37;
	double n = body_fbm(dir_d * freq + dvec3(seed_offset, -seed_offset, seed_offset * 0.5), 4u, 0.55);
	double threshold = clamp(1.0 - 0.22 * clamp(double(density), 0.0, 4.0), -0.2, 0.98);
	if (n <= threshold) return vec3(0.0);

	float strength = float(clamp((n - threshold) / max(1.0 - threshold, 0.05), 0.0, 1.0));
	float shaped = strength * strength;

	double tint_noise = body_fbm(dir_d * freq * 0.5 + dvec3(91.0, -37.0, 13.0), 3u, 0.5);
	float tint_t = float(clamp((tint_noise + 1.0) * 0.5, 0.0, 1.0));
	float rr = 0.55 * (1.0 - tint_t) + 0.28 * tint_t;
	float gg = 0.22 * (1.0 - tint_t) + 0.16 * tint_t;
	float bb = 0.12 * (1.0 - tint_t) + 0.52 * tint_t;

	float lum = shaped * float(max(intensity, 0.0)) * 0.6;
	return vec3(rr * lum, gg * lum, bb * lum);
}

vec3 sample_star_clusters(vec3 dir, uint seed, double density, double brightness, double size_scale) {
	if (density <= 0.0) return vec3(0.0);
	float theta = acos(clamp(dir.z, -1.0, 1.0));
	float phi = atan(dir.y, dir.x);
	float u = (phi + 3.14159265) * (1.0 / (2.0 * 3.14159265));
	float v = theta * (1.0 / 3.14159265);

	const float grid_u = 90.0;
	const float grid_v = 45.0;
	float u_grid = u * grid_u;
	float v_grid = v * grid_v;
	int iu = int(floor(u_grid));
	int iv = int(floor(v_grid));
	uint cell_seed = uint(iu * 1274126177 ^ iv * 374761393u) ^ (seed * 2246822519u);

	float presence = hash_to_float(cell_seed);
	float threshold = clamp(1.0 - 0.06 * clamp(float(density), 0.0, 4.0), 0.0, 0.999);
	if (presence <= threshold) return vec3(0.0);

	vec3 total = vec3(0.0);
	float member_footprint = max(float(size_scale), 0.05) * 0.03;
	for (uint member = 0u; member < 7u; ++member) {
		uint member_seed = cell_seed + member * 97u;
		float off_u = hash_to_float(member_seed + 1u);
		float off_v = hash_to_float(member_seed + 2u);
		float du = (u_grid - float(iu)) - off_u;
		float dv = (v_grid - float(iv)) - off_v;
		float dist_sq = du * du + dv * dv;
		if (dist_sq > member_footprint) continue;

		float member_brightness = pow(hash_to_float(member_seed + 3u), 3.0) * 2.2;
		float falloff = exp(-dist_sq * (6.0 / max(member_footprint, 1e-6)));
		float lum = member_brightness * falloff * float(max(brightness, 0.0));
		total += vec3(lum, lum * 0.95, lum * 0.85);
	}
	return total;
}

vec3 sample_celestial_grid_sphere(vec3 dir, float grid_opacity) {
	float theta = acos(clamp(dir.z, -1.0, 1.0));
	float phi = atan(dir.y, dir.x);
	float lat_deg = 90.0 - theta * (180.0 / 3.14159265);
	float lon_deg = phi * (180.0 / 3.14159265);
	float lat_line = abs(mod(lat_deg + 7.5, 15.0) - 7.5);
	float lon_line = abs(mod(lon_deg + 7.5, 15.0) - 7.5);
	const float line_width = 0.35;
	bool on_major_lat = abs(mod(lat_deg + 45.0, 90.0) - 45.0) < line_width;
	bool on_major_lon = abs(mod(lon_deg + 45.0, 90.0) - 45.0) < line_width;
	bool on_minor_line = (lat_line < line_width) || (lon_line < line_width);
	float opacity = max(grid_opacity, 0.0);
	if (on_major_lat || on_major_lon) return vec3(0.14, 0.20, 0.28) * opacity;
	if (on_minor_line) return vec3(0.05, 0.07, 0.10) * opacity;
	return vec3(0.008, 0.009, 0.012) * opacity;
}

vec3 apply_hue_saturation(vec3 rgb, double hue_shift_rad, double saturation) {
	if (hue_shift_rad == 0.0 && saturation == 1.0) return rgb;
	float r = rgb.r, g = rgb.g, b = rgb.b;
	float max_c = max(r, max(g, b));
	float min_c = min(r, min(g, b));
	float delta = max_c - min_c;
	float h = 0.0;
	if (delta > 1e-8) {
		if (max_c == r) h = mod((g - b) / delta, 6.0);
		else if (max_c == g) h = (b - r) / delta + 2.0;
		else h = (r - g) / delta + 4.0;
		h *= 60.0;
		if (h < 0.0) h += 360.0;
	}
	float s_val = (max_c > 1e-8) ? (delta / max_c) : 0.0;
	float v_val = max_c;

	h += float(hue_shift_rad * (180.0 / PI_D));
	h = mod(h, 360.0);
	if (h < 0.0) h += 360.0;
	float s_new = clamp(s_val * float(saturation), 0.0, 1.0);

	float c_val = v_val * s_new;
	float x_val = c_val * (1.0 - abs(mod(h / 60.0, 2.0) - 1.0));
	float m_val = v_val - c_val;

	float r2 = 0.0, g2 = 0.0, b2 = 0.0;
	if (h < 60.0) { r2 = c_val; g2 = x_val; b2 = 0.0; }
	else if (h < 120.0) { r2 = x_val; g2 = c_val; b2 = 0.0; }
	else if (h < 180.0) { r2 = 0.0; g2 = c_val; b2 = x_val; }
	else if (h < 240.0) { r2 = 0.0; g2 = x_val; b2 = c_val; }
	else if (h < 300.0) { r2 = x_val; g2 = 0.0; b2 = c_val; }
	else { r2 = c_val; g2 = 0.0; b2 = x_val; }

	return vec3(r2 + m_val, g2 + m_val, b2 + m_val);
}

vec3 sample_panorama(vec3 dir) {
	float len = length(dir);
	if (len < 1e-12) return vec3(0.0);
	float theta = acos(clamp(dir.z / len, -1.0, 1.0));
	float phi = atan(dir.y, dir.x);
	float u = (phi + 3.14159265) * (1.0 / (2.0 * 3.14159265));
	float v = theta * (1.0 / 3.14159265);
	return textureLod(panorama_sampler, vec2(u, clamp(v, 0.0, 1.0)), 0.0).rgb;
}

vec3 compute_sky_radiance(dvec3 dir_d, double sky_rotation_rad) {
	float sky_rotation_f = float(sky_rotation_rad);
	double cos_r = double(cos(sky_rotation_f));
	double sin_r = double(sin(sky_rotation_f));
	dvec3 rotated = dvec3(
		dir_d.x * cos_r - dir_d.y * sin_r,
		dir_d.x * sin_r + dir_d.y * cos_r,
		dir_d.z
	);
	vec3 dir = vec3(rotated);

	if (pc.sky_background_source != 0u && pc.sky_panorama_width > 0u && pc.sky_panorama_height > 0u) {
		vec3 panorama_rgb = sample_panorama(dir);
		panorama_rgb = apply_hue_saturation(panorama_rgb, pc.sky_hue_shift_rad, pc.sky_saturation);
		return max(panorama_rgb + vec3(float(pc.sky_background_r), float(pc.sky_background_g), float(pc.sky_background_b)), vec3(0.0));
	}

	uint sky_mode = pc.render_flags & 0x0Fu;
	vec3 sky_rgb = vec3(0.0);

	float bvar = float(pc.sky_star_brightness_variation);
	float svar = float(pc.sky_star_size_variation);
	float cvar = float(pc.sky_star_color_variation);
	float tbias = float(pc.sky_star_temperature_bias);
	uint seed = pc.sky_procedural_seed;

	if (sky_mode == 1u || (pc.render_flags & (1u << 4)) != 0u) {
		sky_rgb = sample_celestial_grid_sphere(dir, float(pc.sky_grid_opacity));
	} else if (sky_mode == 2u) {
		vec3 stars = sample_celestial_starfield(dir, float(pc.sky_star_density), float(pc.sky_star_brightness), float(pc.sky_nebula_intensity), bvar, svar, cvar, tbias, seed);
		vec3 grid = sample_celestial_grid_sphere(dir, float(pc.sky_grid_opacity));
		sky_rgb = stars + grid * 0.7;
	} else if (sky_mode == 0u) {
		sky_rgb = sample_celestial_starfield(dir, float(pc.sky_star_density), float(pc.sky_star_brightness), float(pc.sky_nebula_intensity), bvar, svar, cvar, tbias, seed);
	} else if (sky_mode == 4u) {
		sky_rgb = sample_celestial_starfield(dir, float(pc.sky_star_density), float(pc.sky_star_brightness), 0.0, bvar, svar, cvar, tbias, seed);
	} else if (sky_mode == 5u) {
		vec3 stars = sample_celestial_starfield(dir, float(pc.sky_star_density), float(pc.sky_star_brightness), 0.0, bvar, svar, cvar, tbias, seed);
		vec3 grid = sample_celestial_grid_sphere(dir, float(pc.sky_grid_opacity));
		sky_rgb = stars + grid;
	}

	if (pc.sky_galaxy_density > 0.0) {
		sky_rgb += sample_deep_field_galaxies(dir, seed, pc.sky_galaxy_density, pc.sky_galaxy_brightness, pc.sky_galaxy_size_scale);
	}
	if (pc.sky_dust_density > 0.0) {
		sky_rgb += sample_dust_clouds(rotated, seed, pc.sky_dust_density, pc.sky_dust_intensity, pc.sky_dust_scale);
	}
	if (pc.sky_cluster_density > 0.0) {
		sky_rgb += sample_star_clusters(dir, seed, pc.sky_cluster_density, pc.sky_cluster_brightness, pc.sky_cluster_size_scale);
	}

	sky_rgb = apply_hue_saturation(sky_rgb, pc.sky_hue_shift_rad, pc.sky_saturation);
	sky_rgb.r = max(0.0, sky_rgb.r + float(pc.sky_background_r));
	sky_rgb.g = max(0.0, sky_rgb.g + float(pc.sky_background_g));
	sky_rgb.b = max(0.0, sky_rgb.b + float(pc.sky_background_b));
	return sky_rgb;
}

float cie_gaussian_component(float x, float alpha, float mu, float sigma1, float sigma2) {
	float sigma = (x < mu) ? sigma1 : sigma2;
	float t = (x - mu) / sigma;
	return alpha * exp(-0.5 * t * t);
}

float cie_x_bar(float lambda_nm) {
	return cie_gaussian_component(lambda_nm, 1.056, 599.8, 37.9, 31.0)
		+ cie_gaussian_component(lambda_nm, 0.362, 442.0, 16.0, 26.7)
		- cie_gaussian_component(lambda_nm, 0.065, 501.1, 20.4, 26.2);
}

float cie_y_bar(float lambda_nm) {
	return cie_gaussian_component(lambda_nm, 0.821, 568.8, 46.9, 40.5)
		+ cie_gaussian_component(lambda_nm, 0.286, 530.9, 16.3, 31.1);
}

float cie_z_bar(float lambda_nm) {
	return cie_gaussian_component(lambda_nm, 1.217, 437.0, 11.8, 36.0)
		+ cie_gaussian_component(lambda_nm, 0.681, 459.0, 26.0, 13.8);
}

float planck_spectral_radiance(float lambda_m, float temp_k) {
	const float c2 = 0.0143877688;
	float x = c2 / (lambda_m * temp_k);
	if (x > 80.0) return 0.0;
	float lambda_um = lambda_m * 1e6;
	float lambda5 = lambda_um * lambda_um * lambda_um * lambda_um * lambda_um;
	return 1.0 / (lambda5 * (exp(x) - 1.0));
}

dvec3 temperature_to_linear_rgb(double t_kelvin, double intensity, double saturation) {
	float t = float(clamp(t_kelvin, 800.0, 60000.0));
	vec3 int_xyz = vec3(0.0);
	const int samples = 16;
	const float lambda_start = 380.0;
	const float d_lambda = (780.0 - 380.0) / float(samples);
	for (int i = 0; i <= samples; ++i) {
		float lambda_nm = lambda_start + float(i) * d_lambda;
		float radiance = planck_spectral_radiance(lambda_nm * 1e-9, t);
		float weight = (i == 0 || i == samples) ? 0.5 : 1.0;
		int_xyz.x += weight * radiance * cie_x_bar(lambda_nm);
		int_xyz.y += weight * radiance * cie_y_bar(lambda_nm);
		int_xyz.z += weight * radiance * cie_z_bar(lambda_nm);
	}

	float r =  3.2404542 * int_xyz.x - 1.5371385 * int_xyz.y - 0.4985314 * int_xyz.z;
	float g = -0.9692660 * int_xyz.x + 1.8760108 * int_xyz.y + 0.0415560 * int_xyz.z;
	float b =  0.0556434 * int_xyz.x - 0.2040259 * int_xyz.y + 1.0572252 * int_xyz.z;
	r = max(r, 0.0);
	g = max(g, 0.0);
	b = max(b, 0.0);

	float max_c = max(max(r, g), max(b, 1e-6));
	r /= max_c;
	g /= max_c;
	b /= max_c;

	float luma = 0.2126 * r + 0.7152 * g + 0.0722 * b;
	float sat = float(clamp(saturation, 0.0, 3.0));
	r = max(0.0, luma + (r - luma) * sat);
	g = max(0.0, luma + (g - luma) * sat);
	b = max(0.0, luma + (b - luma) * sat);

	float scale = float(max(intensity, 0.0));
	return dvec3(double(r * scale), double(g * scale), double(b * scale));
}

float disk_lattice_value(ivec3 p, uint seed) {
	uint h = uint(p.x) * 374761393u + uint(p.y) * 668265263u + uint(p.z) * 2147483647u + seed * 1274126177u;
	return float(hash_u32(h) & 0x00FFFFFFu) * (1.0 / 16777216.0) * 2.0 - 1.0;
}

float disk_value_noise(vec3 p, uint seed) {
	vec3 base = floor(p);
	ivec3 i0 = ivec3(base);
	vec3 f = p - base;
	vec3 u = f * f * (3.0 - 2.0 * f);

	float c000 = disk_lattice_value(i0, seed);
	float c100 = disk_lattice_value(i0 + ivec3(1, 0, 0), seed);
	float c010 = disk_lattice_value(i0 + ivec3(0, 1, 0), seed);
	float c110 = disk_lattice_value(i0 + ivec3(1, 1, 0), seed);
	float c001 = disk_lattice_value(i0 + ivec3(0, 0, 1), seed);
	float c101 = disk_lattice_value(i0 + ivec3(1, 0, 1), seed);
	float c011 = disk_lattice_value(i0 + ivec3(0, 1, 1), seed);
	float c111 = disk_lattice_value(i0 + ivec3(1, 1, 1), seed);

	float c00 = mix(c000, c100, u.x);
	float c10 = mix(c010, c110, u.x);
	float c01 = mix(c001, c101, u.x);
	float c11 = mix(c011, c111, u.x);
	return mix(mix(c00, c10, u.y), mix(c01, c11, u.y), u.z);
}

float disk_fractal_noise(vec3 p, int octaves, uint seed) {
	float total = 0.0;
	float amplitude = 1.0;
	float frequency = 1.0;
	float normalization = 0.0;
	for (int octave = 0; octave < octaves; ++octave) {
		total += disk_value_noise(p * frequency, seed + uint(octave) * 7919u) * amplitude;
		normalization += amplitude;
		amplitude *= 0.5;
		frequency *= 2.0;
	}
	return total / max(normalization, 1e-5);
}

vec3 disk_blackbody_rgb(float temperature_k, float reference_luminance) {
	const int samples = 32;
	float t = clamp(temperature_k, 300.0, 400000.0);
	vec3 xyz = vec3(0.0);
	for (int i = 0; i <= samples; ++i) {
		float lambda_nm = 380.0 + float(i) * (400.0 / float(samples));
		float lambda_um = lambda_nm * 1e-3;
		float exponent = 14387.76877 / (lambda_um * t);
		if (exponent > 80.0) continue;
		float lambda_sq = lambda_um * lambda_um;
		float radiance = 1.0 / (lambda_sq * lambda_sq * lambda_um * (exp(exponent) - 1.0));
		float weight = (i == 0 || i == samples) ? 0.5 : 1.0;
		xyz += weight * radiance * vec3(cie_x_bar(lambda_nm), cie_y_bar(lambda_nm), cie_z_bar(lambda_nm));
	}
	xyz /= max(reference_luminance, 1e-30);
	vec3 rgb = vec3(
		3.2404542 * xyz.x - 1.5371385 * xyz.y - 0.4985314 * xyz.z,
		-0.9692660 * xyz.x + 1.8760108 * xyz.y + 0.0415560 * xyz.z,
		0.0556434 * xyz.x - 0.2040259 * xyz.y + 1.0572252 * xyz.z
	);
	return max(rgb, vec3(0.0));
}

void disk_orbital_frame(double mass, double spin, double radius, out double omega, out double dilation) {
	double spin_magnitude = abs(spin);
	double sqrt_mass = sqrt(max(mass, 1e-12));
	double sqrt_radius = sqrt(max(radius, 1e-12));
	double radius_pow_1_5 = radius * sqrt_radius;
	double angular = sqrt_mass / (radius_pow_1_5 + spin_magnitude * sqrt_mass);
	double bracket = max(radius_pow_1_5 - 3.0 * mass * sqrt_radius + 2.0 * spin_magnitude * sqrt_mass, 1e-9);
	omega = (spin < 0.0) ? -angular : angular;
	dilation = (radius_pow_1_5 + spin_magnitude * sqrt_mass) / (sqrt(radius_pow_1_5) * sqrt(bracket));
}

double disk_redshift(double mass, double spin, double radius, double angular_momentum_ratio) {
	double omega;
	double dilation;
	disk_orbital_frame(mass, spin, radius, omega, dilation);
	double denominator = dilation * (1.0 - omega * angular_momentum_ratio);
	return (abs(denominator) > 1e-9) ? clamp(1.0 / denominator, 0.05, 4.0) : 1.0;
}

float disk_smooth_unit(float x) {
	float t = clamp(x, 0.0, 1.0);
	return t * t * (3.0 - 2.0 * t);
}

double disk_reduce_angle(double angle) {
	const double two_pi = 6.283185307179586;
	return angle - two_pi * floor(angle / two_pi);
}

void disk_shade(DiskProfile disk, double mass_in, double spin, double inner_in, double outer_in, double radius_in, double azimuth, double redshift_in, double time, double detail_scale, out vec3 radiance, out double opacity) {
	double mass = max(mass_in, 1e-9);
	double radius = max(radius_in, 1e-9);
	double inner = max(inner_in, 1e-9);
	double outer = max(outer_in, inner * 1.0001);

	float u = float(clamp(inner / radius, 1e-4, 1.0));
	float boundary = max(1.0 - disk.zero_torque_strength * sqrt(u), 0.0);
	float base = pow(u, disk.temperature_exponent) * pow(boundary, 0.25) * disk.temperature_normalization;

	float softness = max(disk.edge_softness, 0.05);
	float mass_f = float(mass);
	float envelope = disk_smooth_unit(float(radius - inner) / (0.8 * softness * mass_f)) * disk_smooth_unit(float(outer - radius) / (1.5 * softness * mass_f));

	double rotation = double(disk.rotation_speed_scale) * time;
	double omega_local;
	double omega_pattern;
	double unused_dilation;
	disk_orbital_frame(mass, spin, radius, omega_local, unused_dilation);
	disk_orbital_frame(mass, spin, sqrt(inner * outer), omega_pattern, unused_dilation);
	double shear_phase = disk_reduce_angle(azimuth - omega_local * rotation);
	double pattern_phase = disk_reduce_angle(azimuth - omega_pattern * rotation);

	float log_ratio = log(float(max(radius / inner, 1.0)));
	float log_span = max(log(float(max(outer / inner, 1.0001))), 1e-4);
	float radial_coordinate = log_ratio / log_span;

	float ring_wave = 0.5 + 0.5 * cos(6.28318531 * disk.ring_frequency * radial_coordinate);
	float ring_sharpness = max(disk.ring_sharpness, 1.0);
	float ring = max(1.0 + disk.ring_amplitude * (pow(ring_wave, ring_sharpness) * sqrt(3.14159265 * ring_sharpness) - 1.0), 0.0);

	float arms = floor(disk.spiral_arm_count + 0.5);
	float spiral = (arms > 0.5) ? max(1.0 + disk.spiral_amplitude * cos(arms * (float(pattern_phase) - disk.spiral_pitch * log_ratio)), 0.0) : 1.0;

	float shear_cos = cos(float(shear_phase));
	float shear_sin = sin(float(shear_phase));
	int octaves = clamp(int(disk.turbulence_octaves + 0.5), 1, 6);
	uint seed = uint(max(disk.noise_seed, 0.0));
	float detail = float(clamp(detail_scale, 0.0, 1.0));

	float turbulence_noise = disk_fractal_noise(vec3(log_ratio * disk.turbulence_scale * disk.radial_stretch, shear_cos * disk.turbulence_scale, shear_sin * disk.turbulence_scale), octaves, seed);
	float turbulence = exp(1.5 * disk.turbulence_amplitude * detail * turbulence_noise);
	float grain_noise = disk_value_noise(vec3(log_ratio * disk.grain_scale * disk.radial_stretch, shear_cos * disk.grain_scale, shear_sin * disk.grain_scale), seed + 104729u);
	float grain = max(1.0 + disk.grain_amplitude * detail * grain_noise, 0.0);

	float flux_modulation = clamp(ring * spiral * turbulence * grain, 0.0, 8.0);
	float temperature_span = max(disk.peak_temperature_k - disk.floor_temperature_k, 0.0);
	float local_temperature = (disk.floor_temperature_k + temperature_span * base) * pow(max(flux_modulation, 1e-4), 0.25);
	float redshift = float(max(redshift_in, 1e-3));

	vec3 color = disk_blackbody_rgb(local_temperature * redshift, disk.reference_luminance) * (disk.brightness * pow(redshift, disk.extra_beaming_exponent) * envelope);
	float luma = dot(color, vec3(0.2126, 0.7152, 0.0722));
	color = max(vec3(0.0), vec3(luma) + (color - vec3(luma)) * disk.color_saturation);
	color *= vec3(1.0) + (vec3(disk.tint_r, disk.tint_g, disk.tint_b) - vec3(1.0)) * disk.tint_strength;

	radiance = color;
	opacity = double(clamp(envelope * 0.95 * disk.opacity_scale * clamp(sqrt(min(flux_modulation, 1.0)), 0.15, 1.0), 0.0, 0.98));
}

vec3 apply_tonemapping(vec3 linear_color, uint mode, double exposure_ev) {
	float exp_scale = exp2(float(exposure_ev));
	vec3 col = max(linear_color * exp_scale, vec3(0.0));

	if (mode == 1u) {
		const float a = 2.51, b = 0.03, c = 2.43, d = 0.59, e = 0.14;
		col = clamp((col * (a * col + b)) / (col * (c * col + d) + e), 0.0, 1.0);
	} else if (mode == 2u) {
		float lum = dot(col, vec3(0.2126, 0.7152, 0.0722));
		if (lum > 0.0) {
			const float inv_log_base = 0.108572457;
			float mapped_lum = log(1.0 + lum * 100.0) * inv_log_base;
			col = clamp(col * clamp(mapped_lum / lum, 0.0, 1.0), 0.0, 1.0);
		} else {
			col = vec3(0.0);
		}
	} else if (mode == 3u) {
		col = (col * (1.0 + col * 0.04)) / (1.0 + col);
	} else {
		col = clamp(col, 0.0, 1.0);
	}

	vec3 lo = 12.92 * col;
	vec3 hi = 1.055 * pow(col, vec3(1.0 / 2.4)) - 0.055;
	return mix(hi, lo, lessThanEqual(col, vec3(0.0031308)));
}

double body_hash3(ivec3 p) {
	uint h = uint(p.x) * 374761393u + uint(p.y) * 668265263u + uint(p.z) * 2147483647u;
	return double(hash_to_float(h)) * 2.0 - 1.0;
}

float body_value_noise(vec3 p) {
	ivec3 i0 = ivec3(floor(p));
	vec3 f = p - vec3(i0);
	vec3 u = f * f * (3.0 - 2.0 * f);

	float c000 = float(body_hash3(i0 + ivec3(0, 0, 0)));
	float c100 = float(body_hash3(i0 + ivec3(1, 0, 0)));
	float c010 = float(body_hash3(i0 + ivec3(0, 1, 0)));
	float c110 = float(body_hash3(i0 + ivec3(1, 1, 0)));
	float c001 = float(body_hash3(i0 + ivec3(0, 0, 1)));
	float c101 = float(body_hash3(i0 + ivec3(1, 0, 1)));
	float c011 = float(body_hash3(i0 + ivec3(0, 1, 1)));
	float c111 = float(body_hash3(i0 + ivec3(1, 1, 1)));

	float c00 = mix(c000, c100, u.x);
	float c10 = mix(c010, c110, u.x);
	float c01 = mix(c001, c101, u.x);
	float c11 = mix(c011, c111, u.x);

	float c0 = mix(c00, c10, u.y);
	float c1 = mix(c01, c11, u.y);

	return mix(c0, c1, u.z);
}

double body_fbm(dvec3 p_d, uint octaves, double roughness) {
	vec3 p = vec3(p_d);
	float r_f = float(roughness);
	float total = 0.0;
	float amplitude = 1.0;
	float frequency = 1.0;
	float max_val = 0.0;
	for (uint i = 0u; i < octaves; ++i) {
		total += body_value_noise(p * frequency) * amplitude;
		max_val += amplitude;
		amplitude *= r_f;
		frequency *= 2.0;
	}
	return double(total / max(max_val, 1e-5));
}

float surface_fbm(vec3 p, uint octaves, float roughness) {
	return float(body_fbm(dvec3(p), octaves, double(roughness)));
}

float surface_pattern_value(uint pattern, vec3 p, float theta, float phi, float scale, uint octaves, uint seed) {
	vec3 q = p * scale + vec3(float(seed % 977u) * 0.731, -float(seed % 613u) * 0.417, float(seed % 389u) * 0.293);
	if (pattern == 1u) {
		float r = 1.0 - abs(surface_fbm(q, octaves, 0.5));
		return r * r;
	}
	if (pattern == 2u) return abs(surface_fbm(q, octaves, 0.5));
	if (pattern == 3u) return 0.5 + 0.5 * sin(theta * scale * 2.0 + surface_fbm(q, octaves, 0.5) * 2.0);
	if (pattern == 4u) return 0.5 + 0.5 * sin(phi * scale + surface_fbm(q, octaves, 0.5) * 2.0);
	if (pattern == 5u) {
		float n = 0.5 + 0.5 * surface_fbm(q * 4.0, 2u, 0.5);
		return smoothstep(0.55, 1.0, n);
	}
	if (pattern == 6u) {
		float c = 0.5 + 0.5 * surface_fbm(q, octaves, 0.5);
		return clamp(smoothstep(0.55, 0.62, c) - 0.6 * smoothstep(0.62, 0.85, c), 0.0, 1.0);
	}
	if (pattern == 7u) {
		float n = surface_fbm(q, octaves, 0.5);
		return pow(clamp(1.0 - abs(n) * 2.2, 0.0, 1.0), 6.0);
	}
	if (pattern == 8u) return 0.5 + 0.5 * sin((phi + theta) * scale * 0.5 + surface_fbm(q, octaves, 0.5) * 6.0);
	if (pattern == 9u) {
		float warp = surface_fbm(q * 0.5, 2u, 0.5);
		return 0.5 + 0.5 * surface_fbm(q + vec3(warp * 1.5), octaves, 0.55);
	}
	return 0.5 + 0.5 * surface_fbm(q, octaves, 0.5);
}

float surface_mask_value(uint mask, float cos_t, float sun, float width) {
	if (mask == 1u) return smoothstep(1.0 - width, 1.0, abs(cos_t));
	if (mask == 2u) return 1.0 - smoothstep(0.0, width, abs(cos_t));
	if (mask == 3u) return smoothstep(-0.5 * width, 0.5 * width, cos_t);
	if (mask == 4u) return 1.0 - smoothstep(-0.5 * width, 0.5 * width, cos_t);
	if (mask == 5u) return smoothstep(-0.5 * width, 0.5 * width, sun);
	if (mask == 6u) return 1.0 - smoothstep(-0.5 * width, 0.5 * width, sun);
	return 1.0;
}

vec3 surface_apply_blend(uint blend, vec3 base, vec3 layer_color, float a) {
	if (blend == 1u) return base + layer_color * a;
	if (blend == 2u) return mix(base, base * layer_color, a);
	if (blend == 3u) return mix(base, vec3(1.0) - (vec3(1.0) - base) * (vec3(1.0) - layer_color), a);
	if (blend == 4u) {
		vec3 lo = 2.0 * base * layer_color;
		vec3 hi = vec3(1.0) - 2.0 * (vec3(1.0) - base) * (vec3(1.0) - layer_color);
		return mix(base, mix(hi, lo, lessThan(base, vec3(0.5))), a);
	}
	return mix(base, layer_color, a);
}

vec3 shade_earth_surface(uint bi, float phi, float cos_t, float sun, float vdn, float footprint_pixels, vec3 fallback, out vec3 emissive) {
	emissive = vec3(0.0);
	uint variant = bodies[bi].earth_map_variant;
	vec2 uv = vec2((phi + 3.14159265) * (1.0 / (2.0 * 3.14159265)), clamp(acos(cos_t) * (1.0 / 3.14159265), 0.0, 1.0));
	float safe_footprint = max(footprint_pixels, 1e-3);
	float grazing_lod = -0.5 * log2(max(vdn, 0.05));
	vec3 day_rgb = fallback;
	vec3 night_rgb = vec3(0.0);

	if (variant != 1u && pc.earth_day_width > 0u) {
		float day_lod = max(log2(max(float(pc.earth_day_width) / safe_footprint, 1.0)) + grazing_lod, 0.0);
		day_rgb = textureLod(earth_day_sampler, uv, day_lod).rgb;
	}
	if (variant != 0u && pc.earth_night_width > 0u) {
		float night_lod = max(log2(max(float(pc.earth_night_width) / safe_footprint, 1.0)) + grazing_lod, 0.0);
		night_rgb = textureLod(earth_night_sampler, uv, night_lod).rgb;
	}

	if (variant == 0u) {
		return day_rgb;
	}
	if (variant == 1u) {
		emissive = night_rgb;
		return vec3(0.0);
	}

	float illumination = sun;
	float softness = clamp(bodies[bi].earth_terminator_softness, 0.0, 1.0);
	float half_width = 0.04 + 0.46 * softness;
	float blend_t = clamp((illumination + half_width) / (2.0 * half_width), 0.0, 1.0);
	float day_weight = blend_t * blend_t * blend_t * (blend_t * (blend_t * 6.0 - 15.0) + 10.0);
	emissive = night_rgb * (1.0 - day_weight);
	return day_rgb * day_weight;
}

vec3 shade_body_surface(uint bi, dvec3 nrm, double sun_facing, double view_dot_n, out vec3 emissive, out float city_speckle, float earth_footprint_pixels) {
	emissive = vec3(0.0);
	city_speckle = 0.0;
	vec3 c1 = vec3(bodies[bi].color_primary_xy.x, bodies[bi].color_primary_xy.y, bodies[bi].color_primary_zw.x);
	vec3 c2 = vec3(bodies[bi].color_secondary_xy.x, bodies[bi].color_secondary_xy.y, bodies[bi].color_secondary_zw.x);
	vec3 c3 = vec3(bodies[bi].color_tertiary_r, bodies[bi].color_tertiary_g, bodies[bi].color_tertiary_b);
	float detail = float(max(bodies[bi].texture_detail_scale, 0.1));
	float noise_scale = float(max(bodies[bi].noise_scale, 0.1)) * detail;
	float roughness = float(clamp(bodies[bi].noise_roughness, 0.05, 1.0));
	uint octaves = clamp(pc.body_noise_octaves, 1u, 6u);
	float cos_t = float(clamp(nrm.z, -1.0, 1.0));
	float theta = acos(cos_t);
	float sin_th = sin(theta);
	float phi = atan(float(nrm.y), float(nrm.x)) + float(bodies[bi].rotation_speed * pc.time);
	vec3 sph = vec3(sin_th * cos(phi), sin_th * sin(phi), cos_t);
	vec3 sp = sph * noise_scale;
	bool earth_mode = (bodies[bi].surface_texture_mode == 13u);
	float n_val = earth_mode ? 0.0 : surface_fbm(sp, octaves, roughness);
	float n_sec = earth_mode ? 0.0 : surface_fbm(sp * 2.3 + vec3(11.0, -7.0, 3.0), octaves, roughness);
	float vdn = float(view_dot_n);
	float sun = float(sun_facing);
	uint mode = bodies[bi].surface_texture_mode;
	float emission_base = float(bodies[bi].emission_intensity);
	vec3 col = c1;

	if (mode == 0u) {
		if (n_val < 0.0) {
			float t = clamp((n_val + 1.0) * 0.5, 0.0, 1.0);
			col = vec3(0.02 + 0.05 * t, 0.15 + 0.25 * t, 0.5 + 0.4 * t);
			col += pow(vdn, 32.0) * vec3(0.8, 0.8, 0.9);
		} else {
			col = mix(c1, c2, clamp(n_val * 2.0, 0.0, 1.0));
		}
	} else if (mode == 1u) {
		col = c1;
	} else if (mode == 2u) {
		float t = clamp((n_val + 1.0) * 0.5, 0.0, 1.0);
		vec3 mid = (c1 + c2) * 0.5;
		col = (t < 0.5) ? mix(c1, mid, t * 2.0) : mix(mid, c2, (t - 0.5) * 2.0);
	} else if (mode == 3u) {
		float band = sin(theta * 16.0 + n_val * 4.0);
		col = mix(c1, c2, clamp((band + 1.0) * 0.5, 0.0, 1.0));
	} else if (mode == 4u) {
		float crater = (n_val > 0.25) ? 0.65 : 1.0;
		float rim = (n_val > 0.2 && n_val < 0.3) ? 1.25 : 1.0;
		col = c1 * crater * rim;
		float speckle_t = clamp((n_sec + 1.0) * 0.35, 0.0, 1.0);
		col = mix(col, c2, speckle_t * 0.3);
	} else if (mode == 5u) {
		float gran = pow(abs(n_val), 0.6);
		float limb = 0.4 + 0.6 * vdn;
		float em = max(emission_base, 1.5);
		col = (c1 * gran + vec3(0.25, 0.18, 0.08)) * limb * em;
	} else if (mode == 6u) {
		float flow = sin(phi * 6.0 + n_val * 5.0 + n_sec * 3.0);
		float streak = clamp(flow * 0.5 + 0.5, 0.0, 1.0);
		float heat = clamp(abs(n_sec) * 1.4, 0.0, 1.0);
		float em = max(emission_base, 1.0);
		col = vec3((0.95 + 0.35 * heat) * (0.55 + 0.45 * streak), (0.55 + 0.25 * heat) * (0.55 + 0.45 * streak), (0.20 + 0.10 * heat) * (0.35 + 0.25 * streak)) * em;
	} else if (mode == 7u) {
		float vein = sin((sp.x + sp.y + sp.z) * 3.0 + n_val * 8.0 * detail);
		float vein_sharp = pow(abs(vein), 0.15);
		float base_t = clamp((n_sec + 1.0) * 0.5, 0.0, 1.0);
		col = mix(c1, c2, base_t) * vein_sharp + c3 * (1.0 - vein_sharp);
	} else if (mode == 8u) {
		float band_freq = 10.0 + detail * 6.0;
		float band = sin(theta * band_freq + n_val * 2.5);
		col = mix(c1, c2, clamp((band + 1.0) * 0.5, 0.0, 1.0));
		float polar = pow(abs(cos_t), 3.0) * float(clamp(bodies[bi].polar_cap_strength, 0.0, 1.0));
		col = mix(col, c3, polar);
		if (bodies[bi].ring_system_enabled > 0.5) {
			float eq = pow(clamp(1.0 - abs(theta - 1.5707963) * 3.5, 0.0, 1.0), 2.0) * 0.35;
			col *= (1.0 - eq);
		}
	} else if (mode == 9u) {
		float crack = pow(clamp(1.0 - abs(n_val) * 2.2, 0.0, 1.0), 6.0);
		col = mix(c1, c2, crack);
		float shimmer = clamp((n_sec + 1.0) * 0.25, 0.0, 0.5);
		col = mix(col, c3, shimmer);
	} else if (mode == 10u) {
		float crack_glow = pow(clamp(1.0 - abs(n_val) * 1.8, 0.0, 1.0), 4.0);
		col = mix(c1, c3 * 2.2, crack_glow);
		float patchiness = clamp((n_sec + 1.0) * 0.5, 0.0, 1.0);
		col = mix(col, c2, patchiness * 0.3);
	} else if (mode == 11u) {
		col = mix(c1, c2, clamp((n_val + 1.0) * 0.5, 0.0, 1.0));
		city_speckle = clamp((n_sec + 1.0) * 0.5, 0.0, 1.0);
	} else if (mode == 12u) {
		float w1 = surface_fbm(sp * 0.5, 3u, 0.6);
		float w2 = surface_fbm(sp * 1.7 + vec3(5.0, 0.0, -5.0), 3u, 0.6);
		float t1 = clamp((w1 + 1.0) * 0.5, 0.0, 1.0);
		float t2 = clamp((w2 + 1.0) * 0.5, 0.0, 1.0);
		col = c1 * (1.0 - t1) * (1.0 - t2) + c2 * t1 * (1.0 - t2) + c3 * t2;
	} else if (mode == 13u) {
		col = shade_earth_surface(bi, phi, cos_t, sun, vdn, earth_footprint_pixels, c1, emissive);
	} else {
		col = mix(c1, c2, clamp((n_val + 1.0) * 0.5, 0.0, 1.0));
	}

	if (mode != 8u && mode != 13u) {
		float polar_strength = float(clamp(bodies[bi].polar_cap_strength, 0.0, 1.0));
		if (polar_strength > 0.0) {
			col = mix(col, c3, pow(abs(cos_t), 3.0) * polar_strength);
		}
		if (bodies[bi].ring_system_enabled > 0.5) {
			float eq = pow(clamp(1.0 - abs(theta - 1.5707963) * 3.5, 0.0, 1.0), 2.0) * 0.35;
			col *= (1.0 - eq);
		}
	}
	if (mode != 11u && mode != 13u && bodies[bi].night_side_light_intensity > 0.0) {
		city_speckle = clamp((n_sec + 1.0) * 0.5, 0.0, 1.0);
	}

	uint layer_total = min(bodies[bi].surface_layer_count, 4u);
	for (uint li = 0u; li < layer_total; ++li) {
		if (bodies[bi].surface_layers[li].ids_b.x == 0u) continue;
		vec4 lc = bodies[bi].surface_layers[li].color;
		vec4 pa = bodies[bi].surface_layers[li].params_a;
		vec4 pb = bodies[bi].surface_layers[li].params_b;
		uvec4 ia = bodies[bi].surface_layers[li].ids_a;
		uint layer_octaves = clamp(bodies[bi].surface_layers[li].ids_b.y, 1u, 6u);
		if (pa.x <= 0.0) continue;
		float layer_phi = phi + pb.z * float(pc.time);
		vec3 lp = vec3(sin_th * cos(layer_phi), sin_th * sin(layer_phi), cos_t);
		float v = surface_pattern_value(ia.x, lp, theta, layer_phi, pa.y, layer_octaves, ia.w);
		v = clamp((v - 0.5) * pa.z + 0.5, 0.0, 1.0);
		v = smoothstep(pa.w, pa.w + max(pb.x, 0.001), v);
		float m = surface_mask_value(ia.z, cos_t, sun, pb.y);
		float a = clamp(pa.x * m * v, 0.0, 1.0);
		col = surface_apply_blend(ia.y, col, lc.rgb, a);
		emissive += lc.rgb * (a * pb.w);
	}

	return col;
}

dvec3 source_spin_axis(uint bi) {
	dvec3 axis = dvec3(bodies[bi].spin_axis_x, bodies[bi].spin_axis_y, bodies[bi].spin_axis_z);
	double axis_length = length(axis);
	return (axis_length > 1e-12) ? (axis / axis_length) : dvec3(0.0, 0.0, 1.0);
}

void source_frame(dvec3 axis, out dvec3 frame_x, out dvec3 frame_y) {
	dvec3 helper = (abs(axis.z) < 0.9) ? dvec3(0.0, 0.0, 1.0) : dvec3(1.0, 0.0, 0.0);
	frame_x = normalize(cross(helper, axis));
	frame_y = cross(axis, frame_x);
}

bool intersect_subsidiary_sources(dvec3 seg_start, dvec3 seg_end, out vec3 out_color, out double out_opacity, out bool out_absorbed) {
	out_color = vec3(0.0);
	out_opacity = 0.0;
	out_absorbed = false;
	dvec3 seg_vec = seg_end - seg_start;
	double seg_len_sq = dot(seg_vec, seg_vec);
	if (seg_len_sq <= 1e-18) return false;

	bool any_hit = false;
	vec3 rim_total = vec3(0.0);
	for (uint bi = 0u; bi < pc.body_count; ++bi) {
		if (bodies[bi].preset_3d != 8u) continue;
		double m = max(bodies[bi].mass, 1e-9);
		double a_star = clamp(bodies[bi].spin_parameter, -0.9999, 0.9999);
		double a_spin = a_star * m;
		double rh = m + sqrt(max(m * m - a_spin * a_spin, 0.0));
		dvec3 bpos = dvec3(bodies[bi].position_xy.x, bodies[bi].position_xy.y, bodies[bi].position_zw.x);

		double req = sqrt(rh * rh + a_spin * a_spin);
		dvec3 source_axis = source_spin_axis(bi);
		dvec3 source_fx;
		dvec3 source_fy;
		source_frame(source_axis, source_fx, source_fy);
		dvec3 o = seg_start - bpos;
		dvec3 lo = dvec3(dot(o, source_fx) / req, dot(o, source_fy) / req, dot(o, source_axis) / rh);
		dvec3 lv = dvec3(dot(seg_vec, source_fx) / req, dot(seg_vec, source_fy) / req, dot(seg_vec, source_axis) / rh);
		dvec3 lo_end = lo + lv;
		double q_a = dot(lv, lv);
		double q_b = 2.0 * dot(lo, lv);
		double q_c = dot(lo, lo) - 1.0;
		if (q_c <= 0.0 || dot(lo_end, lo_end) <= 1.0) {
			out_absorbed = true;
			return true;
		}
		double discr = q_b * q_b - 4.0 * q_a * q_c;
		if (q_a > 1e-30 && discr >= 0.0) {
			double sqrt_discr = sqrt(discr);
			double t1 = (-q_b - sqrt_discr) / (2.0 * q_a);
			double t2 = (-q_b + sqrt_discr) / (2.0 * q_a);
			if ((t1 >= 0.0 && t1 <= 1.0) || (t2 >= 0.0 && t2 <= 1.0)) {
				out_absorbed = true;
				return true;
			}
		}

		double rim_seg_len = sqrt(seg_len_sq);
		double rim_t = clamp(-dot(lo, lv) / max(q_a, 1e-30), 0.0, 1.0);
		double rim_d = length(lo + rim_t * lv);
		double rim_band = 0.12;
		if (rim_d > 1.0 && rim_d < 1.0 + rim_band) {
			double rim_ring = 1.0 - (rim_d - 1.0) / rim_band;
			double rim_i = rim_ring * rim_ring * min(rim_seg_len / (rim_band * req), 1.0) * 0.35;
			rim_total += vec3(1.0, 0.75, 0.45) * float(rim_i);
		}

		double prev_z_rel = lo.z * rh;
		double curr_z_rel = lo_end.z * rh;
		double z_span = curr_z_rel - prev_z_rel;
		if (prev_z_rel * curr_z_rel <= 0.0 && abs(z_span) > 1e-15) {
			double isco = kerr_isco_radius_prograde_retrograde(m, a_spin);
			double disk_inner = isco * double(max(bodies[bi].disk.inner_radius_scale, 1.0));
			double disk_outer = max(double(bodies[bi].disk.outer_radius_mass_units) * m, disk_inner * 1.05);
			double s_cross = clamp(abs(prev_z_rel) / abs(z_span), 0.0, 1.0);
			dvec3 cross_pos = lo + s_cross * lv;
			double cross_x = cross_pos.x * req;
			double cross_y = cross_pos.y * req;
			double r_cross = length(dvec2(cross_x, cross_y));
			if (bodies[bi].disk.enabled > 0.5 && r_cross >= disk_inner && r_cross <= disk_outer) {
				dvec3 segment_local = dvec3(lv.x * req, lv.y * req, lv.z * rh);
				double l_over_e = -(cross_x * segment_local.y - cross_y * segment_local.x) / max(length(segment_local), 1e-30);
				double g_doppler = disk_redshift(m, a_spin, r_cross, l_over_e);
				double azimuth = double(atan(float(cross_y), float(cross_x)));
				vec3 shaded_rgb;
				double shaded_opacity;
				disk_shade(bodies[bi].disk, m, a_spin, disk_inner, disk_outer, r_cross, azimuth, g_doppler, pc.time, 1.0, shaded_rgb, shaded_opacity);
				out_color = shaded_rgb;
				out_opacity = shaded_opacity;
				any_hit = true;
			}
		}
	}
	if (rim_total.x + rim_total.y + rim_total.z > 0.0) {
		out_color += rim_total;
		any_hit = true;
	}
	return any_hit;
}

struct LightSample {
	dvec3 direction;
	double dist;
	float intensity;
	vec3 color;
	bool lit;
	bool at_origin;
	int source_index;
};

const float EMITTER_THRESHOLD = 1e-3;

dvec3 body_center(uint bi) {
	return dvec3(bodies[bi].position_xy.x, bodies[bi].position_xy.y, bodies[bi].position_zw.x);
}

vec3 body_primary_color(uint bi) {
	return vec3(bodies[bi].color_primary_xy.x, bodies[bi].color_primary_xy.y, bodies[bi].color_primary_zw.x);
}

void place_light(inout LightSample s, dvec3 position, dvec3 hit, bool at_origin) {
	dvec3 delta = position - hit;
	double d = length(delta);
	s.dist = d;
	s.direction = (d > 1e-9) ? (delta / d) : dvec3(0.0, 0.0, 1.0);
	s.at_origin = at_origin;
}

LightSample resolve_body_light(dvec3 hit, uint self_index) {
	LightSample s;
	s.direction = dvec3(0.0, 0.0, 1.0);
	s.dist = 1.0e30;
	s.intensity = pc.light_intensity;
	s.color = vec3(pc.light_color_r, pc.light_color_g, pc.light_color_b);
	s.lit = true;
	s.at_origin = false;
	s.source_index = -1;

	uint mode = min(pc.light_source_mode, 6u);
	if (mode == 6u) {
		s.lit = false;
		return s;
	}

	if (mode == 1u) {
		place_light(s, spherical_to_cartesian(pc.observer_position.y, pc.observer_position.z, pc.observer_position.w), hit, false);
	} else if (mode == 2u) {
		dvec3 d = dvec3(pc.light_direction_x, pc.light_direction_y, pc.light_direction_z);
		double dl = length(d);
		s.direction = (dl > 1e-9) ? (d / dl) : dvec3(0.0, 0.0, 1.0);
	} else if (mode == 3u) {
		place_light(s, dvec3(pc.light_position_x, pc.light_position_y, pc.light_position_z), hit, false);
	} else if (mode == 4u || mode == 5u) {
		int found = -1;
		double best = 1.0e30;
		for (uint bi = 0u; bi < pc.body_count; ++bi) {
			if (bi == self_index) continue;
			if (mode == 5u) {
				if (bodies[bi].body_id == pc.light_source_body_id) {
					found = int(bi);
					break;
				}
			} else if (bodies[bi].preset_3d != 8u && bodies[bi].emission_intensity > double(EMITTER_THRESHOLD)) {
				dvec3 delta = body_center(bi) - hit;
				double d2 = dot(delta, delta);
				if (d2 < best) {
					best = d2;
					found = int(bi);
				}
			}
		}
		if (found >= 0) {
			place_light(s, body_center(uint(found)), hit, false);
			s.source_index = found;
			s.color *= body_primary_color(uint(found));
		} else {
			place_light(s, dvec3(0.0), hit, true);
		}
	} else {
		place_light(s, dvec3(0.0), hit, true);
	}

	if (pc.light_attenuation_mode == 1u && s.dist < 5.0e29) {
		double ratio = double(pc.light_reference_distance) / max(s.dist, 1e-6);
		s.intensity = pc.light_intensity * float(min(ratio * ratio, 64.0));
	}
	return s;
}

float wrapped_diffuse(float ndl, float softness) {
	float w = clamp(softness, 0.0, 1.0);
	return clamp((ndl + w) / (1.0 + w), 0.0, 1.0);
}

bool light_is_occluded(dvec3 hit, LightSample s, uint self_index) {
	if (s.dist < 1e-6) return false;
	for (uint bi = 0u; bi < pc.body_count; ++bi) {
		if (bi == self_index || int(bi) == s.source_index) continue;
		dvec3 to_body = body_center(bi) - hit;
		double proj = dot(to_body, s.direction);
		if (proj <= 1e-6 || proj >= s.dist) continue;
		dvec3 closest = hit + s.direction * proj - body_center(bi);
		double occluder_radius = max(bodies[bi].radius, 1e-6) * max(bodies[bi].oblateness_ratio, 1.0);
		if (dot(closest, closest) < occluder_radius * occluder_radius) return true;
	}
	if (!s.at_origin && pc.horizon_radius > 0.0) {
		double proj_h = dot(-hit, s.direction);
		if (proj_h > 1e-6 && proj_h < s.dist) {
			dvec3 closest_h = hit + s.direction * proj_h;
			if (dot(closest_h, closest_h) < pc.horizon_radius * pc.horizon_radius) return true;
		}
	}
	return false;
}

vec3 emitted_irradiance(dvec3 hit, dvec3 nrm, uint self_index, int excluded_index) {
	vec3 total = vec3(0.0);
	double reference = double(pc.body_emission_lighting_reference_distance);
	double gain = double(pc.body_emission_lighting_gain);
	for (uint bi = 0u; bi < pc.body_count; ++bi) {
		if (bi == self_index || int(bi) == excluded_index) continue;
		double emission = bodies[bi].emission_intensity;
		if (bodies[bi].preset_3d == 8u || emission <= double(EMITTER_THRESHOLD)) continue;
		dvec3 delta = body_center(bi) - hit;
		double d = length(delta);
		if (d < 1e-9) continue;
		double n_dot_l = dot(nrm, delta) / d;
		if (n_dot_l <= 0.0) continue;
		double effective_distance = max(d, max(bodies[bi].radius, 1e-6));
		double ratio = reference / effective_distance;
		double weight = gain * emission * min(ratio * ratio, 16.0) * n_dot_l;
		total += float(weight) * body_primary_color(bi);
	}
	return total;
}

bool intersect_bodies(dvec3 ray_pos, dvec3 ray_dir, double max_dist, out vec3 out_color, out uint out_status, out double out_hit_dist) {
	bool hit_any = false;
	double best_t = max_dist;
	vec3 best_color = vec3(0.0);

	for (uint bi = 0u; bi < pc.body_count; ++bi) {
		if (bodies[bi].preset_3d == 8u) continue;
		dvec3 bpos = dvec3(bodies[bi].position_xy.x, bodies[bi].position_xy.y, bodies[bi].position_zw.x);
		double radius = max(bodies[bi].radius, 1e-6);
		double oblateness = clamp(bodies[bi].oblateness_ratio, 0.1, 5.0);

		double scale_a = radius;
		double scale_b = radius;
		double scale_c = radius;
		uint geom = bodies[bi].geometry_model;
		if (geom == 0u) {
			scale_c = radius * oblateness;
		} else if (geom == 2u) {
			scale_c = radius / max(oblateness, 0.1);
		} else if (geom == 3u) {
			scale_b = radius * 0.85;
			scale_c = radius * oblateness;
		}

		dvec3 o = ray_pos - bpos;
		double bound_radius = max(scale_a, max(scale_b, scale_c));
		double max_reach = bound_radius + best_t;
		double dist_sq = dot(o, o);
		if (dist_sq > max_reach * max_reach) continue;
		double bound_b = dot(o, ray_dir);
		double bound_disc = bound_b * bound_b - (dist_sq - bound_radius * bound_radius);
		if (bound_disc < 0.0) continue;
		double bound_root = sqrt(bound_disc);
		if (-bound_b + bound_root < 1e-5 || -bound_b - bound_root > best_t) continue;

		double inv_a2 = 1.0 / (scale_a * scale_a);
		double inv_b2 = 1.0 / (scale_b * scale_b);
		double inv_c2 = 1.0 / (scale_c * scale_c);

		double A = ray_dir.x * ray_dir.x * inv_a2 + ray_dir.y * ray_dir.y * inv_b2 + ray_dir.z * ray_dir.z * inv_c2;
		double B = 2.0 * (o.x * ray_dir.x * inv_a2 + o.y * ray_dir.y * inv_b2 + o.z * ray_dir.z * inv_c2);
		double C = o.x * o.x * inv_a2 + o.y * o.y * inv_b2 + o.z * o.z * inv_c2 - 1.0;

		double discr = B * B - 4.0 * A * C;
		if (discr < 0.0) continue;
		double sqrt_discr = sqrt(discr);
		double t1 = (-B - sqrt_discr) / (2.0 * A);
		double t2 = (-B + sqrt_discr) / (2.0 * A);
		double t = -1.0;
		if (t1 > 1e-5) t = t1;
		else if (t2 > 1e-5) t = t2;
		if (t <= 1e-5 || t >= best_t) continue;

		dvec3 hit_pos = ray_pos + ray_dir * t;
		dvec3 l = hit_pos - bpos;
		dvec3 nrm = dvec3(l.x * inv_a2, l.y * inv_b2, l.z * inv_c2);
		double n_len = length(nrm);
		if (n_len > 1e-12) nrm = nrm / n_len;

		double dist_to_cam = length(o);
		double angular_pixel_size = pc.field_of_view_rad / max(double(pc.screen_width), 1.0);
		double max_axis = max(scale_a, max(scale_b, scale_c));
		double apparent_radius = double(asin(float(clamp(max_axis / max(dist_to_cam, 1e-9), 0.0, 1.0))));
		double coverage = apparent_radius / max(angular_pixel_size, 1e-12);

		bool is_point_lod = (pc.body_render_low_power_mode == 0u) && (coverage < double(max(pc.body_render_point_pixel_threshold, 1u)));
		bool is_simple_lod = (pc.body_render_low_power_mode != 0u) || is_point_lod || (coverage < double(pc.body_render_lod_pixel_threshold));

		vec3 surf = vec3(bodies[bi].color_primary_xy.x, bodies[bi].color_primary_xy.y, bodies[bi].color_primary_zw.x);

		vec3 surface_emissive = vec3(0.0);
		float surface_city_speckle = 0.0;
		double surface_view_dot_n = max(0.0, dot(-ray_dir, nrm));
		LightSample body_light = resolve_body_light(hit_pos, bi);
		double surface_sun_facing = body_light.lit ? dot(nrm, body_light.direction) : 1.0;
		bool earth_surface = (bodies[bi].surface_texture_mode == 13u) && (pc.body_render_low_power_mode == 0u);
		if (!is_simple_lod || earth_surface) {
			surf = shade_body_surface(bi, nrm, surface_sun_facing, surface_view_dot_n, surface_emissive, surface_city_speckle, float(coverage) * 6.28318531);
		}

		double view_dot_n = max(0.0, dot(-ray_dir, nrm));
		double raw_ndl = body_light.lit ? dot(nrm, body_light.direction) : 1.0;
		bool shadowed = false;
		if (!is_point_lod && body_light.lit && raw_ndl > 0.0 && (pc.render_flags & (1u << 16)) != 0u) {
			shadowed = light_is_occluded(hit_pos, body_light, bi);
		}

		vec3 light_factor = vec3(1.0);
		vec3 specular_add = vec3(0.0);
		if (!is_point_lod) {
			float terminator_softness = earth_surface ? max(pc.light_terminator_softness, float(bodies[bi].earth_terminator_softness)) : pc.light_terminator_softness;
			float lit_amount = body_light.lit ? (shadowed ? 0.0 : wrapped_diffuse(float(raw_ndl), terminator_softness)) : 1.0;
			float ambient_level = body_light.lit ? pc.light_ambient : 0.0;
			light_factor = vec3(ambient_level) + body_light.color * (lit_amount * body_light.intensity);
			if (pc.body_emission_lighting_enabled != 0u) {
				light_factor += emitted_irradiance(hit_pos, nrm, bi, body_light.source_index);
			}
			if (body_light.lit && !shadowed && raw_ndl > 0.0) {
				dvec3 half_vec = body_light.direction - ray_dir;
				double half_len = length(half_vec);
				if (half_len > 1e-9) {
					double spec_dot = max(0.0, dot(nrm, half_vec / half_len));
					double rough = clamp(bodies[bi].specular_roughness, 0.0, 1.0);
					double shininess = 4.0 + (1.0 - rough) * 80.0;
					float spec = pow(float(spec_dot), float(shininess)) * float((1.0 - rough) * 0.6);
					specular_add = body_light.color * (spec * body_light.intensity * pc.light_specular_scale);
				}
			}
		}
		light_factor += vec3(float(max(bodies[bi].emission_intensity, 0.0)));
		surf = surf * light_factor + specular_add;
		if (!is_point_lod) {
			double night_gain = clamp(1.0 - max(0.0, surface_sun_facing) * 5.0, 0.0, 1.0);
			float city_glow = float(night_gain * bodies[bi].night_side_light_intensity) * surface_city_speckle;
			surf += vec3(1.1, 0.95, 0.6) * city_glow;
		}
		surf += surface_emissive;

		if ((pc.render_flags & (1u << 13)) != 0u) {
			dvec3 vel = dvec3(bodies[bi].velocity_xy.x, bodies[bi].velocity_xy.y, bodies[bi].velocity_zw.x);
			double v_sq = dot(vel, vel);
			if (v_sq > 1e-12) {
				double beta = min(sqrt(v_sq), 0.9999);
				double beta_dot_n = dot(vel, ray_dir) / beta;
				double gamma = 1.0 / sqrt(1.0 - beta * beta);
				double doppler = 1.0 / (gamma * (1.0 - beta * beta_dot_n));
				float d_factor = float(clamp(doppler * doppler * doppler, 0.1, 10.0));
				surf *= d_factor;
			}
		}

		if ((pc.render_flags & (1u << 14)) != 0u && bodies[bi].mass > 0.0) {
			double z_factor = sqrt(max(1.0 - 2.0 * bodies[bi].mass / radius, 0.05));
			surf *= vec3(float(z_factor), float(z_factor * 0.9), float(z_factor * 0.7));
		}

		if ((pc.render_flags & (1u << 15)) != 0u && !is_simple_lod && bodies[bi].atmosphere_mode != 2u) {
			float rim = pow(1.0 - float(view_dot_n), 3.0);
			float atmo_thick = float(bodies[bi].atmosphere_thickness * pc.body_atmosphere_global_intensity);
			vec3 acol = vec3(bodies[bi].atmosphere_color_xy.x, bodies[bi].atmosphere_color_xy.y, bodies[bi].atmosphere_color_zw.x);
			float aa = float(bodies[bi].atmosphere_color_zw.y);
			surf = surf * (1.0 - rim * aa) + acol * rim * atmo_thick * 2.5;
		}

		best_t = t;
		best_color = clamp(surf, 0.0, 10.0);
		hit_any = true;
	}

	out_color = best_color;
	out_status = hit_any ? 16u : 0u;
	out_hit_dist = best_t;
	return hit_any;
}

bool attempt_analytic_space_skip(inout double ray_r, inout double ray_th, inout double ray_phi, inout double ray_pr, inout double ray_pth, inout double ray_pphi, double space_skip_radius, double escape_radius, double mass) {
	if (ray_r <= space_skip_radius) {
		return false;
	}

	dvec2 sincos_th = precise_sincos(ray_th);
	double sin_t = sincos_th.x;
	double cos_t = sincos_th.y;
	float phi_f = float(ray_phi);
	double sin_p = double(sin(phi_f));
	double cos_p = double(cos(phi_f));

	double px = ray_r * sin_t * cos_p;
	double py = ray_r * sin_t * sin_p;
	double pz = ray_r * cos_t;

	double local_radial = ray_pr / sqrt(max(1.0 - 2.0 * mass / ray_r, 1e-6));
	double dx = -(local_radial * sin_t * cos_p + ray_r * ray_pth * cos_t * cos_p - ray_r * sin_t * ray_pphi * sin_p);
	double dy = -(local_radial * sin_t * sin_p + ray_r * ray_pth * cos_t * sin_p + ray_r * sin_t * ray_pphi * cos_p);
	double dz = -(local_radial * cos_t - ray_r * ray_pth * sin_t);

	double dir_norm_sq = dx * dx + dy * dy + dz * dz;
	if (dir_norm_sq <= 1e-30) {
		return false;
	}

	double cross_x = py * dz - pz * dy;
	double cross_y = pz * dx - px * dz;
	double cross_z = px * dy - py * dx;
	double cross_norm = sqrt(cross_x * cross_x + cross_y * cross_y + cross_z * cross_z);
	double dir_norm_for_impact = sqrt(dir_norm_sq);
	double impact_parameter_relative = (dir_norm_for_impact > 1e-30) ? (cross_norm / dir_norm_for_impact) : 0.0;
	if (impact_parameter_relative > mass * 0.05 && mass > 0.0) {
		double impact_parameter = impact_parameter_relative;
		double deflection = min(4.0 * mass / max(impact_parameter, mass * 1e-6), 0.6);
		double nx = cross_x / cross_norm;
		double ny = cross_y / cross_norm;
		double nz = cross_z / cross_norm;
		double wx = ny * dz - nz * dy;
		double wy = nz * dx - nx * dz;
		double wz = nx * dy - ny * dx;
		float defl_f = float(deflection);
		double cos_a = double(cos(defl_f));
		double sin_a = double(sin(defl_f));
		double rdx = dx * cos_a + wx * sin_a;
		double rdy = dy * cos_a + wy * sin_a;
		double rdz = dz * cos_a + wz * sin_a;
		dx = rdx;
		dy = rdy;
		dz = rdz;
	}

	double p_dot_d = px * dx + py * dy + pz * dz;
	double p_dot_p = px * px + py * py + pz * pz;

	double t_skip = -1.0;
	{
		double c_coeff = p_dot_p - space_skip_radius * space_skip_radius;
		double b_coeff = 2.0 * p_dot_d;
		double discr = b_coeff * b_coeff - 4.0 * dir_norm_sq * c_coeff;
		if (discr >= 0.0) {
			double sqrt_discr = sqrt(discr);
			double t1 = (-b_coeff - sqrt_discr) / (2.0 * dir_norm_sq);
			double t2 = (-b_coeff + sqrt_discr) / (2.0 * dir_norm_sq);
			if (t1 > 1e-9) t_skip = t1;
			if (t2 > 1e-9 && (t_skip < 0.0 || t2 < t_skip)) t_skip = t2;
		}
	}

	double t_escape = -1.0;
	{
		double c_coeff = p_dot_p - escape_radius * escape_radius;
		double b_coeff = 2.0 * p_dot_d;
		double discr = b_coeff * b_coeff - 4.0 * dir_norm_sq * c_coeff;
		if (discr >= 0.0) {
			double sqrt_discr = sqrt(discr);
			double t1 = (-b_coeff - sqrt_discr) / (2.0 * dir_norm_sq);
			double t2 = (-b_coeff + sqrt_discr) / (2.0 * dir_norm_sq);
			if (t1 > 1e-9) t_escape = t1;
			if (t2 > 1e-9 && (t_escape < 0.0 || t2 < t_escape)) t_escape = t2;
		}
	}

	double t_leap;
	if (t_skip > 0.0 && t_escape > 0.0) {
		t_leap = min(t_skip, t_escape);
	} else if (t_skip > 0.0) {
		t_leap = t_skip;
	} else if (t_escape > 0.0) {
		t_leap = t_escape;
	} else {
		return false;
	}

	if (t_leap <= 1e-6) {
		return false;
	}

	double new_px = px + t_leap * dx;
	double new_py = py + t_leap * dy;
	double new_pz = pz + t_leap * dz;

	double new_r = sqrt(new_px * new_px + new_py * new_py + new_pz * new_pz);
	if (new_r <= 1e-9) {
		return false;
	}

	float new_cos_theta_f = float(clamp(new_pz / new_r, -1.0, 1.0));
	double new_theta = double(acos(new_cos_theta_f));
	double new_phi = double(atan(float(new_py), float(new_px)));

	dvec2 sincos_new_th = precise_sincos(new_theta);
	double new_sin_t = sincos_new_th.x;
	double safe_sin_t = (abs(new_sin_t) > 1e-9) ? new_sin_t : ((new_sin_t >= 0.0) ? 1e-9 : -1e-9);

	double new_local_f = max(1.0 - 2.0 * mass / new_r, 1e-6);
	double inv_dir_len = 1.0 / sqrt(dir_norm_sq);
	double travel_x = dx * inv_dir_len;
	double travel_y = dy * inv_dir_len;
	double travel_z = dz * inv_dir_len;
	double travel_radial = (new_px * travel_x + new_py * travel_y + new_pz * travel_z) / new_r;
	double inv_sqrt_new_f = 1.0 / sqrt(new_local_f);
	double new_pr = -travel_radial;
	double new_pth = -((travel_radial * (new_pz / new_r) - travel_z) / (new_r * safe_sin_t)) * inv_sqrt_new_f;
	double r2_sin2 = new_r * new_r * new_sin_t * new_sin_t;
	double new_pphi = (abs(r2_sin2) > 1e-12) ? (-((new_px * travel_y - new_py * travel_x) / r2_sin2) * inv_sqrt_new_f) : 0.0;

	ray_r = new_r;
	ray_th = new_theta;
	ray_phi = new_phi;
	ray_pr = new_pr;
	ray_pth = new_pth;
	ray_pphi = new_pphi;
	return true;
}

void apply_subsidiary_deflection(inout double ray_r, double ray_th, double ray_phi, inout double ray_pr, inout double ray_pth, inout double ray_pphi, double dt) {
	if (pc.body_count == 0u) return;

	dvec3 pos = spherical_to_cartesian(ray_r, ray_th, ray_phi);
	dvec2 sincos_th = precise_sincos(ray_th);
	double sin_t = sincos_th.x;
	double cos_t = sincos_th.y;
	float phi_f = float(ray_phi);
	double sin_p = double(sin(phi_f));
	double cos_p = double(cos(phi_f));

	dvec3 v = dvec3(
		ray_pr * sin_t * cos_p + ray_r * ray_pth * cos_t * cos_p - ray_r * sin_t * ray_pphi * sin_p,
		ray_pr * sin_t * sin_p + ray_r * ray_pth * cos_t * sin_p + ray_r * sin_t * ray_pphi * cos_p,
		ray_pr * cos_t - ray_r * ray_pth * sin_t
	);
	double speed = length(v);
	if (speed < 1e-12) return;
	dvec3 dir = v / speed;
	bool any_correction = false;

	for (uint bi = 0u; bi < pc.body_count; ++bi) {
		if (bodies[bi].preset_3d != 8u) continue;
		dvec3 bpos = dvec3(bodies[bi].position_xy.x, bodies[bi].position_xy.y, bodies[bi].position_zw.x);
		double m = max(bodies[bi].mass, 1e-9);
		double a_star = clamp(bodies[bi].spin_parameter, -0.9999, 0.9999);
		double a_spin = a_star * m;
		double rh = m + sqrt(max(m * m - a_spin * a_spin, 0.0));

		dvec3 rel = pos - bpos;
		double r_len = length(rel);
		dvec3 deflection_axis = source_spin_axis(bi);
		dvec3 deflection_fx;
		dvec3 deflection_fy;
		source_frame(deflection_axis, deflection_fx, deflection_fy);
		double horizon_equatorial = sqrt(rh * rh + a_spin * a_spin);
		dvec3 scaled_rel = dvec3(dot(rel, deflection_fx) / horizon_equatorial, dot(rel, deflection_fy) / horizon_equatorial, dot(rel, deflection_axis) / rh);
		if (length(scaled_rel) < 1.5) continue;
		if (r_len > m * 2000.0) continue;

		double proj = dot(rel, dir);
		dvec3 perp = rel - proj * dir;
		double impact_param = length(perp);
		if (impact_param < rh * 0.1) continue;

		double cross_x = rel.y * dir.z - rel.z * dir.y;
		double cross_y = rel.z * dir.x - rel.x * dir.z;
		double cross_z = rel.x * dir.y - rel.y * dir.x;
		double cross_norm = sqrt(cross_x * cross_x + cross_y * cross_y + cross_z * cross_z);
		if (cross_norm < 1e-12) continue;
		dvec3 n_axis = dvec3(cross_x, cross_y, cross_z) / cross_norm;

		double schwarzschild_term = (4.0 * m) / max(impact_param, m * 1e-3);
		double impact_squared = impact_param * impact_param;
		double gravitomagnetic_term = -(4.0 * a_spin * m * dot(deflection_axis, n_axis)) / max(impact_squared, m * m * 1e-6);
		double quad_term = (schwarzschild_term * schwarzschild_term) * 0.1875;
		double weight = double(exp(float(-r_len / (30.0 * max(m, 1e-6)))));
		double total_deflection = min(max(schwarzschild_term + gravitomagnetic_term + quad_term, 0.0) * weight * (abs(dt) / max(r_len, m)), 0.5);
		if (total_deflection < 1e-14) continue;

		double wx = n_axis.y * dir.z - n_axis.z * dir.y;
		double wy = n_axis.z * dir.x - n_axis.x * dir.z;
		double wz = n_axis.x * dir.y - n_axis.y * dir.x;

		float defl_f = float(total_deflection);
		double cos_a = double(cos(defl_f));
		double sin_a = double(sin(defl_f));
		dvec3 new_dir = dir * cos_a + dvec3(wx, wy, wz) * sin_a;
		double new_len = length(new_dir);
		if (new_len > 1e-12) {
			dir = new_dir / new_len;
			any_correction = true;
		}
	}

	if (!any_correction) return;

	dvec3 new_v = dir * speed;
	double safe_sin_t = (abs(sin_t) > 1e-9) ? sin_t : ((sin_t >= 0.0) ? 1e-9 : -1e-9);
	ray_pr = new_v.x * sin_t * cos_p + new_v.y * sin_t * sin_p + new_v.z * cos_t;
	ray_pth = (new_v.x * cos_t * cos_p + new_v.y * cos_t * sin_p - new_v.z * sin_t) / max(ray_r, 1e-9);
	ray_pphi = (-new_v.x * sin_p + new_v.y * cos_p) / max(ray_r * safe_sin_t, 1e-9);
}

dvec2 sincos_wide(double angle) {
	double h = angle * 0.125;
	double h2 = h * h;
	double sin_h = h * (1.0 - h2 * (1.0 / 6.0 - h2 * (1.0 / 120.0 - h2 * (1.0 / 5040.0 - h2 * (1.0 / 362880.0 - h2 / 39916800.0)))));
	double cos_h = 1.0 - h2 * (0.5 - h2 * (1.0 / 24.0 - h2 * (1.0 / 720.0 - h2 * (1.0 / 40320.0 - h2 * (1.0 / 3628800.0 - h2 / 479001600.0)))));
	double sin_2h = 2.0 * sin_h * cos_h;
	double cos_2h = 1.0 - 2.0 * sin_h * sin_h;
	double sin_4h = 2.0 * sin_2h * cos_2h;
	double cos_4h = 1.0 - 2.0 * sin_2h * sin_2h;
	double sin_8h = 2.0 * sin_4h * cos_4h;
	double cos_8h = 1.0 - 2.0 * sin_4h * sin_4h;
	return dvec2(sin_8h, cos_8h);
}

double atan2_wide(double y, double x) {
	if (abs(x) + abs(y) < 1e-300) {
		return 0.0;
	}
	double angle = double(atan(float(y), float(x)));
	for (int iteration = 0; iteration < 2; ++iteration) {
		dvec2 sc = sincos_wide(angle);
		double residual = x * sc.x - y * sc.y;
		double slope = x * sc.y + y * sc.x;
		if (abs(slope) > 1e-300) {
			angle -= residual / slope;
		}
	}
	return angle;
}

dvec3 schwarzschild_null_accel(dvec3 pos, double angular_momentum_sq, double rs) {
	double r2 = max(dot(pos, pos), 1e-30);
	double r = sqrt(r2);
	return pos * (-1.5 * rs * angular_momentum_sq / (r2 * r2 * r));
}

void schwarzschild_null_step(inout double ray_r, inout double ray_th, inout double ray_phi, inout double ray_pr, inout double ray_pth, inout double ray_pphi, double dt, double rs) {
	const double two_pi = 6.283185307179586;
	dvec2 sc_th = sincos_wide(ray_th);
	double phi_reduced = ray_phi - two_pi * floor((ray_phi + PI_D) / two_pi);
	dvec2 sc_ph = sincos_wide(phi_reduced);
	double sin_t = sc_th.x;
	double cos_t = sc_th.y;
	double sin_p = sc_ph.x;
	double cos_p = sc_ph.y;

	dvec3 pos = ray_r * dvec3(sin_t * cos_p, sin_t * sin_p, cos_t);
	dvec3 vel = dvec3(
		ray_pr * sin_t * cos_p + ray_r * ray_pth * cos_t * cos_p - ray_r * sin_t * ray_pphi * sin_p,
		ray_pr * sin_t * sin_p + ray_r * ray_pth * cos_t * sin_p + ray_r * sin_t * ray_pphi * cos_p,
		ray_pr * cos_t - ray_r * ray_pth * sin_t
	);

	dvec3 angular = cross(pos, vel);
	double h2 = dot(angular, angular);
	double half_dt = 0.5 * dt;

	dvec3 k1x = vel;
	dvec3 k1v = schwarzschild_null_accel(pos, h2, rs);
	dvec3 p1 = pos + half_dt * k1x;
	dvec3 v1 = vel + half_dt * k1v;
	dvec3 k2x = v1;
	dvec3 k2v = schwarzschild_null_accel(p1, h2, rs);
	dvec3 p2 = pos + half_dt * k2x;
	dvec3 v2 = vel + half_dt * k2v;
	dvec3 k3x = v2;
	dvec3 k3v = schwarzschild_null_accel(p2, h2, rs);
	dvec3 p3 = pos + dt * k3x;
	dvec3 v3 = vel + dt * k3v;
	dvec3 k4x = v3;
	dvec3 k4v = schwarzschild_null_accel(p3, h2, rs);

	double sixth = dt / 6.0;
	pos += sixth * (k1x + 2.0 * k2x + 2.0 * k3x + k4x);
	vel += sixth * (k1v + 2.0 * k2v + 2.0 * k3v + k4v);

	double rho2 = pos.x * pos.x + pos.y * pos.y;
	double rho = sqrt(rho2);
	double r_new = sqrt(rho2 + pos.z * pos.z);
	if (r_new < 1e-30) {
		return;
	}

	ray_r = r_new;
	ray_th = atan2_wide(rho, pos.z);
	ray_pr = dot(pos, vel) / r_new;
	if (rho > 1e-13 * r_new) {
		double phi_new = atan2_wide(pos.y, pos.x);
		double delta = phi_new - ray_phi;
		delta -= two_pi * floor(delta / two_pi + 0.5);
		ray_phi += delta;
		ray_pth = (pos.z * (pos.x * vel.x + pos.y * vel.y) - rho2 * vel.z) / (r_new * r_new * rho);
		ray_pphi = (pos.x * vel.y - pos.y * vel.x) / rho2;
	} else {
		double lateral_speed = sqrt(vel.x * vel.x + vel.y * vel.y);
		if (lateral_speed > 0.0) {
			double phi_new = atan2_wide(vel.y, vel.x);
			double delta = phi_new - ray_phi;
			delta -= two_pi * floor(delta / two_pi + 0.5);
			ray_phi += delta;
		}
		ray_pth = ((pos.z >= 0.0) ? lateral_speed : -lateral_speed) / r_new;
		ray_pphi = 0.0;
	}
}

void kerr_newman_rk4_step(inout double ray_r, inout double ray_th, inout double ray_phi, inout dvec4 u, double dt, double mass, double a, double rq2) {
	double half_dt = 0.5 * dt;

	dvec3 x0 = dvec3(ray_r, ray_th, ray_phi);
	dvec4 u0 = u;

	dvec3 k1x = dvec3(u0.y, u0.z, u0.w);
	dvec4 k1u = kerr_newman_geodesic_derivative(u0, x0.x, x0.y, mass, a, rq2);

	dvec3 x1 = x0 + half_dt * k1x;
	dvec4 u1 = u0 + half_dt * k1u;
	dvec3 k2x = dvec3(u1.y, u1.z, u1.w);
	dvec4 k2u = kerr_newman_geodesic_derivative(u1, x1.x, x1.y, mass, a, rq2);

	dvec3 x2 = x0 + half_dt * k2x;
	dvec4 u2 = u0 + half_dt * k2u;
	dvec3 k3x = dvec3(u2.y, u2.z, u2.w);
	dvec4 k3u = kerr_newman_geodesic_derivative(u2, x2.x, x2.y, mass, a, rq2);

	dvec3 x3 = x0 + dt * k3x;
	dvec4 u3 = u0 + dt * k3u;
	dvec3 k4x = dvec3(u3.y, u3.z, u3.w);
	dvec4 k4u = kerr_newman_geodesic_derivative(u3, x3.x, x3.y, mass, a, rq2);

	double sixth = dt / 6.0;
	dvec3 x_new = x0 + sixth * (k1x + 2.0 * k2x + 2.0 * k3x + k4x);
	dvec4 u_new = u0 + sixth * (k1u + 2.0 * k2u + 2.0 * k3u + k4u);
	ray_r = x_new.x;
	ray_th = x_new.y;
	ray_phi = x_new.z;
	u = u_new;
}

double subsidiary_step_guard(dvec3 pos) {
	if (pc.body_count == 0u) return 1.0;
	double nearest_ratio = 1.0e30;
	for (uint bi = 0u; bi < pc.body_count; ++bi) {
		if (bodies[bi].preset_3d != 8u) continue;
		double m_b = max(bodies[bi].mass, 1e-9);
		double a_star = clamp(bodies[bi].spin_parameter, -0.9999, 0.9999);
		double a_spin = a_star * m_b;
		double rh_b = m_b + sqrt(max(m_b * m_b - a_spin * a_spin, 0.0));
		dvec3 bpos = dvec3(bodies[bi].position_xy.x, bodies[bi].position_xy.y, bodies[bi].position_zw.x);
		dvec3 guard_axis = source_spin_axis(bi);
		dvec3 guard_fx;
		dvec3 guard_fy;
		source_frame(guard_axis, guard_fx, guard_fy);
		dvec3 guard_rel = pos - bpos;
		double guard_equatorial = sqrt(rh_b * rh_b + a_spin * a_spin);
		nearest_ratio = min(nearest_ratio, length(dvec3(dot(guard_rel, guard_fx) / guard_equatorial, dot(guard_rel, guard_fy) / guard_equatorial, dot(guard_rel, guard_axis) / max(rh_b, 1e-9))));
	}
	if (nearest_ratio > 1.0e29) return 1.0;
	return clamp(nearest_ratio / 8.0, 0.03, 1.0);
}

void ks_field(dvec3 x, double mass, double a, out double r, out double h, out dvec3 k) {
	double a2 = a * a;
	double z2 = x.z * x.z;
	double diff = dot(x, x) - a2;
	double r2 = max(0.5 * (diff + sqrt(diff * diff + 4.0 * a2 * z2)), 1e-24);
	r = sqrt(r2);
	double den = r2 * r2 + a2 * z2;
	double rpa = r2 + a2;
	h = mass * r2 * r / den;
	k = dvec3((r * x.x + a * x.y) / rpa, (r * x.y - a * x.x) / rpa, x.z / r);
}

void ks_rhs(dvec3 x, dvec3 p, double mass, double a, out dvec3 dx, out dvec3 dp) {
	double r;
	double h;
	dvec3 k;
	ks_field(x, mass, a, r, h, k);
	double a2 = a * a;
	double z2 = x.z * x.z;
	double r2 = r * r;
	double r3 = r2 * r;
	double r4 = r2 * r2;
	double den = r4 + a2 * z2;
	double den2 = den * den;
	double rpa = r2 + a2;
	double inv_rpa2 = 1.0 / (rpa * rpa);
	double s = dot(k, p) + 1.0;

	dx = p - 2.0 * h * s * k;

	dvec3 dr = dvec3(r3 * x.x / den, r3 * x.y / den, r * rpa * x.z / den);
	double bracket = 3.0 * a2 * z2 - r4;
	dvec3 dh = mass * dr * r2 * bracket / den2;
	dh.z -= 2.0 * mass * a2 * r3 * x.z / den2;

	double nx = r * x.x + a * x.y;
	double ny = r * x.y - a * x.x;
	dvec3 dk_dot_p;
	dk_dot_p.x = (((dr.x * x.x + r) * rpa - nx * 2.0 * r * dr.x) * inv_rpa2) * p.x
		+ (((dr.x * x.y - a) * rpa - ny * 2.0 * r * dr.x) * inv_rpa2) * p.y
		+ (-x.z * dr.x / r2) * p.z;
	dk_dot_p.y = (((dr.y * x.x + a) * rpa - nx * 2.0 * r * dr.y) * inv_rpa2) * p.x
		+ (((dr.y * x.y + r) * rpa - ny * 2.0 * r * dr.y) * inv_rpa2) * p.y
		+ (-x.z * dr.y / r2) * p.z;
	dk_dot_p.z = (((dr.z * x.x) * rpa - nx * 2.0 * r * dr.z) * inv_rpa2) * p.x
		+ (((dr.z * x.y) * rpa - ny * 2.0 * r * dr.z) * inv_rpa2) * p.y
		+ ((r - x.z * dr.z) / r2) * p.z;

	dp = dh * s * s + 2.0 * h * s * dk_dot_p;
}

void ks_rk4_step(inout dvec3 x, inout dvec3 p, double dt, double mass, double a) {
	dvec3 k1x;
	dvec3 k1p;
	dvec3 k2x;
	dvec3 k2p;
	dvec3 k3x;
	dvec3 k3p;
	dvec3 k4x;
	dvec3 k4p;
	ks_rhs(x, p, mass, a, k1x, k1p);
	ks_rhs(x + 0.5 * dt * k1x, p + 0.5 * dt * k1p, mass, a, k2x, k2p);
	ks_rhs(x + 0.5 * dt * k2x, p + 0.5 * dt * k2p, mass, a, k3x, k3p);
	ks_rhs(x + dt * k3x, p + dt * k3p, mass, a, k4x, k4p);
	double sixth = dt / 6.0;
	x += sixth * (k1x + 2.0 * k2x + 2.0 * k3x + k4x);
	p += sixth * (k1p + 2.0 * k2p + 2.0 * k3p + k4p);
}

double ks_metric_dot(dvec4 a, dvec4 b, double h, dvec3 k) {
	double la = a.x + dot(k, a.yzw);
	double lb = b.x + dot(k, b.yzw);
	return -a.x * b.x + dot(a.yzw, b.yzw) + 2.0 * h * la * lb;
}

dvec3 ks_initial_momentum(dvec3 x, double mass, double a, dvec3 outward) {
	double r;
	double h;
	dvec3 k;
	ks_field(x, mass, a, r, h, k);
	double u0 = 1.0 / sqrt(max(1.0 - 2.0 * h, 1e-6));
	double shift = 2.0 * h * u0 * u0;
	dvec4 e1 = dvec4(shift * k.x, 1.0, 0.0, 0.0);
	dvec4 e2 = dvec4(shift * k.y, 0.0, 1.0, 0.0);
	dvec4 e3 = dvec4(shift * k.z, 0.0, 0.0, 1.0);
	e1 /= sqrt(max(ks_metric_dot(e1, e1, h, k), 1e-30));
	e2 -= ks_metric_dot(e2, e1, h, k) * e1;
	e2 /= sqrt(max(ks_metric_dot(e2, e2, h, k), 1e-30));
	e3 -= ks_metric_dot(e3, e1, h, k) * e1;
	e3 -= ks_metric_dot(e3, e2, h, k) * e2;
	e3 /= sqrt(max(ks_metric_dot(e3, e3, h, k), 1e-30));
	dvec4 v = dvec4(u0, 0.0, 0.0, 0.0) - outward.x * e1 - outward.y * e2 - outward.z * e3;
	double lv = v.x + dot(k, v.yzw);
	double pt = -v.x + 2.0 * h * lv;
	dvec3 p = v.yzw + 2.0 * h * lv * k;
	return p / max(-pt, 1e-12);
}

void main() {
	uint tile_x = gl_WorkGroupID.x * 16u;
	uint tile_y = gl_WorkGroupID.y * 16u;
	uint px = tile_x + gl_LocalInvocationID.x;
	uint local_row = tile_y + gl_LocalInvocationID.y;
	uint py = pc.dispatch_row_offset + local_row;

		if (px < pc.screen_width && local_row < pc.dispatch_row_count && py < pc.screen_height) {
		uint pixel_index = local_row * pc.screen_width + px;

		double aspect = double(pc.screen_width) / double(pc.screen_height);
		double v_norm = 1.0 - (double(py) + 0.5) / double(pc.screen_height) * 2.0;
		bool is_allsky = (pc.projection_mode == 3u || pc.projection_mode == 7u);
		double u_raw = (double(px) + 0.5) / double(pc.screen_width) * 2.0 - 1.0;
		double u_coord = is_allsky ? u_raw : (u_raw * aspect);

	dvec3 n_local = compute_ray_direction(pc.projection_mode, u_coord, v_norm, pc.field_of_view_rad);

	dvec3 fwd = pc.tetrad_e1.yzw;
	dvec3 rgt = pc.tetrad_e2.yzw;
	dvec3 up  = pc.tetrad_e3.yzw;

	dvec3 ray_dir = n_local.x * fwd + n_local.z * rgt + n_local.y * up;

	bool subsidiary_sources_present = false;
	for (uint sbi = 0u; sbi < pc.body_count; ++sbi) {
		if (bodies[sbi].preset_3d == 8u) { subsidiary_sources_present = true; break; }
	}

	bool early_done = false;
	{
		double obs_r0 = pc.observer_position.y;
		double obs_th0 = pc.observer_position.z;
		double obs_ph0 = pc.observer_position.w;
		dvec3 obs_pos0 = spherical_to_cartesian(obs_r0, obs_th0, obs_ph0);

		if ((pc.render_flags & (1u << 12)) != 0u && pc.body_count > 0u && ((pc.metric_type == 0u && !subsidiary_sources_present) || (pc.render_flags & (1u << 17)) != 0u)) {
			vec3 body_color;
			uint body_status;
			double body_dist;
			if (intersect_bodies(obs_pos0, ray_dir, 1e30, body_color, body_status, body_dist)) {
				vec3 mapped_body = apply_tonemapping(body_color, pc.tonemapping_mode, pc.camera_exposure);
				pixels[pixel_index].rgba = vec4(mapped_body, 1.0);
				pixels[pixel_index].redshift = 1.0;
				pixels[pixel_index].affine_parameter = 0.0;
				pixels[pixel_index].status_flags = body_status;
				pixels[pixel_index].iterations_used = 0u;
				early_done = true;
			}
		}

		if (!early_done && (pc.render_flags & (1u << 17)) != 0u) {
			vec3 sky_only = compute_sky_radiance(ray_dir, pc.sky_rotation_rad);
			vec3 mapped_sky = apply_tonemapping(sky_only, pc.tonemapping_mode, pc.camera_exposure);
			pixels[pixel_index].rgba = vec4(mapped_sky, 1.0);
			pixels[pixel_index].redshift = 1.0;
			pixels[pixel_index].affine_parameter = 0.0;
			pixels[pixel_index].status_flags = 2u;
			pixels[pixel_index].iterations_used = 0u;
			early_done = true;
		}
	}

	if (!early_done) {
		double m = (pc.metric_type == 0u) ? 0.0 : max(pc.metric_mass, 1e-4);
		double raw_spin = clamp(pc.metric_spin, -0.999 * m, 0.999 * m);
		double a_spin = (pc.metric_type == 4u) ? 0.0 : raw_spin;
		double kn_charge_sq = (pc.metric_type == 4u || pc.metric_type == 5u) ? (pc.metric_charge * pc.metric_charge) : 0.0;
		double rs = 2.0 * m;
		double rh = (abs(a_spin) > 1e-12 || kn_charge_sq > 1e-12) ? (m + sqrt(max(m * m - a_spin * a_spin - kn_charge_sq, 0.0))) : rs;

		uint status = 0u;
		uint iters = 0u;
		dvec3 accum = dvec3(0.0);
		double redshift_rec = 1.0;

		bool needs_ray_march = (pc.metric_type != 0u) || (subsidiary_sources_present && (pc.render_flags & (1u << 12)) != 0u && pc.body_count > 0u && (pc.render_flags & (1u << 17)) == 0u);

		if (!needs_ray_march) {
			iters = 1u;
			vec3 sky = compute_sky_radiance(ray_dir, pc.sky_rotation_rad);
			accum = dvec3(sky);
			status |= 2u;
		} else {
			bool has_accretion_disk = (pc.metric_type == 1u || pc.metric_type == 2u || pc.metric_type == 3u || pc.metric_type == 4u || pc.metric_type == 5u);
			bool use_kerr_newman_metric = (pc.metric_type == 2u || pc.metric_type == 4u || pc.metric_type == 5u) && (abs(a_spin) > 1e-9 * m || kn_charge_sq > 1e-18 * m * m);
			bool use_kerr_schild = use_kerr_newman_metric && pc.metric_type == 2u;
			double isco = use_kerr_newman_metric ? kerr_isco_radius_prograde_retrograde(m, a_spin) : ((abs(a_spin) > 1e-12) ? max(rh * 1.05, 6.0 * m - 4.0 * a_spin) : (6.0 * m));
			double disk_inner = isco * double(max(pc.primary_disk.inner_radius_scale, 1.0));
			double disk_outer = max(double(pc.primary_disk.outer_radius_mass_units) * m, disk_inner * 1.05);

			double r_obs = max(pc.observer_position.y, rh * 1.02);
			double theta_obs = clamp(pc.observer_position.z, 0.001, PI_D - 0.001);
			double phi_obs = pc.observer_position.w;

			double angular_pixel_size = pc.field_of_view_rad / max(double(pc.screen_width), 1.0);
			double bh_angular_diameter = (2.0 * rh) / r_obs;
			double turbulence_aa_factor = clamp(bh_angular_diameter / max(angular_pixel_size * 24.0, 1e-9), 0.0, 1.0);

			float phi_obs_f = float(phi_obs);
			dvec2 sincos_theta_obs = precise_sincos(theta_obs);
			double sin_to = sincos_theta_obs.x;
			double cos_to = sincos_theta_obs.y;
			double sin_po = double(sin(phi_obs_f));
			double cos_po = double(cos(phi_obs_f));

			dvec3 er = dvec3(sin_to * cos_po, sin_to * sin_po, cos_to);
			dvec3 eth = dvec3(cos_to * cos_po, cos_to * sin_po, -sin_to);
			dvec3 eph = dvec3(-sin_po, cos_po, 0.0);

			double n_r = dot(ray_dir, er);
			double n_th = dot(ray_dir, eth);
			double n_ph = dot(ray_dir, eph);

			double ray_r = r_obs;
			double ray_th = theta_obs;
			double ray_phi = phi_obs;
			double ray_pr;
			double ray_pth;
			double ray_pphi;
			double ray_p0 = 1.0;
			double E_cons = 1.0;
			double Lz_cons = 0.0;
			dvec3 ks_pos = dvec3(0.0);
			dvec3 ks_mom = dvec3(0.0);
			dvec3 ks_vel = dvec3(0.0, 0.0, 1.0);

			if (use_kerr_newman_metric) {
				double g00, g03, g11, g22, g33;
				double e0_t, e0_phi, e1_r, e2_th, e3_phi;
				kerr_newman_zamo_frame(r_obs, theta_obs, m, a_spin, kn_charge_sq, g00, g03, g11, g22, g33, e0_t, e0_phi, e1_r, e2_th, e3_phi);
				ray_p0 = e0_t;
				ray_pr = -n_r * e1_r;
				ray_pth = -n_th * e2_th;
				ray_pphi = e0_phi - n_ph * e3_phi;
				E_cons = -(g00 * ray_p0 + g03 * ray_pphi);
				Lz_cons = g03 * ray_p0 + g33 * ray_pphi;
				if (use_kerr_schild) {
					ks_pos = dvec3((r_obs * cos_po - a_spin * sin_po) * sin_to, (r_obs * sin_po + a_spin * cos_po) * sin_to, r_obs * cos_to);
					ks_mom = ks_initial_momentum(ks_pos, m, a_spin, ray_dir);
					E_cons = 1.0;
					Lz_cons = ks_pos.x * ks_mom.y - ks_pos.y * ks_mom.x;
				}
			} else {
				double factor_obs = max(1.0 - rs / r_obs, 1e-6);
				double sqrt_factor_obs = sqrt(factor_obs);
				ray_pr = -n_r;
				ray_pth = -n_th / (r_obs * sqrt_factor_obs);
				ray_pphi = -n_ph / (r_obs * sin_to * sqrt_factor_obs);
				Lz_cons = ray_pphi * (r_obs * r_obs * sin_to * sin_to);
			}

			double throughput = 1.0;

			bool bodies_traced = (pc.render_flags & (1u << 12)) != 0u && pc.body_count > 0u && (pc.render_flags & (1u << 17)) == 0u;
			dvec3 curr_body_cart_pos = bodies_traced ? spherical_to_cartesian(ray_r, ray_th, ray_phi) : dvec3(0.0);

			uint effective_max_steps = pc.max_integration_steps;
			if ((pc.render_flags & (1u << 9)) != 0u && pc.lod_distance_threshold > 0.0 && r_obs > pc.lod_distance_threshold) {
				effective_max_steps = min(pc.max_integration_steps, pc.lod_reduced_steps);
			}

			for (uint step = 0u; step < effective_max_steps && throughput > 0.01; ++step) {
				iters = step + 1u;

				double delta_kn = kerr_newman_delta(ray_r, m, a_spin, kn_charge_sq);
				if (ray_r <= rh * 1.0001 || delta_kn <= 0.0) {
					status = 1u;
					throughput = 0.0;
					break;
				}
				if (ray_r >= pc.escape_radius) {
					status = 2u;
					break;
				}

				if (!use_kerr_newman_metric && !subsidiary_sources_present && (pc.render_flags & (1u << 10)) != 0u) {
					double effective_skip_r = has_accretion_disk ? max(pc.space_skip_radius_scale * m, disk_outer * 1.05) : max(pc.space_skip_radius_scale * m, rh * 2.0);
					if (ray_r > effective_skip_r) {
						dvec3 skip_origin = spherical_to_cartesian(ray_r, ray_th, ray_phi);
						if (attempt_analytic_space_skip(ray_r, ray_th, ray_phi, ray_pr, ray_pth, ray_pphi, effective_skip_r, pc.escape_radius, m)) {
							if (bodies_traced) {
								dvec3 skip_vector = spherical_to_cartesian(ray_r, ray_th, ray_phi) - skip_origin;
								double skip_length = length(skip_vector);
								vec3 skip_color;
								uint skip_status;
								double skip_dist;
								if (skip_length > 1e-12 && intersect_bodies(skip_origin, skip_vector / skip_length, skip_length, skip_color, skip_status, skip_dist)) {
									accum += throughput * dvec3(skip_color);
									status |= 16u;
									throughput = 0.0;
									break;
								}
								curr_body_cart_pos = spherical_to_cartesian(ray_r, ray_th, ray_phi);
							}
							continue;
						}
					}
				}

				double r_scale = max(ray_r - rh, 0.02 * m);
				dvec2 sincos_ray_th = precise_sincos(ray_th);
				double sin_t = sincos_ray_th.x;
				double cos_t = sincos_ray_th.y;
				double pole_guard = (use_kerr_newman_metric && !use_kerr_schild) ? clamp(abs(sin_t) * 12.0 * pc.pole_guard_precision_scale, 0.02, 1.0) : 1.0;
				double far_field_factor = 1.0 + (pc.far_field_step_scale - 1.0) * clamp((ray_r - 20.0 * rh) / (80.0 * rh), 0.0, 1.0);
				double subsidiary_guard = subsidiary_step_guard(spherical_to_cartesian(ray_r, ray_th, ray_phi));
				double dt = -clamp(pc.step_size_factor * sqrt(ray_r * r_scale) * far_field_factor, pc.min_step_size, pc.max_step_size * pc.far_field_step_scale) * pole_guard * subsidiary_guard;

				double prev_r = ray_r;
				double prev_th = ray_th;
				double prev_phi = ray_phi;
				double prev_pphi = ray_pphi;

				if (use_kerr_newman_metric) {
					dvec4 u_state = dvec4(ray_p0, ray_pr, ray_pth, ray_pphi);
					if (use_kerr_schild) {
						ks_rk4_step(ks_pos, ks_mom, dt, m, a_spin);
						dvec3 ks_unused_dp;
						ks_rhs(ks_pos, ks_mom, m, a_spin, ks_vel, ks_unused_dp);
						double ks_a2 = a_spin * a_spin;
						double ks_diff = dot(ks_pos, ks_pos) - ks_a2;
						double ks_r2 = max(0.5 * (ks_diff + sqrt(ks_diff * ks_diff + 4.0 * ks_a2 * ks_pos.z * ks_pos.z)), 1e-24);
						ray_r = sqrt(ks_r2);
						ray_th = atan2_wide(sqrt(max(ks_r2 - ks_pos.z * ks_pos.z, 0.0)), ks_pos.z);
						double ks_phi = atan2_wide(ks_pos.y, ks_pos.x) - atan2_wide(a_spin, ray_r);
						double ks_delta = ks_phi - ray_phi;
						ks_delta -= 6.283185307179586 * floor(ks_delta / 6.283185307179586 + 0.5);
						ray_phi += ks_delta;
					} else {
						kerr_newman_rk4_step(ray_r, ray_th, ray_phi, u_state, dt, m, a_spin, kn_charge_sq);
					}
					ray_p0 = u_state.x;
					ray_pr = u_state.y;
					ray_pth = u_state.z;
					ray_pphi = u_state.w;
				} else {
					schwarzschild_null_step(ray_r, ray_th, ray_phi, ray_pr, ray_pth, ray_pphi, dt, rs);
				}

				if (bodies_traced) {
					apply_subsidiary_deflection(ray_r, ray_th, ray_phi, ray_pr, ray_pth, ray_pphi, dt);
				}

				if (ray_th < 0.0) {
					ray_th = -ray_th;
					ray_phi += PI_D;
					ray_pth = -ray_pth;
				} else if (ray_th > PI_D) {
					ray_th = 2.0 * PI_D - ray_th;
					ray_phi += PI_D;
					ray_pth = -ray_pth;
				}

				vec3 body_segment_color = vec3(0.0);
				bool body_segment_hit = false;
				if (bodies_traced) {
					dvec3 next_body_cart_pos = spherical_to_cartesian(ray_r, ray_th, ray_phi);
					dvec3 segment_vector = next_body_cart_pos - curr_body_cart_pos;
					double segment_length = length(segment_vector);
					if (segment_length > 1e-12) {
						uint segment_status;
						double segment_dist;
						body_segment_hit = intersect_bodies(curr_body_cart_pos, segment_vector / segment_length, segment_length, body_segment_color, segment_status, segment_dist);
					}

					vec3 subsidiary_color;
					double subsidiary_opacity;
					bool subsidiary_absorbed;
					if (intersect_subsidiary_sources(curr_body_cart_pos, next_body_cart_pos, subsidiary_color, subsidiary_opacity, subsidiary_absorbed)) {
						if (subsidiary_absorbed) {
							status = 1u;
							throughput = 0.0;
							break;
						}
						accum += throughput * dvec3(subsidiary_color);
						throughput *= (1.0 - subsidiary_opacity);
					}

					curr_body_cart_pos = next_body_cart_pos;
				}

				double mid_plane = PI_D * 0.5;
				if (has_accretion_disk && (prev_th - mid_plane) * (ray_th - mid_plane) <= 0.0) {
					double d_th_span = abs(ray_th - prev_th);
					double s_cross = (d_th_span > 1e-12) ? clamp(abs(prev_th - mid_plane) / d_th_span, 0.0, 1.0) : 0.5;
					double r_cross = prev_r + s_cross * (ray_r - prev_r);
					double phi_cross = prev_phi + s_cross * (ray_phi - prev_phi);
					double pphi_cross = prev_pphi + s_cross * (ray_pphi - prev_pphi);

					if (pc.primary_disk.enabled > 0.5 && r_cross >= disk_inner && r_cross <= disk_outer) {
						status |= 4u;

						double lz_at_cross = (use_kerr_newman_metric && !use_kerr_schild) ? (pphi_cross * r_cross * r_cross) : Lz_cons;
						double l_over_e = lz_at_cross / max(abs(E_cons), 1e-12);
						double g_doppler = disk_redshift(m, use_kerr_newman_metric ? a_spin : 0.0, r_cross, l_over_e);
						redshift_rec = g_doppler;

						vec3 shaded_rgb;
						double shaded_opacity;
						disk_shade(pc.primary_disk, m, use_kerr_newman_metric ? a_spin : 0.0, disk_inner, disk_outer, r_cross, phi_cross, g_doppler, pc.time, turbulence_aa_factor, shaded_rgb, shaded_opacity);

						accum += throughput * dvec3(shaded_rgb);
						throughput *= (1.0 - shaded_opacity);
					}
				}
				if (body_segment_hit && throughput > 0.01) {
					accum += throughput * dvec3(body_segment_color);
					status |= 16u;
					throughput = 0.0;
					break;
				}
			}

			if ((status & 3u) == 0u && ray_r < 3.0 * rs) {
				throughput = 0.0;
			}

			if ((status & 2u) != 0u || throughput > 0.01) {
				float ray_phi_f2 = float(ray_phi);
				dvec2 sincos_exit_th = precise_sincos(ray_th);
				double sin_t = sincos_exit_th.x;
				double cos_t = sincos_exit_th.y;
				double sin_p = double(sin(ray_phi_f2));
				double cos_p = double(cos(ray_phi_f2));

				double exit_radial = ray_pr / sqrt(max(1.0 - rs / ray_r, 1e-6));
				double pxr = -(exit_radial * sin_t * cos_p + ray_r * ray_pth * cos_t * cos_p - ray_r * sin_t * ray_pphi * sin_p);
				double pyr = -(exit_radial * sin_t * sin_p + ray_r * ray_pth * cos_t * sin_p + ray_r * sin_t * ray_pphi * cos_p);
				double pzr = -(exit_radial * cos_t - ray_r * ray_pth * sin_t);

				double p_len = sqrt(pxr * pxr + pyr * pyr + pzr * pzr);
				double inv_plen = (p_len > 1e-12) ? (1.0 / p_len) : 1.0;
				dvec3 dir_out = dvec3(pxr * inv_plen, pyr * inv_plen, pzr * inv_plen);
				if (use_kerr_schild) {
					dir_out = -ks_vel / max(length(ks_vel), 1e-12);
				}

				bool exit_body_hit = false;
				if (bodies_traced) {
					vec3 exit_color;
					uint exit_status;
					double exit_dist;
					dvec3 exit_origin = spherical_to_cartesian(ray_r, ray_th, ray_phi);
					exit_body_hit = intersect_bodies(exit_origin, dir_out, 1e30, exit_color, exit_status, exit_dist);
					if (exit_body_hit) {
						accum += throughput * dvec3(exit_color);
						status |= 16u;
					}
				}
				if (!exit_body_hit) {
					vec3 sky = compute_sky_radiance(dir_out, pc.sky_rotation_rad);
					accum += throughput * dvec3(sky);
					status |= 2u;
				}
			}
		}

		vec3 mapped = apply_tonemapping(vec3(accum), pc.tonemapping_mode, pc.camera_exposure);

		pixels[pixel_index].rgba = vec4(mapped, 1.0);
		pixels[pixel_index].redshift = float(redshift_rec);
		pixels[pixel_index].affine_parameter = float(iters) * 0.05;
		pixels[pixel_index].status_flags = status;
		pixels[pixel_index].iterations_used = iters;
	}
	}
}

