#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(push_constant) uniform PushConstants {
	vec4 obs_pos_hi;
	vec4 obs_pos_lo;
	vec4 tetrad_e0_hi;
	vec4 tetrad_e0_lo;
	vec4 tetrad_e1_hi;
	vec4 tetrad_e1_lo;
	vec4 tetrad_e2_hi;
	vec4 tetrad_e2_lo;
	vec4 tetrad_e3_hi;
	vec4 tetrad_e3_lo;

	uint screen_width;
	uint screen_height;
	uint metric_type;
	uint max_steps;

	float fov_rad;
	float metric_mass;
	float metric_spin;
	float horizon_radius;
	float escape_radius;
	float initial_step;
	uint projection_mode;
	uint pad1;
} pc;

struct PixelOutput {
	vec4 rgba;
	float redshift;
	float affine_parameter;
	uint status_flags;
	uint iterations_used;
};

layout(std430, binding = 0) buffer OutputBuffer {
	PixelOutput pixels[];
};

uint hash_u32(uint x) {
	x ^= x >> 16;
	x *= 0x7feb352dU;
	x ^= x >> 15;
	x *= 0x846ca68bU;
	x ^= x >> 16;
	return x;
}

float hash_to_float(uint x) {
	return float(hash_u32(x) & 0x00FFFFFFU) * (1.0 / 16777216.0);
}

vec3 sample_sky(vec3 dir) {
	float theta = acos(clamp(dir.z, -1.0, 1.0));
	float phi = atan(dir.y, dir.x);

	float u = (phi + 3.141592653589793) * (1.0 / (2.0 * 3.141592653589793));
	float v = theta * (1.0 / 3.141592653589793);

	float gal_lat = 0.5 - v;
	float gal_band = exp(-(gal_lat * gal_lat) / 0.015);
	float gal_core = exp(-(gal_lat * gal_lat) / 0.008) * exp(-pow(u - 0.5, 2.0) / 0.05);

	vec3 col = vec3(0.015 * gal_band + 0.12 * gal_core,
					0.020 * gal_band + 0.09 * gal_core,
					0.045 * gal_band + 0.06 * gal_core);

	float u_grid = u * 720.0;
	float v_grid = v * 360.0;
	int iu = int(floor(u_grid));
	int iv = int(floor(v_grid));

	uint seed = uint(iu * 73856093 ^ iv * 19349663);
	float prob = hash_to_float(seed);

	if (prob > 0.88) {
		float off_u = hash_to_float(seed + 101U);
		float off_v = hash_to_float(seed + 202U);
		float du = (u_grid - float(iu)) - off_u;
		float dv = (v_grid - float(iv)) - off_v;
		float d2 = du * du + dv * dv;
		if (d2 < 0.35) {
			float bright = pow(hash_to_float(seed + 303U), 6.0) * 4.5;
			float fall = exp(-d2 * 10.0);
			col += vec3(bright * fall);
		}
	}
	return col;
}

vec3 temp_to_rgb(float t, float intensity) {
	float r = 1.0, g = 1.0, b = 1.0;
	if (t <= 6600.0) {
		g = clamp(0.39008 * log(t / 100.0) - 0.63184, 0.0, 1.0);
		b = (t <= 1900.0) ? 0.0 : clamp(0.54320 * log(t / 100.0 - 10.0) - 1.19625, 0.0, 1.0);
	} else {
		r = clamp(1.29293 * pow(t / 100.0 - 60.0, -0.13320), 0.0, 1.0);
		g = clamp(1.12989 * pow(t / 100.0 - 60.0, -0.07551), 0.0, 1.0);
	}
	return vec3(r, g, b) * intensity;
}

void main() {
	uint px = gl_GlobalInvocationID.x;
	uint py = gl_GlobalInvocationID.y;

	if (px >= pc.screen_width || py >= pc.screen_height) {
		return;
	}

	uint pixel_index = py * pc.screen_width + px;

	float u_norm = (float(px) + 0.5) / float(pc.screen_width) * 2.0 - 1.0;
	float v_norm = 1.0 - (float(py) + 0.5) / float(pc.screen_height) * 2.0;
	float aspect = float(pc.screen_width) / float(pc.screen_height);
	u_norm *= aspect;

	float tan_half_fov = tan(pc.fov_rad * 0.5);
	float n1 = 1.0;
	float n2 = -v_norm * tan_half_fov;
	float n3 = u_norm * tan_half_fov;
	float n_len = sqrt(n1 * n1 + n2 * n2 + n3 * n3);
	if (n_len > 0.0) {
		n1 /= n_len; n2 /= n_len; n3 /= n_len;
	}

	float m = max(pc.metric_mass, 1e-4);
	float rs = 2.0 * m;
	float isco = 6.0 * m;
	float disk_outer = 24.0 * m;

	float r_obs = max(pc.obs_pos_hi.y, rs * 1.02);
	float th_obs = clamp(pc.obs_pos_hi.z, 0.01, 3.14159265 - 0.01);
	float phi_obs = pc.obs_pos_hi.w;

	float sin_to = sin(th_obs);
	float f_obs = max(1.0 - rs / r_obs, 1e-6);
	float sqrt_f_obs = sqrt(f_obs);

	float e0_t = 1.0 / sqrt_f_obs;
	float e1_r = sqrt_f_obs;
	float e2_th = 1.0 / r_obs;
	float e3_phi = 1.0 / (r_obs * sin_to);

	float ray_r = r_obs;
	float ray_th = th_obs;
	float ray_phi = phi_obs;
	float ray_pr = n1 * e1_r;
	float ray_pth = n2 * e2_th;
	float ray_pphi = n3 * e3_phi;

	float E_cons = e0_t * f_obs;
	float Lz_cons = ray_pphi * (r_obs * r_obs * sin_to * sin_to);

	vec3 acc_col = vec3(0.0);
	float throughput = 1.0;
	float redshift = 1.0;
	uint status = 0;
	uint iters = 0;

	for (uint step = 0; step < pc.max_steps && throughput > 0.01; ++step) {
		iters = step + 1;

		float delta_k = ray_r * ray_r - 2.0 * m * ray_r + pc.metric_spin * pc.metric_spin;
		if (ray_r <= rs * 1.0001 || delta_k <= 0.0) {
			status = 1;
			throughput = 0.0;
			break;
		}

		if (ray_r >= pc.escape_radius) {
			status = 2;
			break;
		}

		float r_scale = max(ray_r - rs, 0.02 * m);
		float dt = -clamp(0.05 * sqrt(ray_r * r_scale), 0.004, 3.5);
		float prev_r = ray_r;
		float prev_th = ray_th;
		float prev_phi = ray_phi;

		float f = max(1.0 - rs / ray_r, 1e-6);
		float p_t = E_cons / f;
		float sin_t = sin(ray_th);
		float cos_t = cos(ray_th);
		float sin2_t = max(sin_t * sin_t, 1e-10);
		float safe_sin_t = (abs(sin_t) > 1e-5) ? sin_t : ((sin_t >= 0.0) ? 1e-5 : -1e-5);
		float r2 = ray_r * ray_r;

		float g100 = (rs * f) / (2.0 * r2);
		float g111 = -rs / (2.0 * r2 * f);
		float g122 = -ray_r * f;
		float g133 = -ray_r * f * sin2_t;

		float d_pr = -(g100 * p_t * p_t + g111 * ray_pr * ray_pr + g122 * ray_pth * ray_pth + g133 * ray_pphi * ray_pphi);
		float d_pth = -(2.0 * (1.0 / ray_r) * ray_pr * ray_pth - sin_t * cos_t * ray_pphi * ray_pphi);
		float d_pphi = -2.0 * ((1.0 / ray_r) * ray_pr * ray_pphi + (cos_t / safe_sin_t) * ray_pth * ray_pphi);

		ray_r += dt * ray_pr;
		ray_th += dt * ray_pth;
		ray_phi += dt * ray_pphi;
		ray_pr += dt * d_pr;
		ray_pth += dt * d_pth;
		ray_pphi += dt * d_pphi;

		float mid = 1.57079632;
		if ((prev_th - mid) * (ray_th - mid) <= 0.0) {
			float s = clamp(abs(prev_th - mid) / max(abs(ray_th - prev_th), 1e-10), 0.0, 1.0);
			float r_cross = mix(prev_r, ray_r, s);
			float phi_cross = mix(prev_phi, ray_phi, s);

			if (r_cross >= isco && r_cross <= disk_outer) {
				status = 4;
				float v_orb = sqrt(m / r_cross);
				float omega_orb = v_orb / r_cross;
				float gamma_orb = 1.0 / sqrt(max(1.0 - 3.0 * m / r_cross, 1e-4));
				float l_e = Lz_cons / max(abs(E_cons), 1e-10);
				float g_dop = sqrt(max(1.0 - rs / r_cross, 1e-4)) / (gamma_orb * (1.0 - omega_orb * l_e));
				redshift = g_dop;

				float t_norm = pow(isco / r_cross, 0.75) * pow(max(1.0 - sqrt(isco / r_cross), 0.0), 0.25);
				float t_obs = (18000.0 * t_norm + 1200.0) * g_dop;
				float flux = pow(g_dop, 4.0) * t_norm * clamp((disk_outer - r_cross) / (1.5 * m), 0.0, 1.0) * 1.5;

				vec3 col = temp_to_rgb(t_obs, flux);
				acc_col += throughput * col;
				throughput *= 0.1;
			}
		}
	}

	if (throughput > 0.01) {
		vec3 dir = vec3(sin(ray_th) * cos(ray_phi), sin(ray_th) * sin(ray_phi), cos(ray_th));
		acc_col += throughput * sample_sky(dir);
	}

	vec3 mapped_col = clamp((acc_col * (2.51 * acc_col + 0.03)) / (acc_col * (2.43 * acc_col + 0.59) + 0.14), 0.0, 1.0);
	pixels[pixel_index].rgba = vec4(mapped_col, 1.0);
	pixels[pixel_index].redshift = redshift;
	pixels[pixel_index].affine_parameter = float(iters) * 0.05;
	pixels[pixel_index].status_flags = status;
	pixels[pixel_index].iterations_used = iters;
}
