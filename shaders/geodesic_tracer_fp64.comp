#version 450
#extension GL_ARB_gpu_shader_fp64 : enable

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(push_constant) uniform PushConstants {
    dvec4 observer_position;
    dvec4 tetrad_e0;
    dvec4 tetrad_e1;
    dvec4 tetrad_e2;
    dvec4 tetrad_e3;

    uint screen_width;
    uint screen_height;
    uint metric_type;
    uint precision_mode;

    double fov_rad;
    double metric_mass;
    double metric_spin;
    double metric_charge;

    double speed_of_light;
    double g_constant;
    double initial_step;
    double min_step;

    double max_step;
    double horizon_radius;
    double escape_radius;
    double cosmological_lambda;

    uint max_steps;
    uint render_flags;
    uint projection_mode;
    uint pad1;
} pc;

struct PixelOutput {
    vec4 rgba;
    float redshift;
    float affine_parameter;
    uint status_flags;
    uint iterations_used;
};

layout(std430, binding = 0) buffer OutputBuffer {
    PixelOutput pixels[];
};

dvec4 compute_schwarzschild_acc(dvec4 x, dvec4 u, double rs, double c2) {
    double r = max(x.y, rs * 1.000000001);
    double theta = x.z;
    double sin_t = sin(theta);
    double cos_t = cos(theta);
    double r_diff = r - rs;
    double r2 = r * r;
    double r3 = r2 * r;

    double g001 = rs / (2.0 * r * r_diff);
    double g100 = (c2 * rs * r_diff) / (2.0 * r3);
    double g111 = -g001;
    double g122 = -r_diff;
    double g133 = -r_diff * sin_t * sin_t;
    double g212 = 1.0 / r;
    double g233 = -sin_t * cos_t;
    double g313 = 1.0 / r;
    double g323 = (abs(sin_t) > 1e-15) ? (cos_t / sin_t) : 0.0;

    dvec4 acc;
    acc.x = -2.0 * g001 * u.x * u.y;
    acc.y = -(g100 * u.x * u.x + g111 * u.y * u.y + g122 * u.z * u.z + g133 * u.w * u.w);
    acc.z = -(2.0 * g212 * u.y * u.z + g233 * u.w * u.w);
    acc.w = -2.0 * (g313 * u.y * u.w + g323 * u.z * u.w);
    return acc;
}

vec4 evaluate_sky(dvec4 x, dvec4 u) {
    double r_final = x.y;
    double theta_final = x.z;
    double phi_final = x.w;
    double pr = u.y;
    double ptheta = u.z;
    double pphi = u.w;

    double sin_t = sin(theta_final);
    double cos_t = cos(theta_final);
    double sin_p = sin(phi_final);
    double cos_p = cos(phi_final);

    double px = pr * sin_t * cos_p + r_final * ptheta * cos_t * cos_p - r_final * sin_t * pphi * sin_p;
    double py = pr * sin_t * sin_p + r_final * ptheta * cos_t * sin_p + r_final * sin_t * pphi * cos_p;
    double pz = pr * cos_t - r_final * ptheta * sin_t;

    double len = sqrt(px * px + py * py + pz * pz);
    if (len > 0.0) {
        px /= len;
        py /= len;
        pz /= len;
    }

    double phi = atan(py, px);
    double theta = acos(clamp(pz, -1.0, 1.0));

    double u_coord = (phi + 3.141592653589793) / (2.0 * 3.141592653589793);
    double v_coord = theta / 3.141592653589793;

    double grid_u = abs(fract(u_coord * 24.0) - 0.5);
    double grid_v = abs(fract(v_coord * 12.0) - 0.5);
    float grid = (grid_u < 0.02 || grid_v < 0.04) ? 0.8 : 0.1;

    vec3 col = vec3(float(0.5 + 0.5 * sin(u_coord * 6.28318)), float(0.5 + 0.5 * cos(v_coord * 6.28318)), float(grid));
    return vec4(col, 1.0);
}

void main() {
    uint px = gl_GlobalInvocationID.x;
    uint py = gl_GlobalInvocationID.y;

    if (px >= pc.screen_width || py >= pc.screen_height) {
        return;
    }

    uint pixel_index = py * pc.screen_width + px;

    double u_norm = (double(px) + 0.5) / double(pc.screen_width) * 2.0 - 1.0;
    double v_norm = 1.0 - (double(py) + 0.5) / double(pc.screen_height) * 2.0;
    double aspect = double(pc.screen_width) / double(pc.screen_height);
    u_norm *= aspect;

    double n1 = 1.0;
    double n2 = 0.0;
    double n3 = 0.0;

    if (pc.projection_mode == 3) {
        double phi = u_norm * 3.14159265358979323846 / aspect;
        double theta = (0.5 - 0.5 * v_norm) * 3.14159265358979323846;
        double sin_t = sin(theta);
        double cos_t = cos(theta);
        n1 = sin_t * cos(phi);
        n2 = cos_t;
        n3 = sin_t * sin(phi);
    } else if (pc.projection_mode == 2) {
        double r = sqrt(u_norm * u_norm + v_norm * v_norm);
        if (r > 1e-15) {
            double theta = 2.0 * atan(r * tan(pc.fov_rad * 0.25));
            double sin_t = sin(theta);
            double cos_t = cos(theta);
            n1 = cos_t;
            n2 = -v_norm * (sin_t / r);
            n3 = u_norm * (sin_t / r);
        }
    } else if (pc.projection_mode == 1) {
        double beta = 0.99;
        double comp = sqrt((1.0 + beta) / (1.0 - beta));
        double tan_half = tan(pc.fov_rad * 0.5) / comp;
        n1 = 1.0;
        n2 = -v_norm * tan_half;
        n3 = u_norm * tan_half;
    } else {
        double tan_half_fov = tan(pc.fov_rad * 0.5);
        n1 = 1.0;
        n2 = -v_norm * tan_half_fov;
        n3 = u_norm * tan_half_fov;
    }

    double n_len = sqrt(n1 * n1 + n2 * n2 + n3 * n3);
    if (n_len > 0.0) {
        n1 /= n_len;
        n2 /= n_len;
        n3 /= n_len;
    }

    dvec4 ray_x = pc.observer_position;
    dvec4 ray_u = pc.tetrad_e0 + n1 * pc.tetrad_e1 + n2 * pc.tetrad_e2 + n3 * pc.tetrad_e3;

    double rs = pc.horizon_radius;
    double c2 = pc.speed_of_light * pc.speed_of_light;
    double total_lambda = 0.0;
    uint status = 0;
    uint iters = 0;

    for (uint step = 0; step < pc.max_steps; ++step) {
        iters = step + 1;
        double current_r = ray_x.y;
        double prev_theta = ray_x.z;

        if (current_r <= rs * 1.002) {
            status = 1;
            break;
        }

        if (current_r >= pc.escape_radius || (step > 4 && current_r >= pc.observer_position.y && ray_u.y < 0.0)) {
            status = 2;
            break;
        }

        double dt = -clamp(0.08 * current_r, 0.01, 1.0);

        dvec4 k1_x = ray_u;
        dvec4 k1_u = compute_schwarzschild_acc(ray_x, ray_u, rs, c2);

        dvec4 s2_x = ray_x + (0.5 * dt) * k1_x;
        dvec4 s2_u = ray_u + (0.5 * dt) * k1_u;
        dvec4 k2_x = s2_u;
        dvec4 k2_u = compute_schwarzschild_acc(s2_x, s2_u, rs, c2);

        dvec4 s3_x = ray_x + (0.5 * dt) * k2_x;
        dvec4 s3_u = ray_u + (0.5 * dt) * k2_u;
        dvec4 k3_x = s3_u;
        dvec4 k3_u = compute_schwarzschild_acc(s3_x, s3_u, rs, c2);

        dvec4 s4_x = ray_x + dt * k3_x;
        dvec4 s4_u = ray_u + dt * k3_u;
        dvec4 k4_x = s4_u;
        dvec4 k4_u = compute_schwarzschild_acc(s4_x, s4_u, rs, c2);

        ray_x += (dt / 6.0) * (k1_x + 2.0 * k2_x + 2.0 * k3_x + k4_x);
        ray_u += (dt / 6.0) * (k1_u + 2.0 * k2_u + 2.0 * k3_u + k4_u);

        total_lambda += abs(dt);

        double curr_theta = ray_x.z;
        if ((prev_theta - 1.57079632679) * (curr_theta - 1.57079632679) < 0.0) {
            double t_cross = abs(prev_theta - 1.57079632679) / (abs(prev_theta - 1.57079632679) + abs(curr_theta - 1.57079632679));
            double r_cross = mix(current_r, ray_x.y, t_cross);
            
            double isco = 6.0 * pc.metric_mass;
            if (pc.metric_spin > 0.0) isco = 6.0 * pc.metric_mass - 4.0 * pc.metric_mass * pc.metric_spin;
            double disk_outer = 25.0 * pc.metric_mass;
            
            if (r_cross >= isco && r_cross <= disk_outer) {
                status = 4;
                ray_x.y = r_cross;
                ray_x.z = 1.57079632679;
                ray_x.w = mix(ray_x.w - dt * ray_u.w, ray_x.w, t_cross);
                break;
            }
        }
    }

    vec4 color = vec4(0.0, 0.0, 0.0, 1.0);
    float redshift = 1.0;

    if (status == 4) {
        double r = ray_x.y;
        double isco = 6.0 * pc.metric_mass;
        if (pc.metric_spin > 0.0) isco = 6.0 * pc.metric_mass - 4.0 * pc.metric_mass * pc.metric_spin;
        
        double temp = pow(isco / r, 0.75);
        double v_phi = sqrt(pc.metric_mass / r);
        double n_phi = ray_u.w * r;
        double g_factor = 1.0 / (1.0 - v_phi * n_phi);
        
        double intensity = temp * pow(g_factor, 3.0);
        double phi = ray_x.w;
        float pattern = float(sin(phi * 20.0) * sin(r * 2.0));
        intensity *= (0.8 + 0.2 * pattern);
        
        double fade = smoothstep(25.0 * pc.metric_mass, 20.0 * pc.metric_mass, r);
        vec3 disk_col = vec3(1.0, 0.5, 0.1) * float(intensity * fade);
        
        color = vec4(disk_col, 1.0);
        redshift = float(g_factor);
    } else if (status == 2) {
        double u_coord = (ray_x.w + 3.141592653589793) / (2.0 * 3.141592653589793);
        double v_coord = ray_x.z / 3.141592653589793;
        
        float n = fract(sin(dot(vec2(u_coord, v_coord), vec2(12.9898, 78.233))) * 43758.5453);
        vec3 sky_col = vec3(0.0);
        if (n > 0.995) {
            sky_col = vec3(float((n - 0.995) * 200.0));
        }
        float band = exp(-pow(v_coord - 0.5, 2.0) * 20.0);
        sky_col += vec3(0.05, 0.1, 0.2) * band;
        
        color = vec4(sky_col, 1.0);
        double factor_obs = 1.0 - rs / pc.observer_position.y;
        double factor_emit = 1.0 - rs / ray_x.y;
        if (factor_obs > 0.0 && factor_emit > 0.0) {
            redshift = float(sqrt(factor_emit / factor_obs));
        }
    } else if (status == 1) {
        color = vec4(0.0, 0.0, 0.0, 1.0);
    }

    pixels[pixel_index].rgba = color;
    pixels[pixel_index].redshift = redshift;
    pixels[pixel_index].affine_parameter = float(total_lambda);
    pixels[pixel_index].status_flags = status;
    pixels[pixel_index].iterations_used = iters;
}
